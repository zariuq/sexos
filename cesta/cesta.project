(cesta project/1
  (compiler gcc)
  (out "build")
  (profile userland
    (flags "-std=c11" "-O2" "-g0" "-ffreestanding" "-fno-builtin"
           "-fPIE" "-fno-stack-protector" "-mno-red-zone" "-mgeneral-regs-only"
           "-Wall" "-Wextra" "-Wpedantic" "-Wformat=2" "-Werror")
    (link "-nostdlib" "-static-pie" "-Wl,-e,_start" "-Wl,--build-id=none"))
  (profile kernel
    (flags "-std=c11" "-O2" "-g0" "-ffreestanding" "-fno-builtin"
           "-fno-pic" "-fno-pie" "-mcmodel=kernel" "-fno-stack-protector" "-fno-asynchronous-unwind-tables"
           "-mno-red-zone" "-mgeneral-regs-only"
           "-Wall" "-Wextra" "-Wpedantic" "-Wformat=2" "-Werror")
    (link "-nostdlib" "-static" "-Wl,-T,runtime/kernel/kernel.ld" "-Wl,--build-id=none"
          "-Wl,-z,max-page-size=0x1000"))
  (profile userland-f64
    (flags "-std=c11" "-O2" "-g0" "-ffreestanding" "-fno-builtin"
           "-fPIE" "-fno-stack-protector" "-mno-red-zone" "-msse2" "-mfpmath=sse"
           "-Wall" "-Wextra" "-Wpedantic" "-Wformat=2" "-Werror")
    (link "-nostdlib" "-static-pie" "-Wl,-e,_start" "-Wl,--build-id=none"))
  (target kaleidoscope
    (profile userland-f64)
    (sources "src/kaleidoscope.cesta" "src/kaleidoscope_body.cesta"
             "src/kaleidoscope_decimal.cesta" "src/kaleidoscope_script_lexer.cesta" "src/kaleidoscope_regex.cesta"
             "src/kaleidoscope_regex_match.cesta" "src/kaleidoscope_script_core.cesta"
             "src/kaleidoscope_html.cesta"
             "runtime/client_runtime.c" "runtime/traps_x86_64.c"
             "runtime/start_x86_64.S" "generated/runtime/*.c")
    (include "generated/include")
    (define "SEXOS_KALEIDOSCOPE_CURRENT=1"))
  (target kaleidoscope-navigation
    (profile userland)
    (kind archive)
    (sources "src/kaleidoscope_navigation.cesta")
    (include "generated/include"))
