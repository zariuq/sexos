      (if (&& DMA_QUARANTINE_PROBE_ENABLED (! (. sexdrive_state dma_probe_injected)))
        (block
          (= (. sexdrive_state dma_probe_injected) true)
          (call sexos_line "[sexdrive.dma.probe.arm] next_cid=%llu read_phys=%#llx"
