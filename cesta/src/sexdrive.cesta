          (var uint32_t rd_sc (& rd_sf 0xFFu))
          (var uint32_t rd_sct (& (>> rd_sf 8) 0x7u))
          (var uint32_t rd_sqhd (& rd_dw2 0xFFFFu))
          (var uint32_t rd_sqid (& (>> rd_dw2 16) 0xFFFFu))

          (= io_cq_head (% (+ io_cq_head 1u) io_q_entries))
