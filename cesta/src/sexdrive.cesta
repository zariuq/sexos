        (cast (unsigned long long) cc_old))
      (call sexos_volatile_write32
        (cast (uint32_t *) (cast uintptr_t (+ map_va 0x0014ULL))) cc_disabled)
      (var uint32_t poll_limit (?: (== cap_to 0u) 1000000u
