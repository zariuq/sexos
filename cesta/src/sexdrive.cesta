(cesta native-c/1 compact-c/2
  (unit
    (include "sexos_mmio.h")

    (comment "NVMe storage driver and block service (apps/sexdrive/src/main.rs).")

    (cpp-if "!defined(SEXOS_STORAGE_100_PERSIST_WRITE)"
      (then (define SEXOS_STORAGE_100_PERSIST_WRITE "0")))
    (cpp-if "!defined(SEXOS_STORAGE_100_PERSIST_READ)"
      (then (define SEXOS_STORAGE_100_PERSIST_READ "0")))
    (cpp-if "!defined(SEXOS_STORAGE_100_FLUSH_AUDIT)"
      (then (define SEXOS_STORAGE_100_FLUSH_AUDIT "0")))
    (cpp-if "!defined(SEXOS_STORAGE_100_NEGATIVE)"
      (then (define SEXOS_STORAGE_100_NEGATIVE "0")))
    (cpp-if "!defined(SEXOS_STORAGE_100_NEG_MISMATCH)"
      (then (define SEXOS_STORAGE_100_NEG_MISMATCH "0")))
    (cpp-if "!defined(SEXOS_STORAGE_100_IO_READ_PROBE)"
      (then (define SEXOS_STORAGE_100_IO_READ_PROBE "0")))

    (define STORAGE_100_PERSIST_WRITE_ENABLED "SEXOS_STORAGE_100_PERSIST_WRITE")
    (define STORAGE_100_PERSIST_READ_ENABLED "SEXOS_STORAGE_100_PERSIST_READ")
    (define STORAGE_100_FLUSH_AUDIT_ENABLED "SEXOS_STORAGE_100_FLUSH_AUDIT")
    (define STORAGE_100_NEGATIVE_ENABLED "SEXOS_STORAGE_100_NEGATIVE")
    (define STORAGE_100_NEG_MISMATCH_ENABLED "SEXOS_STORAGE_100_NEG_MISMATCH")
    (define STORAGE_100_IO_READ_PROBE_ENABLED "SEXOS_STORAGE_100_IO_READ_PROBE")

    (define OP_SHELL_BIND_BUFFER "UINT64_C(0x14)")
    (define SLOT_SHELL "((uint64_t)SEXOS_SLOT_shell)")
    (define SLOT_USB_HOST "UINT64_C(8)")
    (define SLOT_NVME_HOST "UINT64_C(16)")
    (define SLOT_BUF_LEND "((uint64_t)SEXOS_SLOT_buf_lend)")
    (define BLOCK_READ "UINT64_C(1)")
    (define BLOCK_WRITE "UINT64_C(2)")
    (define BLOCK_SYNC "UINT64_C(3)")
    (define BLOCK_ERR_BAD_CMD "UINT64_C(1)")
    (define BLOCK_ERR_BAD_LEN "UINT64_C(2)")
    (define BLOCK_ERR_NO_DEVICE "UINT64_C(4)")
    (define BLOCK_SECTOR_SIZE "UINT64_C(512)")
    (define BLOCK_MAX_XFER "UINT64_C(4096)")

    (define PAGE_SIZE "UINT64_C(4096)")
    (define NVME_SQ0TDBL "UINT64_C(0x1000)")
    (define NVME_CQ0HDBL "UINT64_C(0x1004)")
    (define NVME_LBA_BYTES "UINT64_C(512)")

    (define WRITE_PROOF_LBA "UINT64_C(2047)")
    (define WRITE_PROOF_LEN "UINT64_C(512)")
    (define WRITE_PROOF_MAGIC "UINT64_C(0x3156455449525753)")
    (define AP4_MULTI_BASE_LBA "UINT64_C(128)")
    (define AP4_MULTI_BLOCKS "UINT64_C(4)")
    (define AP4_MULTI_BLOCK_BYTES "NVME_LBA_BYTES")
    (define AP5A_PERSIST_BASE_LBA "UINT64_C(256)")
    (define AP5A_PERSIST_BLOCKS "UINT64_C(4)")
    (define AP5A_PERSIST_BLOCK_BYTES "NVME_LBA_BYTES")
    (define AP6_NEG_MISMATCH_LBA "UINT64_C(384)")
    (define AP6_NEG_MISMATCH_BYTES "NVME_LBA_BYTES")
    (define MANIFEST_LBA "UINT64_C(2046)")
    (define PROOF_OBJECT_START_LBA "UINT64_C(2038)")
    (define PROOF_OBJECT_END_LBA "UINT64_C(2045)")
    (define LINEN_OBJECT_START_LBA "UINT64_C(2030)")
    (define LINEN_OBJECT_END_LBA "UINT64_C(2037)")
    (define QUIL_OBJECT_START_LBA "UINT64_C(2022)")
    (define QUIL_OBJECT_END_LBA "UINT64_C(2029)")
    (define SEXFS_V0_META_START_LBA "UINT64_C(0)")
    (define SEXFS_V0_META_END_LBA "UINT64_C(47)")
    (define SEXFS_V0_OBJECT_START_LBA "UINT64_C(128)")
    (define SEXFS_V0_OBJECT_END_LBA "UINT64_C(2019)")

    (typedef (struct
      (bool ready)
      (uint64_t map_va)
      (uint64_t io_sq_va)
      (uint64_t io_cq_va)
      (uint64_t sq1tdbl)
      (uint64_t cq1hdbl)
      (uint32_t sq_tail)
      (uint32_t cq_head)
      (uint32_t cq_phase)
      (uint16_t next_cid)) NvmeIoState)

    (typedef (struct
      (uint32_t hot_log_budget)
      (NvmeIoState nvme_io_state)) SexdriveState)

    (var (static SexdriveState) sexdrive_state)

    (fn (static void) sexdrive_state_init ((SexdriveState (* s)))
      (call memset s 0 (sizeof (* s)))
      (= (-> s hot_log_budget) 240)
      (= (. (-> s nvme_io_state) cq_phase) 1)
      (= (. (-> s nvme_io_state) next_cid) 0x0500))

    (fn (static bool) hot_log (void)
      (if (> (. sexdrive_state hot_log_budget) 0)
        (block
          (-= (. sexdrive_state hot_log_budget) 1)
          (return true)))
      (return false))

    (fn (static inline uint64_t) sys_alloc_phys ((uint64_t size))
      (return (call sexos_allocate_memory size)))

    (fn (static inline uint64_t) sys_map_phys ((uint64_t phys) (uint64_t size))
      (return (call sexos_map_memory phys size)))

    (fn (static uint64_t) nvme_read_into_bounce ((uint64_t offset) (uint64_t size))
      (if (|| (== size 0) (|| (> size BLOCK_MAX_XFER) (|| (> size PAGE_SIZE) (|| (!= (% offset NVME_LBA_BYTES) 0) (!= (% size NVME_LBA_BYTES) 0)))))
        (block
          (call sexos_line "[sexdrive.block.read.api.err] reason=bad_len offset=%#llx size=%llu lba=%llu"
            (cast (unsigned long long) offset) (cast (unsigned long long) size) (cast (unsigned long long) NVME_LBA_BYTES))
          (return BLOCK_ERR_BAD_LEN)))

      (if (! (. (. sexdrive_state nvme_io_state) ready))
        (block
          (call sexos_line "[sexdrive.block.read.api.err] reason=no_ioq_ready")
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint64_t map_va (. (. sexdrive_state nvme_io_state) map_va))
      (var uint64_t io_sq_va (. (. sexdrive_state nvme_io_state) io_sq_va))
      (var uint64_t io_cq_va (. (. sexdrive_state nvme_io_state) io_cq_va))
      (var uint64_t sq1tdbl (. (. sexdrive_state nvme_io_state) sq1tdbl))
      (var uint64_t cq1hdbl (. (. sexdrive_state nvme_io_state) cq1hdbl))
      (var uint32_t sq_tail (. (. sexdrive_state nvme_io_state) sq_tail))
      (var uint32_t cq_head (. (. sexdrive_state nvme_io_state) cq_head))
      (var uint32_t cq_phase (. (. sexdrive_state nvme_io_state) cq_phase))
      (var uint16_t cid (. (. sexdrive_state nvme_io_state) next_cid))
      (= (. (. sexdrive_state nvme_io_state) next_cid) (cast uint16_t (+ cid 1u)))

      (var uint64_t data_phys (call sys_alloc_phys PAGE_SIZE))
      (if (|| (== data_phys 0) (|| (== data_phys UINT64_MAX) (!= (% data_phys PAGE_SIZE) 0)))
        (block
          (call sexos_line "[sexdrive.block.read.api.err] reason=data_alloc_invalid phys=%#llx"
            (cast (unsigned long long) data_phys))
          (return BLOCK_ERR_NO_DEVICE)))
      (var uint64_t data_va (call sys_map_phys data_phys PAGE_SIZE))
      (if (|| (== data_va 0) (== data_va UINT64_MAX))
        (block
          (call sexos_line "[sexdrive.block.read.api.err] reason=data_map_failed va=%#llx"
            (cast (unsigned long long) data_va))
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint64_t (* zero_ptr) (cast (uint64_t *) (cast uintptr_t data_va)))
      (for (var size_t i 0) (< i (cast size_t (/ PAGE_SIZE 8ULL))) (++ i)
        (call sexos_volatile_write64 (+ zero_ptr i) 0ULL))

      (var uint64_t slba (/ offset NVME_LBA_BYTES))
      (var uint64_t nlb (- (/ size NVME_LBA_BYTES) 1ULL))

      (var uint32_t (* sqe_ptr) (cast (uint32_t *) (cast uintptr_t (+ io_sq_va (* (cast uint64_t sq_tail) 64ULL)))))
      (for (var size_t i 0) (< i 16) (++ i)
        (call sexos_volatile_write32 (+ sqe_ptr i) 0u))
      (call sexos_volatile_write32 (+ sqe_ptr 0) (| 0x02u (<< (cast uint32_t cid) 16)))
      (call sexos_volatile_write32 (+ sqe_ptr 1) 1u)
      (call sexos_volatile_write32 (+ sqe_ptr 6) (cast uint32_t (& data_phys 0xFFFFFFFFULL)))
      (call sexos_volatile_write32 (+ sqe_ptr 7) (cast uint32_t (>> data_phys 32)))
      (call sexos_volatile_write32 (+ sqe_ptr 10) (cast uint32_t (& slba 0xFFFFFFFFULL)))
      (call sexos_volatile_write32 (+ sqe_ptr 11) (cast uint32_t (>> slba 32)))
      (call sexos_volatile_write32 (+ sqe_ptr 12) (cast uint32_t (& nlb 0xFFFFULL)))

      (call sexos_line "[sexdrive.block.read.api.nvme.submit] cid=%llu nsid=%llu slba=%llu nlb=%llu prp1=%#llx sq_tail=%llu"
        (cast (unsigned long long) cid) 1ULL (cast (unsigned long long) slba) (cast (unsigned long long) nlb)
        (cast (unsigned long long) data_phys) (cast (unsigned long long) sq_tail))
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.submit.detail] path=typed op=READ cid=%llu sq_tail_before=%llu sq_tail_after=%llu cq_head=%llu cq_phase=%llu lba=%llu bytes=%llu"
          (cast (unsigned long long) cid) (cast (unsigned long long) sq_tail)
          (cast (unsigned long long) (% (+ sq_tail 1u) 16u)) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) slba) (cast (unsigned long long) size)))

      (call sexos_compiler_fence_seq_cst)
      (= sq_tail (% (+ sq_tail 1u) 16u))
      (call sexos_volatile_write32 (cast (uint32_t *) (cast uintptr_t (+ map_va sq1tdbl))) sq_tail)
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.doorbell] path=typed qid=1 tail=%llu"
          (cast (unsigned long long) sq_tail)))

      (var bool done false)
      (var uint32_t dw2 0)
      (var uint32_t dw3 0)
      (var uint32_t max_polls 1000000u)
      (var uint32_t polls 0)
      (var uint32_t last_dw3 0)
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.poll.begin] path=typed cid=%llu cq_head=%llu phase=%llu max_polls=%llu"
          (cast (unsigned long long) cid) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) max_polls)))
      (for (var uint32_t p 0) (< p max_polls) (++ p)
        (block
          (+= polls 1u)
          (var (const uint32_t) (* cqe_ptr) (cast ((const uint32_t) *) (cast uintptr_t (+ io_cq_va (* (cast uint64_t cq_head) 16ULL)))))
          (var uint32_t rd_dw2 (call sexos_volatile_read32 (+ cqe_ptr 2)))
          (var uint32_t rd_dw3 (call sexos_volatile_read32 (+ cqe_ptr 3)))
          (= last_dw3 rd_dw3)
          (var uint32_t cid_now (& rd_dw3 0xFFFFu))
          (var uint32_t phase_now (& (>> rd_dw3 16) 0x1u))
          (if (&& (== cid_now (cast uint32_t cid)) (== phase_now cq_phase))
            (block
              (= done true)
              (= dw2 rd_dw2)
              (= dw3 rd_dw3)
              (call sexos_line "[sexdrive.block.read.api.cqe] cid=%llu phase=%llu dw2=%#llx dw3=%#llx"
                (cast (unsigned long long) cid_now) (cast (unsigned long long) phase_now)
                (cast (unsigned long long) rd_dw2) (cast (unsigned long long) rd_dw3))
              break))))
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.poll.end] path=typed cid=%llu found=%llu status=%llu cq_head=%llu phase=%llu polls=%llu"
          (cast (unsigned long long) cid) (cast (unsigned long long) (?: done 1ULL 0ULL))
          (cast (unsigned long long) (& (>> dw3 17) 0x7FFFu)) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) polls)))
      (if (! done)
        (block
          (call sexos_line "[sexdrive.block.read.api.err] reason=cqe_timeout cid=%llu head=%llu phase=%llu"
            (cast (unsigned long long) cid) (cast (unsigned long long) cq_head) (cast (unsigned long long) cq_phase))
          (call sexos_line "[sexdrive.nvme.poll.timeout.detail] path=typed cid=%llu expected_cid=%llu seen_cid=%llu seen_status=%llu seen_phase=%llu cq_head=%llu phase=%llu polls=%llu"
            (cast (unsigned long long) cid) (cast (unsigned long long) cid)
            (cast (unsigned long long) (& last_dw3 0xFFFFu)) (cast (unsigned long long) (& (>> last_dw3 17) 0x7FFFu))
            (cast (unsigned long long) (& (>> last_dw3 16) 0x1u)) (cast (unsigned long long) cq_head)
            (cast (unsigned long long) cq_phase) (cast (unsigned long long) polls))
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint32_t sf (& (>> dw3 17) 0x7FFFu))
      (var uint32_t sc (& sf 0xFFu))
      (var uint32_t sct (& (>> sf 8) 0x7u))
      (if (|| (!= sc 0) (!= sct 0))
        (block
          (var uint32_t sqhd (& dw2 0xFFFFu))
          (var uint32_t sqid (& (>> dw2 16) 0xFFFFu))
          (call sexos_line "[sexdrive.block.read.api.err] reason=status_fail cid=%llu sc=%llu sct=%llu sqhd=%llu sqid=%llu dw3=%#llx"
            (cast (unsigned long long) cid) (cast (unsigned long long) sc) (cast (unsigned long long) sct)
            (cast (unsigned long long) sqhd) (cast (unsigned long long) sqid) (cast (unsigned long long) dw3))
          (return BLOCK_ERR_NO_DEVICE)))

      (= cq_head (% (+ cq_head 1u) 16u))
      (if (== cq_head 0u)
        (^= cq_phase 1u))
      (call sexos_volatile_write32 (cast (uint32_t *) (cast uintptr_t (+ map_va cq1hdbl))) cq_head)
      (= (. (. sexdrive_state nvme_io_state) sq_tail) sq_tail)
      (= (. (. sexdrive_state nvme_io_state) cq_head) cq_head)
      (= (. (. sexdrive_state nvme_io_state) cq_phase) cq_phase)

      (var uint64_t d0 (call sexos_volatile_read64 (cast ((const uint64_t) *) (cast uintptr_t data_va))))
      (var uint64_t d1 (call sexos_volatile_read64 (cast ((const uint64_t) *) (cast uintptr_t (+ data_va 8ULL)))))
      (call sexos_line "[sexdrive.block.read.api.ok] cid=%llu slba=%llu nlb=%llu d0=%#llx d1=%#llx"
        (cast (unsigned long long) cid) (cast (unsigned long long) slba) (cast (unsigned long long) nlb)
        (cast (unsigned long long) d0) (cast (unsigned long long) d1))
      (return 0ULL))

    (fn (static uint64_t) nvme_read_into_mapped_va ((uint64_t offset) (uint64_t size) (uint64_t dst_va))
      (if (|| (== size 0) (|| (> size BLOCK_MAX_XFER) (|| (> size PAGE_SIZE) (|| (!= (% offset NVME_LBA_BYTES) 0) (|| (!= (% size NVME_LBA_BYTES) 0) (|| (== dst_va 0) (== dst_va UINT64_MAX)))))))
        (block
          (call sexos_line "[sexdrive.block.read.handoff.err] reason=bad_args offset=%#llx size=%llu dst_va=%#llx"
            (cast (unsigned long long) offset) (cast (unsigned long long) size) (cast (unsigned long long) dst_va))
          (return BLOCK_ERR_BAD_LEN)))

      (if (call hot_log)
        (call sexos_line "[sexdrive.block.read.handoff.nvme.begin] offset=%#llx size=%llu dst_va=%#llx"
          (cast (unsigned long long) offset) (cast (unsigned long long) size) (cast (unsigned long long) dst_va)))

      (if (! (. (. sexdrive_state nvme_io_state) ready))
        (block
          (call sexos_line "[sexdrive.block.read.handoff.err] reason=no_ioq_ready")
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint64_t map_va (. (. sexdrive_state nvme_io_state) map_va))
      (var uint64_t io_sq_va (. (. sexdrive_state nvme_io_state) io_sq_va))
      (var uint64_t io_cq_va (. (. sexdrive_state nvme_io_state) io_cq_va))
      (var uint64_t sq1tdbl (. (. sexdrive_state nvme_io_state) sq1tdbl))
      (var uint64_t cq1hdbl (. (. sexdrive_state nvme_io_state) cq1hdbl))
      (var uint32_t sq_tail (. (. sexdrive_state nvme_io_state) sq_tail))
      (var uint32_t cq_head (. (. sexdrive_state nvme_io_state) cq_head))
      (var uint32_t cq_phase (. (. sexdrive_state nvme_io_state) cq_phase))
      (var uint16_t cid (. (. sexdrive_state nvme_io_state) next_cid))
      (= (. (. sexdrive_state nvme_io_state) next_cid) (cast uint16_t (+ cid 1u)))

      (var uint64_t data_phys (call sys_alloc_phys PAGE_SIZE))
      (if (|| (== data_phys 0) (|| (== data_phys UINT64_MAX) (!= (% data_phys PAGE_SIZE) 0)))
        (block
          (call sexos_line "[sexdrive.block.read.handoff.err] reason=data_alloc_invalid phys=%#llx"
            (cast (unsigned long long) data_phys))
          (return BLOCK_ERR_NO_DEVICE)))
      (var uint64_t data_va (call sys_map_phys data_phys PAGE_SIZE))
      (if (|| (== data_va 0) (== data_va UINT64_MAX))
        (block
          (call sexos_line "[sexdrive.block.read.handoff.err] reason=data_map_failed va=%#llx"
            (cast (unsigned long long) data_va))
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint64_t (* zero_ptr) (cast (uint64_t *) (cast uintptr_t data_va)))
      (for (var size_t i 0) (< i (cast size_t (/ PAGE_SIZE 8ULL))) (++ i)
        (call sexos_volatile_write64 (+ zero_ptr i) 0ULL))

      (var uint64_t slba (/ offset NVME_LBA_BYTES))
      (var uint64_t nlb (- (/ size NVME_LBA_BYTES) 1ULL))
      (var uint64_t max_lba WRITE_PROOF_LBA)
      (var uint64_t last_lba (+ slba nlb))
      (var uint64_t range_ok (?: (> slba max_lba) 0ULL (?: (> nlb (- max_lba slba)) 0ULL 1ULL)))
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.cmd.range] path=typed slba=%llu nlb=%llu max_lba=%llu ok=%llu"
          (cast (unsigned long long) slba) (cast (unsigned long long) nlb)
          (cast (unsigned long long) max_lba) (cast (unsigned long long) range_ok)))

      (var uint32_t (* sqe_ptr) (cast (uint32_t *) (cast uintptr_t (+ io_sq_va (* (cast uint64_t sq_tail) 64ULL)))))
      (for (var size_t i 0) (< i 16) (++ i)
        (call sexos_volatile_write32 (+ sqe_ptr i) 0u))
      (call sexos_volatile_write32 (+ sqe_ptr 0) (| 0x02u (<< (cast uint32_t cid) 16)))
      (call sexos_volatile_write32 (+ sqe_ptr 1) 1u)
      (call sexos_volatile_write32 (+ sqe_ptr 6) (cast uint32_t (& data_phys 0xFFFFFFFFULL)))
      (call sexos_volatile_write32 (+ sqe_ptr 7) (cast uint32_t (>> data_phys 32)))
      (call sexos_volatile_write32 (+ sqe_ptr 10) (cast uint32_t (& slba 0xFFFFFFFFULL)))
      (call sexos_volatile_write32 (+ sqe_ptr 11) (cast uint32_t (>> slba 32)))
      (call sexos_volatile_write32 (+ sqe_ptr 12) (cast uint32_t (& nlb 0xFFFFULL)))

      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.cmd.shape] path=typed op=READ cid=%llu nsid=%llu slba=%llu nlb=%llu bytes=%llu prp1=%#llx prp2=%#llx buf_va=%#llx buf_phys=%#llx buffer_cap=%#llx buffer_kind=memlend last_lba=%llu"
          (cast (unsigned long long) cid) 1ULL (cast (unsigned long long) slba) (cast (unsigned long long) nlb)
          (cast (unsigned long long) size) (cast (unsigned long long) data_phys) 0ULL
          (cast (unsigned long long) dst_va) (cast (unsigned long long) data_phys)
          (cast (unsigned long long) SLOT_BUF_LEND) (cast (unsigned long long) last_lba)))

      (call sexos_compiler_fence_seq_cst)
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.submit.detail] path=typed op=READ cid=%llu sq_tail_before=%llu sq_tail_after=%llu cq_head=%llu cq_phase=%llu lba=%llu bytes=%llu"
          (cast (unsigned long long) cid) (cast (unsigned long long) sq_tail)
          (cast (unsigned long long) (% (+ sq_tail 1u) 16u)) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) slba) (cast (unsigned long long) size)))
      (= sq_tail (% (+ sq_tail 1u) 16u))
      (call sexos_volatile_write32 (cast (uint32_t *) (cast uintptr_t (+ map_va sq1tdbl))) sq_tail)
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.doorbell] path=typed qid=1 tail=%llu"
          (cast (unsigned long long) sq_tail)))

      (var bool done false)
      (var uint32_t dw2 0)
      (var uint32_t dw3 0)
      (var uint32_t max_polls 1000000u)
      (var uint32_t polls 0)
      (var uint32_t last_dw3 0)
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.poll.begin] path=typed cid=%llu cq_head=%llu phase=%llu max_polls=%llu"
          (cast (unsigned long long) cid) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) max_polls)))
      (for (var uint32_t p 0) (< p max_polls) (++ p)
        (block
          (+= polls 1u)
          (var (const uint32_t) (* cqe_ptr) (cast ((const uint32_t) *) (cast uintptr_t (+ io_cq_va (* (cast uint64_t cq_head) 16ULL)))))
          (var uint32_t rd_dw2 (call sexos_volatile_read32 (+ cqe_ptr 2)))
          (var uint32_t rd_dw3 (call sexos_volatile_read32 (+ cqe_ptr 3)))
          (= last_dw3 rd_dw3)
          (var uint32_t cid_now (& rd_dw3 0xFFFFu))
          (var uint32_t phase_now (& (>> rd_dw3 16) 0x1u))
          (if (&& (== cid_now (cast uint32_t cid)) (== phase_now cq_phase))
            (block
              (= done true)
              (= dw2 rd_dw2)
              (= dw3 rd_dw3)
              (if (call hot_log)
                (call sexos_line "[sexdrive.block.read.handoff.nvme.cqe] cid=%llu phase=%llu dw2=%#llx dw3=%#llx"
                  (cast (unsigned long long) cid_now) (cast (unsigned long long) phase_now)
                  (cast (unsigned long long) rd_dw2) (cast (unsigned long long) rd_dw3)))
              break))))
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.poll.end] path=typed cid=%llu found=%llu status=%llu cq_head=%llu phase=%llu polls=%llu"
          (cast (unsigned long long) cid) (cast (unsigned long long) (?: done 1ULL 0ULL))
          (cast (unsigned long long) (& (>> dw3 17) 0x7FFFu)) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) polls)))
      (if (! done)
        (block
          (call sexos_line "[sexdrive.block.read.handoff.err] reason=cqe_timeout cid=%llu head=%llu phase=%llu"
            (cast (unsigned long long) cid) (cast (unsigned long long) cq_head) (cast (unsigned long long) cq_phase))
          (call sexos_line "[sexdrive.nvme.poll.timeout.detail] path=typed cid=%llu expected_cid=%llu seen_cid=%llu seen_status=%llu seen_phase=%llu cq_head=%llu phase=%llu polls=%llu"
            (cast (unsigned long long) cid) (cast (unsigned long long) cid)
            (cast (unsigned long long) (& last_dw3 0xFFFFu)) (cast (unsigned long long) (& (>> last_dw3 17) 0x7FFFu))
            (cast (unsigned long long) (& (>> last_dw3 16) 0x1u)) (cast (unsigned long long) cq_head)
            (cast (unsigned long long) cq_phase) (cast (unsigned long long) polls))
          (return BLOCK_ERR_NO_DEVICE)))

