          (= (. sexdrive_state reset_rebuild_pending) false)
          (= (. sexdrive_state reset_recovery_pending) false)
          (+= (. sexdrive_state reset_count) 1u)
          (call sexos_line "[sexdrive.dma.reset.resumed] generation=%llu resets=%llu ready=1 read_generation=%llu write_generation=%llu"
            (cast (unsigned long long) (. (. sexdrive_state dma_device) generation))
            (cast (unsigned long long) (. sexdrive_state reset_count))
