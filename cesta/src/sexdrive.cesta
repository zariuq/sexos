          (var uint64_t d1 (call sexos_volatile_read64 (cast ((const uint64_t) *) (cast uintptr_t (+ data_va 8ULL)))))
          (var uint64_t d2 (call sexos_volatile_read64 (cast ((const uint64_t) *) (cast uintptr_t (+ data_va 16ULL)))))
          (var uint64_t d3 (call sexos_volatile_read64 (cast ((const uint64_t) *) (cast uintptr_t (+ data_va 24ULL)))))
