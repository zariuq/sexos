      (if (call hot_log)
        (call sexos_line "[sexdrive.block.read.handoff.copy.ok] phase=B len=%llu"
          (cast (unsigned long long) size)))
      (return 0ULL))

    (fn (static bool) write_guard_allows ((uint64_t offset) (uint64_t size) (uint64_t buf_cap))
      (var uint64_t expected_offset (* WRITE_PROOF_LBA NVME_LBA_BYTES))
      (var uint64_t manifest_offset (* MANIFEST_LBA NVME_LBA_BYTES))
      (var uint64_t object_start_offset (* PROOF_OBJECT_START_LBA NVME_LBA_BYTES))
      (var uint64_t object_end_offset (* PROOF_OBJECT_END_LBA NVME_LBA_BYTES))
      (var bool proof_mode (== buf_cap SLOT_BUF_LEND))
      (var bool allow_manifest (&& proof_mode (&& (== size WRITE_PROOF_LEN) (== offset manifest_offset))))
      (var uint64_t linen_start (* LINEN_OBJECT_START_LBA NVME_LBA_BYTES))
      (var uint64_t linen_end (* LINEN_OBJECT_END_LBA NVME_LBA_BYTES))
      (var uint64_t quil_start (* QUIL_OBJECT_START_LBA NVME_LBA_BYTES))
      (var uint64_t quil_end (* QUIL_OBJECT_END_LBA NVME_LBA_BYTES))
      (var bool allow_object (&& proof_mode (&& (== size WRITE_PROOF_LEN) (&& (== (% offset NVME_LBA_BYTES) 0) (&& (>= offset object_start_offset) (<= offset object_end_offset))))))
      (var bool allow_linen (&& proof_mode (&& (== size WRITE_PROOF_LEN) (&& (== (% offset NVME_LBA_BYTES) 0) (&& (>= offset linen_start) (<= offset linen_end))))))
      (var bool allow_quil (&& proof_mode (&& (== size WRITE_PROOF_LEN) (&& (== (% offset NVME_LBA_BYTES) 0) (&& (>= offset quil_start) (<= offset quil_end))))))
      (var bool allow_proof (&& proof_mode (&& (== offset expected_offset) (== size WRITE_PROOF_LEN))))
      (var uint64_t sexfs_meta_start (* SEXFS_V0_META_START_LBA NVME_LBA_BYTES))
      (var uint64_t sexfs_meta_end (* SEXFS_V0_META_END_LBA NVME_LBA_BYTES))
      (var uint64_t sexfs_obj_start (* SEXFS_V0_OBJECT_START_LBA NVME_LBA_BYTES))
      (var uint64_t sexfs_obj_end (* SEXFS_V0_OBJECT_END_LBA NVME_LBA_BYTES))
      (var bool allow_sexfs_meta (&& proof_mode (&& (== size WRITE_PROOF_LEN) (&& (== (% offset NVME_LBA_BYTES) 0) (&& (>= offset sexfs_meta_start) (<= offset sexfs_meta_end))))))
      (var bool allow_sexfs_obj (&& proof_mode (&& (== size WRITE_PROOF_LEN) (&& (== (% offset NVME_LBA_BYTES) 0) (&& (>= offset sexfs_obj_start) (<= offset sexfs_obj_end))))))
      (var bool allow (|| allow_proof (|| allow_manifest (|| allow_object (|| allow_linen (|| allow_quil (|| allow_sexfs_meta allow_sexfs_obj)))))))

      (call sexos_line "[sexdrive.write.guard.config] proof_lba=%llu proof_offset=%#llx manifest_lba=%llu object_lba_start=%llu object_lba_end=%llu proof_len=%llu magic=%#llx sexfs_meta=%llu-%llu sexfs_obj=%llu-%llu"
        (cast (unsigned long long) WRITE_PROOF_LBA) (cast (unsigned long long) expected_offset)
        (cast (unsigned long long) MANIFEST_LBA) (cast (unsigned long long) PROOF_OBJECT_START_LBA)
        (cast (unsigned long long) PROOF_OBJECT_END_LBA) (cast (unsigned long long) WRITE_PROOF_LEN)
        (cast (unsigned long long) WRITE_PROOF_MAGIC) (cast (unsigned long long) SEXFS_V0_META_START_LBA)
        (cast (unsigned long long) SEXFS_V0_META_END_LBA) (cast (unsigned long long) SEXFS_V0_OBJECT_START_LBA)
        (cast (unsigned long long) SEXFS_V0_OBJECT_END_LBA))
      (call sexos_line "[sexdrive.write.guard.begin] offset=%#llx size=%llu buf_cap=%#llx proof_mode=%llu"
        (cast (unsigned long long) offset) (cast (unsigned long long) size)
        (cast (unsigned long long) buf_cap) (cast (unsigned long long) (?: proof_mode 1ULL 0ULL)))
      (var uint64_t lba (/ offset NVME_LBA_BYTES))
      (if allow
        (block
          (if (|| allow_sexfs_meta allow_sexfs_obj)
            (call sexos_line "[sexdrive.write_guard.sexfs.allow] lba=%llu size=%llu ok=1"
              (cast (unsigned long long) lba) (cast (unsigned long long) size))
            (call sexos_line "[sexdrive.write.guard.allow] offset=%#llx size=%llu buf_cap=%#llx"
              (cast (unsigned long long) offset) (cast (unsigned long long) size) (cast (unsigned long long) buf_cap))))
        (call sexos_line "[sexdrive.write_guard.reject] lba=%llu size=%llu ok=1"
          (cast (unsigned long long) lba) (cast (unsigned long long) size)))
      (return allow))

    (fn (static uint64_t) nvme_write_one_block ((uint64_t offset) (uint64_t size) (uint64_t src_va))
      (if (|| (!= size WRITE_PROOF_LEN) (|| (== src_va 0) (== src_va UINT64_MAX)))
        (block
          (call sexos_line "[sexdrive.nvme.write.err] reason=bad_args offset=%#llx size=%llu src_va=%#llx"
            (cast (unsigned long long) offset) (cast (unsigned long long) size) (cast (unsigned long long) src_va))
          (return BLOCK_ERR_BAD_LEN)))

      (if (! (. (. sexdrive_state nvme_io_state) ready))
        (block
          (call sexos_line "[sexdrive.nvme.write.err] reason=no_ioq_ready")
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint64_t map_va (. (. sexdrive_state nvme_io_state) map_va))
      (var uint64_t io_sq_va (. (. sexdrive_state nvme_io_state) io_sq_va))
      (var uint64_t io_cq_va (. (. sexdrive_state nvme_io_state) io_cq_va))
      (var uint64_t sq1tdbl (. (. sexdrive_state nvme_io_state) sq1tdbl))
      (var uint64_t cq1hdbl (. (. sexdrive_state nvme_io_state) cq1hdbl))
      (var uint32_t sq_tail (. (. sexdrive_state nvme_io_state) sq_tail))
      (var uint32_t cq_head (. (. sexdrive_state nvme_io_state) cq_head))
      (var uint32_t cq_phase (. (. sexdrive_state nvme_io_state) cq_phase))
      (var uint16_t write_cid (. (. sexdrive_state nvme_io_state) next_cid))
      (= (. (. sexdrive_state nvme_io_state) next_cid) (cast uint16_t (+ write_cid 1u)))

      (var uint64_t write_phys (call sys_alloc_phys PAGE_SIZE))
      (var uint64_t write_va (call sys_map_phys write_phys PAGE_SIZE))
      (if (|| (== write_phys 0) (|| (== write_phys UINT64_MAX) (|| (!= (% write_phys PAGE_SIZE) 0) (|| (== write_va 0) (== write_va UINT64_MAX)))))
        (block
          (call sexos_line "[sexdrive.nvme.write.err] reason=write_buf_invalid phys=%#llx va=%#llx"
            (cast (unsigned long long) write_phys) (cast (unsigned long long) write_va))
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint8_t (* write_ptr) (cast (uint8_t *) (cast uintptr_t write_va)))
      (var (const uint8_t) (* src_ptr) (cast ((const uint8_t) *) (cast uintptr_t src_va)))
      (for (var size_t i 0) (< i (cast size_t PAGE_SIZE)) (++ i)
        (call sexos_volatile_write8 (+ write_ptr i) 0u))
      (for (var size_t i 0) (< i (cast size_t WRITE_PROOF_LEN)) (++ i)
        (call sexos_volatile_write8 (+ write_ptr i) (call sexos_volatile_read8 (+ src_ptr i))))

      (var uint64_t slba (/ offset NVME_LBA_BYTES))
      (var uint32_t nlb 0u)
      (var uint64_t max_lba WRITE_PROOF_LBA)
      (var uint64_t last_lba slba)
      (var uint64_t range_ok (?: (<= slba max_lba) 1ULL 0ULL))
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.cmd.range] path=typed slba=%llu nlb=%llu max_lba=%llu ok=%llu"
          (cast (unsigned long long) slba) (cast (unsigned long long) nlb)
          (cast (unsigned long long) max_lba) (cast (unsigned long long) range_ok)))

      (var uint32_t (* sqe_ptr) (cast (uint32_t *) (cast uintptr_t (+ io_sq_va (* (cast uint64_t sq_tail) 64ULL)))))
      (for (var size_t i 0) (< i 16) (++ i)
        (call sexos_volatile_write32 (+ sqe_ptr i) 0u))
      (call sexos_volatile_write32 (+ sqe_ptr 0) (| 0x01u (<< (cast uint32_t write_cid) 16)))
      (call sexos_volatile_write32 (+ sqe_ptr 1) 1u)
      (call sexos_volatile_write32 (+ sqe_ptr 6) (cast uint32_t (& write_phys 0xFFFFFFFFULL)))
      (call sexos_volatile_write32 (+ sqe_ptr 7) (cast uint32_t (>> write_phys 32)))
      (call sexos_volatile_write32 (+ sqe_ptr 10) (cast uint32_t (& slba 0xFFFFFFFFULL)))
      (call sexos_volatile_write32 (+ sqe_ptr 11) (cast uint32_t (>> slba 32)))
      (call sexos_volatile_write32 (+ sqe_ptr 12) nlb)

      (call sexos_line "[sexdrive.nvme.write.submit] cid=%llu nsid=1 slba=%llu nlb=0 prp1=%#llx sq_tail=%llu"
        (cast (unsigned long long) write_cid) (cast (unsigned long long) slba)
        (cast (unsigned long long) write_phys) (cast (unsigned long long) sq_tail))
      (call sexos_line "[sexdrive.block.write.api.nvme.submit] cid=%llu nsid=1 slba=%llu nlb=0 prp1=%#llx"
        (cast (unsigned long long) write_cid) (cast (unsigned long long) slba) (cast (unsigned long long) write_phys))
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.cmd.shape] path=typed op=WRITE cid=%llu nsid=%llu slba=%llu nlb=%llu bytes=%llu prp1=%#llx prp2=%#llx buf_va=%#llx buf_phys=%#llx buffer_cap=%#llx buffer_kind=memlend last_lba=%llu"
          (cast (unsigned long long) write_cid) 1ULL (cast (unsigned long long) slba) (cast (unsigned long long) nlb)
          (cast (unsigned long long) size) (cast (unsigned long long) write_phys) 0ULL
          (cast (unsigned long long) src_va) (cast (unsigned long long) write_phys)
          (cast (unsigned long long) SLOT_BUF_LEND) (cast (unsigned long long) last_lba)))
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.submit.detail] path=typed op=WRITE cid=%llu sq_tail_before=%llu sq_tail_after=%llu cq_head=%llu cq_phase=%llu lba=%llu bytes=%llu"
          (cast (unsigned long long) write_cid) (cast (unsigned long long) sq_tail)
          (cast (unsigned long long) (% (+ sq_tail 1u) 16u)) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) slba) (cast (unsigned long long) size)))

      (call sexos_compiler_fence_seq_cst)
      (= sq_tail (% (+ sq_tail 1u) 16u))
      (call sexos_volatile_write32 (cast (uint32_t *) (cast uintptr_t (+ map_va sq1tdbl))) sq_tail)
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.doorbell] path=typed qid=1 tail=%llu"
          (cast (unsigned long long) sq_tail)))

      (var bool done false)
      (var uint32_t dw3 0)
      (var uint32_t max_polls 1000000u)
      (var uint32_t polls 0)
      (var uint32_t last_dw3 0)
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.poll.begin] path=typed cid=%llu cq_head=%llu phase=%llu max_polls=%llu"
          (cast (unsigned long long) write_cid) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) max_polls)))
      (for (var uint32_t p 0) (< p max_polls) (++ p)
        (block
          (+= polls 1u)
