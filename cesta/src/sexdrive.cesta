      (var uint32_t sc (& sf 0xFFu))
      (var uint32_t sct (& (>> sf 8) 0x7u))
      (if (|| (!= sc 0) (!= sct 0))
        (block
          (var uint32_t sqhd (& dw2 0xFFFFu))
          (var uint32_t sqid (& (>> dw2 16) 0xFFFFu))
          (call sexos_line "[sexdrive.block.read.handoff.err] reason=status_fail cid=%llu sc=%llu sct=%llu sqhd=%llu sqid=%llu dw3=%#llx"
            (cast (unsigned long long) cid) (cast (unsigned long long) sc) (cast (unsigned long long) sct)
            (cast (unsigned long long) sqhd) (cast (unsigned long long) sqid) (cast (unsigned long long) dw3))
          (return BLOCK_ERR_NO_DEVICE)))

      (= cq_head (% (+ cq_head 1u) 16u))
