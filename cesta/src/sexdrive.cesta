            (cast (unsigned long long) first) (cast (unsigned long long) second)
            (cast (unsigned long long) third) (cast (unsigned long long) retry)
            (cast (unsigned long long) (. (. sexdrive_state read_lease) phase))
            (cast (unsigned long long) (. (. sexdrive_state read_lease) tag))
            (cast (unsigned long long) (?: (. (. sexdrive_state nvme_io_state) ready) 1ULL 0ULL))
            (cast (unsigned long long) cid_before_retry) (cast (unsigned long long) cid_after_retry)
