            (cast (unsigned long long) polls))
          (return false)))
      (var uint32_t cc_now (call sexos_volatile_read32
        (cast ((const uint32_t) *) (cast uintptr_t (+ map_va 0x0014ULL)))))
      (var uint32_t csts_now (call sexos_volatile_read32
        (cast ((const uint32_t) *) (cast uintptr_t (+ map_va 0x001CULL)))))
