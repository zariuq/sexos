          (var uint64_t cid_before_retry
            (cast uint64_t (. (. sexdrive_state nvme_io_state) next_cid)))
          (var uint64_t retry (call nvme_read_into_mapped_va 0ULL NVME_LBA_BYTES dst_va))
          (var uint64_t cid_after_retry
