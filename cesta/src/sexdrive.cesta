(cesta native-c/1 compact-c/2
  (unit
    (include "sexos_mmio.h")
    (include "sexos_dma_lease.h")
    (include "epoch_types.h")

    (comment "NVMe storage driver and block service (apps/sexdrive/src/main.rs).")

    (cpp-if "!defined(SEXOS_STORAGE_100_PERSIST_WRITE)"
      (then (define SEXOS_STORAGE_100_PERSIST_WRITE "0")))
    (cpp-if "!defined(SEXOS_STORAGE_100_PERSIST_READ)"
      (then (define SEXOS_STORAGE_100_PERSIST_READ "0")))
    (cpp-if "!defined(SEXOS_STORAGE_100_FLUSH_AUDIT)"
      (then (define SEXOS_STORAGE_100_FLUSH_AUDIT "0")))
    (cpp-if "!defined(SEXOS_STORAGE_100_NEGATIVE)"
      (then (define SEXOS_STORAGE_100_NEGATIVE "0")))
    (cpp-if "!defined(SEXOS_STORAGE_100_NEG_MISMATCH)"
      (then (define SEXOS_STORAGE_100_NEG_MISMATCH "0")))
    (cpp-if "!defined(SEXOS_STORAGE_100_IO_READ_PROBE)"
      (then (define SEXOS_STORAGE_100_IO_READ_PROBE "0")))
    (cpp-if "!defined(SEXOS_CURRENT_REGION_WRITER)"
      (then (define SEXOS_CURRENT_REGION_WRITER "0")))
    (cpp-if "!defined(SEXOS_DMA_QUARANTINE_PROBE)"
      (then (define SEXOS_DMA_QUARANTINE_PROBE "0")))
    (cpp-if "!defined(SEXOS_NVME_INTERRUPT_MODE)"
      (then (define SEXOS_NVME_INTERRUPT_MODE "0")))

    (define STORAGE_100_PERSIST_WRITE_ENABLED "SEXOS_STORAGE_100_PERSIST_WRITE")
    (define STORAGE_100_PERSIST_READ_ENABLED "SEXOS_STORAGE_100_PERSIST_READ")
    (define STORAGE_100_FLUSH_AUDIT_ENABLED "SEXOS_STORAGE_100_FLUSH_AUDIT")
    (define STORAGE_100_NEGATIVE_ENABLED "SEXOS_STORAGE_100_NEGATIVE")
    (define STORAGE_100_NEG_MISMATCH_ENABLED "SEXOS_STORAGE_100_NEG_MISMATCH")
    (define STORAGE_100_IO_READ_PROBE_ENABLED "SEXOS_STORAGE_100_IO_READ_PROBE")
    (define DMA_QUARANTINE_PROBE_ENABLED "SEXOS_DMA_QUARANTINE_PROBE")
    (define NVME_INTERRUPT_MODE_ENABLED "SEXOS_NVME_INTERRUPT_MODE")

    (define OP_SHELL_BIND_BUFFER "UINT64_C(0x14)")
    (define SLOT_SHELL "((uint64_t)SEXOS_SLOT_shell)")
    (define SLOT_USB_HOST "UINT64_C(8)")
    (define SLOT_NVME_HOST "UINT64_C(16)")
    (define SLOT_BUF_LEND "((uint64_t)SEXOS_SLOT_buf_lend)")
    (define SLOT_FRAME_REGION "UINT64_C(33)")
    (define SLOT_DMA_REGION "UINT64_C(32)")
    (define BLOCK_READ "UINT64_C(1)")
    (define BLOCK_WRITE "UINT64_C(2)")
    (define BLOCK_SYNC "UINT64_C(3)")
    (define BLOCK_ERR_BAD_CMD "UINT64_C(1)")
    (define BLOCK_ERR_BAD_LEN "UINT64_C(2)")
    (define BLOCK_ERR_NO_DEVICE "UINT64_C(4)")
    (define BLOCK_ERR_TIMEOUT "UINT64_C(5)")
    (define BLOCK_SECTOR_SIZE "UINT64_C(512)")
    (define BLOCK_MAX_XFER "UINT64_C(4096)")
    (cpp-if "!defined(SEXOS_SEXDRIVE_CURRENT_DURABILITY)" (then (define SEXOS_SEXDRIVE_CURRENT_DURABILITY "1")))
    (define DMA_RESET_LIMIT "UINT32_C(12)")
    (define NVME_TIMED_WAIT_ENABLED "(NVME_INTERRUPT_MODE_ENABLED && SEXOS_SEXDRIVE_CURRENT_DURABILITY)")
    (define NVME_CQE_TIMEOUT_TICKS "UINT64_C(5000)")
    (define DMA_PROBE_HANDSHAKE_SPINS "UINT32_C(20000000)")

    (define PAGE_SIZE "UINT64_C(4096)")
    (define NVME_SQ0TDBL "UINT64_C(0x1000)")
    (define NVME_CQ0HDBL "UINT64_C(0x1004)")
    (define NVME_LBA_BYTES "UINT64_C(512)")
    (define DISKFS_V4_POOL_BASE_LBA "UINT64_C(400)")
    (define DISKFS_V4_POOL_SECTORS "UINT64_C(1408)")

    (define WRITE_PROOF_LBA "UINT64_C(2047)")
    (define WRITE_PROOF_LEN "UINT64_C(512)")
    (define WRITE_PROOF_MAGIC "UINT64_C(0x3156455449525753)")
    (define AP4_MULTI_BASE_LBA "UINT64_C(128)")
    (define AP4_MULTI_BLOCKS "UINT64_C(4)")
    (define AP4_MULTI_BLOCK_BYTES "NVME_LBA_BYTES")
    (define AP5A_PERSIST_BASE_LBA "UINT64_C(256)")
    (define AP5A_PERSIST_BLOCKS "UINT64_C(4)")
    (define AP5A_PERSIST_BLOCK_BYTES "NVME_LBA_BYTES")
    (define AP6_NEG_MISMATCH_LBA "UINT64_C(384)")
    (define AP6_NEG_MISMATCH_BYTES "NVME_LBA_BYTES")
    (define MANIFEST_LBA "UINT64_C(2046)")
    (define PROOF_OBJECT_START_LBA "UINT64_C(2038)")
    (define PROOF_OBJECT_END_LBA "UINT64_C(2045)")
    (define LINEN_OBJECT_START_LBA "UINT64_C(2030)")
    (define LINEN_OBJECT_END_LBA "UINT64_C(2037)")
    (define QUIL_OBJECT_START_LBA "UINT64_C(2022)")
    (define QUIL_OBJECT_END_LBA "UINT64_C(2029)")
    (define SEXFS_V0_META_START_LBA "UINT64_C(0)")
    (define SEXFS_V0_META_END_LBA "UINT64_C(47)")
    (define SEXFS_V0_OBJECT_START_LBA "UINT64_C(128)")
    (define SEXFS_V0_OBJECT_END_LBA "UINT64_C(2019)")

    (typedef (struct
      (bool ready)
      (uint64_t map_va)
      (uint64_t io_sq_va)
      (uint64_t io_cq_va)
      (uint64_t sq1tdbl)
      (uint64_t cq1hdbl)
      (uint32_t sq_tail)
      (uint32_t cq_head)
      (uint32_t cq_phase)
      (uint16_t next_cid)) NvmeIoState)

    (typedef (struct
      (uint32_t hot_log_budget)
      (NvmeIoState nvme_io_state)
      (DmaLeasePool dma_pool)
      (DmaDeviceEpoch dma_device)
      (DmaLease read_lease)
      (DmaLease write_lease)
      (bool leases_ready)
      (bool dma_ready)
      (bool reset_rebuild_pending)
      (bool reset_recovery_pending)
      (bool dma_probe_injected)
      (bool dma_probe_recovery_pending)
      (uint32_t reset_count)) SexdriveState)

    (var (static SexdriveState) sexdrive_state)

    (fn (static uint64_t) block_buffer_view
      ((uint32_t caller) (uint64_t length) (uint64_t rights))
      (if (|| (== caller 0) (|| (== length 0) (> length BLOCK_MAX_XFER))) (return UINT64_MAX))
      (var MemoryRegionReply info (call sexos_memory_region_info SLOT_BUF_LEND))
      (if (|| (!= (. info status) 0) (|| (< (. info value0) length) (!= (. info value2) caller)))
        (return UINT64_MAX))
      (var MemoryRegionReply view
        (call sexos_memory_region_view SLOT_BUF_LEND 0 length (| REGION_QUERY rights)))
      (return (?: (== (. view status) 0) (. view value0) UINT64_MAX)))

    (fn (static uint64_t) block_writer_claim
      ((uint32_t caller) (RegionWriterReceipt (* out)))
      (if (== caller 0) (return BLOCK_ERR_NO_DEVICE))
      (var RegionWriterReceipt query (call sexos_region_writer_query SLOT_BUF_LEND))
      (if (!= (. query status) REGION_WRITER_OK) (return BLOCK_ERR_NO_DEVICE))
      (if (== (. query job) 0) (return BLOCK_ERR_TIMEOUT))
      (if (|| (!= (. query current) caller) (== (. query peer) 0))
        (return BLOCK_ERR_NO_DEVICE))
      (var RegionWriterReceipt claimed
        (call sexos_region_writer_change SLOT_BUF_LEND REGION_WRITER_CLAIM (. query revision) (. query job)))
      (if (|| (!= (. claimed status) REGION_WRITER_OK)
              (|| (!= (. claimed current) (. query peer)) (!= (. claimed job) (. query job))))
        (return BLOCK_ERR_NO_DEVICE))
      (= (* out) claimed)
      (return 0))

    (fn (static bool) block_writer_release
      ((uint32_t caller) ((const RegionWriterReceipt) (* claimed)))
      (var RegionWriterReceipt released
        (call sexos_region_writer_change SLOT_BUF_LEND REGION_WRITER_RELEASE
          (-> claimed revision) (-> claimed job)))
      (return (&& (== (. released status) REGION_WRITER_OK)
                  (&& (== (. released current) caller) (== (. released job) 0)))))

    (fn (static void) sexdrive_state_init ((SexdriveState (* s)))
      (call memset s 0 (sizeof (* s)))
      (= (-> s hot_log_budget) 240)
      (= (. (-> s nvme_io_state) cq_phase) 1)
      (= (. (-> s nvme_io_state) next_cid) 0x0500))

    (fn (static bool) hot_log (void)
      (if (> (. sexdrive_state hot_log_budget) 0)
        (block
          (-= (. sexdrive_state hot_log_budget) 1)
          (return true)))
      (return false))

    (comment "The current IRQ profile uses the kernel's millisecond clock for command waits. A poll-counter guard also prevents wrap if that clock stalls. Historical durability controls retain their original iteration bound.")
    (fn (static inline uint64_t) nvme_wait_started (void)
      (return (?: NVME_TIMED_WAIT_ENABLED (call sexos_get_ticks) 0ULL)))

    (fn (static inline bool) nvme_wait_pending
      ((uint32_t poll) (uint32_t legacy_limit) (uint64_t started))
      (if (! NVME_TIMED_WAIT_ENABLED) (return (< poll legacy_limit)))
      (if (== poll UINT32_MAX) (return false))
      (if (|| (== poll 0u) (!= (& poll 0xfffu) 0u)) (return true))
      (var uint64_t now (call sexos_get_ticks))
      (return (&& (>= now started) (< (- now started) NVME_CQE_TIMEOUT_TICKS))))

    (fn (static inline void) nvme_wait_turn ((uint32_t poll))
      (if (&& NVME_INTERRUPT_MODE_ENABLED (== (& poll 0xfffu) 0u))
        (call sexos_yield)))

    (fn (static uint64_t) nvme_unavailable_status (void)
      (return (?: (. sexdrive_state reset_recovery_pending) BLOCK_ERR_TIMEOUT BLOCK_ERR_NO_DEVICE)))

    (fn (static bool) sexdrive_dma_init (void)
      (if (! SEXOS_CURRENT_REGION_WRITER) (return true))
      (var MemoryRegionReply info (call sexos_memory_region_info SLOT_DMA_REGION))
      (if (|| (!= (. info status) 0)
              (|| (!= (. info value1) (| REGION_QUERY (| REGION_READ (| REGION_WRITE REGION_DMA))))
                  (|| (!= (. info value2) 0) (!= (. info value3) 3)))) (return false))
      (var MemoryRegionReply view
        (call sexos_memory_region_view SLOT_DMA_REGION 0 (. info value0)
          (| REGION_QUERY (| REGION_READ (| REGION_WRITE REGION_DMA)))))
      (if (|| (!= (. view status) 0) (|| (== (. view value0) 0) (== (. view value2) 0)))
        (return false))
      (var DmaLeaseRegion region
        (compound DmaLeaseRegion (= (. region_id) (cast uint32_t (. view value3)))
          (= (. virtual_address) (. view value0)) (= (. physical_address) (. view value2))
          (= (. length) (. view value1))))
      (= (. sexdrive_state dma_ready)
        (== (call dma_lease_pool_init region (& (. sexdrive_state dma_pool))) DMA_LEASE_OK))
      (if (! (. sexdrive_state dma_ready)) (return false))
      (= (. sexdrive_state dma_device) (call dma_device_epoch_init SLOT_NVME_HOST))
      (if (! (call dma_device_epoch_active (& (. sexdrive_state dma_device)))) (return false))
      (var DmaLeaseResult read_buffer (call dma_lease_reserve (& (. sexdrive_state dma_pool)) PAGE_SIZE))
      (var DmaLeaseResult write_buffer (call dma_lease_reserve (& (. sexdrive_state dma_pool)) PAGE_SIZE))
      (if (|| (!= (. read_buffer status) DMA_LEASE_OK) (!= (. write_buffer status) DMA_LEASE_OK))
        (return false))
      (= (. sexdrive_state read_lease)
        (call dma_lease_init (. read_buffer buffer) (& (. sexdrive_state dma_device))))
      (= (. sexdrive_state write_lease)
        (call dma_lease_init (. write_buffer buffer) (& (. sexdrive_state dma_device))))
      (= (. sexdrive_state leases_ready) true)
      (return (. sexdrive_state dma_ready)))

    (fn (static inline uint64_t) sys_alloc_phys ((uint64_t size))
      (if SEXOS_CURRENT_REGION_WRITER
        (block
          (var DmaLeaseResult result (call dma_lease_reserve (& (. sexdrive_state dma_pool)) size))
          (return (?: (== (. result status) DMA_LEASE_OK) (. (. result buffer) physical_address) UINT64_MAX))))
      (return (call sexos_allocate_memory size)))

    (fn (static inline uint64_t) sys_map_phys ((uint64_t phys) (uint64_t size))
      (if SEXOS_CURRENT_REGION_WRITER
        (block
          (var (const DmaLeaseRegion) (* region) (& (. (. sexdrive_state dma_pool) region)))
          (if (|| (! (. sexdrive_state dma_ready)) (|| (< phys (-> region physical_address))
                  (|| (> phys (+ (-> region physical_address) (-> region length)))
                      (> size (- (+ (-> region physical_address) (-> region length)) phys)))))
            (return UINT64_MAX))
          (return (+ (-> region virtual_address) (- phys (-> region physical_address)))))
      (return (call sexos_map_memory phys size))))

    (fn (static uint64_t) nvme_read_into_bounce ((uint64_t offset) (uint64_t size))
      (if (|| (== size 0) (|| (> size BLOCK_MAX_XFER) (|| (> size PAGE_SIZE) (|| (!= (% offset NVME_LBA_BYTES) 0) (!= (% size NVME_LBA_BYTES) 0)))))
        (block
          (call sexos_line "[sexdrive.block.read.api.err] reason=bad_len offset=%#llx size=%llu lba=%llu"
            (cast (unsigned long long) offset) (cast (unsigned long long) size) (cast (unsigned long long) NVME_LBA_BYTES))
          (return BLOCK_ERR_BAD_LEN)))

      (if (! (. (. sexdrive_state nvme_io_state) ready))
        (block
          (call sexos_line "[sexdrive.block.read.api.err] reason=no_ioq_ready")
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint64_t map_va (. (. sexdrive_state nvme_io_state) map_va))
      (var uint64_t io_sq_va (. (. sexdrive_state nvme_io_state) io_sq_va))
      (var uint64_t io_cq_va (. (. sexdrive_state nvme_io_state) io_cq_va))
      (var uint64_t sq1tdbl (. (. sexdrive_state nvme_io_state) sq1tdbl))
      (var uint64_t cq1hdbl (. (. sexdrive_state nvme_io_state) cq1hdbl))
      (var uint32_t sq_tail (. (. sexdrive_state nvme_io_state) sq_tail))
      (var uint32_t cq_head (. (. sexdrive_state nvme_io_state) cq_head))
      (var uint32_t cq_phase (. (. sexdrive_state nvme_io_state) cq_phase))
      (var uint16_t cid (. (. sexdrive_state nvme_io_state) next_cid))
      (= (. (. sexdrive_state nvme_io_state) next_cid) (cast uint16_t (+ cid 1u)))

      (var uint64_t data_phys (call sys_alloc_phys PAGE_SIZE))
      (if (|| (== data_phys 0) (|| (== data_phys UINT64_MAX) (!= (% data_phys PAGE_SIZE) 0)))
        (block
          (call sexos_line "[sexdrive.block.read.api.err] reason=data_alloc_invalid phys=%#llx"
            (cast (unsigned long long) data_phys))
          (return BLOCK_ERR_NO_DEVICE)))
      (var uint64_t data_va (call sys_map_phys data_phys PAGE_SIZE))
      (if (|| (== data_va 0) (== data_va UINT64_MAX))
        (block
          (call sexos_line "[sexdrive.block.read.api.err] reason=data_map_failed va=%#llx"
            (cast (unsigned long long) data_va))
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint64_t (* zero_ptr) (cast (uint64_t *) (cast uintptr_t data_va)))
      (for (var size_t i 0) (< i (cast size_t (/ PAGE_SIZE 8ULL))) (++ i)
        (call sexos_volatile_write64 (+ zero_ptr i) 0ULL))

      (var uint64_t slba (/ offset NVME_LBA_BYTES))
      (var uint64_t nlb (- (/ size NVME_LBA_BYTES) 1ULL))

      (var uint32_t (* sqe_ptr) (cast (uint32_t *) (cast uintptr_t (+ io_sq_va (* (cast uint64_t sq_tail) 64ULL)))))
      (for (var size_t i 0) (< i 16) (++ i)
        (call sexos_volatile_write32 (+ sqe_ptr i) 0u))
      (call sexos_volatile_write32 (+ sqe_ptr 0) (| 0x02u (<< (cast uint32_t cid) 16)))
      (call sexos_volatile_write32 (+ sqe_ptr 1) 1u)
      (call sexos_volatile_write32 (+ sqe_ptr 6) (cast uint32_t (& data_phys 0xFFFFFFFFULL)))
      (call sexos_volatile_write32 (+ sqe_ptr 7) (cast uint32_t (>> data_phys 32)))
      (call sexos_volatile_write32 (+ sqe_ptr 10) (cast uint32_t (& slba 0xFFFFFFFFULL)))
      (call sexos_volatile_write32 (+ sqe_ptr 11) (cast uint32_t (>> slba 32)))
      (call sexos_volatile_write32 (+ sqe_ptr 12) (cast uint32_t (& nlb 0xFFFFULL)))

      (call sexos_line "[sexdrive.block.read.api.nvme.submit] cid=%llu nsid=%llu slba=%llu nlb=%llu prp1=%#llx sq_tail=%llu"
        (cast (unsigned long long) cid) 1ULL (cast (unsigned long long) slba) (cast (unsigned long long) nlb)
        (cast (unsigned long long) data_phys) (cast (unsigned long long) sq_tail))
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.submit.detail] path=typed op=READ cid=%llu sq_tail_before=%llu sq_tail_after=%llu cq_head=%llu cq_phase=%llu lba=%llu bytes=%llu"
          (cast (unsigned long long) cid) (cast (unsigned long long) sq_tail)
          (cast (unsigned long long) (% (+ sq_tail 1u) 16u)) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) slba) (cast (unsigned long long) size)))

      (call sexos_compiler_fence_seq_cst)
      (= sq_tail (% (+ sq_tail 1u) 16u))
      (call sexos_volatile_write32 (cast (uint32_t *) (cast uintptr_t (+ map_va sq1tdbl))) sq_tail)
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.doorbell] path=typed qid=1 tail=%llu"
          (cast (unsigned long long) sq_tail)))

      (var bool done false)
      (var uint32_t dw2 0)
      (var uint32_t dw3 0)
      (var uint32_t max_polls (?: NVME_TIMED_WAIT_ENABLED UINT32_MAX 1000000u))
      (var uint32_t polls 0)
      (var uint32_t last_dw3 0)
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.poll.begin] path=typed cid=%llu cq_head=%llu phase=%llu max_polls=%llu"
          (cast (unsigned long long) cid) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) max_polls)))
      (var uint64_t typed_read_wait_started (call nvme_wait_started))
      (for (var uint32_t p 0) (call nvme_wait_pending p max_polls typed_read_wait_started) (++ p)
        (block
          (call nvme_wait_turn p)
          (+= polls 1u)
          (var (const uint32_t) (* cqe_ptr) (cast ((const uint32_t) *) (cast uintptr_t (+ io_cq_va (* (cast uint64_t cq_head) 16ULL)))))
          (var uint32_t rd_dw2 (call sexos_volatile_read32 (+ cqe_ptr 2)))
          (var uint32_t rd_dw3 (call sexos_volatile_read32 (+ cqe_ptr 3)))
          (= last_dw3 rd_dw3)
          (var uint32_t cid_now (& rd_dw3 0xFFFFu))
          (var uint32_t phase_now (& (>> rd_dw3 16) 0x1u))
          (if (&& (== cid_now (cast uint32_t cid)) (== phase_now cq_phase))
            (block
              (= done true)
              (= dw2 rd_dw2)
              (= dw3 rd_dw3)
              (call sexos_line "[sexdrive.block.read.api.cqe] cid=%llu phase=%llu dw2=%#llx dw3=%#llx"
                (cast (unsigned long long) cid_now) (cast (unsigned long long) phase_now)
                (cast (unsigned long long) rd_dw2) (cast (unsigned long long) rd_dw3))
              break))))
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.poll.end] path=typed cid=%llu found=%llu status=%llu cq_head=%llu phase=%llu polls=%llu"
          (cast (unsigned long long) cid) (cast (unsigned long long) (?: done 1ULL 0ULL))
          (cast (unsigned long long) (& (>> dw3 17) 0x7FFFu)) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) polls)))
      (if (! done)
        (block
          (call sexos_line "[sexdrive.block.read.api.err] reason=cqe_timeout cid=%llu head=%llu phase=%llu"
            (cast (unsigned long long) cid) (cast (unsigned long long) cq_head) (cast (unsigned long long) cq_phase))
          (call sexos_line "[sexdrive.nvme.poll.timeout.detail] path=typed cid=%llu expected_cid=%llu seen_cid=%llu seen_status=%llu seen_phase=%llu cq_head=%llu phase=%llu polls=%llu"
            (cast (unsigned long long) cid) (cast (unsigned long long) cid)
            (cast (unsigned long long) (& last_dw3 0xFFFFu)) (cast (unsigned long long) (& (>> last_dw3 17) 0x7FFFu))
            (cast (unsigned long long) (& (>> last_dw3 16) 0x1u)) (cast (unsigned long long) cq_head)
            (cast (unsigned long long) cq_phase) (cast (unsigned long long) polls))
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint32_t sf (& (>> dw3 17) 0x7FFFu))
      (var uint32_t sc (& sf 0xFFu))
      (var uint32_t sct (& (>> sf 8) 0x7u))
      (if (|| (!= sc 0) (!= sct 0))
        (block
          (var uint32_t sqhd (& dw2 0xFFFFu))
          (var uint32_t sqid (& (>> dw2 16) 0xFFFFu))
          (call sexos_line "[sexdrive.block.read.api.err] reason=status_fail cid=%llu sc=%llu sct=%llu sqhd=%llu sqid=%llu dw3=%#llx"
            (cast (unsigned long long) cid) (cast (unsigned long long) sc) (cast (unsigned long long) sct)
            (cast (unsigned long long) sqhd) (cast (unsigned long long) sqid) (cast (unsigned long long) dw3))
          (return BLOCK_ERR_NO_DEVICE)))

      (= cq_head (% (+ cq_head 1u) 16u))
      (if (== cq_head 0u)
        (^= cq_phase 1u))
      (call sexos_volatile_write32 (cast (uint32_t *) (cast uintptr_t (+ map_va cq1hdbl))) cq_head)
      (= (. (. sexdrive_state nvme_io_state) sq_tail) sq_tail)
      (= (. (. sexdrive_state nvme_io_state) cq_head) cq_head)
      (= (. (. sexdrive_state nvme_io_state) cq_phase) cq_phase)

      (var uint64_t d0 (call sexos_volatile_read64 (cast ((const uint64_t) *) (cast uintptr_t data_va))))
      (var uint64_t d1 (call sexos_volatile_read64 (cast ((const uint64_t) *) (cast uintptr_t (+ data_va 8ULL)))))
      (call sexos_line "[sexdrive.block.read.api.ok] cid=%llu slba=%llu nlb=%llu d0=%#llx d1=%#llx"
        (cast (unsigned long long) cid) (cast (unsigned long long) slba) (cast (unsigned long long) nlb)
        (cast (unsigned long long) d0) (cast (unsigned long long) d1))
      (return 0ULL))

    (var (static bool) (function nvme_recover_controller (bool data_submission)))
    (fn (static uint64_t) nvme_read_into_mapped_va_attempt ((uint64_t offset) (uint64_t size) (uint64_t dst_va) (bool retry))
      (if (|| (== size 0) (|| (> size BLOCK_MAX_XFER) (|| (> size PAGE_SIZE) (|| (!= (% offset NVME_LBA_BYTES) 0) (|| (!= (% size NVME_LBA_BYTES) 0) (|| (== dst_va 0) (== dst_va UINT64_MAX)))))))
        (block
          (call sexos_line "[sexdrive.block.read.handoff.err] reason=bad_args offset=%#llx size=%llu dst_va=%#llx"
            (cast (unsigned long long) offset) (cast (unsigned long long) size) (cast (unsigned long long) dst_va))
          (return BLOCK_ERR_BAD_LEN)))

      (if (call hot_log)
        (call sexos_line "[sexdrive.block.read.handoff.nvme.begin] offset=%#llx size=%llu dst_va=%#llx"
          (cast (unsigned long long) offset) (cast (unsigned long long) size) (cast (unsigned long long) dst_va)))

      (if (! (. (. sexdrive_state nvme_io_state) ready))
        (block
          (call sexos_line "[sexdrive.block.read.handoff.err] reason=no_ioq_ready")
          (return (call nvme_unavailable_status))))

      (var uint64_t map_va (. (. sexdrive_state nvme_io_state) map_va))
      (var uint64_t io_sq_va (. (. sexdrive_state nvme_io_state) io_sq_va))
      (var uint64_t io_cq_va (. (. sexdrive_state nvme_io_state) io_cq_va))
      (var uint64_t sq1tdbl (. (. sexdrive_state nvme_io_state) sq1tdbl))
      (var uint64_t cq1hdbl (. (. sexdrive_state nvme_io_state) cq1hdbl))
      (var uint32_t sq_tail (. (. sexdrive_state nvme_io_state) sq_tail))
      (var uint32_t cq_head (. (. sexdrive_state nvme_io_state) cq_head))
      (var uint32_t cq_phase (. (. sexdrive_state nvme_io_state) cq_phase))
      (var uint16_t cid (. (. sexdrive_state nvme_io_state) next_cid))
      (= (. (. sexdrive_state nvme_io_state) next_cid) (cast uint16_t (+ cid 1u)))

      (var bool leased false)
      (var uint64_t data_phys 0)
      (var uint64_t data_va 0)
      (if SEXOS_CURRENT_REGION_WRITER
        (block
          (var DmaLeaseResult prepared
            (call dma_lease_prepare (& (. sexdrive_state read_lease))
              (& (. sexdrive_state dma_device)) (cast uint64_t cid)))
          (if (!= (. prepared status) DMA_LEASE_OK) (return BLOCK_ERR_NO_DEVICE))
          (= leased true)
          (= data_phys (. (. prepared buffer) physical_address))
          (= data_va (. (. prepared buffer) virtual_address)))
        (block
          (= data_phys (call sys_alloc_phys PAGE_SIZE))
          (= data_va (call sys_map_phys data_phys PAGE_SIZE))))
      (if (|| (== data_phys 0) (|| (== data_phys UINT64_MAX) (!= (% data_phys PAGE_SIZE) 0)))
        (block
          (if leased
            (cast void (call dma_lease_uncertain (& (. sexdrive_state read_lease)) (cast uint64_t cid) false)))
          (call sexos_line "[sexdrive.block.read.handoff.err] reason=data_alloc_invalid phys=%#llx"
            (cast (unsigned long long) data_phys))
          (return BLOCK_ERR_NO_DEVICE)))
      (if (|| (== data_va 0) (== data_va UINT64_MAX))
        (block
          (if leased
            (cast void (call dma_lease_uncertain (& (. sexdrive_state read_lease)) (cast uint64_t cid) false)))
          (call sexos_line "[sexdrive.block.read.handoff.err] reason=data_map_failed va=%#llx"
            (cast (unsigned long long) data_va))
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint64_t (* zero_ptr) (cast (uint64_t *) (cast uintptr_t data_va)))
      (for (var size_t i 0) (< i (cast size_t (/ PAGE_SIZE 8ULL))) (++ i)
        (call sexos_volatile_write64 (+ zero_ptr i) 0ULL))

      (var uint64_t slba (/ offset NVME_LBA_BYTES))
      (var uint64_t nlb (- (/ size NVME_LBA_BYTES) 1ULL))
      (var uint64_t max_lba WRITE_PROOF_LBA)
      (var uint64_t last_lba (+ slba nlb))
      (var uint64_t range_ok (?: (> slba max_lba) 0ULL (?: (> nlb (- max_lba slba)) 0ULL 1ULL)))
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.cmd.range] path=typed slba=%llu nlb=%llu max_lba=%llu ok=%llu"
          (cast (unsigned long long) slba) (cast (unsigned long long) nlb)
          (cast (unsigned long long) max_lba) (cast (unsigned long long) range_ok)))

      (var uint32_t (* sqe_ptr) (cast (uint32_t *) (cast uintptr_t (+ io_sq_va (* (cast uint64_t sq_tail) 64ULL)))))
      (for (var size_t i 0) (< i 16) (++ i)
        (call sexos_volatile_write32 (+ sqe_ptr i) 0u))
      (call sexos_volatile_write32 (+ sqe_ptr 0) (| 0x02u (<< (cast uint32_t cid) 16)))
      (call sexos_volatile_write32 (+ sqe_ptr 1) 1u)
      (call sexos_volatile_write32 (+ sqe_ptr 6) (cast uint32_t (& data_phys 0xFFFFFFFFULL)))
      (call sexos_volatile_write32 (+ sqe_ptr 7) (cast uint32_t (>> data_phys 32)))
      (call sexos_volatile_write32 (+ sqe_ptr 10) (cast uint32_t (& slba 0xFFFFFFFFULL)))
      (call sexos_volatile_write32 (+ sqe_ptr 11) (cast uint32_t (>> slba 32)))
      (call sexos_volatile_write32 (+ sqe_ptr 12) (cast uint32_t (& nlb 0xFFFFULL)))

      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.cmd.shape] path=typed op=READ cid=%llu nsid=%llu slba=%llu nlb=%llu bytes=%llu prp1=%#llx prp2=%#llx buf_va=%#llx buf_phys=%#llx buffer_cap=%#llx buffer_kind=memlend last_lba=%llu"
          (cast (unsigned long long) cid) 1ULL (cast (unsigned long long) slba) (cast (unsigned long long) nlb)
          (cast (unsigned long long) size) (cast (unsigned long long) data_phys) 0ULL
          (cast (unsigned long long) dst_va) (cast (unsigned long long) data_phys)
          (cast (unsigned long long) SLOT_BUF_LEND) (cast (unsigned long long) last_lba)))

      (call sexos_compiler_fence_seq_cst)
      (if (&& leased (!= (call dma_lease_submit (& (. sexdrive_state read_lease)) (cast uint64_t cid)) DMA_LEASE_OK))
        (block
          (cast void (call dma_lease_uncertain (& (. sexdrive_state read_lease)) (cast uint64_t cid) false))
          (return BLOCK_ERR_NO_DEVICE)))
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.submit.detail] path=typed op=READ cid=%llu sq_tail_before=%llu sq_tail_after=%llu cq_head=%llu cq_phase=%llu lba=%llu bytes=%llu"
          (cast (unsigned long long) cid) (cast (unsigned long long) sq_tail)
          (cast (unsigned long long) (% (+ sq_tail 1u) 16u)) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) slba) (cast (unsigned long long) size)))
      (= sq_tail (% (+ sq_tail 1u) 16u))
      (call sexos_volatile_write32 (cast (uint32_t *) (cast uintptr_t (+ map_va sq1tdbl))) sq_tail)
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.doorbell] path=typed qid=1 tail=%llu"
          (cast (unsigned long long) sq_tail)))

      (var bool done false)
      (var uint32_t dw2 0)
      (var uint32_t dw3 0)
      (var uint32_t max_polls (?: NVME_TIMED_WAIT_ENABLED UINT32_MAX 1000000u))
      (var uint32_t polls 0)
      (var uint32_t last_dw3 0)
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.poll.begin] path=typed cid=%llu cq_head=%llu phase=%llu max_polls=%llu"
          (cast (unsigned long long) cid) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) max_polls)))
      (var uint64_t typed_write_wait_started (call nvme_wait_started))
      (for (var uint32_t p 0) (call nvme_wait_pending p max_polls typed_write_wait_started) (++ p)
        (block
          (call nvme_wait_turn p)
          (+= polls 1u)
          (var (const uint32_t) (* cqe_ptr) (cast ((const uint32_t) *) (cast uintptr_t (+ io_cq_va (* (cast uint64_t cq_head) 16ULL)))))
          (var uint32_t rd_dw2 (call sexos_volatile_read32 (+ cqe_ptr 2)))
          (var uint32_t rd_dw3 (call sexos_volatile_read32 (+ cqe_ptr 3)))
          (= last_dw3 rd_dw3)
          (var uint32_t cid_now (& rd_dw3 0xFFFFu))
          (var uint32_t phase_now (& (>> rd_dw3 16) 0x1u))
          (if (&& (== cid_now (cast uint32_t cid)) (== phase_now cq_phase))
            (block
              (= done true)
              (= dw2 rd_dw2)
              (= dw3 rd_dw3)
              (if (call hot_log)
                (call sexos_line "[sexdrive.block.read.handoff.nvme.cqe] cid=%llu phase=%llu dw2=%#llx dw3=%#llx"
                  (cast (unsigned long long) cid_now) (cast (unsigned long long) phase_now)
                  (cast (unsigned long long) rd_dw2) (cast (unsigned long long) rd_dw3)))
              break))))
      (if (call hot_log)
        (call sexos_line "[sexdrive.nvme.poll.end] path=typed cid=%llu found=%llu status=%llu cq_head=%llu phase=%llu polls=%llu"
          (cast (unsigned long long) cid) (cast (unsigned long long) (?: done 1ULL 0ULL))
          (cast (unsigned long long) (& (>> dw3 17) 0x7FFFu)) (cast (unsigned long long) cq_head)
          (cast (unsigned long long) cq_phase) (cast (unsigned long long) polls)))
      (if (! done)
        (block
          (if leased
            (block
              (cast void (call dma_lease_uncertain (& (. sexdrive_state read_lease)) (cast uint64_t cid) true))
              (= (. (. sexdrive_state nvme_io_state) ready) false)
              (call sexos_line "[sexdrive.dma.quarantine] ready=0 reason=unresolved_submission")))
          (call sexos_line "[sexdrive.block.read.handoff.err] reason=cqe_timeout cid=%llu head=%llu phase=%llu"
            (cast (unsigned long long) cid) (cast (unsigned long long) cq_head) (cast (unsigned long long) cq_phase))
          (call sexos_line "[sexdrive.nvme.poll.timeout.detail] path=typed cid=%llu expected_cid=%llu seen_cid=%llu seen_status=%llu seen_phase=%llu cq_head=%llu phase=%llu polls=%llu"
            (cast (unsigned long long) cid) (cast (unsigned long long) cid)
            (cast (unsigned long long) (& last_dw3 0xFFFFu)) (cast (unsigned long long) (& (>> last_dw3 17) 0x7FFFu))
            (cast (unsigned long long) (& (>> last_dw3 16) 0x1u)) (cast (unsigned long long) cq_head)
            (cast (unsigned long long) cq_phase) (cast (unsigned long long) polls))
          (if (&& retry (call nvme_recover_controller true))
            (block
              (call sexos_line "[sexdrive.nvme.read.retry] cid=%llu controller_recovered=1"
                (cast (unsigned long long) cid))
              (return (call nvme_read_into_mapped_va_attempt offset size dst_va false))))
          (return (call nvme_unavailable_status))))

      (if (&& leased
              (!= (call dma_lease_complete_observed (& (. sexdrive_state read_lease))
                    (cast uint64_t cid) (cast uint64_t (& dw3 0xFFFFu))
                    cq_phase (& (>> dw3 16) 1u)) DMA_LEASE_OK))
        (block
          (= (. (. sexdrive_state nvme_io_state) ready) false)
          (call sexos_line "[sexdrive.dma.quarantine] ready=0 reason=completion_identity")
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint32_t sf (& (>> dw3 17) 0x7FFFu))
      (var uint32_t sc (& sf 0xFFu))
      (var uint32_t sct (& (>> sf 8) 0x7u))
      (if (|| (!= sc 0) (!= sct 0))
        (block
          (var uint32_t sqhd (& dw2 0xFFFFu))
          (var uint32_t sqid (& (>> dw2 16) 0xFFFFu))
          (call sexos_line "[sexdrive.block.read.handoff.err] reason=status_fail cid=%llu sc=%llu sct=%llu sqhd=%llu sqid=%llu dw3=%#llx"
            (cast (unsigned long long) cid) (cast (unsigned long long) sc) (cast (unsigned long long) sct)
            (cast (unsigned long long) sqhd) (cast (unsigned long long) sqid) (cast (unsigned long long) dw3))
          (return BLOCK_ERR_NO_DEVICE)))

      (= cq_head (% (+ cq_head 1u) 16u))
      (if (== cq_head 0u)
        (^= cq_phase 1u))
      (call sexos_volatile_write32 (cast (uint32_t *) (cast uintptr_t (+ map_va cq1hdbl))) cq_head)
      (= (. (. sexdrive_state nvme_io_state) sq_tail) sq_tail)
      (= (. (. sexdrive_state nvme_io_state) cq_head) cq_head)
      (= (. (. sexdrive_state nvme_io_state) cq_phase) cq_phase)

      (var (const uint8_t) (* src) (cast ((const uint8_t) *) (cast uintptr_t data_va)))
      (var uint8_t (* dst) (cast (uint8_t *) (cast uintptr_t dst_va)))
      (for (var size_t i 0) (< i (cast size_t size)) (++ i)
        (call sexos_volatile_write8 (+ dst i) (call sexos_volatile_read8 (+ src i))))
      (if (call hot_log)
        (call sexos_line "[sexdrive.block.read.handoff.copy.ok] phase=B len=%llu"
          (cast (unsigned long long) size)))
      (return 0ULL))

    (fn (static uint64_t) nvme_read_into_mapped_va ((uint64_t offset) (uint64_t size) (uint64_t dst_va))
      (return (call nvme_read_into_mapped_va_attempt offset size dst_va true)))

    (fn (static bool) write_guard_allows ((uint64_t offset) (uint64_t size) (uint64_t buf_cap))
      (var uint64_t expected_offset (* WRITE_PROOF_LBA NVME_LBA_BYTES))
      (var uint64_t manifest_offset (* MANIFEST_LBA NVME_LBA_BYTES))
      (var uint64_t object_start_offset (* PROOF_OBJECT_START_LBA NVME_LBA_BYTES))
      (var uint64_t object_end_offset (* PROOF_OBJECT_END_LBA NVME_LBA_BYTES))
      (var bool proof_mode (== buf_cap SLOT_BUF_LEND))
      (var bool allow_manifest (&& proof_mode (&& (== size WRITE_PROOF_LEN) (== offset manifest_offset))))
      (var uint64_t linen_start (* LINEN_OBJECT_START_LBA NVME_LBA_BYTES))
      (var uint64_t linen_end (* LINEN_OBJECT_END_LBA NVME_LBA_BYTES))
      (var uint64_t quil_start (* QUIL_OBJECT_START_LBA NVME_LBA_BYTES))
      (var uint64_t quil_end (* QUIL_OBJECT_END_LBA NVME_LBA_BYTES))
      (var bool allow_object (&& proof_mode (&& (== size WRITE_PROOF_LEN) (&& (== (% offset NVME_LBA_BYTES) 0) (&& (>= offset object_start_offset) (<= offset object_end_offset))))))
      (var bool allow_linen (&& proof_mode (&& (== size WRITE_PROOF_LEN) (&& (== (% offset NVME_LBA_BYTES) 0) (&& (>= offset linen_start) (<= offset linen_end))))))
      (var bool allow_quil (&& proof_mode (&& (== size WRITE_PROOF_LEN) (&& (== (% offset NVME_LBA_BYTES) 0) (&& (>= offset quil_start) (<= offset quil_end))))))
      (var bool allow_proof (&& proof_mode (&& (== offset expected_offset) (== size WRITE_PROOF_LEN))))
      (var uint64_t sexfs_meta_start (* SEXFS_V0_META_START_LBA NVME_LBA_BYTES))
      (var uint64_t sexfs_meta_end (* SEXFS_V0_META_END_LBA NVME_LBA_BYTES))
      (var uint64_t sexfs_obj_start (* SEXFS_V0_OBJECT_START_LBA NVME_LBA_BYTES))
      (var uint64_t sexfs_obj_end (* SEXFS_V0_OBJECT_END_LBA NVME_LBA_BYTES))
      (var bool allow_sexfs_meta (&& proof_mode (&& (== size WRITE_PROOF_LEN) (&& (== (% offset NVME_LBA_BYTES) 0) (&& (>= offset sexfs_meta_start) (<= offset sexfs_meta_end))))))
      (var bool allow_sexfs_obj (&& proof_mode (&& (== size WRITE_PROOF_LEN) (&& (== (% offset NVME_LBA_BYTES) 0) (&& (>= offset sexfs_obj_start) (<= offset sexfs_obj_end))))))
      (var uint64_t pool_start (* DISKFS_V4_POOL_BASE_LBA NVME_LBA_BYTES))
      (var uint64_t pool_end (* (+ DISKFS_V4_POOL_BASE_LBA DISKFS_V4_POOL_SECTORS) NVME_LBA_BYTES))
      (var bool allow_pool_bulk
        (&& proof_mode
          (&& (> size WRITE_PROOF_LEN)
            (&& (<= size PAGE_SIZE)
              (&& (== (% size NVME_LBA_BYTES) 0)
                (&& (== (% offset NVME_LBA_BYTES) 0)
                  (&& (>= offset pool_start) (&& (<= offset pool_end) (<= size (- pool_end offset))))))))))
      (var uint64_t epoch_start (* EPOCH_JOURNAL_BASE_LBA NVME_LBA_BYTES))
      (var uint64_t epoch_end (* (+ (+ EPOCH_JOURNAL_BASE_LBA EPOCH_JOURNAL_DATA_SECTORS) EPOCH_JOURNAL_META_SECTORS) NVME_LBA_BYTES))
      (var bool allow_epoch
        (&& proof_mode
          (&& (> size 0)
            (&& (<= size PAGE_SIZE)
              (&& (== (% size NVME_LBA_BYTES) 0)
                (&& (== (% offset NVME_LBA_BYTES) 0)
                  (&& (>= offset epoch_start)
                    (&& (< offset epoch_end)
                      (<= size (- epoch_end offset))))))))))
      (var bool allow (|| allow_proof (|| allow_manifest (|| allow_object (|| allow_linen (|| allow_quil (|| allow_sexfs_meta (|| allow_sexfs_obj (|| allow_pool_bulk allow_epoch)))))))))

      (call sexos_line "[sexdrive.write.guard.config] proof_lba=%llu proof_offset=%#llx manifest_lba=%llu object_lba_start=%llu object_lba_end=%llu proof_len=%llu magic=%#llx sexfs_meta=%llu-%llu sexfs_obj=%llu-%llu"
        (cast (unsigned long long) WRITE_PROOF_LBA) (cast (unsigned long long) expected_offset)
        (cast (unsigned long long) MANIFEST_LBA) (cast (unsigned long long) PROOF_OBJECT_START_LBA)
        (cast (unsigned long long) PROOF_OBJECT_END_LBA) (cast (unsigned long long) WRITE_PROOF_LEN)
        (cast (unsigned long long) WRITE_PROOF_MAGIC) (cast (unsigned long long) SEXFS_V0_META_START_LBA)
        (cast (unsigned long long) SEXFS_V0_META_END_LBA) (cast (unsigned long long) SEXFS_V0_OBJECT_START_LBA)
        (cast (unsigned long long) SEXFS_V0_OBJECT_END_LBA))
      (call sexos_line "[sexdrive.write.guard.begin] offset=%#llx size=%llu buf_cap=%#llx proof_mode=%llu"
        (cast (unsigned long long) offset) (cast (unsigned long long) size)
        (cast (unsigned long long) buf_cap) (cast (unsigned long long) (?: proof_mode 1ULL 0ULL)))
      (var uint64_t lba (/ offset NVME_LBA_BYTES))
      (if allow
        (block
          (if (|| allow_sexfs_meta allow_sexfs_obj)
            (call sexos_line "[sexdrive.write_guard.sexfs.allow] lba=%llu size=%llu ok=1"
              (cast (unsigned long long) lba) (cast (unsigned long long) size))
            (call sexos_line "[sexdrive.write.guard.allow] offset=%#llx size=%llu buf_cap=%#llx"
              (cast (unsigned long long) offset) (cast (unsigned long long) size) (cast (unsigned long long) buf_cap))))
        (call sexos_line "[sexdrive.write_guard.reject] lba=%llu size=%llu ok=1"
          (cast (unsigned long long) lba) (cast (unsigned long long) size)))
      (return allow))

    (fn (static uint64_t) nvme_write_one_block_attempt ((uint64_t offset) (uint64_t size) (uint64_t src_va) (bool retry))
      (if (|| (== size 0)
              (|| (> size PAGE_SIZE)
                  (|| (> size BLOCK_MAX_XFER)
                      (|| (!= (% size NVME_LBA_BYTES) 0)
                          (|| (!= (% offset NVME_LBA_BYTES) 0)
                              (|| (> offset (* (+ (+ EPOCH_JOURNAL_BASE_LBA EPOCH_JOURNAL_DATA_SECTORS) EPOCH_JOURNAL_META_SECTORS) NVME_LBA_BYTES))
                                  (|| (> size (- (* (+ (+ EPOCH_JOURNAL_BASE_LBA EPOCH_JOURNAL_DATA_SECTORS) EPOCH_JOURNAL_META_SECTORS) NVME_LBA_BYTES) offset))
                                      (|| (== src_va 0) (== src_va UINT64_MAX)))))))))
        (block
          (call sexos_line "[sexdrive.nvme.write.err] reason=bad_args offset=%#llx size=%llu src_va=%#llx"
            (cast (unsigned long long) offset) (cast (unsigned long long) size) (cast (unsigned long long) src_va))
          (return BLOCK_ERR_BAD_LEN)))

      (if (! (. (. sexdrive_state nvme_io_state) ready))
        (block
          (call sexos_line "[sexdrive.nvme.write.err] reason=no_ioq_ready")
          (return (call nvme_unavailable_status))))

      (var uint64_t map_va (. (. sexdrive_state nvme_io_state) map_va))
      (var uint64_t io_sq_va (. (. sexdrive_state nvme_io_state) io_sq_va))
      (var uint64_t io_cq_va (. (. sexdrive_state nvme_io_state) io_cq_va))
      (var uint64_t sq1tdbl (. (. sexdrive_state nvme_io_state) sq1tdbl))
      (var uint64_t cq1hdbl (. (. sexdrive_state nvme_io_state) cq1hdbl))
      (var uint32_t sq_tail (. (. sexdrive_state nvme_io_state) sq_tail))
      (var uint32_t cq_head (. (. sexdrive_state nvme_io_state) cq_head))
      (var uint32_t cq_phase (. (. sexdrive_state nvme_io_state) cq_phase))
      (var uint16_t write_cid (. (. sexdrive_state nvme_io_state) next_cid))
      (= (. (. sexdrive_state nvme_io_state) next_cid) (cast uint16_t (+ write_cid 1u)))

      (var bool leased false)
      (var uint64_t write_phys 0)
      (var uint64_t write_va 0)
      (var uint64_t write_length PAGE_SIZE)
      (if SEXOS_CURRENT_REGION_WRITER
        (block
          (var DmaLeaseResult prepared
            (call dma_lease_prepare (& (. sexdrive_state write_lease))
              (& (. sexdrive_state dma_device)) (cast uint64_t write_cid)))
          (if (!= (. prepared status) DMA_LEASE_OK) (return BLOCK_ERR_NO_DEVICE))
          (= leased true)
          (= write_phys (. (. prepared buffer) physical_address))
          (= write_va (. (. prepared buffer) virtual_address))
          (= write_length (. (. prepared buffer) length)))
        (block
          (= write_phys (call sys_alloc_phys PAGE_SIZE))
          (= write_va (call sys_map_phys write_phys PAGE_SIZE))))
      (if (|| (< write_length size)
              (|| (== write_phys 0) (|| (== write_phys UINT64_MAX) (|| (!= (% write_phys PAGE_SIZE) 0) (|| (== write_va 0) (== write_va UINT64_MAX))))))
        (block
          (if leased
            (cast void (call dma_lease_uncertain (& (. sexdrive_state write_lease)) (cast uint64_t write_cid) false)))
          (call sexos_line "[sexdrive.nvme.write.err] reason=write_buf_invalid phys=%#llx va=%#llx"
            (cast (unsigned long long) write_phys) (cast (unsigned long long) write_va))
          (return BLOCK_ERR_NO_DEVICE)))

      (var uint8_t (* write_ptr) (cast (uint8_t *) (cast uintptr_t write_va)))
      (var (const uint8_t) (* src_ptr) (cast ((const uint8_t) *) (cast uintptr_t src_va)))
      (for (var size_t i 0) (< i (cast size_t PAGE_SIZE)) (++ i)
        (call sexos_volatile_write8 (+ write_ptr i) 0u))
      (for (var size_t i 0) (< i (cast size_t size)) (++ i)
        (call sexos_volatile_write8 (+ write_ptr i) (call sexos_volatile_read8 (+ src_ptr i))))

      (var uint64_t slba (/ offset NVME_LBA_BYTES))
      (var uint32_t nlb (cast uint32_t (- (/ size NVME_LBA_BYTES) 1)))
      (var uint64_t max_lba (- (+ (+ EPOCH_JOURNAL_BASE_LBA EPOCH_JOURNAL_DATA_SECTORS) EPOCH_JOURNAL_META_SECTORS) 1))
      (var uint64_t last_lba (+ slba (cast uint64_t nlb)))
      (var uint64_t range_ok (?: (<= last_lba max_lba) 1ULL 0ULL))
      (if (call hot_log)
