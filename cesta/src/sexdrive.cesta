            (cast (unsigned long long) create_sq_cid) (cast (unsigned long long) sq_sc)
            (cast (unsigned long long) sq_sct) (cast (unsigned long long) sq_cqe_dw3))
          (return)))
      (call sexos_line "[sexdrive.nvme.ioq.create_sq.ok] cid=%llu sc=%llu sct=%llu cqh=%llu cqp=%llu"
        (cast (unsigned long long) create_sq_cid) (cast (unsigned long long) sq_sc)
        (cast (unsigned long long) sq_sct) (cast (unsigned long long) admin_cq_head)
        (cast (unsigned long long) admin_cq_phase))

      (var uint64_t sq1tdbl (+ 0x1000ULL (<< (* 2ULL 1ULL) (+ 2u (cast uint32_t cap_dstrd)))))
      (var uint64_t cq1hdbl (+ 0x1000ULL (<< (+ (* 2ULL 1ULL) 1ULL) (+ 2u (cast uint32_t cap_dstrd)))))
      (call sexos_line "[sexdrive.nvme.ioq.ready] qid=1 depth=16 sq_tail=%llu cq_head=%llu cq_phase=%llu sq1tdbl=%#llx cq1hdbl=%#llx"
