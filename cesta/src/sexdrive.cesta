      (= (. (. sexdrive_state nvme_io_state) cq_head) cq_head)
      (= (. (. sexdrive_state nvme_io_state) cq_phase) cq_phase)

      (var (const uint8_t) (* src) (cast ((const uint8_t) *) (cast uintptr_t data_va)))
      (var uint8_t (* dst) (cast (uint8_t *) (cast uintptr_t dst_va)))
      (for (var size_t i 0) (< i (cast size_t size)) (++ i)
