        (block
          (call sexos_line "[sexdrive.dma.reset.failed] reason=kernel_quiescence status=%llu generation=%llu phase=%llu cc=%#llx csts=%#llx"
            (cast (unsigned long long) (. kernel_quiescent status))
            (cast (unsigned long long) (. kernel_quiescent generation))
            (cast (unsigned long long) (. kernel_quiescent phase))
            (cast (unsigned long long) (. kernel_quiescent cc))
            (cast (unsigned long long) (. kernel_quiescent csts)))
          (return false)))
      (if (!= (call dma_device_observe_quiescent (& (. sexdrive_state dma_device))
                (!= (& cc_now 1u) 0u) (!= (& csts_now 1u) 0u)) DMA_LEASE_OK)
        (call sexos_fail))
      (if (|| (! (call dma_lease_generation_compatible (& (. sexdrive_state read_lease))
                    (& (. sexdrive_state dma_device))))
              (! (call dma_lease_generation_compatible (& (. sexdrive_state write_lease))
                    (& (. sexdrive_state dma_device)))))
        (block
          (call sexos_line "[sexdrive.dma.reset.failed] reason=lease_generation")
          (return false)))
      (if (|| (!= (call dma_lease_advance_generation (& (. sexdrive_state read_lease))
                    (& (. sexdrive_state dma_device))) DMA_LEASE_OK)
              (!= (call dma_lease_advance_generation (& (. sexdrive_state write_lease))
                    (& (. sexdrive_state dma_device))) DMA_LEASE_OK))
        (block
          (call sexos_line "[sexdrive.dma.reset.failed] reason=lease_retirement")
          (return false)))
      (= (. sexdrive_state reset_rebuild_pending) true)
      (call sexos_line "[sexdrive.dma.reset.quiescent] generation=%llu next_generation=%llu polls=%llu read_phase=%llu write_phase=%llu"
        (cast (unsigned long long) (. (. sexdrive_state dma_device) generation))
        (cast (unsigned long long) (+ (. (. sexdrive_state dma_device) generation) 1ULL))
        (cast (unsigned long long) polls)
        (cast (unsigned long long) (. (. sexdrive_state read_lease) phase))
        (cast (unsigned long long) (. (. sexdrive_state write_lease) phase)))
      (if DMA_QUARANTINE_PROBE_ENABLED (call sexos_spin_loop_count DMA_PROBE_HANDSHAKE_SPINS))
      (call nvme_probe_bar)
      (var bool recovered (&& (! (. sexdrive_state reset_rebuild_pending))
        (&& (. (. sexdrive_state nvme_io_state) ready)
          (&& (call dma_device_epoch_active (& (. sexdrive_state dma_device)))
            (&& (== (. (. sexdrive_state read_lease) generation)
                    (. (. sexdrive_state dma_device) generation))
                (== (. (. sexdrive_state write_lease) generation)
                    (. (. sexdrive_state dma_device) generation)))))))
      (if (! recovered) (call sexos_line "[sexdrive.dma.reset.failed] reason=rebuild"))
      (return recovered))

    (fn (static bool) nvme_recovery_maybe_start (void)
      (if (|| (. (. sexdrive_state nvme_io_state) ready)
              (&& (! (. sexdrive_state reset_recovery_pending))
                  (&& (! (call dma_lease_is_quarantined (& (. sexdrive_state read_lease))))
                      (! (call dma_lease_is_quarantined (& (. sexdrive_state write_lease)))))))
        (block
          (= (. sexdrive_state reset_recovery_pending) false)
          (return false)))
      (var uint64_t generation (. (. sexdrive_state dma_device) generation))
      (var DeviceResetReceipt snapshot
        (call sexos_device_reset SLOT_NVME_HOST DEVICE_RESET_QUERY generation false))
      (if (|| (!= (. snapshot status) DEVICE_RESET_OK)
              (!= (. snapshot generation) generation))
        (block
          (= (. sexdrive_state reset_recovery_pending) false)
          (call sexos_line "[sexdrive.dma.reset.failed] reason=kernel_query status=%llu generation=%llu phase=%llu"
            (cast (unsigned long long) (. snapshot status))
            (cast (unsigned long long) (. snapshot generation))
            (cast (unsigned long long) (. snapshot phase)))
          (return false)))
      (if (!= (. snapshot interrupt_revision) (. snapshot acknowledged_revision))
        (block
          (= (. sexdrive_state reset_recovery_pending) true)
          (call sexos_line "[sexdrive.dma.reset.deferred] generation=%llu produced=%llu acknowledged=%llu"
            (cast (unsigned long long) generation)
            (cast (unsigned long long) (. snapshot interrupt_revision))
            (cast (unsigned long long) (. snapshot acknowledged_revision)))
          (return false)))
      (= (. sexdrive_state reset_recovery_pending) false)
      (return (call nvme_recover_controller
        (|| (call dma_lease_is_quarantined (& (. sexdrive_state read_lease)))
            (call dma_lease_is_quarantined (& (. sexdrive_state write_lease)))))))

    (fn (static void) dma_probe_finish_recovery (void)
      (if (! (. sexdrive_state dma_probe_recovery_pending)) (return))
      (= (. sexdrive_state dma_probe_recovery_pending) false)
      (if (! (. (. sexdrive_state nvme_io_state) ready))
        (block
          (call sexos_line "[sexdrive.dma.probe.failed] reason=recovery")
          (return)))
      (var uint64_t dst_phys (call sys_alloc_phys PAGE_SIZE))
      (var uint64_t dst_va (call sys_map_phys dst_phys PAGE_SIZE))
      (if (|| (== dst_phys 0ULL) (|| (== dst_phys UINT64_MAX)
              (|| (== dst_va 0ULL) (== dst_va UINT64_MAX))))
        (block
          (call sexos_line "[sexdrive.dma.probe.failed] reason=recovered_destination")
          (return)))
      (var uint64_t status (call nvme_read_into_mapped_va 0ULL NVME_LBA_BYTES dst_va))
      (call sexos_line "[sexdrive.dma.probe.recovered] status=%llu phase=%llu generation=%llu device_generation=%llu ready=%llu read_phys=%#llx resets=%llu"
        (cast (unsigned long long) status)
        (cast (unsigned long long) (. (. sexdrive_state read_lease) phase))
        (cast (unsigned long long) (. (. sexdrive_state read_lease) generation))
        (cast (unsigned long long) (. (. sexdrive_state dma_device) generation))
        (cast (unsigned long long) (?: (. (. sexdrive_state nvme_io_state) ready) 1ULL 0ULL))
        (cast (unsigned long long) (. (. (. sexdrive_state read_lease) buffer) physical_address))
        (cast (unsigned long long) (. sexdrive_state reset_count))))

    (fn (static void) xhci_probe_mmio (void)
      (var uint64_t map_va (call sexos_map_pci_bar SLOT_USB_HOST 0ULL 0x1000ULL))
      (if (|| (== map_va UINT64_MAX) (== map_va 0ULL))
        (block
          (call sexos_line "[sexdrive] XHCI probe: no BAR lease/mapping available")
          (return)))

      (var (const uint32_t) (* regs) (cast ((const uint32_t) *) (cast uintptr_t map_va)))
      (var uint32_t cap0 (call sexos_volatile_read32 (+ regs 0)))
      (var uint8_t caplength (cast uint8_t (& cap0 0xFFu)))
      (var uint16_t hciversion (cast uint16_t (& (>> cap0 16) 0xFFFFu)))
      (var uint32_t hcsp1 (call sexos_volatile_read32 (+ regs 1)))
      (var uint32_t hcc1 (call sexos_volatile_read32 (+ regs 4)))

      (call sexos_line "[sexdrive] XHCI MMIO probe ok va=%#llx caplength=%#llx hciversion=%#llx hcsp1=%#llx hcc1=%#llx"
        (cast (unsigned long long) map_va) (cast (unsigned long long) caplength)
        (cast (unsigned long long) hciversion) (cast (unsigned long long) hcsp1)
        (cast (unsigned long long) hcc1)))

    (fn (static bool) nvme_handle_interrupt ((SexosMessage msg))
      (if (|| (! SEXOS_CURRENT_REGION_WRITER)
              (|| (!= (. msg type_id) 0xFFULL)
      (|| (!= (. msg caller_pd) 1u) (!= (. msg caller_task) 0u))))
        (return false))
      (var uint64_t offset (. msg arg0))
      (var uint64_t size (. msg arg1))
      (var uint64_t _buf_cap (. msg arg2))
      (var uint64_t generation (. (. sexdrive_state dma_device) generation))
      (var DeviceResetReceipt interrupt_ack
        (?: (&& (== offset 0x22ULL) (&& (!= size 0ULL) (== _buf_cap generation)))
          (call sexos_device_interrupt_ack SLOT_NVME_HOST generation size)
          (compound DeviceResetReceipt (= (. status) DEVICE_RESET_INVALID))))
      (call sexos_line "[sexdrive.interrupt.ack] vector=%llu revision=%llu generation=%llu status=%llu acknowledged=%llu"
        (cast (unsigned long long) offset) (cast (unsigned long long) size)
        (cast (unsigned long long) _buf_cap)
        (cast (unsigned long long) (. interrupt_ack status))
        (cast (unsigned long long) (. interrupt_ack acknowledged_revision)))
      (if (== (. interrupt_ack status) DEVICE_RESET_OK)
        (if (! (. (. sexdrive_state nvme_io_state) ready))
          (if (|| (. sexdrive_state reset_recovery_pending)
              (|| (call dma_lease_is_quarantined (& (. sexdrive_state read_lease)))
                  (call dma_lease_is_quarantined (& (. sexdrive_state write_lease)))))
            (block
              (= (. sexdrive_state reset_recovery_pending) true)
              (if (call nvme_recovery_maybe_start)
                (call dma_probe_finish_recovery)
                (if (&& (. sexdrive_state dma_probe_recovery_pending)
                        (! (. sexdrive_state reset_recovery_pending)))
                  (call dma_probe_finish_recovery)))))))
      (return true))

    (fn void sexdrive_main (void)
      (call sexdrive_state_init (& sexdrive_state))
      (call sexos_line "[sexdrive.init.start]")
      (if (call sexdrive_dma_init)
        (call nvme_probe_bar)
        (call sexos_line "[sexdrive.dma.region.err] ready=0"))
      (if (&& DMA_QUARANTINE_PROBE_ENABLED (. sexdrive_state dma_probe_injected))
        (block
          (= (. sexdrive_state dma_probe_recovery_pending) true)
          (if (call nvme_recovery_maybe_start)
            (call dma_probe_finish_recovery)
            (if (! (. sexdrive_state reset_recovery_pending))
              (call dma_probe_finish_recovery)))))
      (call xhci_probe_mmio)

      (if SEXOS_CURRENT_REGION_WRITER
        (call sexos_spin_loop_count 10000000u)
        (block
          (for (var uint32_t _spin 0) (< _spin 10000000u) (++ _spin)
            (call sexos_spin_loop_hint))))

      (var uint64_t fb_size (* (* 1024ULL 768ULL) 4ULL))
      (var uint64_t shared_addr 0)
      (if SEXOS_CURRENT_REGION_WRITER
        (block
          (var MemoryRegionReply frame_view
            (call sexos_memory_region_view SLOT_FRAME_REGION 0 fb_size (| REGION_QUERY REGION_WRITE)))
          (= shared_addr (?: (== (. frame_view status) 0) (. frame_view value0) UINT64_MAX))
          (if (|| (== shared_addr 0) (== shared_addr UINT64_MAX))
            (block
              (call sexos_line "[sexdrive.frame.region.err] slot=%llu"
                (cast (unsigned long long) SLOT_FRAME_REGION))
              (call sexos_spin_forever))))
        (block
          (= shared_addr (call sexos_alloc_shared_buffer fb_size 1ULL))
          (if (== shared_addr 0ULL)
            (call sexos_spin_forever))))

      (cast void (call sexos_pdx_call SLOT_SHELL OP_SHELL_BIND_BUFFER shared_addr 0ULL 0ULL))

      (var uint32_t frame 0u)
      (if (call hot_log)
        (call sexos_line "[sexdrive.ready]"))
      (while 1
        (block
          (var SexosMessage msg (init 0))
          (if (call sexos_try_listen 0ULL (& msg))
            (block
              (var uint64_t cmd (. msg type_id))
              (var uint64_t offset (. msg arg0))
              (var uint64_t size (. msg arg1))
              (var uint64_t _buf_cap (. msg arg2))
              (var uint64_t ready_snapshot (?: (. (. sexdrive_state nvme_io_state) ready) 1ULL 0ULL))
              (var (const char) (* op)
                (?: (== cmd BLOCK_READ) "READ"
                  (?: (== cmd BLOCK_WRITE) "WRITE" "OTHER")))
              (var uint64_t lba (?: (!= BLOCK_SECTOR_SIZE 0ULL) (/ offset BLOCK_SECTOR_SIZE) 0ULL))
              (var uint64_t submit_cid_snapshot (cast uint64_t (. (. sexdrive_state nvme_io_state) next_cid)))
              (var uint64_t submit_tail_snapshot (cast uint64_t (. (. sexdrive_state nvme_io_state) sq_tail)))

              (if (call nvme_handle_interrupt msg) continue)

              (if (call hot_log)
                (call sexos_line "[sexdrive.block.typed.recv] cmd=%llu offset=%#llx size=%llu buf_cap=%#llx caller=%u"
                  (cast (unsigned long long) cmd) (cast (unsigned long long) offset)
                  (cast (unsigned long long) size) (cast (unsigned long long) _buf_cap)
                  (cast unsigned (. msg caller_pd))))
              (if (|| (== cmd BLOCK_READ) (== cmd BLOCK_WRITE))
                (if (call hot_log)
                  (call sexos_line "[sexdrive.block.req] op=%s ready=%llu lba=%llu bytes=%llu buffer_cap=%#llx device_cap=%#llx"
                    op (cast (unsigned long long) ready_snapshot) (cast (unsigned long long) lba)
                    (cast (unsigned long long) size) (cast (unsigned long long) _buf_cap)
                    (cast (unsigned long long) SLOT_NVME_HOST))))

              (var uint64_t reply_val 0ULL)
              (if (== cmd BLOCK_READ)
                (block
                  (if (call hot_log)
                    (call sexos_line "[sexdrive.block.read.api.recv] offset=%#llx size=%llu buf_cap=%#llx"
                      (cast (unsigned long long) offset) (cast (unsigned long long) size)
                      (cast (unsigned long long) _buf_cap)))
                  (if (call hot_log)
                    (call sexos_line "[sexdrive.block.read.handoff.begin] offset=%#llx size=%llu buf_cap=%#llx"
                      (cast (unsigned long long) offset) (cast (unsigned long long) size)
                      (cast (unsigned long long) _buf_cap)))
                  (if (|| (== size 0ULL) (> size BLOCK_MAX_XFER))
                    (block
                      (call sexos_line "[sexdrive.block.read.api.err] reason=bad_len size=%llu max=%llu"
                        (cast (unsigned long long) size) (cast (unsigned long long) BLOCK_MAX_XFER))
                      (call sexos_line "[sexdrive.block.read.handoff.err] reason=bad_len size=%llu"
                        (cast (unsigned long long) size))
                      (= reply_val BLOCK_ERR_BAD_LEN))
                    (if (!= (% offset BLOCK_SECTOR_SIZE) 0ULL)
                      (block
                        (call sexos_line "[sexdrive.block.read.api.err] reason=unaligned_offset offset=%#llx sector=%llu"
                          (cast (unsigned long long) offset) (cast (unsigned long long) BLOCK_SECTOR_SIZE))
                        (call sexos_line "[sexdrive.block.read.handoff.err] reason=unaligned_offset offset=%#llx"
                          (cast (unsigned long long) offset))
                        (= reply_val BLOCK_ERR_BAD_LEN))
                      (if (== _buf_cap SLOT_BUF_LEND)
                        (if (|| (== size 0) (!= (% size 512ULL) 0))
                          (block
                            (call sexos_line "[sexdrive.block.read.handoff.err] reason=bad_len_phase_b size=%llu expect=sector_span"
                              (cast (unsigned long long) size))
                            (= reply_val BLOCK_ERR_BAD_LEN))
                          (block
                            (var RegionWriterReceipt writer (init 0))
                            (var uint64_t writer_status
                              (call block_writer_claim (. msg caller_pd) (& writer)))
                            (if (!= writer_status 0)
                              (block
                                (call sexos_line "[sexdrive.block.read.handoff.err] reason=writer_claim_failed status=%llu"
                                  (cast (unsigned long long) writer_status))
                                (= reply_val writer_status))
                              (block
                                (var uint64_t fill_va
                                  (call block_buffer_view (. msg caller_pd) size (| REGION_READ REGION_WRITE)))
                                (if (|| (== fill_va 0ULL) (== fill_va UINT64_MAX))
                                  (block
                                    (call sexos_line "[sexdrive.block.read.handoff.err] reason=map_failed va=%#llx"
                                      (cast (unsigned long long) fill_va))
                                    (if (call hot_log)
                                      (call sexos_line "[sexdrive.nvme.cmd.shape.err] path=typed reason=memlend_map_failed buffer_cap=%#llx"
                                        (cast (unsigned long long) SLOT_BUF_LEND)))
                                    (= reply_val BLOCK_ERR_NO_DEVICE))
                                  (block
                                    (if (call hot_log)
                                      (call sexos_line "[sexdrive.bufcap.map.ok] fill_va=%#llx"
                                        (cast (unsigned long long) fill_va)))
                                    (if (call hot_log)
                                      (call sexos_line "[sexdrive.block.nvme.submit] op=%s lba=%llu bytes=%llu cid=%llu tail=%llu ready=%llu"
                                        op (cast (unsigned long long) lba) (cast (unsigned long long) size)
                                        (cast (unsigned long long) submit_cid_snapshot)
                                        (cast (unsigned long long) submit_tail_snapshot)
                                        (cast (unsigned long long) ready_snapshot)))
                                    (= reply_val (call nvme_read_into_mapped_va offset size fill_va))))
                                (if (! (call block_writer_release (. msg caller_pd) (& writer)))
                                  (call sexos_fail))))))
                        (block
                          (call sexos_line "[sexdrive.block.read.api.validate.ok] offset=%#llx size=%llu lba_bytes=%llu"
                            (cast (unsigned long long) offset) (cast (unsigned long long) size)
                            (cast (unsigned long long) NVME_LBA_BYTES))
                          (if (== _buf_cap 0ULL)
                            (call sexos_line "[sexdrive.block.read.handoff.err] reason=buffer_cap_not_real buf_cap=%#llx"
                              (cast (unsigned long long) _buf_cap))
                            (call sexos_line "[sexdrive.block.read.handoff.err] reason=buffer_cap_unverifiable buf_cap=%#llx"
                              (cast (unsigned long long) _buf_cap)))
                          (if (call hot_log)
                            (call sexos_line "[sexdrive.block.nvme.submit] op=%s lba=%llu bytes=%llu cid=%llu tail=%llu ready=%llu"
                              op (cast (unsigned long long) lba) (cast (unsigned long long) size)
                              (cast (unsigned long long) submit_cid_snapshot)
                              (cast (unsigned long long) submit_tail_snapshot)
                              (cast (unsigned long long) ready_snapshot)))
                          (= reply_val (call nvme_read_into_bounce offset size)))))))
                (if (== cmd BLOCK_WRITE)
                  (block
                    (if (call hot_log)
                      (call sexos_line "[sexdrive.block.write.api.recv] offset=%#llx size=%llu buf_cap=%#llx"
                        (cast (unsigned long long) offset) (cast (unsigned long long) size)
                        (cast (unsigned long long) _buf_cap)))
                    (if (call write_guard_allows offset size _buf_cap)
                      (block
                        (var uint64_t fill_va
                          (call block_buffer_view (. msg caller_pd) size REGION_READ))
                        (if (|| (== fill_va 0ULL) (== fill_va UINT64_MAX))
                          (block
                            (call sexos_line "[sexdrive.nvme.write.err] reason=map_failed va=%#llx"
                              (cast (unsigned long long) fill_va))
                            (if (call hot_log)
                              (call sexos_line "[sexdrive.nvme.cmd.shape.err] path=typed reason=memlend_map_failed buffer_cap=%#llx"
                                (cast (unsigned long long) SLOT_BUF_LEND)))
                            (= reply_val BLOCK_ERR_NO_DEVICE))
                          (block
                            (if (call hot_log)
                              (call sexos_line "[sexdrive.bufcap.map.ok] fill_va=%#llx"
                                (cast (unsigned long long) fill_va)))
                            (if (call hot_log)
                              (call sexos_line "[sexdrive.block.nvme.submit] op=%s lba=%llu bytes=%llu cid=%llu tail=%llu ready=%llu"
                                op (cast (unsigned long long) lba) (cast (unsigned long long) size)
                                (cast (unsigned long long) submit_cid_snapshot)
                                (cast (unsigned long long) submit_tail_snapshot)
                                (cast (unsigned long long) ready_snapshot)))
                            (var uint64_t proof_offset (* WRITE_PROOF_LBA NVME_LBA_BYTES))
                            (if (== offset proof_offset)
                              (= reply_val (call nvme_write_readback_proof offset size fill_va))
                              (= reply_val (call nvme_write_one_block offset size fill_va))))))
                      (block
                        (call sexos_line "[sexdrive.block.typed] cmd=%llu ERR_NO_DEVICE honest=write_not_implemented_guard_only"
                          (cast (unsigned long long) cmd))
                        (= reply_val BLOCK_ERR_NO_DEVICE))))
                  (if (== cmd BLOCK_SYNC)
                    (block
                      (if SEXOS_SEXDRIVE_CURRENT_DURABILITY
                        (block
                          (= reply_val (call nvme_flush))
                          (call sexos_line "[sexdrive.sync.result] status=%llu actual_nvme_flush=1"
                            (cast (unsigned long long) reply_val)))
                        (block
                          (call sexos_line "[sexdrive.sync.recv] cmd=%llu honest=flush_not_emulated_by_qemu_nvme"
                            (cast (unsigned long long) cmd))
                          (= reply_val BLOCK_ERR_NO_DEVICE))))
                    (block
                      (call sexos_line "[sexdrive.block.typed] cmd=%llu ERR_BAD_CMD unknown"
                        (cast (unsigned long long) cmd))
                      (= reply_val BLOCK_ERR_BAD_CMD)))))

              (if (call hot_log)
                (call sexos_line "[sexblock.abi.reply.encode] caller=%u status=%llu"
                  (cast unsigned (. msg caller_pd)) (cast (unsigned long long) reply_val)))
              (cast void (call sexos_reply (. msg caller_pd) reply_val))
              (if (call hot_log)
                (call sexos_line "[sexdrive.block.typed.reply] cmd=%llu caller=%u status=%llu"
                  (cast (unsigned long long) cmd) (cast unsigned (. msg caller_pd))
                  (cast (unsigned long long) reply_val)))
              (if (|| (== cmd BLOCK_READ) (== cmd BLOCK_WRITE))
                (block
                  (if (== reply_val 0ULL)
                    (block
                      (if (call hot_log)
                        (call sexos_line "[sexdrive.block.nvme.cqe] op=%s cid=%llu status=0"
                          op (cast (unsigned long long) submit_cid_snapshot)))
                      (if (call hot_log)
                        (call sexos_line "[sexdrive.block.reply] op=%s status=0 bytes=%llu ready=1"
                          op (cast (unsigned long long) size))))
                    (if (== reply_val BLOCK_ERR_NO_DEVICE)
                      (block
                        (if (call hot_log)
                          (call sexos_line "[sexdrive.block.nvme.cqe.timeout] op=%s cid=%llu polls=%llu"
                            op (cast (unsigned long long) submit_cid_snapshot) 0ULL))
                        (var (const char) (* reason) (?: (== ready_snapshot 0ULL) "no_ioq_ready" "no_device_other"))
                        (if (call hot_log)
                          (call sexos_line "[sexdrive.block.reply] op=%s status=4 reason=%s ready=%llu"
                            op reason (cast (unsigned long long) ready_snapshot))))
                      (if (call hot_log)
                        (call sexos_line "[sexdrive.block.reply] op=%s status=%llu reason=other ready=%llu"
                          op (cast (unsigned long long) reply_val)
                          (cast (unsigned long long) ready_snapshot)))))))))

              (if SEXOS_CURRENT_REGION_WRITER
                (if (! (. (. sexdrive_state nvme_io_state) ready))
                  (if (|| (. sexdrive_state reset_recovery_pending)
                      (|| (call dma_lease_is_quarantined (& (. sexdrive_state read_lease)))
                          (call dma_lease_is_quarantined (& (. sexdrive_state write_lease)))))
                    (block
                      (= (. sexdrive_state reset_recovery_pending) true)
                      (if (call nvme_recovery_maybe_start)
                        (call dma_probe_finish_recovery))))))

          (+= frame 1u)
          (var uint32_t (* ptr) (cast (uint32_t *) (cast uintptr_t shared_addr)))
          (for (var size_t y 0) (< y 768) (++ y)
            (for (var size_t x 0) (< x 1024) (++ x)
              (block
                (var uint32_t color (+ (^ (cast uint32_t x) (cast uint32_t y)) frame))
                (= ([] ptr (+ (* y 1024) x)) color))))

          (for (var uint32_t _spin 0) (< _spin 2000000u) (++ _spin)
            (call sexos_spin_loop_hint))))))
)
