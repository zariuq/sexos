              (call sexos_line "[sexdrive.nvme.io.read.err] reason=status_fail cid=%llu sc=%llu sct=%llu sqhd=%llu sqid=%llu dw3=%#llx"
                (cast (unsigned long long) read_cid) (cast (unsigned long long) rd_sc)
                (cast (unsigned long long) rd_sct) (cast (unsigned long long) rd_sqhd)
                (cast (unsigned long long) rd_sqid) (cast (unsigned long long) rd_dw3))
