    (fn (static bool) dma_lease_generation_compatible
      (((const DmaLease) (* lease)) ((const DmaDeviceEpoch) (* device)))
      (return (&& (!= lease NULL) (&& (!= device NULL)
        (&& (== (-> device phase) DMA_DEVICE_QUIESCENT)
          (&& (< (-> device generation) UINT64_MAX)
            (&& (== (-> lease device_id) (-> device device_id))
              (&& (== (-> lease generation) (-> device generation))
                (|| (== (-> lease phase) DMA_AVAILABLE)
                    (== (-> lease phase) DMA_QUARANTINED))))))))))

    (fn (static DmaLeaseStatus) dma_lease_advance_generation
      ((DmaLease (* lease)) ((const DmaDeviceEpoch) (* device)))
      (if (== (-> lease phase) DMA_QUARANTINED)
        (return (call dma_lease_retire_quarantined lease device)))
      (return (call dma_lease_rebind_available lease device)))

    (fn (static bool) nvme_recover_controller ((bool data_submission))
      (if (! SEXOS_CURRENT_REGION_WRITER) (return false))
      (if (|| (. (. sexdrive_state nvme_io_state) ready)
              (>= (. sexdrive_state reset_count) DMA_RESET_LIMIT)) (return false))
      (if (&& data_submission
              (&& (! (call dma_lease_is_quarantined (& (. sexdrive_state read_lease))))
                  (! (call dma_lease_is_quarantined (& (. sexdrive_state write_lease))))))
        (return false))
      (var uint64_t map_va (. (. sexdrive_state nvme_io_state) map_va))
      (if (|| (== map_va 0ULL) (== map_va UINT64_MAX)) (return false))
      (var uint64_t generation (. (. sexdrive_state dma_device) generation))
      (if (== (. (. sexdrive_state dma_device) phase) DMA_DEVICE_ACTIVE)
        (block
          (var DeviceResetReceipt kernel_begin
            (call sexos_device_reset SLOT_NVME_HOST DEVICE_RESET_BEGIN generation false))
          (if (&& (== (. kernel_begin status) DEVICE_RESET_INTERRUPTED)
                  (&& (== (. kernel_begin generation) generation)
                      (== (. kernel_begin phase) DEVICE_RESET_ACTIVE)))
            (block
              (= (. sexdrive_state reset_recovery_pending) true)
              (call sexos_line "[sexdrive.dma.reset.deferred] reason=interrupt_receipt generation=%llu"
                (cast (unsigned long long) generation))
              (return false)))
          (if (|| (!= (. kernel_begin status) DEVICE_RESET_OK)
                  (|| (!= (. kernel_begin generation) generation)
                      (!= (. kernel_begin phase) DEVICE_RESET_RESETTING)))
            (block
              (call sexos_line "[sexdrive.dma.reset.failed] reason=kernel_begin status=%llu generation=%llu phase=%llu"
                (cast (unsigned long long) (. kernel_begin status))
                (cast (unsigned long long) (. kernel_begin generation))
                (cast (unsigned long long) (. kernel_begin phase)))
              (return false)))
          (if (!= (call dma_device_reset_begin (& (. sexdrive_state dma_device))) DMA_LEASE_OK)
            (call sexos_fail)))
        (if (!= (. (. sexdrive_state dma_device) phase) DMA_DEVICE_RESETTING)
          (return false)))
      (var uint64_t cap (call sexos_volatile_read64
        (cast ((const uint64_t) *) (cast uintptr_t (+ map_va 0x0000ULL)))))
      (var uint32_t cap_to (cast uint32_t (& (>> cap 24) 0xFFULL)))
      (var uint32_t cc_old (call sexos_volatile_read32
        (cast ((const uint32_t) *) (cast uintptr_t (+ map_va 0x0014ULL)))))
      (var uint32_t cc_disabled (& cc_old (~ 1u)))
