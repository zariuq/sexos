          (if (! read_done)
            (block
              (call sexos_line "[sexdrive.nvme.io.read.err] reason=cqe_timeout cid=%llu head=%llu phase=%llu"
                (cast (unsigned long long) read_cid) (cast (unsigned long long) io_cq_head)
                (cast (unsigned long long) io_cq_phase))
