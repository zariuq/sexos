              (var uint32_t dw0 (call sexos_volatile_read32 (+ cqe_ptr 0)))
              (var uint32_t dw1 (call sexos_volatile_read32 (+ cqe_ptr 1)))
              (var uint32_t dw2 (call sexos_volatile_read32 (+ cqe_ptr 2)))
              (var uint32_t dw3 (call sexos_volatile_read32 (+ cqe_ptr 3)))
