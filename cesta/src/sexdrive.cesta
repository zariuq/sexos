    (fn (static void) xhci_probe_mmio (void)
      (var uint64_t map_va (call sexos_map_pci_bar SLOT_USB_HOST 0ULL 0x1000ULL))
      (if (|| (== map_va UINT64_MAX) (== map_va 0ULL))
        (block
          (call sexos_line "[sexdrive] XHCI probe: no BAR lease/mapping available")
          (return)))

      (var (const uint32_t) (* regs) (cast ((const uint32_t) *) (cast uintptr_t map_va)))
      (var uint32_t cap0 (call sexos_volatile_read32 (+ regs 0)))
      (var uint8_t caplength (cast uint8_t (& cap0 0xFFu)))
      (var uint16_t hciversion (cast uint16_t (& (>> cap0 16) 0xFFFFu)))
      (var uint32_t hcsp1 (call sexos_volatile_read32 (+ regs 1)))
      (var uint32_t hcc1 (call sexos_volatile_read32 (+ regs 4)))

      (call sexos_line "[sexdrive] XHCI MMIO probe ok va=%#llx caplength=%#llx hciversion=%#llx hcsp1=%#llx hcc1=%#llx"
        (cast (unsigned long long) map_va) (cast (unsigned long long) caplength)
        (cast (unsigned long long) hciversion) (cast (unsigned long long) hcsp1)
        (cast (unsigned long long) hcc1)))

    (fn void sexdrive_main (void)
      (call sexdrive_state_init (& sexdrive_state))
      (call sexos_line "[sexdrive.init.start]")
      (call nvme_probe_bar)
      (call xhci_probe_mmio)

      (for (var uint32_t _spin 0) (< _spin 10000000u) (++ _spin)
        (call sexos_spin_loop_hint))

      (var uint64_t fb_size (* (* 1024ULL 768ULL) 4ULL))
      (var uint64_t shared_addr (call sexos_alloc_shared_buffer fb_size 1ULL))
      (if (== shared_addr 0ULL)
        (while 1
          (call sexos_spin_loop_hint)))

      (cast void (call sexos_pdx_call SLOT_SHELL OP_SHELL_BIND_BUFFER shared_addr 0ULL 0ULL))

      (var uint32_t frame 0u)
      (if (call hot_log)
        (call sexos_line "[sexdrive.ready]"))
      (while 1
        (block
          (var SexosMessage msg (init 0))
          (if (call sexos_try_listen 0ULL (& msg))
            (block
              (var uint64_t cmd (. msg type_id))
              (var uint64_t offset (. msg arg0))
              (var uint64_t size (. msg arg1))
              (var uint64_t _buf_cap (. msg arg2))
              (var uint64_t ready_snapshot (?: (. (. sexdrive_state nvme_io_state) ready) 1ULL 0ULL))
              (var (const char) (* op)
                (?: (== cmd BLOCK_READ) "READ"
                  (?: (== cmd BLOCK_WRITE) "WRITE" "OTHER")))
              (var uint64_t lba (?: (!= BLOCK_SECTOR_SIZE 0ULL) (/ offset BLOCK_SECTOR_SIZE) 0ULL))
              (var uint64_t submit_cid_snapshot (cast uint64_t (. (. sexdrive_state nvme_io_state) next_cid)))
              (var uint64_t submit_tail_snapshot (cast uint64_t (. (. sexdrive_state nvme_io_state) sq_tail)))

              (if (call hot_log)
                (call sexos_line "[sexdrive.block.typed.recv] cmd=%llu offset=%#llx size=%llu buf_cap=%#llx caller=%u"
                  (cast (unsigned long long) cmd) (cast (unsigned long long) offset)
                  (cast (unsigned long long) size) (cast (unsigned long long) _buf_cap)
                  (cast unsigned (. msg caller_pd))))
              (if (|| (== cmd BLOCK_READ) (== cmd BLOCK_WRITE))
                (if (call hot_log)
                  (call sexos_line "[sexdrive.block.req] op=%s ready=%llu lba=%llu bytes=%llu buffer_cap=%#llx device_cap=%#llx"
                    op (cast (unsigned long long) ready_snapshot) (cast (unsigned long long) lba)
                    (cast (unsigned long long) size) (cast (unsigned long long) _buf_cap)
                    (cast (unsigned long long) SLOT_NVME_HOST))))

              (var uint64_t reply_val 0ULL)
              (if (== cmd BLOCK_READ)
                (block
                  (if (call hot_log)
                    (call sexos_line "[sexdrive.block.read.api.recv] offset=%#llx size=%llu buf_cap=%#llx"
                      (cast (unsigned long long) offset) (cast (unsigned long long) size)
                      (cast (unsigned long long) _buf_cap)))
                  (if (call hot_log)
                    (call sexos_line "[sexdrive.block.read.handoff.begin] offset=%#llx size=%llu buf_cap=%#llx"
                      (cast (unsigned long long) offset) (cast (unsigned long long) size)
                      (cast (unsigned long long) _buf_cap)))
                  (if (|| (== size 0ULL) (> size BLOCK_MAX_XFER))
                    (block
                      (call sexos_line "[sexdrive.block.read.api.err] reason=bad_len size=%llu max=%llu"
                        (cast (unsigned long long) size) (cast (unsigned long long) BLOCK_MAX_XFER))
                      (call sexos_line "[sexdrive.block.read.handoff.err] reason=bad_len size=%llu"
                        (cast (unsigned long long) size))
                      (= reply_val BLOCK_ERR_BAD_LEN))
                    (if (!= (% offset BLOCK_SECTOR_SIZE) 0ULL)
                      (block
                        (call sexos_line "[sexdrive.block.read.api.err] reason=unaligned_offset offset=%#llx sector=%llu"
                          (cast (unsigned long long) offset) (cast (unsigned long long) BLOCK_SECTOR_SIZE))
                        (call sexos_line "[sexdrive.block.read.handoff.err] reason=unaligned_offset offset=%#llx"
                          (cast (unsigned long long) offset))
                        (= reply_val BLOCK_ERR_BAD_LEN))
                      (if (== _buf_cap SLOT_BUF_LEND)
                        (if (!= size 512ULL)
                          (block
                            (call sexos_line "[sexdrive.block.read.handoff.err] reason=bad_len_phase_b size=%llu expect=512"
                              (cast (unsigned long long) size))
                            (= reply_val BLOCK_ERR_BAD_LEN))
                          (block
                            (var uint64_t fill_va (call sexos_map_mem_lend SLOT_BUF_LEND))
                            (if (|| (== fill_va 0ULL) (== fill_va UINT64_MAX))
                              (block
                                (call sexos_line "[sexdrive.block.read.handoff.err] reason=map_failed va=%#llx"
                                  (cast (unsigned long long) fill_va))
                                (if (call hot_log)
                                  (call sexos_line "[sexdrive.nvme.cmd.shape.err] path=typed reason=memlend_map_failed buffer_cap=%#llx"
                                    (cast (unsigned long long) SLOT_BUF_LEND)))
                                (= reply_val BLOCK_ERR_NO_DEVICE))
                              (block
                                (if (call hot_log)
                                  (call sexos_line "[sexdrive.bufcap.map.ok] fill_va=%#llx"
                                    (cast (unsigned long long) fill_va)))
                                (if (call hot_log)
                                  (call sexos_line "[sexdrive.block.nvme.submit] op=%s lba=%llu bytes=%llu cid=%llu tail=%llu ready=%llu"
                                    op (cast (unsigned long long) lba) (cast (unsigned long long) size)
                                    (cast (unsigned long long) submit_cid_snapshot)
                                    (cast (unsigned long long) submit_tail_snapshot)
                                    (cast (unsigned long long) ready_snapshot)))
                                (= reply_val (call nvme_read_into_mapped_va offset size fill_va))))))
                        (block
                          (call sexos_line "[sexdrive.block.read.api.validate.ok] offset=%#llx size=%llu lba_bytes=%llu"
                            (cast (unsigned long long) offset) (cast (unsigned long long) size)
                            (cast (unsigned long long) NVME_LBA_BYTES))
                          (if (== _buf_cap 0ULL)
                            (call sexos_line "[sexdrive.block.read.handoff.err] reason=buffer_cap_not_real buf_cap=%#llx"
                              (cast (unsigned long long) _buf_cap))
                            (call sexos_line "[sexdrive.block.read.handoff.err] reason=buffer_cap_unverifiable buf_cap=%#llx"
                              (cast (unsigned long long) _buf_cap)))
                          (if (call hot_log)
                            (call sexos_line "[sexdrive.block.nvme.submit] op=%s lba=%llu bytes=%llu cid=%llu tail=%llu ready=%llu"
                              op (cast (unsigned long long) lba) (cast (unsigned long long) size)
                              (cast (unsigned long long) submit_cid_snapshot)
                              (cast (unsigned long long) submit_tail_snapshot)
                              (cast (unsigned long long) ready_snapshot)))
                          (= reply_val (call nvme_read_into_bounce offset size)))))))
                (if (== cmd BLOCK_WRITE)
                  (block
                    (if (call hot_log)
                      (call sexos_line "[sexdrive.block.write.api.recv] offset=%#llx size=%llu buf_cap=%#llx"
                        (cast (unsigned long long) offset) (cast (unsigned long long) size)
                        (cast (unsigned long long) _buf_cap)))
                    (if (call write_guard_allows offset size _buf_cap)
                      (block
                        (var uint64_t fill_va (call sexos_map_mem_lend SLOT_BUF_LEND))
                        (if (|| (== fill_va 0ULL) (== fill_va UINT64_MAX))
                          (block
                            (call sexos_line "[sexdrive.nvme.write.err] reason=map_failed va=%#llx"
                              (cast (unsigned long long) fill_va))
                            (if (call hot_log)
                              (call sexos_line "[sexdrive.nvme.cmd.shape.err] path=typed reason=memlend_map_failed buffer_cap=%#llx"
                                (cast (unsigned long long) SLOT_BUF_LEND)))
                            (= reply_val BLOCK_ERR_NO_DEVICE))
                          (block
                            (if (call hot_log)
                              (call sexos_line "[sexdrive.bufcap.map.ok] fill_va=%#llx"
                                (cast (unsigned long long) fill_va)))
                            (if (call hot_log)
                              (call sexos_line "[sexdrive.block.nvme.submit] op=%s lba=%llu bytes=%llu cid=%llu tail=%llu ready=%llu"
                                op (cast (unsigned long long) lba) (cast (unsigned long long) size)
                                (cast (unsigned long long) submit_cid_snapshot)
                                (cast (unsigned long long) submit_tail_snapshot)
                                (cast (unsigned long long) ready_snapshot)))
                            (var uint64_t proof_offset (* WRITE_PROOF_LBA NVME_LBA_BYTES))
                            (if (== offset proof_offset)
                              (= reply_val (call nvme_write_readback_proof offset size fill_va))
                              (= reply_val (call nvme_write_one_block offset size fill_va))))))
                      (block
                        (call sexos_line "[sexdrive.block.typed] cmd=%llu ERR_NO_DEVICE honest=write_not_implemented_guard_only"
                          (cast (unsigned long long) cmd))
                        (= reply_val BLOCK_ERR_NO_DEVICE))))
                  (if (== cmd BLOCK_SYNC)
                    (block
                      (call sexos_line "[sexdrive.sync.recv] cmd=%llu honest=flush_not_emulated_by_qemu_nvme"
                        (cast (unsigned long long) cmd))
                      (= reply_val BLOCK_ERR_NO_DEVICE))
                    (block
                      (call sexos_line "[sexdrive.block.typed] cmd=%llu ERR_BAD_CMD unknown"
                        (cast (unsigned long long) cmd))
                      (= reply_val BLOCK_ERR_BAD_CMD)))))

              (if (call hot_log)
                (call sexos_line "[sexblock.abi.reply.encode] caller=%u status=%llu"
                  (cast unsigned (. msg caller_pd)) (cast (unsigned long long) reply_val)))
              (cast void (call sexos_reply (. msg caller_pd) reply_val))
              (if (call hot_log)
                (call sexos_line "[sexdrive.block.typed.reply] cmd=%llu caller=%u status=%llu"
                  (cast (unsigned long long) cmd) (cast unsigned (. msg caller_pd))
                  (cast (unsigned long long) reply_val)))
              (if (|| (== cmd BLOCK_READ) (== cmd BLOCK_WRITE))
                (block
                  (if (== reply_val 0ULL)
                    (block
                      (if (call hot_log)
                        (call sexos_line "[sexdrive.block.nvme.cqe] op=%s cid=%llu status=0"
                          op (cast (unsigned long long) submit_cid_snapshot)))
                      (if (call hot_log)
                        (call sexos_line "[sexdrive.block.reply] op=%s status=0 bytes=%llu ready=1"
                          op (cast (unsigned long long) size))))
                    (if (== reply_val BLOCK_ERR_NO_DEVICE)
                      (block
                        (if (call hot_log)
                          (call sexos_line "[sexdrive.block.nvme.cqe.timeout] op=%s cid=%llu polls=%llu"
                            op (cast (unsigned long long) submit_cid_snapshot) 0ULL))
                        (var (const char) (* reason) (?: (== ready_snapshot 0ULL) "no_ioq_ready" "no_device_other"))
                        (if (call hot_log)
                          (call sexos_line "[sexdrive.block.reply] op=%s status=4 reason=%s ready=%llu"
                            op reason (cast (unsigned long long) ready_snapshot))))
                      (if (call hot_log)
                        (call sexos_line "[sexdrive.block.reply] op=%s status=%llu reason=other ready=%llu"
                          op (cast (unsigned long long) reply_val)
                          (cast (unsigned long long) ready_snapshot)))))))))

          (+= frame 1u)
          (var uint32_t (* ptr) (cast (uint32_t *) (cast uintptr_t shared_addr)))
          (for (var size_t y 0) (< y 768) (++ y)
            (for (var size_t x 0) (< x 1024) (++ x)
              (block
                (var uint32_t color (+ (^ (cast uint32_t x) (cast uint32_t y)) frame))
                (= ([] ptr (+ (* y 1024) x)) color))))

          (for (var uint32_t _spin 0) (< _spin 2000000u) (++ _spin)
            (call sexos_spin_loop_hint))))))
)
