(cesta native-c/1 compact-c/2 (unit (ownership (check-all)
(record ShellTextSinkContext (field proofs_a (borrow write)) (field chrome (borrow read)))
(function diagnostic_label (returns-borrow 0 bytes))
(foreign sexos_line (variadic-read) (obligation "Prints the declared bounded arguments synchronously, with no retained borrow."))
(foreign sexos_fail (obligation "Stops the malformed native input path."))
(foreign shell_diagnostics_pdx_call (obligation "Invokes the caller's immutable BOOT slot using register-only arguments, returning the actual admission status and retaining no pointer."))
) (native "#include \"silk_shell_diagnostics_a.h\"\nbool shell_diagnostics_is_spindle_text_key(uint8_t sc)\n{\n    return sc==0x1c || sc==0x0e || sc==1 || sc==0x0f || sc==0x39 || (sc>=2 && sc<=0x0b) || (sc>=0x10 && sc<=0x19) || (sc>=0x1e && sc<=0x26) || (sc>=0x2c && sc<=0x32) || sc==0x0c || sc==0x0d || sc==0x1a || sc==0x1b || sc==0x27 || sc==0x28 || sc==0x2b || (sc>=0x33 && sc<=0x35) || sc==0x48 || sc==0x50 || sc==0x4d || sc==0x4b || sc==0x47 || sc==0x4f || sc==0x49 || sc==0x51;\n}\nbool shell_diagnostics_is_quil_text_key(uint8_t sc)\n{\n    return sc==0x1c || sc==0x0e || sc==1 || sc==0x39 || (sc>=2 && sc<=0x0b) || (sc>=0x10 && sc<=0x19) || (sc>=0x1e && sc<=0x26) || (sc>=0x2c && sc<=0x32) || sc==0x48 || sc==0x50 || sc==0x4b || sc==0x4d || sc==0x47 || sc==0x4f;\n}\nstatic const char *diagnostic_label(const ShellDiagnosticLabel *label)\n{\n    if(label->len>=sizeof(label->bytes) || label->bytes[label->len])sexos_fail();\n    return label->bytes;\n}\nbool shell_diagnostics_send_silkbar_phase2_update(uint32_t kind,uint64_t a,uint64_t b)\n{\n    if(!SILKBAR_PHASE2_SHELL_PROOF_ENABLED)return false;\n    SexosReply result=shell_diagnostics_pdx_call(SLOT_DISPLAY,OP_SILKBAR_UPDATE,kind,a,b);\n    const char *name=kind==8?\"SetActiveApp\":kind==9?\"SetTintAccent\":kind==10?\"SetPaletteState\":\"Unknown\";\n    bool admitted=!result.status;\n    sexos_line(\"[shell.silkbar.phase2.send] kind=%s a=%llu b=%llu ok=%u reason=%s\",name,(unsigned long long)a,(unsigned long long)b,(unsigned)admitted,admitted?\"sent\":\"enqueue_fail\");\n    return admitted;\n}\nvoid shell_diagnostics_bell_send_app_event(const ShellDiagnosticLabel *source,uint64_t event)\n{\n    SexosReply result=shell_diagnostics_pdx_call(SLOT_BELL,OP_BELL_NOTIFY,0x100,event&255,0);\n    sexos_line(\"[bell.app.event] source=%s event_id=%llu ok=%u reason=%s\",diagnostic_label(source),(unsigned long long)event,(unsigned)!result.status,result.status?\"enqueue_fail\":\"fire_and_forget\");\n}\n#define DRAW_BODY(bytes,length,capacity) \\\n    size_t limit=(length)<(capacity)?(length):(capacity),offset=0;bool admitted=true; \\\n    while(offset<limit){size_t chunk=limit-offset;if(chunk>8)chunk=8;uint64_t packed=0; \\\n        for(size_t i=0;i<chunk;++i)packed|=(uint64_t)(bytes)[offset+i]<<(i*8); \\\n        uint64_t control=(offset&255)|((uint64_t)chunk<<8)|(((uint64_t)(offset>>8)&15)<<12)|(color<<32); \\\n        SexosReply reply=shell_diagnostics_pdx_call(SLOT_DISPLAY,0xfb,surface,packed,control); \\\n        if(reply.status){admitted=false;}offset+=chunk;} \\\n    return(ShellDiagnosticDraw){offset,offset>0 && admitted};\nShellDiagnosticDraw shell_diagnostics_shell_draw_text(uint64_t surface,const ShellTextBytes *text,uint64_t color)\n{\n    DRAW_BODY(text->bytes,text->len,SHELL_TEXT_CAPACITY)\n}\nstatic ShellDiagnosticDraw diagnostic_draw_sink(uint64_t surface,const ShellSinkBytes *text,size_t len,uint64_t color)\n{\n    DRAW_BODY((*text),len,SILK_TEXT_SINK_CAP)\n}\nbool shell_diagnostics_sink_scancode_to_char(uint8_t scan,uint8_t *out)\n{\n    static const uint8_t map[58]={\n        [0x10]='Q',[0x11]='W',[0x12]='E',[0x14]='T',[0x15]='Y',[0x16]='U',[0x17]='I',[0x18]='O',[0x19]='P',\n        [0x1e]='A',[0x1f]='S',[0x20]='D',[0x21]='F',[0x22]='G',[0x23]='H',[0x2c]='Z',[0x2d]='X',[0x2f]='V',[0x30]='B',[0x31]='N',\n        [0x07]='6',[0x08]='7',[0x09]='8',[0x0a]='9',[0x0b]='0',[0x39]=' '};\n    if(scan>=sizeof(map) || !map[scan])return false;\n    *out=map[scan];return true;\n}\nbool shell_diagnostics_silk_text_sink_redraw(ShellTextSinkContext *ctx)\n{\n    size_t len=ctx->proofs_a->SILK_TEXT_LEN;if(len>SILK_TEXT_SINK_CAP)return false;\n    SexosReply clear=shell_diagnostics_pdx_call(SLOT_DISPLAY,OP_TEXT_CLEAR,SILK_TEXT_SINK_SID,0,0);\n    if(!len){sexos_line(\"[silk.text.draw] surface=%llu len=0 ok=%u\",(unsigned long long)SILK_TEXT_SINK_SID,(unsigned)!clear.status);return !clear.status;}\n    ShellDiagnosticDraw result={0};\n    {const SilkShellProofsAState *view=ctx->proofs_a;result=diagnostic_draw_sink(SILK_TEXT_SINK_SID,&view->SILK_TEXT_BUF,len,0x00e8ffff);}\n    bool admitted=result.admitted && !clear.status;\n    sexos_line(\"[silk.text.draw] surface=%llu len=%zu ok=%u\",(unsigned long long)SILK_TEXT_SINK_SID,result.attempted,(unsigned)admitted);return admitted;\n}\nbool shell_diagnostics_silk_text_sink_key(ShellTextSinkContext *ctx,uint8_t scan,uint64_t value)\n{\n    if(ctx->chrome->FOCUSED_SURFACE_ID!=SILK_TEXT_SINK_SID || !ctx->chrome->SURFACE_100_ALIVE)return false;\n    size_t len=ctx->proofs_a->SILK_TEXT_LEN;if(len>SILK_TEXT_SINK_CAP)return false;\n    uint8_t ch=0;bool printable=shell_diagnostics_sink_scancode_to_char(scan,&ch);\n    if(!printable && scan!=0x0e)return false;\n    if(value!=1)return true;\n    if(ctx->proofs_a->silk_text_sink_key__SILK_KEY_ROUTE_BUDGET){--ctx->proofs_a->silk_text_sink_key__SILK_KEY_ROUTE_BUDGET;sexos_line(\"[silk.key.route] surface=%llu code=%u printable=%u\",(unsigned long long)SILK_TEXT_SINK_SID,(unsigned)scan,(unsigned)printable);}\n    if(scan==0x0e){if(len){ctx->proofs_a->SILK_TEXT_LEN=len-1;sexos_line(\"[silk.text.backspace] surface=%llu len=%zu\",(unsigned long long)SILK_TEXT_SINK_SID,len-1);(void)shell_diagnostics_silk_text_sink_redraw(ctx);}return true;}\n    if(printable && len<SILK_TEXT_SINK_CAP){\n        ctx->proofs_a->SILK_TEXT_BUF[len]=ch;ctx->proofs_a->SILK_TEXT_LEN=len+1;\n        const char chars[2]={(char)ch,0};sexos_line(\"[silk.text.append] surface=%llu len=%zu ch=%s\",(unsigned long long)SILK_TEXT_SINK_SID,len+1,chars);\n        bool ok=shell_diagnostics_silk_text_sink_redraw(ctx);\n        if(ok && !ctx->proofs_a->SILK_TEXT_PROOF_DONE_EMITTED){ctx->proofs_a->SILK_TEXT_PROOF_DONE_EMITTED=true;sexos_line(\"[silk.text.input.proof.done] ok=1\");}\n    }\n    return true;\n}\n\nvoid shell_diagnostics_input_negative_begin_once(SilkShellProofsAState *state)\n{\n    if(!INPUT_NEGATIVE_PROOF_ENABLED || state->INPUT_NEGATIVE_BEGIN_EMITTED)return;\n    state->INPUT_NEGATIVE_BEGIN_EMITTED=true;sexos_line(\"[input.negative.once] ok=1 malformed_unavailable=1\");\n}\nvoid shell_diagnostics_input_negative_mark_done(SilkShellProofsAState *state)\n{\n    if(!INPUT_NEGATIVE_PROOF_ENABLED || state->INPUT_NEGATIVE_DONE_EMITTED)return;\n    if(state->INPUT_NEGATIVE_UNKNOWN_CLASS_SEEN && state->INPUT_NEGATIVE_BAD_BUTTON_SEEN && state->INPUT_NEGATIVE_BUTTON_UP_NO_CAPTURE_SEEN){\n        state->INPUT_NEGATIVE_DONE_EMITTED=true;\n        sexos_line(\"[input.negative.done] ok=1 unknown_class=1 bad_button=1 no_focus_key_reuse=1 dead_target_reuse=1 button_up_no_capture=1 malformed_unavailable=1\");\n    }\n}\nvoid shell_diagnostics_surface_input_lifetime_begin_once(SilkShellProofsAState *state)\n{\n    if(!SURFACE_ID_LIFETIME_INPUT_SAFETY_PROOF_ENABLED || state->SURFACE_ID_LIFETIME_PROOF_BEGIN_EMITTED)return;\n    state->SURFACE_ID_LIFETIME_PROOF_BEGIN_EMITTED=true;sexos_line(\"[surface.input_lifetime.begin] ok=1\");\n}\nvoid shell_diagnostics_surface_input_lifetime_mark_focus_live(SilkShellProofsAState *state,uint64_t focused,uint8_t live,uint8_t ok)\n{\n    if(!SURFACE_ID_LIFETIME_INPUT_SAFETY_PROOF_ENABLED)return;\n    if(live==1 && ok==1)state->SURFACE_ID_LIFETIME_PROOF_FOCUS_LIVE_SEEN=true;\n    sexos_line(\"[surface.input_lifetime.focus_live] focused=%llu live=%u ok=%u\",(unsigned long long)focused,(unsigned)live,(unsigned)ok);\n}\nvoid shell_diagnostics_surface_input_lifetime_mark_key_route(SilkShellProofsAState *state,uint64_t target,uint8_t live,uint8_t routed,uint8_t ok)\n{\n    if(!SURFACE_ID_LIFETIME_INPUT_SAFETY_PROOF_ENABLED)return;\n    if(live==1 && ok==1)state->SURFACE_ID_LIFETIME_PROOF_KEY_ROUTE_SEEN=true;\n    sexos_line(\"[surface.input_lifetime.key_route_guard] target=%llu live=%u routed=%u ok=%u\",(unsigned long long)target,(unsigned)live,(unsigned)routed,(unsigned)ok);\n}\nvoid shell_diagnostics_surface_input_lifetime_mark_click_target(SilkShellProofsAState *state,uint64_t target,uint8_t live,uint8_t committed,uint8_t ok)\n{\n    if(!SURFACE_ID_LIFETIME_INPUT_SAFETY_PROOF_ENABLED)return;\n    if(live==1 && ok==1)state->SURFACE_ID_LIFETIME_PROOF_CLICK_TARGET_SEEN=true;\n    sexos_line(\"[surface.input_lifetime.click_target_guard] target=%llu live=%u committed=%u ok=%u\",(unsigned long long)target,(unsigned)live,(unsigned)committed,(unsigned)ok);\n}\nvoid shell_diagnostics_surface_input_lifetime_mark_drag_target(SilkShellProofsAState *state,uint64_t target,uint8_t live,const ShellDiagnosticLabel *phase,uint8_t ok)\n{\n    if(!SURFACE_ID_LIFETIME_INPUT_SAFETY_PROOF_ENABLED)return;\n    if(live==1 && ok==1)state->SURFACE_ID_LIFETIME_PROOF_DRAG_TARGET_SEEN=true;\n    sexos_line(\"[surface.input_lifetime.drag_target_guard] target=%llu live=%u phase=%s ok=%u\",(unsigned long long)target,(unsigned)live,diagnostic_label(phase),(unsigned)ok);\n}\nvoid shell_diagnostics_surface_input_lifetime_mark_dead_clear(SilkShellProofsAState *state,uint64_t target)\n{\n    if(!SURFACE_ID_LIFETIME_INPUT_SAFETY_PROOF_ENABLED)return;\n    state->SURFACE_ID_LIFETIME_PROOF_DEAD_CLEAR_SEEN=true;sexos_line(\"[surface.input_lifetime.dead_clear] target=%llu cleared=1 ok=1\",(unsigned long long)target);\n}\nvoid shell_diagnostics_surface_input_lifetime_try_done(SilkShellProofsAState *state)\n{\n    if(!SURFACE_ID_LIFETIME_INPUT_SAFETY_PROOF_ENABLED)return;\n    if(state->SURFACE_ID_LIFETIME_PROOF_FOCUS_LIVE_SEEN && state->SURFACE_ID_LIFETIME_PROOF_KEY_ROUTE_SEEN && state->SURFACE_ID_LIFETIME_PROOF_CLICK_TARGET_SEEN && state->SURFACE_ID_LIFETIME_PROOF_DRAG_TARGET_SEEN)\n        sexos_line(\"[surface.input_lifetime.done] ok=1 dead_clear=%u\",(unsigned)state->SURFACE_ID_LIFETIME_PROOF_DEAD_CLEAR_SEEN);\n}\nvoid shell_diagnostics_shell_interaction_contract_begin_once(SilkShellProofsAState *state)\n{\n    if(!SHELL_INTERACTION_CONTRACT_PROOF_ENABLED || state->SHELL_INTERACTION_CONTRACT_BEGIN_EMITTED)return;\n    state->SHELL_INTERACTION_CONTRACT_BEGIN_EMITTED=true;sexos_line(\"[shell.interact.contract.begin] mode=proof ok=1\");\n}\nvoid shell_diagnostics_click_drag_proof_begin_click_once(SilkShellProofsAState *state)\n{\n    if(!CLICK_DRAG_PROOF_ENABLED || state->CLICK_FOCUS_PROOF_BEGIN_EMITTED)return;\n    state->CLICK_FOCUS_PROOF_BEGIN_EMITTED=true;sexos_line(\"[click.focus.proof.begin] ok=1\");\n}\nvoid shell_diagnostics_click_drag_proof_begin_drag_once(SilkShellProofsAState *state)\n{\n    if(!CLICK_DRAG_PROOF_ENABLED || state->DRAG_PROOF_BEGIN_EMITTED)return;\n    state->DRAG_PROOF_BEGIN_EMITTED=true;sexos_line(\"[drag.proof.begin] ok=1\");\n}\nvoid shell_diagnostics_shell_interaction_contract_mark_stage(SilkShellProofsAState *state,uint8_t stage)\n{\n    if(!SHELL_INTERACTION_CONTRACT_PROOF_ENABLED)return;\n    state->SHELL_INTERACTION_CONTRACT_STAGE_MASK|=stage;\n}\nvoid shell_diagnostics_shell_interaction_contract_try_done(SilkShellProofsAState *state)\n{\n    if(!SHELL_INTERACTION_CONTRACT_PROOF_ENABLED || state->SHELL_INTERACTION_CONTRACT_DONE_EMITTED)return;\n    uint8_t required=SHELL_INTERACTION_STAGE_POINTER|SHELL_INTERACTION_STAGE_CLICK|SHELL_INTERACTION_STAGE_DRAG|SHELL_INTERACTION_STAGE_KEY;\n    if((state->SHELL_INTERACTION_CONTRACT_STAGE_MASK&required)==required){\n        state->SHELL_INTERACTION_CONTRACT_DONE_EMITTED=true;\n        sexos_line(\"[shell.interact.contract.done] pointer=1 click=1 drag=1 key=1 dead_guard=%u no_focus_key=%u ok=1\",(unsigned)((state->SHELL_INTERACTION_CONTRACT_STAGE_MASK&SHELL_INTERACTION_STAGE_DEAD_GUARD)!=0),(unsigned)((state->SHELL_INTERACTION_CONTRACT_STAGE_MASK&SHELL_INTERACTION_STAGE_NO_FOCUS_KEY)!=0));\n    }\n}\n")))
