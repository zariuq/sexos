        (block
          (= ([] (-> q name_buf) (-> q name_len)) ch)
          (+= (-> q name_len) 1)
          (call redraw q))))

    (comment "One key event, from the serving loop or a stash replay. Shift and Control track their press/release state. Current upstream control chords operate on the text document before ordinary palette/text dispatch.")
