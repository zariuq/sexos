                        (block
                          (if (< (-> q find_qlen) 31)
                            (block (= ([] (-> q find_query) (post++ (-> q find_qlen))) ch)
                              (= ([] (-> q find_query) (-> q find_qlen)) 0)))))))))))))
      (call redraw q)
      (return true))

    (comment "Keep a HID event for replay; false when the stash is full.")
    (fn (static bool) stash_hid ((Quil (* q)) (uint64_t code) (uint64_t value) (uint64_t mod))
      (if (>= (-> q hid_stash_count) HID_STASH_CAPACITY) (return false))
      (= ([] (-> q hid_stash) (-> q hid_stash_count)) (compound HidStashEntry (= (. code) code) (= (. value) value) (= (. mod) mod)))
      (+= (-> q hid_stash_count) 1)
      (return true))

    (comment "A synchronous storage call: pdx_call only enqueues (the kernel's AsyncEnqueue always succeeds) and the reply arrives as a listen of type 1. While waiting, HID events are stashed for replay and other messages skipped. 0 with the reply in *value, or the failing status or negative reply.")
    (fn (static int64_t) pdx_storage_call ((Quil (* q)) (uint64_t opcode) (uint64_t arg0) (uint64_t arg1) (uint64_t arg2) (uint64_t (* value)))
      (var SexosReply sent (call sexos_pdx_call SEXOS_SLOT_storage opcode arg0 arg1 arg2))
      (if (!= (. sent status) 0) (return (call wrap_i64 (. sent status))))
      (while 1
        (block
          (var SexosMessage msg)
          (cpp-if "SEXOS_QUIL_CURRENT_DOCUMENT"
            (then
              (cast void (call quil_current_step q))
              (var SexosRequest request (call sexos_rpc_listen_once 0))
              (= msg (. request message))
              (if (== (. msg type_id) 0) (block (call sexos_yield) continue)))
            (else (= msg (call sexos_listen (& (-> q listener)) 0))))
          (if (== (. msg type_id) 1)
            (block
              (if (call is_negative (. msg arg0)) (return (call wrap_i64 (. msg arg0))))
              (= (* value) (. msg arg0))
              (return 0)))
          (if (== (. msg type_id) OP_HID_EVENT)
            (block
              (var size_t idx (-> q hid_stash_count))
              (if (call stash_hid q (. msg arg0) (. msg arg1) (. msg arg2))
                (call sexos_line "[quil.hid.stash] idx=%zu code=%#llx down=%llu mod=%llu ok=1 reason=stashed" idx (cast (unsigned long long) (. msg arg0))
                  (cast (unsigned long long) (. msg arg1)) (cast (unsigned long long) (. msg arg2)))
                (call sexos_line "[quil.hid.stash.drop] code=%#llx reason=full" (cast (unsigned long long) (. msg arg0)))))
            (call sexos_line "[quil.sync.skip] type_id=%#llx" (cast (unsigned long long) (. msg type_id)))))))

    (comment "QUIL_PERSIST_V1: the persist path's call, bounded. A storage request lost under contention (seen while Linen's boot publish held SexFiles) must not hang the editor, so it polls without blocking: 300000 empty polls, each a yield, give -101. HID events are stashed unlogged.")
    (fn (static int64_t) pdx_storage_call_bounded ((Quil (* q)) (uint64_t opcode) (uint64_t arg0) (uint64_t arg1) (uint64_t arg2) (uint64_t (* value)))
      (var SexosReply sent (call sexos_pdx_call SEXOS_SLOT_storage opcode arg0 arg1 arg2))
      (if (!= (. sent status) 0) (return (call wrap_i64 (. sent status))))
      (var uint32_t polls 0)
      (while 1
        (block
          (var SexosMessage msg (init 0))
          (if (! (call sexos_try_listen 0 (& msg)))
            (block
              (+= polls 1)
              (if (>= polls 300000)
                (block
                  (call sexos_line "[quil.persist.reply.timeout] op=%#llx" (cast (unsigned long long) opcode))
                  (return (- 101))))
              continue))
          (if (== (. msg type_id) 1)
            (block
              (if (call is_negative (. msg arg0)) (return (call wrap_i64 (. msg arg0))))
              (= (* value) (. msg arg0))
              (return 0)))
          (if (== (. msg type_id) OP_HID_EVENT)
            (block
              (if (! (call stash_hid q (. msg arg0) (. msg arg1) (. msg arg2)))
                (call sexos_line "[quil.hid.stash.drop] code=%#llx reason=full" (cast (unsigned long long) (. msg arg0)))))
            (call sexos_line "[quil.sync.skip] type_id=%#llx" (cast (unsigned long long) (. msg type_id)))))))

    (fn (static uint64_t) v2_status ((uint64_t reply)) (return (& (>> reply 56) 0xFF)))
    (fn (static uint64_t) v2_len_field ((uint64_t reply)) (return (& (>> reply 48) 0xFF)))
    (fn (static uint8_t) v2_byte ((uint64_t reply) (size_t i)) (return (cast uint8_t (>> reply (* 8 i)))))

    (fn (static void) slot_proof_done_fail (void) (call sexos_line "[quil.diskfs.slot.min.done] ok=0"))

    (comment "V2 slot proof on path id 2 (/disk/quil-object-v1): select, stat, write 16 bytes, read them back through READ_V2 (6, 6 and 4 bytes) and compare.")
    (fn (static void) run_quil_diskfs_slot_min_proof ((Quil (* q)))
      (call sexos_line "[quil.diskfs.slot.min.begin]")
      (for (var unsigned i 0) (< i 64) (++ i) (call sexos_yield))
      (var uint64_t r 0)
      (var int64_t e (call pdx_storage_call q OP_DISKFS_SELECT QUIL_DISKFS_PATH_ID 0 0 (& r)))
      (if (!= e 0)
        (block
          (call sexos_line "[quil.diskfs.slot.min.select.err] err=%lld" (cast (long long) e))
          (call slot_proof_done_fail)
          (return)))
      (call sexos_line "[quil.diskfs.slot.min.select.ok] path_id=2")
      (= e (call pdx_storage_call q OP_DISKFS_STAT 0 0 0 (& r)))
      (if (!= e 0)
        (block
          (call sexos_line "[quil.diskfs.slot.min.stat.err] err=%lld" (cast (long long) e))
          (call slot_proof_done_fail)
          (return)))
      (call sexos_line "[quil.diskfs.slot.min.stat.ok] size=%llu flags=%#llx" (cast (unsigned long long) QUIL_DISKFS_EXPECT_SIZE) (cast (unsigned long long) QUIL_DISKFS_EXPECT_FLAGS))
      (comment "QUIL-SLOT-V1!!, a zero, then 0x02.")
      (var uint8_t ([] payload 16) "QUIL-SLOT-V1!!")
      (= ([] payload 15) 0x02)
      (var uint64_t lo 0)
      (var uint64_t hi 0)
      (for (var size_t i 0) (< i 8) (++ i)
        (block
          (|= lo (<< (cast uint64_t ([] payload i)) (* i 8)))
          (|= hi (<< (cast uint64_t ([] payload (+ i 8))) (* i 8)))))
      (= e (call pdx_storage_call q OP_DISKFS_WRITE 0 lo hi (& r)))
      (if (|| (!= e 0) (== r 0))
        (block
          (call sexos_line "[quil.diskfs.slot.min.write.err] err=%lld" (cast (long long) (?: (!= e 0) e 0)))
          (call slot_proof_done_fail)
          (return)))
      (call sexos_line "[quil.diskfs.slot.min.write.ok] size=16")
      (var uint8_t ([] readback 16) (init 0))
      (var size_t off 0)
      (while (< off 16)
        (block
          (var size_t want (call min_size (- 16 off) 6))
          (var uint64_t reply 0)
          (= e (call pdx_storage_call q OP_DISKFS_READ_V2 off want 0 (& reply)))
          (if (!= e 0)
            (block
              (call sexos_line "[quil.diskfs.slot.min.read.err] err=%lld" (cast (long long) e))
              (call slot_proof_done_fail)
              (return)))
          (if (!= (call v2_status reply) DISKFS_V2_STATUS_OK)
            (block
              (call sexos_line "[quil.diskfs.slot.min.read.err] status=%#llx" (cast (unsigned long long) (call v2_status reply)))
              (call slot_proof_done_fail)
              (return)))
          (var size_t n (call min_size (call v2_len_field reply) 6))
          (if (< n want)
            (block
              (call sexos_line "[quil.diskfs.slot.min.read.err] reason=short_read got=%zu want=%zu" n want)
              (call slot_proof_done_fail)
              (return)))
          (comment "More bytes than asked for overrun the 16-byte readback, a slice panic in the Rust.")
          (if (> (+ off n) 16) (call sexos_spin_forever))
          (for (var size_t i 0) (< i n) (++ i) (= ([] readback (+ off i)) (call v2_byte reply i)))
          (+= off n)))
      (call sexos_line "[quil.diskfs.slot.min.read.ok] size=16")
      (for (var size_t i 0) (< i 16) (++ i)
        (if (!= ([] readback i) ([] payload i))
          (block
            (call sexos_line "[quil.diskfs.slot.min.match] ok=0 first_bad=%zu got=%#x expected=%#x" i (cast unsigned ([] readback i)) (cast unsigned ([] payload i)))
            (call slot_proof_done_fail)
            (return))))
      (call sexos_line "[quil.diskfs.slot.min.match] ok=1")
      (call sexos_line "[quil.diskfs.slot.min.done] ok=1"))

    (comment "Pack up to 16 name bytes into two words, little-endian (the RamFS open convention).")
    (fn (static void) pack_name (((const char) (* name)) (uint64_t (* a0)) (uint64_t (* a1)))
      (var size_t len (call sexos_strlen name))
      (= (* a0) 0)
      (= (* a1) 0)
