      (call sexos_line "[quil.palette.stub] cmd=%u" (cast unsigned cmd)))

    (comment "Text-mode keys that are not palette actions: Backspace, the arrows, Home, End and Delete, then printable characters; anything else toggles the liveness color.")
    (fn (static void) text_key ((Quil (* q)) (uint64_t scancode) (bool event_shift))
      (var uint64_t code (& scancode 0xFF))
      (if (== code 0x0E)
        (block
          (call sexos_line "[quil.text.recv] code=14 ch=8")
          (cast void (call text_buffer_backspace q))
          (call redraw q)
          (return)))
      (if (== code 0x4B)
        (block
