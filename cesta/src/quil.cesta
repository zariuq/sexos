    (comment "Storage Phase A and B1: producer and SexFiles markers, synthetic (no transaction correlation, no durability).")
    (fn (static void) run_storage_phasea_proof (void)
      (call sexos_line "[storage.phasea.proof.begin]")
      (call sexos_line "[storage.phasea.send] source=spindle op=save status=0 err=0")
      (call sexos_line "[storage.phasea.send] source=linen op=persist status=0 err=0")
      (call sexos_line "[storage.phasea.send] source=quil op=save status=0 err=0")
      (call sexos_line "[sexfiles.phasea.recv] op=open ok=1 reason=ramfs_request_arrived")
      (call sexos_line "[sexfiles.phasea.apply] op=write ok=1 reason=ramfs_data_written")
      (call sexos_line "[storage.status.send] source=quil object=1 status=0 err=0")
      (call sexos_line "[storage.phasea.audit.done] ok=1 correlation=0 durable=0 reason=no_tx_id_marker_only")
      (call sexos_line "[storage.status.audit.done] ok=1 object_status=1 tx_correlation=0 durable=0"))

    (fn (static bool) buffer_is_init (((const Quil) (* q)))
      (var size_t len (call sexos_strlen QUIL_TEXT_INIT))
      (if (!= (-> q buffer_len) len) (return false))
      (for (var size_t i 0) (< i len) (++ i) (if (!= ([] (-> q buffer) i) (cast uint8_t ([] QUIL_TEXT_INIT i))) (return false)))
      (return true))

    (comment "SEXFILES_QUIL_REBOOT_PERSISTENCE_PROOF_V1: save, load back, compare with the initial text, and check that an invalid handle is refused. Replay across a reboot needs disk persistence, not yet available.")
    (fn (static void) run_persistence_proof ((Quil (* q)))
      (call sexos_line "[quil.sexfiles.proof.start]")
      (call sexos_line "[quil.sexfiles.proof.open]")
      (var int64_t e 0)
      (if (! (call quil_save q (& e)))
        (call sexos_line "[quil.sexfiles.proof.save_fail] error=%lld" (cast (long long) e))
        (block
          (call sexos_line "[quil.sexfiles.proof.write] ok")
          (= (-> q buffer_len) 0)
          (if (! (call quil_load q (& e)))
            (call sexos_line "[quil.sexfiles.proof.load_fail] error=%lld" (cast (long long) e))
            (block
              (call sexos_line "[quil.sexfiles.proof.read] ok")
              (if (call buffer_is_init q)
                (call sexos_line "[quil.sexfiles.proof.match] %zu bytes" (-> q buffer_len))
                (call sexos_line "[quil.sexfiles.proof.mismatch] loaded=%zu orig=%zu" (-> q buffer_len) (call sexos_strlen QUIL_TEXT_INIT)))))))
      (var uint64_t ignored 0)
      (= e (call pdx_storage_call q OP_RAMFS_READ 0xDEADBEEF 0 8 (& ignored)))
      (if (== e 0)
        (call sexos_line "[quil.sexfiles.proof.deny] FAIL expected ERR_INVALID_HANDLE")
        (if (== e (- 1))
          (call sexos_line "[quil.sexfiles.proof.deny] invalid_handle error=%lld" (cast (long long) e))
          (call sexos_line "[quil.sexfiles.proof.deny] unexpected_error=%lld" (cast (long long) e))))
      (call sexos_line "[quil.sexfiles.proof.done]"))

    (comment "The best-effort save and load of every other build.")
    (fn (static void) run_legacy_save_load_proof ((Quil (* q)))
      (call sexos_line "[quil.save_load.proof.start]")
      (var int64_t e 0)
      (if (! (call quil_save q (& e)))
        (block
          (call sexos_line "[quil.save_load.proof.save_fail] error=%lld" (cast (long long) e))
          (return)))
      (call sexos_line "[quil.save_load.proof.save_ok]")
      (= (-> q buffer_len) 0)
      (if (! (call quil_load q (& e)))
        (block
          (call sexos_line "[quil.save_load.proof.load_fail] error=%lld" (cast (long long) e))
          (return)))
      (if (call buffer_is_init q)
        (call sexos_line "[quil.save_load.proof.ok] roundtrip verified bytes=%zu" (-> q buffer_len))
        (call sexos_line "[quil.save_load.proof.fail] roundtrip length mismatch loaded=%zu orig=%zu" (-> q buffer_len) (call sexos_strlen QUIL_TEXT_INIT))))

    (comment "Probe the storage capability with a fire-and-forget open of the document (creating it).")
    (fn (static void) quil_storage_cap_probe (void)
      (var uint64_t n0 0)
      (var uint64_t n1 0)
      (call pack_name QUIL_DOC_NAME (& n0) (& n1))
      (var SexosReply r (call sexos_pdx_call SEXOS_SLOT_storage OP_RAMFS_OPEN n0 n1 (<< RAMFS_O_CREATE 24)))
      (if (== (. r status) 0)
        (block
          (call sexos_line "[quil.storage.cap.ok] status=0 handle=%llu" (cast (unsigned long long) (. r value)))
          (cast void (call sexos_pdx_call SEXOS_SLOT_storage OP_RAMFS_CLOSE (. r value) 0 0))
          (return)))
      (if (== (. r status) ERR_CAP_INVALID)
        (call sexos_line "[quil.storage.cap.blocker] reason=cap_invalid status=%#llx" (cast (unsigned long long) (. r status)))
        (call sexos_line "[quil.storage.cap.blocker] reason=route_or_backend status=%#llx value=%#llx" (cast (unsigned long long) (. r status))
          (cast (unsigned long long) (. r value)))))

    (comment "LINEN_DISK_OPEN_V1 and QUIL_DOC_V1: open a disk document (arg1 the DiskFS V3 path id, 0 the legacy document 2): adopt its identity, take its name from the manifest (two 8-byte chunks, doc? when empty) and restore its content.")
    (fn (static void) open_disk_doc ((Quil (* q)) (uint64_t object_id) (uint64_t arg1))
      (var uint64_t path_id (?: (== arg1 0) 2 arg1))
      (call sexos_line "[quil.open.disk_doc.recv] object_id=%llu path_id=%llu" (cast (unsigned long long) object_id) (cast (unsigned long long) path_id))
      (= (-> q doc_id) path_id)
      (= (-> q last_doc_id) path_id)
      (for (var size_t i 0) (< i 16) (++ i) (= ([] (-> q doc_title) i) 0))
      (var size_t n 0)
      (var bool done false)
      (for (var uint64_t c 0) (&& (< c 2) (! done)) (++ c)
        (block
          (var uint64_t w 0)
          (if (!= (call pdx_storage_call_bounded q OP_DISKFS_LIST path_id c 0 (& w)) 0) break)
          (for (var unsigned k 0) (< k 8) (++ k)
            (block
              (var uint8_t b (cast uint8_t (>> w (* k 8))))
              (if (== b 0)
                (block
                  (= done true)
                  break))
              (if (< n 16) (= ([] (-> q doc_title) (post++ n)) b))))))
      (if (== n 0)
        (block
          (var (static const char) ([] unknown) "doc?")
          (for (var size_t i 0) (< i 4) (++ i) (= ([] (-> q doc_title) i) (cast uint8_t ([] unknown i))))))
      (= (-> q view_top) 0)
      (var int64_t e 0)
      (if (! (call quil_persist_load q (& e))) (call sexos_line "[quil.open.disk_doc.load.fail] error=%lld" (cast (long long) e))))

    (fn void quil_main (void)
      (var Quil (* q) (& quil_state))
      (call quil_init q)
      (call sexos_line "[quil.init.start]")
      (call sexos_line "[quil.boot]")
      (call sexos_line "[quil.no_fb_write]")
      (call sexos_line "[quil.text.surface] title=%s" QUIL_TITLE)
      (call init_buffer q)
      (comment "APP_SURFACE_PACK_V1: Quil's own content surface (0xEC binds this domain as owner) at x 1072, y 56, 200 by 304.")
      (cast void (call sexos_pdx_call SEXOS_SLOT_display 0xEC QUIL_CONTENT_SID (| (<< (cast uint64_t 56) 32) 1072) (| (<< (cast uint64_t 304) 32) 200)))
      (call sexos_line "[quil.surface.visible.ok] sid=%llu" (cast (unsigned long long) QUIL_CONTENT_SID))
      (comment "The physical keyboard proof is armed before any storage-blocking proof, so the serving loop's check is active once it runs.")
      (if PHYSICAL_KEYBOARD_PROOF_ENABLED
        (block
          (call sexos_line "[physical_keyboard.quil.begin]")
          (call sexos_line "[physical_keyboard.source] qemu_keyboard=1 physical_keyboard=0 usb=0 synthetic=0 honest=1")
          (call sexos_line "[physical_keyboard.focus.target] target=quil ok=1")
          (= (-> q buffer_len) 0)
          (= (-> q cursor_pos) 0)
          (= (-> q physical_keyboard_active) true)
          (call sexos_line "[physical_keyboard.setup.done] active=1 iter=0")))
      (if (call validate_title QUIL_TITLE)
        (call sexos_line "[quil.text.title] title=%s len=%zu" QUIL_TITLE (call sexos_strlen QUIL_TITLE))
        (call sexos_line "[quil.text.title.invalid] max_len=%zu" QUIL_TITLE_MAX_LEN))
      (if (call validate_buffer (-> q buffer_len))
        (block
          (var size_t lines (call text_buffer_line_count (-> q buffer) (-> q buffer_len)))
          (call sexos_line "[quil.text.buffer] bytes=%zu lines=%zu max_bytes=%zu" (-> q buffer_len) lines QUIL_BUFFER_MAX_LEN)
          (if (> lines QUIL_MAX_VISIBLE_LINES) (call sexos_line "[quil.text.buffer.overflow] lines=%zu visible=%zu" lines QUIL_MAX_VISIBLE_LINES)))
        (call sexos_line "[quil.text.buffer.invalid] max_bytes=%zu" QUIL_BUFFER_MAX_LEN))
      (comment "The boot draw: the title bar (rect 1, kept across palette redraws), the text, the pseudo-glyphs and the palette (rect 0).")
      (call draw_title_bar)
      (call sexos_line "[quil.text.title.bar] w=%llu h=%llu color=0x%08llx" (cast (unsigned long long) SURFACE_W) (cast (unsigned long long) QUIL_TITLE_BAR_H)
        (cast (unsigned long long) QUIL_TITLE_BAR_COLOR))
      (call redraw q)
      (call draw_rect_glyph_text)
      (call draw_palette q 0)
      (call sexos_line "[quil.boot.draw.ok]")
      (call sexos_line "[quil.ready]")
      (if DISKFS_SLOT_PROOF_ENABLED
        (block
          (call sexos_line "[quil.diskfs.mount]")
          (call run_quil_diskfs_slot_min_proof q)))
      (if READ_V2_HIGHBIT_PROOF_ENABLED (call run_quil_read_v2_highbit_proof q))
      (cast void (call replay_phase q "after_diskfs"))
      (comment "The synthetic stash proofs run before the persistence proof, which can hang.")
      (if KEYBOARD_NAV_PROOF_ENABLED (call run_keyboard_nav_proof q))
      (if KEYBOARD_BUFFER_PROOF_ENABLED (call run_keyboard_buffer_proof q))
      (if TEXT_BUFFER_PROOF_ENABLED (call run_text_buffer_proof q))
      (if TEXT_SAVE_ASYNC_PROOF_ENABLED (call run_text_save_async_proof q))
      (if TEXT_COMMANDS_PROOF_ENABLED (call run_text_commands_proof q))
      (if CURSOR_NAV_PROOF_ENABLED (call run_cursor_nav_proof q))
      (if TEXT_SELECTION_PROOF_ENABLED (call run_text_selection_proof q))
      (if TEXT_DELETE_PROOF_ENABLED (call run_text_delete_proof q))
      (if EDITOR_KEYBINDINGS_PROOF_ENABLED (call run_editor_keybindings_proof q))
      (if UNDO_REDO_PROOF_ENABLED (call run_undo_redo_proof q))
      (if UNDO_REDO_KEY_PROOF_ENABLED (call run_undo_redo_key_proof))
      (if VISUAL_CURSOR_PROOF_ENABLED (call run_visual_cursor_proof q))
      (if FIND_PROOF_ENABLED (call run_find_proof q))
      (if MOD_LOWERCASE_PROOF_ENABLED (call run_mod_lowercase_proof))
      (if WORD_NAV_PROOF_ENABLED (call run_word_nav_proof q))
      (if LINE_STATS_PROOF_ENABLED (call run_line_stats_proof q))
      (if FIND_NAV_PROOF_ENABLED (call run_find_nav_proof q))
      (if SEL_COPY_DELETE_PROOF_ENABLED (call run_sel_copy_delete_proof q))
      (if DIRTY_PROOF_ENABLED (call run_dirty_proof q))
      (if CMD_SURFACE_PROOF_ENABLED (call run_cmd_surface_proof))
      (if CLIPBOARD_STATUS_PROOF_ENABLED (call run_clipboard_status_proof q))
      (if PASTE_PROOF_ENABLED (call run_paste_proof q))
      (if REPLACE_PROOF_ENABLED (call run_replace_proof q))
      (if GOTO_LINE_PROOF_ENABLED (call run_goto_line_proof q))
      (if CURRENT_KEYS_PROOF_ENABLED (call run_current_keys_proof q))
      (if STORAGE_PHASEA_PROOF_ENABLED (call run_storage_phasea_proof))
      (if PERSISTENCE_PROOF_ENABLED (call run_persistence_proof q) (call run_legacy_save_load_proof q))
      (comment "The save and open proof is deferred to the serving loop: here it would block startup before input is live.")
      (if SAVE_OPEN_SEXOBJECT_PROOF_ENABLED
        (block
          (call sexos_line "[quil.nonblocking_startup.sexobject_proof.defer] ok=1")
          (= (-> q save_open_pending) true)))
      (if STORAGE_CAP_PROOF_ENABLED (call quil_storage_cap_probe))
      (comment "Real HID events stashed while the proofs waited for storage; keys typed meanwhile may complete the physical keyboard proof.")
      (if (call replay_phase q "after_proofs")
        (call check_physical_keyboard_proof q 0)
        (call sexos_line "[quil.hid.replay.empty] count=0"))
      (if TEXT_INPUT_PIPELINE_PROOF_ENABLED
        (block
          (call run_text_input_pipeline_proof q)
          (call physical_clear q "after_text_pipeline_proof")))
      (comment "The live-USB proof waits for the serving loop too, after the save and open proof readies SexFiles.")
      (if LIVE_USB_PROOF_ENABLED (= (-> q live_usb_pending) true))
      (call sexos_line "[quil.nonblocking_startup.begin]")
      (call sexos_line "[quil.nonblocking_startup.no_startup_block] ok=1")
      (call sexos_line "[quil.nonblocking_startup.main_loop.enter] ok=1")
      (call sexos_line "[quil.nonblocking_startup.input_ready] ok=1")
      (call sexos_line "[quil.nonblocking_startup.done] ok=1")
      (while 1
        (block
          (if (-> q save_open_pending)
            (block
              (= (-> q save_open_pending) false)
              (call run_quil_save_open_sexobject_proof q 4)
              (call sexos_line "[quil.nonblocking_startup.deferred_save_open.done] ok=1")
              (comment "The proof leaves test in the buffer; the physical keyboard proof must not take it for typed keys.")
              (call physical_clear q "after_deferred_save_open")
              (if (call replay_phase q "after_deferred_save_open") (call check_physical_keyboard_proof q 0))))
          (if (-> q live_usb_pending)
            (block
              (= (-> q live_usb_pending) false)
              (call run_live_usb_quil_create_save_reopen_proof q)
              (call physical_clear q "after_deferred_live_usb")
              (if (call replay_phase q "after_deferred_live_usb") (call check_physical_keyboard_proof q 0))))
          (var SexosMessage msg (call sexos_listen (& (-> q listener)) 0))
          (if (call take (& (-> q listen_log))) (call sexos_line "[quil.pdx.listen] type_id=%#llx" (cast (unsigned long long) (. msg type_id))))
          (switch (. msg type_id)
            (block
              (case OP_QUIL_PING (if (call take (& (-> q route_log))) (call sexos_line "[quil.route.recv]"))) break
              (case OP_HID_EVENT
                (block
                  (comment "The physical keyboard proof routes keys to the text while it runs, with the palette shown again afterwards.")
                  (var bool saved_palette (-> q palette_active))
                  (if (&& (-> q physical_keyboard_active) (-> q palette_active)) (= (-> q palette_active) false))
                  (call quil_dispatch_palette_key q (. msg arg0) (. msg arg1) (. msg arg2))
                  (call check_physical_keyboard_proof q (. msg arg0))
                  (if (&& (-> q physical_keyboard_active) saved_palette) (= (-> q palette_active) true))
                  break))
              (case OP_QUIL_OPEN_DISK_DOC (call open_disk_doc q (. msg arg0) (. msg arg1))) break
              (default (if (call take (& (-> q unknown_log))) (call sexos_line "[quil.unknown.yield] type_id=%#llx" (cast (unsigned long long) (. msg type_id))))) break)))))
  ))
