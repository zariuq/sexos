          (cast void (call text_buffer_append q ch))
          (call redraw q)
          (return)))
      (call toggle_color (& (-> q text_color_toggle)))
      (call sexos_line "[quil.text.recv] code=%llu ch=0 reason=unmapped" (cast (unsigned long long) scancode)))

    (comment "QUIL_DOC_V1's name entry swallows keys until Enter (create and save; an empty name is refused) or Esc (cancel: untitled and dirty).")
