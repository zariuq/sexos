          (call sexos_line "[quil.save.fail] close error=%lld" (cast (long long) e))
          (return (call fail err e))))
      (= (-> q dirty) false)
      (call sexos_line "[quil.save.ok] bytes=%zu" len)
      (return true))

    (comment "Load the RamFS file QUIL_DOC_NAME. Reads go 8 bytes at a time from the bytes kept so far; a chunk keeps its bytes up to the first zero, and a short chunk ends the file. An all-zero first chunk is an empty file.")
    (fn (static bool) quil_load ((Quil (* q)) (int64_t (* err)))
      (var uint64_t n0 0)
      (var uint64_t n1 0)
      (call pack_name QUIL_DOC_NAME (& n0) (& n1))
      (var uint64_t handle 0)
      (var int64_t e (call pdx_storage_call q OP_RAMFS_OPEN n0 n1 0 (& handle)))
      (if (!= e 0)
        (block
          (call sexos_line "[quil.load.fail] open error=%lld" (cast (long long) e))
          (return (call fail err e))))
      (var uint64_t ignored 0)
      (var size_t total 0)
      (while 1
        (block
          (var uint64_t raw 0)
          (= e (call pdx_storage_call q OP_RAMFS_READ handle total 8 (& raw)))
          (if (!= e 0)
            (block
              (call sexos_line "[quil.load.fail] read offset=%zu error=%lld" total (cast (long long) e))
              (cast void (call pdx_storage_call q OP_RAMFS_CLOSE handle 0 0 (& ignored)))
              (return (call fail err e))))
          (if (&& (== total 0) (== (& raw 0xFF) 0))
            (block
              (= (-> q buffer_len) 0)
              (cast void (call pdx_storage_call q OP_RAMFS_CLOSE handle 0 0 (& ignored)))
              (call sexos_line "[quil.load.empty]")
              (return true)))
          (var size_t chunk_len 0)
          (while (&& (< chunk_len 8) (!= (& (>> raw (* chunk_len 8)) 0xFF) 0)) (+= chunk_len 1))
          (if (== chunk_len 0) break)
          (if (> (+ total chunk_len) QUIL_BUFFER_MAX_LEN)
            (block
              (call sexos_line "[quil.load.reject] reason=overflow max=%zu" QUIL_BUFFER_MAX_LEN)
              (cast void (call pdx_storage_call q OP_RAMFS_CLOSE handle 0 0 (& ignored)))
              (return (call fail err (- 4)))))
          (for (var size_t i 0) (< i chunk_len) (++ i) (= ([] (-> q buffer) (+ total i)) (cast uint8_t (>> raw (* i 8)))))
          (+= total chunk_len)
          (if (< chunk_len 8) break)))
      (cast void (call pdx_storage_call q OP_RAMFS_CLOSE handle 0 0 (& ignored)))
      (= (-> q buffer_len) total)
      (= (-> q dirty) false)
      (call sexos_line "[quil.load.ok] bytes=%zu" total)
      (call redraw q)
      (return true))

    (comment "LANE3: one READ_V2 call, decoded into *n bytes at OUT; end of file gives 0 bytes, not an error, so a caller's short-read check covers it. An error status gives minus its magnitude.")
    (fn (static bool) read_v2_chunk ((Quil (* q)) (uint64_t offset) (uint64_t want) (uint8_t (* out)) (size_t (* n)) (int64_t (* err)))
      (var uint64_t reply 0)
      (var int64_t e (call pdx_storage_call_bounded q OP_DISKFS_READ_V2 offset want 0 (& reply)))
      (if (!= e 0) (return (call fail err e)))
      (= (* n) 0)
      (if (== (call v2_status reply) DISKFS_V2_STATUS_EOF) (return true))
      (if (!= (call v2_status reply) DISKFS_V2_STATUS_OK) (return (call fail err (- (cast int64_t (call v2_len_field reply))))))
      (= (* n) (call min_size (call v2_len_field reply) 6))
      (for (var size_t i 0) (< i 6) (++ i) (= ([] out i) (call v2_byte reply i)))
      (return true))

    (comment "QUIL_PERSIST_V1: save to the document's DiskFS object, so it survives a reboot: a header (magic, length) at 0, the content in 16-byte writes from 16, then a truncate to the exact length (DISKFS_V4: whole-chunk writes overshoot, and a longer earlier save would leave a stale tail). Clears dirty and logs an FNV-1a hash of the content.")
    (fn (static bool) quil_persist_save ((Quil (* q)) (int64_t (* err)))
      (var size_t len (call min_size (-> q buffer_len) QUIL_BUFFER_MAX_LEN))
      (if (== len 0)
        (block
          (call sexos_line "[quil.persist.save.skip] reason=empty")
          (return (call fail err (- 1)))))
      (if (== (-> q doc_id) UINT64_MAX)
        (block
          (call sexos_line "[quil.persist.save.skip] reason=untitled")
          (return (call fail err (- 9)))))
      (var uint64_t ignored 0)
      (var int64_t e (call pdx_storage_call_bounded q OP_DISKFS_SELECT (-> q doc_id) 0 0 (& ignored)))
      (if (!= e 0)
        (block
          (call sexos_line "[quil.persist.save.err] stage=select err=%lld" (cast (long long) e))
          (return (call fail err e))))
      (= e (call pdx_storage_call_bounded q OP_DISKFS_WRITE 0 (| QUIL_PERSIST_MAGIC (<< (cast uint64_t len) 32)) 0 (& ignored)))
      (if (!= e 0)
        (block
          (call sexos_line "[quil.persist.save.err] stage=header err=%lld" (cast (long long) e))
          (return (call fail err e))))
      (for (var size_t off 0) (< off len) (+= off 16)
        (block
          (var uint64_t lo 0)
          (var uint64_t hi 0)
          (for (var size_t i 0) (< i 8) (++ i)
            (block
              (if (< (+ off i) len) (|= lo (<< (cast uint64_t ([] (-> q buffer) (+ off i))) (* i 8))))
              (if (< (+ (+ off 8) i) len) (|= hi (<< (cast uint64_t ([] (-> q buffer) (+ (+ off 8) i))) (* i 8))))))
          (= e (call pdx_storage_call_bounded q OP_DISKFS_WRITE (+ 16 off) lo hi (& ignored)))
          (if (!= e 0)
            (block
              (call sexos_line "[quil.persist.save.err] stage=write off=%zu err=%lld" off (cast (long long) e))
              (return (call fail err e))))))
      (= e (call pdx_storage_call_bounded q OP_DISKFS_TRUNCATE (+ 16 len) 0 0 (& ignored)))
      (if (!= e 0)
        (block
          (call sexos_line "[quil.persist.save.err] stage=truncate err=%lld" (cast (long long) e))
          (return (call fail err e))))
      (= (-> q dirty) false)
      (call sexos_line "[quil.persist.save.ok] bytes=%zu hash=%#llx" len (cast (unsigned long long) (call fnv1a (-> q buffer) len)))
      (return true))

    (comment "QUIL_PERSIST_V1: restore from DiskFS. An untitled buffer reloads the document last attached (DISKFS_V4) and adopts it. The 8-byte header takes two READ_V2 calls; the content is staged and copied in only when every chunk arrived (LANE3), each read asking for no more than remains, since the backend bounds reads to the exact committed size.")
    (fn (static bool) quil_persist_load ((Quil (* q)) (int64_t (* err)))
      (var uint64_t target (?: (!= (-> q doc_id) UINT64_MAX) (-> q doc_id) (-> q last_doc_id)))
      (if (== target UINT64_MAX)
        (block
          (call sexos_line "[quil.persist.load.skip] reason=untitled")
          (return (call fail err (- 9)))))
      (var uint64_t ignored 0)
      (var int64_t e (call pdx_storage_call_bounded q OP_DISKFS_SELECT target 0 0 (& ignored)))
      (if (!= e 0)
        (block
          (call sexos_line "[quil.persist.load.err] stage=select err=%lld" (cast (long long) e))
          (return (call fail err e))))
      (var uint8_t ([] hdr 8) (init 0))
      (var size_t hoff 0)
      (while (< hoff 8)
        (block
          (var size_t want (call min_size (- 8 hoff) DISKFS_V2_MAX_READ))
          (var uint8_t ([] bytes 6) (init 0))
          (var size_t n 0)
          (if (! (call read_v2_chunk q hoff want bytes (& n) (& e)))
            (block
              (call sexos_line "[quil.persist.load.err] stage=header err=%lld" (cast (long long) e))
              (return (call fail err e))))
          (comment "More bytes than asked for overrun the 8-byte header, a slice panic in the Rust.")
          (if (> (+ hoff n) 8) (call sexos_spin_forever))
          (for (var size_t i 0) (< i n) (++ i) (= ([] hdr (+ hoff i)) ([] bytes i)))
          (if (< n want)
            (block
              (call sexos_line "[quil.persist.load.miss] magic=short_header")
              (return (call fail err (- 2)))))
          (+= hoff n)))
      (var uint64_t word 0)
      (for (var size_t i 0) (< i 8) (++ i) (|= word (<< (cast uint64_t ([] hdr i)) (* i 8))))
      (var uint64_t magic (& word 0xFFFFFFFF))
      (var size_t len (call min_size (cast size_t (>> word 32)) QUIL_BUFFER_MAX_LEN))
      (if (|| (!= magic QUIL_PERSIST_MAGIC) (== len 0))
        (block
          (call sexos_line "[quil.persist.load.miss] magic=%#llx len=%zu" (cast (unsigned long long) magic) len)
          (return (call fail err (- 2)))))
      (var size_t off 0)
      (while (< off len)
        (block
          (var size_t want (call min_size (- len off) DISKFS_V2_MAX_READ))
          (var uint8_t ([] bytes 6) (init 0))
          (var size_t n 0)
          (if (! (call read_v2_chunk q (+ 16 off) want bytes (& n) (& e)))
            (block
              (call sexos_line "[quil.persist.load.err] stage=read off=%zu err=%lld" off (cast (long long) e))
              (return (call fail err e))))
          (if (< n want)
            (block
              (call sexos_line "[quil.persist.load.err] stage=read off=%zu reason=short_read got=%zu want=%zu" off n want)
              (return (call fail err (- 2)))))
          (comment "A reply longer than asked for can overrun the staging copy only at its end, a slice panic in the Rust; the next read starts where this one was asked to end.")
          (if (> (+ off n) QUIL_BUFFER_MAX_LEN) (call sexos_spin_forever))
          (for (var size_t i 0) (< i n) (++ i) (= ([] (-> q load_staging) (+ off i)) ([] bytes i)))
          (+= off want)))
      (for (var size_t i 0) (< i len) (++ i) (= ([] (-> q buffer) i) ([] (-> q load_staging) i)))
      (= (-> q buffer_len) len)
      (= (-> q cursor_pos) len)
      (= (-> q dirty) false)
      (= (-> q doc_id) target)
      (= (-> q last_doc_id) target)
      (call sexos_line "[quil.persist.load.ok] bytes=%zu" len)
      (call redraw q)
      (return true))

    (comment "Up to 16 bytes as the two words of a DiskFS create.")
    (fn (static void) pack_bytes (((const uint8_t) (* bytes)) (size_t len) (uint64_t (* lo)) (uint64_t (* hi)))
      (= (* lo) 0)
      (= (* hi) 0)
      (for (var size_t i 0) (&& (< i len) (< i 16)) (++ i)
        (if (< i 8) (|= (* lo) (<< (cast uint64_t ([] bytes i)) (* i 8))) (|= (* hi) (<< (cast uint64_t ([] bytes i)) (* (- i 8) 8))))))

    (cpp-if "SEXOS_QUIL_CURRENT_DOCUMENT"
      (then
        (native "
static bool quil_current_utf8(const uint8_t *bytes,size_t length)
{
 size_t i=0;while(i<length){uint8_t c=bytes[i++];if(c<0x80)continue;size_t need=0;uint32_t value=0,minimum=0;if((c&0xe0)==0xc0){need=1;value=c&0x1f;minimum=0x80;}else if((c&0xf0)==0xe0){need=2;value=c&15;minimum=0x800;}else if((c&0xf8)==0xf0){need=3;value=c&7;minimum=0x10000;}else return false;if(need>length-i)return false;for(size_t k=0;k<need;k++){uint8_t d=bytes[i++];if((d&0xc0)!=0x80)return false;value=(value<<6)|(d&0x3f);}if(value<minimum||value>0x10ffff||(value>=0xd800&&value<=0xdfff))return false;}return true;
}
static bool quil_current_save(Quil *q,bool create)
{
 if(document_client_busy(&q->document)){if(quil_autosave_pending(&q->autosave))q->autosave.queued_save=create?1:0;return false;}
