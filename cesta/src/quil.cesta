    (comment "Replay the stashed HID events through the key dispatch (each logged when LOGGED), then empty the stash. Events stashed during the replay, as a palette save waits for storage, go with it, as in the Rust.")
    (fn (static void) replay_stash ((Quil (* q)) (bool logged))
      (var size_t count (-> q hid_stash_count))
      (for (var size_t i 0) (< i count) (++ i)
        (block
          (var HidStashEntry e ([] (-> q hid_stash) i))
          (if logged
