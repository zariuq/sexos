              (cast (unsigned long long) (. e value)) (cast (unsigned long long) (. e mod))))
          (call quil_dispatch_palette_key q (. e code) (. e value) (. e mod))))
      (= (-> q hid_stash_count) 0))

    (comment "Replay a phase's stash between begin and done markers; false when it was empty.")
    (fn (static bool) replay_phase ((Quil (* q)) ((const char) (* phase)))
      (var size_t count (-> q hid_stash_count))
      (if (== count 0) (return false))
      (call sexos_line "[quil.hid.replay.begin] count=%zu phase=%s" count phase)
      (call replay_stash q true)
      (call sexos_line "[quil.hid.replay.done] count=%zu" count)
      (return true))

    (comment "A proof's synthetic key: stashed with value 1 (press) when there is room; gives the index, or SIZE_MAX.")
    (fn (static size_t) seed_key ((Quil (* q)) (uint64_t code))
      (var size_t idx (-> q hid_stash_count))
      (return (?: (call stash_hid q code 1 0) idx SIZE_MAX)))

    (comment "Poll up to MAX_WINDOWS windows of 128 non-blocking listens for a storage reply; HID events are stashed (unlogged) and other messages answered with a yield.")
    (fn (static bool) await_reply ((Quil (* q)) (uint64_t max_windows) (uint64_t (* value)))
      (for (var uint64_t attempt 0) (< attempt max_windows) (++ attempt)
        (for (var uint64_t w 0) (< w 128) (++ w)
          (block
            (var SexosMessage msg (init 0))
            (if (call sexos_try_listen 0 (& msg))
              (block
                (if (== (. msg type_id) 1)
                  (block
                    (= (* value) (. msg arg0))
                    (return true)))
                (if (== (. msg type_id) OP_HID_EVENT) (cast void (call stash_hid q (. msg arg0) (. msg arg1) (. msg arg2))) (call sexos_yield)))))))
      (return false))

    (fn (static bool) buffer_is_test (((const Quil) (* q)) (bool at_least))
      (if (?: at_least (< (-> q buffer_len) 4) (!= (-> q buffer_len) 4)) (return false))
      (return (&& (&& (&& (== ([] (-> q buffer) 0) 't') (== ([] (-> q buffer) 1) 'e')) (== ([] (-> q buffer) 2) 's')) (== ([] (-> q buffer) 3) 't'))))

    (comment "Save and open a native SexObject (Quil to SLOT_STORAGE opcodes 0x40 and 0x41, SexFiles, SexFS v0): 0x40 formats, creates, writes test and reads it back, giving the object id; 0x41 reads that object, giving its length 4. Quil reaches storage only through SLOT_STORAGE, never SLOT_BLOCK or SexDrive.")
    (fn (static void) run_quil_save_open_sexobject_proof ((Quil (* q)) (uint64_t readiness_yields))
      (call sexos_line "[quil.sexobject.save.open.begin]")
      (var (const char) (* label) "test")
      (for (var size_t i 0) (< i 4) (++ i) (= ([] (-> q buffer) i) (cast uint8_t ([] label i))))
      (= (-> q buffer_len) 4)
      (call sexos_line "[quil.sexobject.buffer.ready] label=test len=4 text=test")
      (call sexos_line "[quil.sexobject.route] uses_linen=1 uses_slot_storage=1 uses_slot_block=0 direct_sexdrive=0")
      (for (var uint64_t i 0) (< i readiness_yields) (++ i) (call sexos_yield))
      (call sexos_line "[quil.sexobject.save.send] label=test len=4 kind=text")
      (var SexosReply sent (call sexos_pdx_call SEXOS_SLOT_storage 0x40 0 0 0))
      (if (!= (. sent status) 0)
        (block
          (call sexos_line "[quil.sexobject.save.send.err] status=%llu" (cast (unsigned long long) (. sent status)))
          (call sexos_line "[quil.sexobject.save.open.done] ok=0 reason=save_send_fail")
          (return)))
      (var uint64_t object_id 0)
      (if (! (call await_reply q 32 (& object_id)))
        (block
          (call sexos_line "[quil.sexobject.save.reply.timeout] attempts=32")
          (call sexos_line "[quil.sexobject.save.open.done] ok=0 reason=save_reply_timeout")
          (return)))
      (if (== object_id 0)
        (block
          (call sexos_line "[quil.sexobject.save.reply.err] val=0")
          (call sexos_line "[quil.sexobject.save.open.done] ok=0 reason=save_reply_bad_val")
          (return)))
      (comment "SexFiles logs its own native create, write, read and persist markers while serving 0x40.")
      (call sexos_line "[linen.sexobject.native.save.recv] label=test len=4")
      (call sexos_line "[quil.sexobject.open.send] label=test")
      (call sexos_line "[linen.sexobject.native.open.recv] label=test")
      (= sent (call sexos_pdx_call SEXOS_SLOT_storage 0x41 object_id 0 0))
      (if (!= (. sent status) 0)
        (block
          (call sexos_line "[quil.sexobject.open.send.err] status=%llu" (cast (unsigned long long) (. sent status)))
          (call sexos_line "[quil.sexobject.save.open.done] ok=0 reason=open_send_fail")
          (return)))
      (var uint64_t val 0)
      (if (! (call await_reply q 16 (& val)))
        (block
          (call sexos_line "[quil.sexobject.open.reply.timeout] attempts=16")
          (call sexos_line "[quil.sexobject.save.open.done] ok=0 reason=open_reply_timeout")
          (return)))
      (if (!= val 4)
        (block
          (call sexos_line "[quil.sexobject.open.reply.err] val=%llu" (cast (unsigned long long) val))
          (call sexos_line "[quil.sexobject.save.open.done] ok=0 reason=open_reply_bad_val")
          (return)))
      (comment "SexFiles' 0x41 handler checked the content; Quil trusts its reply.")
      (call sexos_line "[quil.sexobject.open.match] text=test ok=1")
      (call sexos_line "[quil.sexobject.truth] filesystem=0 posix=0 directories=0 rename=0 delete=0 durable=0 powerloss=0 journal=0 ok=1")
      (call sexos_line "[quil.sexobject.save.open.done] ok=1"))

    (comment "The synthetic keys t, e, s, t.")
    (var (static const uint64_t) ([] TEST_KEYS 4) (init 0x14 0x12 0x1F 0x14))

    (comment "Text input pipeline: seed t, e, s, t into the stash and replay them through the key dispatch with the palette off, the path real keys take (scancode_to_char, text_buffer_append, draw_text_lines); the buffer must then be test. The source is synthetic, and the markers say so.")
    (fn (static void) run_text_input_pipeline_proof ((Quil (* q)))
      (call sexos_line "[text_input.pipeline.begin]")
      (call sexos_line "[text_input.source] kind=synthetic honest=1")
      (call sexos_line "[text_input.focus.target] target=quil ok=1")
      (= (-> q palette_active) false)
      (for (var size_t k 0) (< k 4) (++ k)
        (block
          (var CharText ch (call char_text (cast uint8_t ([] "test" k))))
          (call sexos_line "[text_input.key.recv] ch=%s" (. ch text))
          (var size_t idx (call seed_key q ([] TEST_KEYS k)))
          (if (!= idx SIZE_MAX) (call sexos_line "[text_input.key.stash] idx=%zu sc=%#llx ch=%s" idx (cast (unsigned long long) ([] TEST_KEYS k)) (. ch text)))))
      (call replay_stash q false)
      (if (call buffer_is_test q false)
        (block
          (call sexos_line "[text_input.char.decode] text=test ok=1")
          (call sexos_line "[quil.input.buffer.append] text=test len=4 ok=1"))
        (block
          (call sexos_line "[text_input.char.decode] text=<mismatch> len=%zu ok=0" (-> q buffer_len))
          (call sexos_line "[quil.input.buffer.append] text=<mismatch> len=%zu ok=0" (-> q buffer_len))))
      (call sexos_line "[quil.input.cursor.ok] pos=%zu" (-> q cursor_pos))
      (comment "No font rendering yet: the draw went to sexdisplay by the same path as keyboard input.")
      (call sexos_line "[quil.input.render.intent] text=test ok=1")
      (call sexos_line "[text_input.pipeline.truth] physical_keyboard=0 usb=0 posix=0 framebuffer_direct=0 ok=1")
      (call sexos_line "[text_input.pipeline.done] ok=1")
      (= (-> q palette_active) true))

    (comment "Live-USB create, save and reopen, with synthetic input: type test through the pipeline above into a cleared buffer, save it as a native SexObject (0x40) and reopen it (0x41).")
    (fn (static void) run_live_usb_proof_steps ((Quil (* q)))
      (call sexos_line "[live_usb.quil_create_save_reopen.begin]")
      (call sexos_line "[live_usb.input.source] kind=synthetic honest=1")
      (= (-> q palette_active) false)
      (= (-> q buffer_len) 0)
      (= (-> q cursor_pos) 0)
      (for (var size_t k 0) (< k 4) (++ k)
        (block
          (var size_t idx (call seed_key q ([] TEST_KEYS k)))
          (if (!= idx SIZE_MAX)
            (call sexos_line "[live_usb.input.key.stash] idx=%zu sc=%#llx ch=%s" idx (cast (unsigned long long) ([] TEST_KEYS k))
              (. (call char_text (cast uint8_t ([] "test" k))) text)))))
      (call replay_stash q false)
      (if (! (call buffer_is_test q false))
        (block
          (call sexos_line "[live_usb.input.buffer.match] text=test ok=0 len=%zu" (-> q buffer_len))
          (call sexos_line "[live_usb.quil_create_save_reopen.done] ok=0 reason=buffer_mismatch")
          (return)))
      (call sexos_line "[live_usb.input.buffer.match] text=test ok=1")
      (call sexos_line "[live_usb.route.truth] quil_direct_sexdrive=0 slot_block=0 slot_storage=1 ok=1")
      (call sexos_line "[live_usb.quil.save.send] label=test len=4")
      (var SexosReply sent (call sexos_pdx_call SEXOS_SLOT_storage 0x40 0 0 0))
      (if (!= (. sent status) 0)
        (block
          (call sexos_line "[live_usb.quil.save.send.err] status=%llu" (cast (unsigned long long) (. sent status)))
          (call sexos_line "[live_usb.quil_create_save_reopen.done] ok=0 reason=save_send_fail")
          (return)))
      (var uint64_t object_id 0)
      (if (! (call await_reply q 32 (& object_id)))
        (block
          (call sexos_line "[live_usb.sexobject.save.reply.timeout] attempts=32")
          (call sexos_line "[live_usb.quil_create_save_reopen.done] ok=0 reason=save_reply_timeout")
          (return)))
      (if (== object_id 0)
        (block
          (call sexos_line "[live_usb.sexobject.save.reply.err] val=0")
          (call sexos_line "[live_usb.quil_create_save_reopen.done] ok=0 reason=save_reply_bad_val")
          (return)))
      (call sexos_line "[live_usb.sexobject.persist.ok] object_id=%llu len=4" (cast (unsigned long long) object_id))
      (call sexos_line "[live_usb.quil.open.send] label=test")
      (= sent (call sexos_pdx_call SEXOS_SLOT_storage 0x41 object_id 0 0))
      (if (!= (. sent status) 0)
        (block
          (call sexos_line "[live_usb.quil.open.send.err] status=%llu" (cast (unsigned long long) (. sent status)))
          (call sexos_line "[live_usb.quil_create_save_reopen.done] ok=0 reason=open_send_fail")
          (return)))
      (var uint64_t val 0)
      (if (! (call await_reply q 16 (& val)))
        (block
          (call sexos_line "[live_usb.quil.open.reply.timeout] attempts=16")
          (call sexos_line "[live_usb.quil_create_save_reopen.done] ok=0 reason=open_reply_timeout")
          (return)))
      (if (!= val 4)
        (block
          (call sexos_line "[live_usb.quil.open.reply.err] val=%llu" (cast (unsigned long long) val))
          (call sexos_line "[live_usb.quil_create_save_reopen.done] ok=0 reason=open_reply_bad_val")
          (return)))
      (call sexos_line "[live_usb.quil.open.match] text=test ok=1")
      (call sexos_line "[live_usb.truth] physical_keyboard=0 usb=0 posix=0 framebuffer_direct=0 durable=0 powerloss=0 journal=0 ok=1")
      (call sexos_line "[live_usb.quil_create_save_reopen.done] ok=1"))

    (comment "Every ending of the live-USB proof shows the palette again.")
    (fn (static void) run_live_usb_quil_create_save_reopen_proof ((Quil (* q)))
      (call run_live_usb_proof_steps q)
      (= (-> q palette_active) true))

    (comment "Physical keyboard proof, checked after each key the serving loop dispatches (and after stash replays, with scancode 0): QEMU's sendkey through PS/2 IRQ1, sexinput and silk-shell must leave test at the start of the buffer.")
    (fn (static void) check_physical_keyboard_proof ((Quil (* q)) (uint64_t scancode))
      (if (! (-> q physical_keyboard_active)) (return))
      (if (!= scancode 0)
        (block
          (var uint8_t c 0)
          (if (call scancode_to_char scancode false (& c))
            (call sexos_line "[physical_keyboard.key.recv] scancode=%#llx ch=%s" (cast (unsigned long long) scancode) (. (call char_text c) text))
            (call sexos_line "[physical_keyboard.key.recv] scancode=%#llx ch=? non_printable=1" (cast (unsigned long long) scancode)))))
      (if (! (call buffer_is_test q true)) (return))
      (call sexos_line "[physical_keyboard.dispatch.quil.ok]")
      (call sexos_line "[physical_keyboard.buffer.append] text=test len=4 ok=1")
      (call sexos_line "[physical_keyboard.cursor.ok] pos=%zu" (-> q cursor_pos))
      (call sexos_line "[physical_keyboard.render.intent] text=test ok=1")
      (call sexos_line "[physical_keyboard.truth] synthetic=0 posix=0 framebuffer_direct=0 slot_block=0 direct_sexdrive=0 ok=1")
      (call sexos_line "[physical_keyboard.quil.done] ok=1")
      (= (-> q physical_keyboard_active) false))

    (comment "A buffer the physical keyboard proof must not mistake for typed keys is cleared, with the reason.")
    (fn (static void) physical_clear ((Quil (* q)) ((const char) (* reason)))
      (if (! (-> q physical_keyboard_active)) (return))
      (= (-> q buffer_len) 0)
      (= (-> q cursor_pos) 0)
      (call sexos_line "[physical_keyboard.buffer.cleared] reason=%s" reason))

    (comment "LANE3 high-bit proof: the real content path (quil_persist_save, quil_persist_load on READ_V2) must carry bytes with the high bit set exactly, which OP_DISKFS_READ could misread as errors. The pattern is printable with 0x00, 0x7f, 0x80 and 0xff spliced in, each checked at its offset and the whole by FNV-1a. Then a load from an invalid path id must fail and leave buffer and dirty state intact.")
    (var (static const uint8_t) ([] HIGHBIT_PATTERN 33)
      (init 0x48 0x49 0x47 0x48 0x42 0x49 0x54 0x2D 0x50 0x52 0x4F 0x4F 0x46 0x2D 0x41 0x2D 0x00 0x2D 0x42 0x2D 0x7F 0x2D 0x43 0x2D 0x80 0x2D 0x44 0x2D 0xFF 0x2D 0x45 0x4E 0x44))
    (fn (static void) run_quil_read_v2_highbit_proof ((Quil (* q)))
      (call sexos_line "[quil.read_v2.highbit.begin]")
      (var uint64_t lo 0)
      (var uint64_t hi 0)
      (call pack_bytes (cast ((const uint8_t) *) "hibitproof") 10 (& lo) (& hi))
      (var uint64_t id 0)
      (var int64_t e (call pdx_storage_call_bounded q OP_DISKFS_CREATE 0 lo hi (& id)))
      (if (!= e 0)
        (block
          (call sexos_line "[quil.read_v2.highbit.err] stage=create err=%lld" (cast (long long) e))
          (call sexos_line "[quil.read_v2.highbit.done] ok=0")
          (return)))
      (= (-> q doc_id) id)
      (= (-> q last_doc_id) id)
      (for (var size_t i 0) (< i 33) (++ i) (= ([] (-> q buffer) i) ([] HIGHBIT_PATTERN i)))
      (= (-> q buffer_len) 33)
      (if (! (call quil_persist_save q (& e)))
        (block
          (call sexos_line "[quil.read_v2.highbit.err] stage=save err=%lld" (cast (long long) e))
          (call sexos_line "[quil.read_v2.highbit.done] ok=0")
          (return)))
      (comment "A sentinel unlike the pattern, so a match proves the load refilled the buffer.")
      (for (var size_t i 0) (< i 33) (++ i) (= ([] (-> q buffer) i) 0xAA))
      (= (-> q buffer_len) 0)
      (if (! (call quil_persist_load q (& e)))
        (block
          (call sexos_line "[quil.read_v2.highbit.err] stage=load err=%lld" (cast (long long) e))
          (call sexos_line "[quil.read_v2.highbit.done] ok=0")
          (return)))
      (var size_t got_len (-> q buffer_len))
      (var bool matched (== got_len 33))
      (for (var size_t i 0) (&& (< i got_len) (< i 33)) (++ i) (if (!= ([] (-> q buffer) i) ([] HIGHBIT_PATTERN i)) (= matched false)))
      (var uint64_t hash (call fnv1a (-> q buffer) got_len))
      (var (static const uint8_t) ([] probes 4) (init 0x00 0x7F 0x80 0xFF))
      (var (static const size_t) ([] probe_at 4) (init 16 20 24 28))
      (var (static const char) (* (const) ([] probe_labels 4)) (init "0x00" "0x7f" "0x80" "0xff"))
      (for (var size_t k 0) (< k 4) (++ k)
        (call sexos_line "[quil.read_v2.highbit.byte] label=%s ok=%u" ([] probe_labels k)
          (cast unsigned (&& (< ([] probe_at k) (-> q buffer_len)) (== ([] (-> q buffer) ([] probe_at k)) ([] probes k))))))
      (call sexos_line "[quil.read_v2.highbit.result] len=%zu expected_len=33 hash=%#llx ok=%u" got_len (cast (unsigned long long) hash) (cast unsigned matched))
      (comment "Negative: simulate an unsaved edit, then force a failed load through path id 9999.")
      (var size_t before_len (-> q buffer_len))
      (= (-> q dirty) true)
      (var uint64_t saved_doc_id (-> q doc_id))
      (= (-> q doc_id) 9999)
      (var bool reported_failure (! (call quil_persist_load q (& e))))
      (var bool intact (&& (== (-> q buffer_len) before_len) (== (call fnv1a (-> q buffer) (-> q buffer_len)) hash)))
      (var bool dirty_kept (-> q dirty))
      (= (-> q doc_id) saved_doc_id)
      (var bool neg_ok (&& (&& reported_failure intact) dirty_kept))
      (call sexos_line "[quil.read_v2.highbit.negative] reported_failure=%u buffer_intact=%u dirty_preserved=%u ok=%u" (cast unsigned reported_failure)
        (cast unsigned intact) (cast unsigned dirty_kept) (cast unsigned neg_ok))
      (call sexos_line "[quil.read_v2.highbit.done] ok=%u" (cast unsigned (&& matched neg_ok))))

    (comment "Keyboard nav proof: seed Down, Up and Enter into the stash and replay them, before the storage proofs that can hang.")
    (fn (static void) run_keyboard_nav_proof ((Quil (* q)))
      (var (static const uint64_t) ([] codes 3) (init 0x50 0x48 0x1C))
      (var (static const char) (* (const) ([] names 3)) (init "0x50" "0x48" "0x1C"))
      (for (var size_t k 0) (< k 3) (++ k)
        (block
          (var size_t idx (call seed_key q ([] codes k)))
          (if (!= idx SIZE_MAX) (call sexos_line "[quil.keyboard.nav.proof] stage=%zu action=seed_stash idx=%zu code=%s" k idx ([] names k)))))
      (call sexos_line "[quil.keyboard.nav.proof] stage=3 action=stash_done count=%zu" (-> q hid_stash_count))
      (cast void (call replay_phase q "synthetic_proof"))
      (call sexos_line "[quil.keyboard.nav.proof.done] ok=1"))

    (comment "Keyboard buffer proof: Up (to row 4), Down, Down (row 1, Save) and Enter, replayed with saves held back by buffer_proof_active; the palette has no delete.")
    (fn (static void) run_keyboard_buffer_proof ((Quil (* q)))
      (= (-> q buffer_proof_active) true)
      (var (static const uint64_t) ([] codes 4) (init 0x48 0x50 0x50 0x1C))
      (var (static const char) (* (const) ([] actions 4)) (init "seed_nav_up" "seed_nav_down" "seed_nav_down" "seed_enter"))
      (var (static const char) (* (const) ([] names 4)) (init "0x48" "0x50" "0x50" "0x1C"))
      (for (var size_t k 0) (< k 4) (++ k)
        (block
          (var size_t idx (call seed_key q ([] codes k)))
          (if (!= idx SIZE_MAX) (call sexos_line "[quil.keyboard.buffer.proof] stage=%zu action=%s idx=%zu code=%s" k ([] actions k) idx ([] names k)))))
      (call sexos_line "[quil.keyboard.buffer.proof] stage=4 action=seed_done count=%zu" (-> q hid_stash_count))
      (var size_t count (-> q hid_stash_count))
      (if (> count 0)
        (block
          (call sexos_line "[quil.keyboard.buffer.proof] stage=5 action=replay_begin count=%zu" count)
          (call replay_stash q true)
          (call sexos_line "[quil.hid.replay.done] count=%zu" count)))
      (call sexos_line "[quil.keyboard.buffer.proof] stage=6 action=delete_proof ok=1 reason=skipped_no_delete_cmd")
      (call sexos_line "[quil.delete.proof] buffer_id=0 ok=1 reason=skipped_no_delete_in_palette_v1")
      (call sexos_line "[quil.keyboard.buffer.proof.done] ok=1")
      (= (-> q buffer_proof_active) false))

    (comment "A proof's seeded key, with the stage, action and code its marker shows.")
    (typedef (struct ProofKey ((const char) (* stage)) ((const char) (* action)) (uint64_t code) ((const char) (* code_text))) ProofKey)

    (comment "Text buffer proof: type Hello, Enter, Quil, Backspace, ! (unshifted: 1) and Enter with the palette off, then verify.")
    (fn (static void) run_text_buffer_proof ((Quil (* q)))
      (= (-> q buffer_proof_active) true)
      (call sexos_line "[quil.text.buffer.proof.begin]")
      (= (-> q palette_active) false)
      (var (static const ProofKey) ([] keys 6)
        (init (init "0" "seed_H" 0x23 "0x23") (init "1" "seed_e" 0x12 "0x12") (init "2a" "seed_l" 0x26 "0x26") (init "2b" "seed_l" 0x26 "0x26")
              (init "3" "seed_o" 0x18 "0x18") (init "4" "seed_enter" 0x1C "0x1C")))
      (for (var size_t k 0) (< k 6) (++ k)
        (block
          (var size_t idx (call seed_key q (. ([] keys k) code)))
          (if (!= idx SIZE_MAX)
            (call sexos_line "[quil.text.buffer.proof] stage=%s action=%s idx=%zu code=%s" (. ([] keys k) stage) (. ([] keys k) action) idx (. ([] keys k) code_text)))))
      (var (static const uint64_t) ([] quil_codes 4) (init 0x10 0x16 0x17 0x26))
      (for (var size_t k 0) (< k 4) (++ k)
        (block
          (var size_t idx (call seed_key q ([] quil_codes k)))
          (if (!= idx SIZE_MAX)
            (call sexos_line "[quil.text.buffer.proof] stage=%zu action=seed_char idx=%zu code=%#llx" (+ k 5) idx (cast (unsigned long long) ([] quil_codes k))))))
      (var size_t idx (call seed_key q 0x0E))
      (if (!= idx SIZE_MAX) (call sexos_line "[quil.text.buffer.proof] stage=9 action=seed_backspace idx=%zu code=0x0E" idx))
      (= idx (call seed_key q 0x02))
      (if (!= idx SIZE_MAX) (call sexos_line "[quil.text.buffer.proof] stage=10 action=seed_excl idx=%zu code=0x02" idx))
      (= idx (call seed_key q 0x1C))
      (if (!= idx SIZE_MAX) (call sexos_line "[quil.text.buffer.proof] stage=11 action=seed_enter2 idx=%zu code=0x1C" idx))
      (call sexos_line "[quil.text.buffer.proof] stage=12 action=seed_done count=%zu" (-> q hid_stash_count))
      (var size_t count (-> q hid_stash_count))
      (if (> count 0)
        (block
          (call sexos_line "[quil.text.buffer.proof] stage=13 action=replay_begin count=%zu" count)
          (call replay_stash q true)
          (call sexos_line "[quil.hid.replay.done] count=%zu" count)))
      (call sexos_line "[quil.text.buffer.proof] stage=14 action=verify len=%zu lines=%zu" (-> q buffer_len)
        (call text_buffer_line_count (-> q buffer) (-> q buffer_len)))
      (call sexos_line "[quil.text.buffer.proof.done] ok=1")
      (= (-> q buffer_proof_active) false)
      (= (-> q palette_active) true))

    (comment "Text save async proof: a fire-and-forget open is the most pdx_call can do; a write needs the handle from its reply.")
    (fn (static void) run_text_save_async_proof ((Quil (* q)))
      (call sexos_line "[quil.text.save.proof.begin]")
      (call sexos_line "[quil.text.save.audit] safe=1 reason=storage_slot_available_fire_and_forget_open_pdx_call")
      (var uint64_t n0 0)
      (var uint64_t n1 0)
      (call pack_name QUIL_DOC_NAME (& n0) (& n1))
      (var SexosReply sent (call sexos_pdx_call SEXOS_SLOT_storage OP_RAMFS_OPEN n0 n1 (<< RAMFS_O_CREATE 24)))
      (call sexos_line "[quil.text.save.send] len=%zu status=%llu err=%u" (-> q buffer_len) (cast (unsigned long long) (. sent status)) (cast unsigned (!= (. sent status) 0)))
      (call sexos_line "[quil.text.save.audit] safe=0 reason=no_async_write_path_requires_handle_from_open_reply")
      (call sexos_line "[quil.text.save.proof.done] ok=1"))

    (fn (static void) type_text ((Quil (* q)) ((const char) (* text)))
      (for (var size_t i 0) (!= ([] text i) 0) (++ i) (cast void (call text_buffer_append q (cast uint8_t ([] text i))))))

    (comment "Text commands proof: clear, type HELLO, QUIL, summarize, backspace three times. Both summaries report the line count taken before the backspaces, and the length as the cursor, as the Rust does.")
    (fn (static void) run_text_commands_proof ((Quil (* q)))
      (call sexos_line "[quil.text.command.proof.begin]")
      (= (-> q buffer_len) 0)
      (call sexos_line "[quil.text.command] name=clear ok=1 reason=buffer_zeroed")
      (call type_text q "HELLO\nQUIL")
      (call sexos_line "[quil.text.command] name=type ok=1 reason=seed_phrase")
      (var size_t lines (call text_buffer_line_count (-> q buffer) (-> q buffer_len)))
      (call sexos_line "[quil.text.summary] bytes=%zu lines=%zu cursor=%zu" (-> q buffer_len) lines (-> q buffer_len))
      (call sexos_line "[quil.text.command] name=summary ok=1 reason=stats_emitted")
      (for (var unsigned i 0) (< i 3) (++ i) (cast void (call text_buffer_backspace q)))
      (call sexos_line "[quil.text.summary] bytes=%zu lines=%zu cursor=%zu" (-> q buffer_len) lines (-> q buffer_len))
      (call sexos_line "[quil.text.command] name=cursor ok=1 reason=backspace_tracking")
      (call sexos_line "[quil.text.command.proof.done] ok=1"))

    (fn (static void) proof_cursor_move ((Quil (* q)) (size_t pos) ((const char) (* dir)))
      (var size_t old (-> q cursor_pos))
