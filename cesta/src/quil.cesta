      (call sexos_line "[quil.cursor.move] old=%zu new=%zu len=%zu dir=%s ok=1" old pos (-> q buffer_len) dir))

    (comment "Cursor navigation proof on AB: left, right, home, end, and left clamped at 0.")
    (fn (static void) run_cursor_nav_proof ((Quil (* q)))
      (call sexos_line "[quil.cursor.proof.begin]")
      (= (-> q palette_active) false)
      (= (-> q buffer_len) 0)
      (= (-> q cursor_pos) 0)
      (call type_text q "AB")
      (call proof_cursor_move q (?: (> (-> q cursor_pos) 0) (- (-> q cursor_pos) 1) 0) "left")
      (call proof_cursor_move q (?: (< (-> q cursor_pos) (-> q buffer_len)) (+ (-> q cursor_pos) 1) (-> q cursor_pos)) "right")
      (call proof_cursor_move q 0 "home")
      (call proof_cursor_move q (-> q buffer_len) "end")
      (comment "Left from the end after a jump to 0: clamped there.")
      (call proof_cursor_move q 0 "left")
      (call sexos_line "[quil.cursor.proof.done] ok=1")
      (= (-> q palette_active) true))

