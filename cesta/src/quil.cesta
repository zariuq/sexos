          (return)))
      (if (== code 0x4D)
        (block
          (call move_cursor_logged q (?: (< (-> q cursor_pos) (-> q buffer_len)) (+ (-> q cursor_pos) 1) (-> q cursor_pos)) "right")
          (return)))
      (if (== code 0x47)
        (block
          (call move_cursor_logged q 0 "home")
          (return)))
      (if (== code 0x4F)
        (block
          (call move_cursor_logged q (-> q buffer_len) "end")
          (return)))
      (if (== code 0x53)
        (block
          (cast void (call text_buffer_delete_char q))
          (call redraw q)
          (return)))
      (var uint8_t ch 0)
      (if (call scancode_to_char code event_shift (& ch))
