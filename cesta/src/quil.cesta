      (for (var size_t i 0) (< i len) (++ i) (= ([] (-> q buffer) i) (cast uint8_t ([] QUIL_TEXT_INIT i))))
      (= (-> q buffer_len) len))

    (comment "The editor's fallible operations give true, or false with the Rust's Err value in *err (which can be 0: a READ_V2 status with no magnitude).")
    (fn (static bool) fail ((int64_t (* err)) (int64_t e))
      (= (* err) e)
      (return false))

    (comment "Save the buffer to the RamFS file QUIL_DOC_NAME: open (creating it), 8-byte writes, close.")
    (fn (static bool) quil_save ((Quil (* q)) (int64_t (* err)))
      (var size_t len (-> q buffer_len))
