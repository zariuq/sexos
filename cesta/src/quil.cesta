(cesta native-c/1 compact-c/2
  (unit
    (include "sexos_server.h")
    (include "sexos_document_client_transport.h")
    (include "quil_autosave.h")
    (comment "Quil text editor server, translated from servers/quil/src/main.rs. The Rust statics (the document, the reload staging copy, the undo ring, cursor, selection, find and clipboard state, the HID stash and the log budgets) and the palette locals of _start are fields of one Quil state in static storage: the document, staging copy and undo ring take about 96 KiB, more than a protection domain's 64 KiB stack. The Rust installs an allocator that always fails and defines memcpy, memset, memmove and memcmp; the runtime provides those here. Each startup proof runs once, so the Rust's per-proof done flags, which nothing reads afterwards, have no counterpart, and neither has its dead code (pad_text_line, an uncalled physical-keyboard setup).")

    (comment "Build-time proof profiles: option_env! in the Rust source, and the cfg! gate sexfiles_quil_persistence_proof (rustc --cfg).")
    (cpp-if "defined(SEXOS_STORAGE_CAP_PROOF)" (then (define STORAGE_CAP_PROOF_ENABLED "1")) (else (define STORAGE_CAP_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_DISKFS_SLOT_PROOF)" (then (define DISKFS_SLOT_PROOF_ENABLED "1")) (else (define DISKFS_SLOT_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_READ_V2_HIGHBIT_PROOF)" (then (define READ_V2_HIGHBIT_PROOF_ENABLED "1")) (else (define READ_V2_HIGHBIT_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_KEYBOARD_NAV_PROOF)" (then (define KEYBOARD_NAV_PROOF_ENABLED "1")) (else (define KEYBOARD_NAV_PROOF_ENABLED "0")))
    (cpp-if "!defined(SEXOS_QUIL_CURRENT_KEYS)" (then (define SEXOS_QUIL_CURRENT_KEYS "1")))
    (cpp-if "!defined(SEXOS_QUIL_CURRENT_DOCUMENT)" (then (define SEXOS_QUIL_CURRENT_DOCUMENT "SEXOS_QUIL_CURRENT_KEYS")))
    (cpp-if "!defined(SEXOS_QUIL_CURRENT_KEYS_PROOF)" (then (define SEXOS_QUIL_CURRENT_KEYS_PROOF "0")))
    (define CURRENT_KEYS_PROOF_ENABLED "SEXOS_QUIL_CURRENT_KEYS_PROOF")
    (cpp-if "defined(SEXOS_QUIL_KEYBOARD_BUFFER_PROOF)" (then (define KEYBOARD_BUFFER_PROOF_ENABLED "1")) (else (define KEYBOARD_BUFFER_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_TEXT_BUFFER_PROOF)" (then (define TEXT_BUFFER_PROOF_ENABLED "1")) (else (define TEXT_BUFFER_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_TEXT_SAVE_ASYNC_PROOF)" (then (define TEXT_SAVE_ASYNC_PROOF_ENABLED "1")) (else (define TEXT_SAVE_ASYNC_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_TEXT_COMMANDS_PROOF)" (then (define TEXT_COMMANDS_PROOF_ENABLED "1")) (else (define TEXT_COMMANDS_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_CURSOR_NAV_PROOF)" (then (define CURSOR_NAV_PROOF_ENABLED "1")) (else (define CURSOR_NAV_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_TEXT_SELECTION_PROOF)" (then (define TEXT_SELECTION_PROOF_ENABLED "1")) (else (define TEXT_SELECTION_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_TEXT_DELETE_PROOF)" (then (define TEXT_DELETE_PROOF_ENABLED "1")) (else (define TEXT_DELETE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_EDITOR_KEYBINDINGS_PROOF)" (then (define EDITOR_KEYBINDINGS_PROOF_ENABLED "1")) (else (define EDITOR_KEYBINDINGS_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_UNDO_REDO_PROOF)" (then (define UNDO_REDO_PROOF_ENABLED "1")) (else (define UNDO_REDO_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_UNDO_REDO_KEY_PROOF)" (then (define UNDO_REDO_KEY_PROOF_ENABLED "1")) (else (define UNDO_REDO_KEY_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_VISUAL_CURSOR_PROOF)" (then (define VISUAL_CURSOR_PROOF_ENABLED "1")) (else (define VISUAL_CURSOR_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_FIND_PROOF)" (then (define FIND_PROOF_ENABLED "1")) (else (define FIND_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_MOD_LOWERCASE_PROOF)" (then (define MOD_LOWERCASE_PROOF_ENABLED "1")) (else (define MOD_LOWERCASE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_WORD_NAV_PROOF)" (then (define WORD_NAV_PROOF_ENABLED "1")) (else (define WORD_NAV_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_LINE_STATS_PROOF)" (then (define LINE_STATS_PROOF_ENABLED "1")) (else (define LINE_STATS_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_FIND_NAV_PROOF)" (then (define FIND_NAV_PROOF_ENABLED "1")) (else (define FIND_NAV_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_SEL_COPY_DELETE_PROOF)" (then (define SEL_COPY_DELETE_PROOF_ENABLED "1")) (else (define SEL_COPY_DELETE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_DIRTY_PROOF)" (then (define DIRTY_PROOF_ENABLED "1")) (else (define DIRTY_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_CMD_SURFACE_PROOF)" (then (define CMD_SURFACE_PROOF_ENABLED "1")) (else (define CMD_SURFACE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_CLIPBOARD_STATUS_PROOF)" (then (define CLIPBOARD_STATUS_PROOF_ENABLED "1")) (else (define CLIPBOARD_STATUS_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_PASTE_PROOF)" (then (define PASTE_PROOF_ENABLED "1")) (else (define PASTE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_REPLACE_PROOF)" (then (define REPLACE_PROOF_ENABLED "1")) (else (define REPLACE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_GOTO_LINE_PROOF)" (then (define GOTO_LINE_PROOF_ENABLED "1")) (else (define GOTO_LINE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_STORAGE_PHASEA_PROOF)" (then (define STORAGE_PHASEA_PROOF_ENABLED "1")) (else (define STORAGE_PHASEA_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_SAVE_OPEN_SEXOBJECT_PROOF)" (then (define SAVE_OPEN_SEXOBJECT_PROOF_ENABLED "1")) (else (define SAVE_OPEN_SEXOBJECT_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_TEXT_INPUT_PIPELINE_PROOF)" (then (define TEXT_INPUT_PIPELINE_PROOF_ENABLED "1")) (else (define TEXT_INPUT_PIPELINE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_LIVE_USB_CREATE_SAVE_REOPEN_PROOF)" (then (define LIVE_USB_PROOF_ENABLED "1")) (else (define LIVE_USB_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_QUIL_PHYSICAL_KEYBOARD_PROOF)" (then (define PHYSICAL_KEYBOARD_PROOF_ENABLED "1")) (else (define PHYSICAL_KEYBOARD_PROOF_ENABLED "0")))
    (cpp-if "defined(sexfiles_quil_persistence_proof)" (then (define PERSISTENCE_PROOF_ENABLED "1")) (else (define PERSISTENCE_PROOF_ENABLED "0")))

    (define OP_HID_EVENT "UINT64_C(0x202)")
    (comment "Shell-to-Quil route ping (no display authority), and LINEN_DISK_OPEN_V1's nudge to restore a disk document (arg1 the DiskFS V3 path id).")
    (define OP_QUIL_PING "UINT64_C(0xD0)")
    (define OP_QUIL_OPEN_DISK_DOC "UINT64_C(0x4A)")
    (comment "sexdisplay text: 0xFB draws eight ASCII bytes (arg2: offset bits 0-7 and 12-15, count bits 8-11, color bits 32-63); 0xFA clears.")
    (define OP_TEXT_DRAW "UINT64_C(0xFB)")
    (define OP_TEXT_CLEAR "UINT64_C(0xFA)")
    (comment "APP_SURFACE_PACK_V1: Quil draws on its own content surface; the shell-owned frame 201 rejects this domain's draws.")
    (define QUIL_CONTENT_SID "UINT64_C(156)")
    (define SURFACE_W "UINT64_C(640)")
    (define SURFACE_H "UINT64_C(480)")
    (define QUIL_TITLE "\"Quil\"")
    (define QUIL_TITLE_MAX_LEN "((size_t)32)")
    (comment "DISKFS_V4: 12 KiB, three DiskFS content blocks. The renderer draws at most 24 rows; layout tables hold 768 display lines (one per byte would be 24 KiB of stack).")
    (define QUIL_BUFFER_MAX_LEN "((size_t)12288)")
    (define QUIL_MAX_VISIBLE_LINES "((size_t)24)")
    (define QUIL_MAX_DISPLAY_LINES "((size_t)768)")
    (comment "QUIL_TEXT_V3: the display layout of sexdisplay's TEXT_MODEL_V2, split at newlines and wrapped at 80 columns, and a 22-row viewport.")
    (define QUIL_VIEW_COLS "((size_t)80)")
    (define QUIL_VIEW_ROWS "((size_t)22)")
    (define UNDO_DEPTH "((size_t)6)")
    (define HID_STASH_CAPACITY "((size_t)8)")
    (comment "RamFS (SEXFILES_RAMFS_CONTRACT_LOCK_V1: names of at most 24 bytes, 8 bytes per write or read) and DiskFS opcodes of SexFiles.")
    (define OP_RAMFS_OPEN "UINT64_C(0x30)")
    (define OP_RAMFS_READ "UINT64_C(0x31)")
    (define OP_RAMFS_WRITE "UINT64_C(0x32)")
    (define OP_RAMFS_CLOSE "UINT64_C(0x33)")
    (define RAMFS_O_CREATE "UINT64_C(0x01)")
    (define OP_DISKFS_WRITE "UINT64_C(0x38)")
    (define OP_DISKFS_STAT "UINT64_C(0x3B)")
    (define OP_DISKFS_SELECT "UINT64_C(0x3E)")
    (define OP_DISKFS_CREATE "UINT64_C(0x42)")
    (define OP_DISKFS_LIST "UINT64_C(0x43)")
    (comment "DISKFS_V4: cut the selected object to an exact length after a save, so a shorter save leaves no stale tail.")
    (define OP_DISKFS_TRUNCATE "UINT64_C(0x49)")
    (comment "LANE3: the canonical read. Its reply keeps a status in bits 56-63, a length (or an error's magnitude) in bits 48-55 and up to six payload bytes below, so no data byte can read as an error.")
    (define OP_DISKFS_READ_V2 "UINT64_C(0x4A)")
    (define DISKFS_V2_MAX_READ "((size_t)6)")
    (define DISKFS_V2_STATUS_OK "UINT64_C(0x00)")
    (define DISKFS_V2_STATUS_EOF "UINT64_C(0x01)")
    (define QUIL_DISKFS_PATH_ID "UINT64_C(2)")
    (define QUIL_DISKFS_EXPECT_SIZE "UINT64_C(4096)")
    (define QUIL_DISKFS_EXPECT_FLAGS "UINT64_C(0x3)")
    (comment "QUIL_PERSIST_V1: the DiskFS document header, magic QP01 and the length.")
    (define QUIL_PERSIST_MAGIC "UINT64_C(0x31305051)")
    (define ERR_CAP_INVALID "UINT64_C(0xFFFFFFFFFFFFFFFC)")
    (comment "Surface geometry: the title bar (rect 1), the palette panel (rect 0) under the original six text lines, and its rows.")
    (define QUIL_TITLE_BAR_H "UINT64_C(32)")
    (define QUIL_TITLE_BAR_COLOR "UINT64_C(0x00302E56)")
    (define QUIL_LINE_BG "UINT64_C(0x000C1420)")
    (define QUIL_GLYPH_COLOR "UINT64_C(0x00D4FF7A)")
    (define TEXT_LINE_COLOR "UINT64_C(0x00E0F0FF)")
    (define QUIL_RECT_SLOT_MIN "UINT64_C(2)")
    (define QUIL_RECT_SLOT_MAX "UINT64_C(7)")
    (define QUIL_ROWS "((uint8_t)5)")
    (define QUIL_PANEL_X "UINT64_C(24)")
    (define QUIL_PANEL_Y "(QUIL_TITLE_BAR_H + 8 + 6 * (18 + 4))")
    (define QUIL_PANEL_W "(SURFACE_W - 48)")
    (define QUIL_PANEL_H "(SURFACE_H - QUIL_PANEL_Y - 16)")
    (define QUIL_ROW_X "(QUIL_PANEL_X + 16)")
    (define QUIL_ROW_Y0 "(QUIL_PANEL_Y + 16)")
    (define QUIL_ROW_W "(QUIL_PANEL_W - 32)")
    (define QUIL_ROW_H "UINT64_C(32)")
    (define QUIL_ROW_GAP "UINT64_C(8)")
    (define QUIL_ACCENT_W "UINT64_C(6)")
    (define QUIL_ROW_INACTIVE "UINT64_C(0x00253556)")
    (define QUIL_ROW_SELECTED "UINT64_C(0x004B6FD3)")
    (define QUIL_ACCENT_COLOR "UINT64_C(0x00E9D36A)")
    (comment "Palette commands. Row 0 stays a harmless stub: the shell's open-quil Enter can leak into the palette there.")
    (define CMD_NEW_BUFFER "((uint8_t)1)")
    (define CMD_SAVE_DOCUMENT "((uint8_t)2)")
    (define CMD_LOAD_DOCUMENT "((uint8_t)3)")
    (define CMD_RUN_CHECK_STUB "((uint8_t)4)")
    (define CMD_SETTINGS_STUB "((uint8_t)5)")
    (var (static const uint8_t) ([] PALETTE_COMMANDS 5) (init CMD_RUN_CHECK_STUB CMD_SAVE_DOCUMENT CMD_LOAD_DOCUMENT CMD_NEW_BUFFER CMD_SETTINGS_STUB))

    (var (static const char) ([] QUIL_TEXT_INIT) "This is the Quil text surface.\nA minimal no_std editor prototype.\nBuilt on the Sex Microkernel.\nNo text rendering available yet.\nFill-rect visual representation.\nBuffer capacity: bounded static array.\nPress arrows to navigate, ESC for cmds.")
    (comment "The fixed RamFS document name.")
    (var (static const char) ([] QUIL_DOC_NAME) "quil_doc_01")

    (typedef (struct HidStashEntry (uint64_t code) (uint64_t value) (uint64_t mod)) HidStashEntry)
    (typedef (struct Quil
      (uint8_t ([] buffer QUIL_BUFFER_MAX_LEN)) (size_t buffer_len)
      (comment "LANE3: a reload is staged here and copied into the buffer only when complete, so a failed or partial one leaves buffer and dirty state as they were.")
      (uint8_t ([] load_staging QUIL_BUFFER_MAX_LEN))
      (comment "QUIL_EDITOR_V1: unsaved edits, the status line's *; cleared by save, load and New Buffer.")
      (bool dirty)
      (comment "QUIL_DOC_V1: the open document's DiskFS V3 path id (UINT64_MAX untitled) and the last real one, which Load falls back to after New Buffer.")
      (uint64_t doc_id) (uint64_t last_doc_id) (uint8_t ([] doc_title 16))
      (comment "Modal name entry, for the first save of an untitled document.")
      (bool name_mode) (uint8_t ([] name_buf 16)) (size_t name_len)
      (comment "QUIL_TEXT_V3: the viewport's top display line and the sticky column of Up and Down (SIZE_MAX: take it from the cursor).")
      (size_t view_top) (size_t goal_col)
      (size_t cursor_pos) (size_t sel_start) (size_t sel_end)
      (bool shift_held) (bool control_held)
      (bool goto_active) (uint32_t goto_line_value)
      (comment "The edit flag of the selection and dirty proofs, apart from dirty.")
      (bool edited)
      (uint8_t ([] find_query 32)) (size_t find_qlen) (size_t ([] find_matches 16)) (uint8_t find_count) (uint8_t find_cur)
      (bool find_active) (bool find_replacement_field) (uint8_t ([] find_replacement 32)) (size_t find_rlen)
      (uint8_t ([] clipboard 256)) (size_t clipboard_len)
      (comment "DISKFS_V4: one whole buffer per level; six levels keep the ring near 72 KiB.")
      (uint8_t ([] ([] undo_ring UNDO_DEPTH) QUIL_BUFFER_MAX_LEN)) (size_t ([] undo_cursors UNDO_DEPTH)) (size_t ([] undo_lens UNDO_DEPTH))
      (size_t undo_head) (size_t undo_count) (size_t undo_redo_count)
      (comment "The palette (the Rust's locals of _start).")
      (bool palette_active) (uint8_t selected_row)
      (comment "The keyboard buffer and text buffer proofs replay saves that must not touch storage.")
      (bool buffer_proof_active)
      (bool physical_keyboard_active) (bool save_open_pending) (bool live_usb_pending)
      (comment "HID events that arrive while a storage reply is awaited, replayed later.")
      (HidStashEntry ([] hid_stash HID_STASH_CAPACITY)) (size_t hid_stash_count)
      (comment "pdx_listen_raw's wrapper log budget is one per process: every blocking listen shares it.")
      (SexosListener listener)
      (uint32_t palette_draw_log) (uint32_t palette_panel_log) (uint32_t palette_selected_log) (uint32_t palette_row_log)
      (uint32_t key_log) (uint32_t palette_key_log) (uint32_t listen_log) (uint32_t route_log) (uint32_t unknown_log)
      (comment "Liveness feedback for unmapped keys: a full-surface color toggle.")
      (bool palette_color_toggle) (bool text_color_toggle)
      (DocumentClient document) (DocumentClientTransport document_transport) (QuilAutosave autosave)
      (uint64_t revision) (bool delete_armed) (uint8_t delete_object) (uint64_t delete_revision)) Quil)

    (var (static Quil) quil_state)

    (fn (static void) quil_init ((Quil (* q)))
      (= (-> q doc_id) 2)
      (= (-> q last_doc_id) 2)
      (var (static const char) ([] title) "n-v1")
      (for (var size_t i 0) (< i 4) (++ i) (= ([] (-> q doc_title) i) (cast uint8_t ([] title i))))
      (= (-> q goal_col) SIZE_MAX)
      (for (var size_t i 0) (< i 16) (++ i) (= ([] (-> q find_matches) i) 0xFFFF))
      (= (-> q palette_active) true)
      (= (. (-> q listener) wrapper_budget) 8)
      (= (-> q palette_draw_log) 12)
      (= (-> q palette_panel_log) 8)
      (= (-> q palette_selected_log) 16)
      (= (-> q palette_row_log) 20)
      (= (-> q key_log) 16)
      (= (-> q palette_key_log) 24)
      (= (-> q listen_log) 8)
      (= (-> q route_log) 8)
      (= (-> q unknown_log) 8)
      (cpp-if "SEXOS_QUIL_CURRENT_DOCUMENT"
        (then
          (call document_client_init (& (-> q document)))
          (call document_client_transport_init (& (-> q document_transport)))
          (call quil_autosave_init (& (-> q autosave)))
          (var DocumentSnapshotRegion snapshot)
          (if (! (call document_snapshot_resolve_client (& snapshot))) (call sexos_fail))
          (if (! (call document_client_set_snapshot (& (-> q document)) snapshot)) (call sexos_fail)))))

    (fn (static void) quil_mark_edited ((Quil (* q)))
      (cpp-if "SEXOS_QUIL_CURRENT_DOCUMENT"
        (then
          (if (== (-> q revision) UINT64_MAX) (call sexos_fail))
          (+= (-> q revision) 1)
          (= (-> q delete_armed) false)))
      (= (-> q dirty) true))

    (cpp-if "SEXOS_QUIL_CURRENT_DOCUMENT"
      (then (native "static void quil_current_delete(Quil *q);
static bool quil_current_step(Quil *q);
")))

    (comment "A budget allows its line while it lasts.")
    (fn (static bool) take ((uint32_t (* budget)))
      (if (== (* budget) 0) (return false))
      (-= (* budget) 1)
      (return true))

    (comment "Rust's `as i64` of a reply word, with defined arithmetic.")
    (fn (static bool) is_negative ((uint64_t word)) (return (!= (>> word 63) 0)))
    (fn (static int64_t) wrap_i64 ((uint64_t word))
      (return (?: (call is_negative word) (- (- (cast int64_t (~ word))) 1) (cast int64_t word))))

    (fn (static size_t) min_size ((size_t a) (size_t b)) (return (?: (< a b) a b)))

    (comment "FNV-1a over a byte range, so gates can assert exact content.")
    (fn (static uint64_t) fnv1a (((const uint8_t) (* bytes)) (size_t len))
      (var uint64_t h (cast uint64_t 0xcbf29ce484222325))
      (for (var size_t i 0) (< i len) (++ i)
        (block
          (^= h ([] bytes i))
          (*= h (cast uint64_t 0x100000001b3))))
      (return h))

    (comment "One printable ASCII byte as a string, for Rust's {} of a char.")
    (typedef (struct CharText (char ([] text 2))) CharText)
    (fn (static CharText) char_text ((uint8_t ch))
      (return (compound CharText (= (. text) (init (cast char ch) 0)))))

    (fn (static size_t) quil_doc_name_len (((const Quil) (* q)))
      (var size_t n 0)
      (while (&& (< n 16) (!= ([] (-> q doc_title) n) 0)) (+= n 1))
      (return n))

    (comment "QUIL_TEXT_V3: the display lines of BUF (split at newlines, wrapped at 80 columns); starts[i] is the byte offset of line i. Bytes are characters: the editor is ASCII-only.")
    (fn (static size_t) quil_layout (((const uint8_t) (* buf)) (size_t len) (uint16_t (* starts)))
      (var size_t count 1)
      (= ([] starts 0) 0)
      (var size_t col 0)
      (var size_t i 0)
      (while (< i len)
        (block
          (var uint8_t c ([] buf i))
          (+= i 1)
          (if (== c 0x0A)
            (block
              (if (>= count QUIL_MAX_DISPLAY_LINES) break)
              (= ([] starts count) (cast uint16_t i))
              (+= count 1)
              (= col 0))
            (block
              (+= col 1)
              (if (&& (>= col QUIL_VIEW_COLS) (< i len))
                (block
                  (if (>= count QUIL_MAX_DISPLAY_LINES) break)
                  (= ([] starts count) (cast uint16_t i))
                  (+= count 1)
                  (= col 0)))))))
      (return count))

    (comment "The display line holding byte offset POS.")
    (fn (static size_t) quil_line_of (((const uint16_t) (* starts)) (size_t count) (size_t pos))
      (var size_t line 0)
      (for (var size_t i 0) (< i count) (++ i)
        (if (<= (cast size_t ([] starts i)) pos) (= line i) break))
      (return line))

    (comment "Lines split at newlines, at most the 24 the renderer draws.")
    (fn (static size_t) text_buffer_line_count (((const uint8_t) (* buf)) (size_t len))
      (var size_t lines 0)
      (for (var size_t i 0) (< i len) (++ i) (if (== ([] buf i) 0x0A) (+= lines 1)))
      (if (|| (== lines 0) (!= ([] buf (- len 1)) 0x0A)) (+= lines 1))
      (return (call min_size lines QUIL_MAX_VISIBLE_LINES)))

    (fn (static bool) validate_title (((const char) (* title)))
      (var size_t len (call sexos_strlen title))
      (var bool valid (&& (<= len QUIL_TITLE_MAX_LEN) (> len 0)))
      (if (! valid) (call sexos_line "[quil.text.title.reject] title=%s len=%zu max=%zu" title len QUIL_TITLE_MAX_LEN))
      (return valid))

    (fn (static bool) validate_buffer ((size_t len))
      (var bool valid (&& (<= len QUIL_BUFFER_MAX_LEN) (> len 0)))
      (if (! valid) (call sexos_line "[quil.text.buffer.reject] bytes=%zu max=%zu" len QUIL_BUFFER_MAX_LEN))
      (return valid))

    (fn (static void) draw_fill ((uint64_t arg1) (uint64_t arg2))
      (cast void (call sexos_pdx_call SEXOS_SLOT_display 0xEF QUIL_CONTENT_SID arg1 arg2)))

    (comment "The title bar fill, rect 1.")
    (fn (static void) draw_title_bar (void)
      (call draw_fill 0 (| (| (| (<< (cast uint64_t 1) 56) (<< QUIL_TITLE_BAR_COLOR 32)) (<< QUIL_TITLE_BAR_H 16)) SURFACE_W)))

    (comment "Send the buffer to sexdisplay: the status line (the name prompt, or the title, the length's last three digits, B and * when dirty), then the 22-row window around the cursor with the caret as #, padded past 32 bytes and sent highest chunk first, so the surface's text length clears sexdisplay's per-draw diagnostic at once (spindle's reverse-chunk dodge). The 512-byte render buffer is separate from the document.")
    (fn (static void) draw_text_lines ((Quil (* q)) ((const uint8_t) (* buf)) (size_t len))
      (cast void (call sexos_pdx_call SEXOS_SLOT_display OP_TEXT_CLEAR QUIL_CONTENT_SID 0 0))
      (var size_t line_count (call text_buffer_line_count buf len))
      (call sexos_line "[quil.text.draw.v2] lines=%zu bytes=%zu visible=%zu dirty=%u" line_count len
        (call min_size line_count QUIL_MAX_VISIBLE_LINES) (cast unsigned (-> q dirty)))
      (var uint8_t ([] line_buf 512) (init 0))
      (var size_t sp 0)
      (if (-> q name_mode)
        (block
          (var (const char) (* prompt) "NAME? ")
          (for (var size_t i 0) (< i 6) (++ i) (= ([] line_buf (post++ sp)) (cast uint8_t ([] prompt i))))
          (for (var size_t i 0) (< i (-> q name_len)) (++ i) (= ([] line_buf (post++ sp)) ([] (-> q name_buf) i)))
          (= ([] line_buf (post++ sp)) 0x23)
          (= ([] line_buf (post++ sp)) 0x0A))
        (if (&& SEXOS_QUIL_CURRENT_KEYS (-> q find_active))
          (block
            (var (const char) (* prompt) (?: (-> q find_replacement_field) "With: " "Find: "))
            (for (var size_t i 0) (< i 6) (++ i) (= ([] line_buf (post++ sp)) (cast uint8_t ([] prompt i))))
            (var (const uint8_t) (* field) (?: (-> q find_replacement_field) (-> q find_replacement) (-> q find_query)))
            (var size_t field_len (?: (-> q find_replacement_field) (-> q find_rlen) (-> q find_qlen)))
            (for (var size_t i 0) (< i field_len) (++ i) (= ([] line_buf (post++ sp)) ([] field i)))
            (= ([] line_buf (post++ sp)) 0x0A))
          (if (&& SEXOS_QUIL_CURRENT_KEYS (-> q goto_active))
            (block
              (var (const char) (* prompt) "Go to line: ")
              (for (var size_t i 0) (< i 12) (++ i) (= ([] line_buf (post++ sp)) (cast uint8_t ([] prompt i))))
              (var uint32_t value (-> q goto_line_value))
              (if (== value 0) (= ([] line_buf (post++ sp)) '0')
                (block
                  (var uint8_t ([] digits 10) (init 0))
                  (var size_t count 0)
                  (while (> value 0)
                    (block (= ([] digits (post++ count)) (cast uint8_t (+ '0' (% value 10)))) (/= value 10)))
                  (while (> count 0)
                    (block (-= count 1) (= ([] line_buf (post++ sp)) ([] digits count))))))
              (= ([] line_buf (post++ sp)) 0x0A))
            (block
              (var size_t n (call quil_doc_name_len q))
              (for (var size_t i 0) (< i n) (++ i) (= ([] line_buf (post++ sp)) ([] (-> q doc_title) i)))
              (= ([] line_buf (post++ sp)) 0x20)
              (if (>= len 100) (= ([] line_buf (post++ sp)) (cast uint8_t (+ 0x30 (% (/ len 100) 10)))))
              (if (>= len 10) (= ([] line_buf (post++ sp)) (cast uint8_t (+ 0x30 (% (/ len 10) 10)))))
              (= ([] line_buf (post++ sp)) (cast uint8_t (+ 0x30 (% len 10))))
              (= ([] line_buf (post++ sp)) 0x42)
              (if (-> q dirty) (= ([] line_buf (post++ sp)) 0x2A))
              (= ([] line_buf (post++ sp)) 0x0A)))))
      (var uint16_t ([] starts QUIL_MAX_DISPLAY_LINES) (init 0))
      (var size_t count (call quil_layout buf len starts))
      (var size_t cursor (call min_size (-> q cursor_pos) len))
      (var size_t cline (call quil_line_of starts count cursor))
      (if (< cline (-> q view_top)) (= (-> q view_top) cline))
      (if (>= cline (+ (-> q view_top) QUIL_VIEW_ROWS)) (= (-> q view_top) (- (+ cline 1) QUIL_VIEW_ROWS)))
      (if (>= (-> q view_top) count) (= (-> q view_top) (- count 1)))
      (var size_t view_start ([] starts (call min_size (-> q view_top) (- count 1))))
      (var size_t view_end (?: (< (+ (-> q view_top) QUIL_VIEW_ROWS) count) (cast size_t ([] starts (+ (-> q view_top) QUIL_VIEW_ROWS))) len))
      (call sexos_line "[quil.view] top=%zu cursor=%zu win=%zu..%zu" (-> q view_top) cursor view_start view_end)
      (var size_t total sp)
      (for (var size_t i view_start) (&& (<= i view_end) (< total 512)) (++ i)
        (block
          (if (&& (== i cursor) (< total 512)) (= ([] line_buf (post++ total)) 0x23))
          (if (&& (< i view_end) (< total 512)) (= ([] line_buf (post++ total)) ([] buf i)))))
      (while (< total 40) (= ([] line_buf (post++ total)) 0x20))
      (var size_t chunks (/ (+ total 7) 8))
      (for (var size_t k chunks) (> k 0) (-- k)
        (block
          (var size_t offset (* (- k 1) 8))
          (var size_t chunk_len (call min_size (- total offset) 8))
          (var uint64_t packed 0)
          (for (var size_t j 0) (< j chunk_len) (++ j) (|= packed (<< (cast uint64_t ([] line_buf (+ offset j))) (* j 8))))
          (cast void (call sexos_pdx_call SEXOS_SLOT_display OP_TEXT_DRAW QUIL_CONTENT_SID packed
            (| (| (| (& (cast uint64_t offset) 0xFF) (<< (& (cast uint64_t chunk_len) 0xF) 8)) (<< (& (>> (cast uint64_t offset) 8) 0xF) 12))
               (<< TEXT_LINE_COLOR 32))))))
      (call sexos_line "[quil.text.draw.v2.sent] total_bytes=%zu chunks=%zu" total chunks)
      (if (> line_count QUIL_MAX_VISIBLE_LINES)
        (call sexos_line "[quil.text.buffer.overflow] lines=%zu visible=%zu" line_count QUIL_MAX_VISIBLE_LINES)))

    (fn (static void) redraw ((Quil (* q))) (call draw_text_lines q (-> q buffer) (-> q buffer_len)))

    (comment "QUIL_TEXT_V3: the cursor one display line up (DIR below 0) or down, at the sticky goal column; the newline ending the target line is outside it.")
    (fn (static void) quil_cursor_vertical ((Quil (* q)) (int dir))
      (var uint16_t ([] starts QUIL_MAX_DISPLAY_LINES) (init 0))
      (var size_t count (call quil_layout (-> q buffer) (-> q buffer_len) starts))
      (var size_t line (call quil_line_of starts count (-> q cursor_pos)))
      (if (== (-> q goal_col) SIZE_MAX) (= (-> q goal_col) (- (-> q cursor_pos) ([] starts line))))
      (var size_t target 0)
      (if (< dir 0)
        (block
          (if (== line 0)
            (block
              (call sexos_line "[quil.cursor.move] dir=up ok=0 reason=first_line")
              (return)))
          (= target (- line 1)))
        (block
          (if (>= (+ line 1) count)
            (block
              (call sexos_line "[quil.cursor.move] dir=down ok=0 reason=last_line")
              (return)))
          (= target (+ line 1))))
      (var size_t t_start ([] starts target))
      (var size_t t_end (-> q buffer_len))
      (if (< (+ target 1) count)
        (block
          (var size_t e ([] starts (+ target 1)))
          (= t_end (?: (&& (> e t_start) (== ([] (-> q buffer) (- e 1)) 0x0A)) (- e 1) e))))
      (var size_t old (-> q cursor_pos))
      (= (-> q cursor_pos) (+ t_start (call min_size (-> q goal_col) (- t_end t_start))))
      (call sexos_line "[quil.cursor.move] old=%zu new=%zu len=%zu dir=%s ok=1" old (-> q cursor_pos) (-> q buffer_len) (?: (< dir 0) "up" "down"))
      (call redraw q))

    (fn (static void) emit_rect_slot ((uint64_t slot) (uint64_t x) (uint64_t y) (uint64_t w) (uint64_t h) (uint64_t color))
      (call draw_fill (| (<< y 32) x) (| (| (| (<< slot 56) (<< color 32)) (<< h 16)) w)))

    (comment "Pseudo-glyphs from rect slots 2 to 7, which fit only a prefix of QUIL TEXT ALIVE: Q (block and tail), U (two stems and a base), I (a stem).")
    (typedef (struct GlyphRect (uint64_t dx) (uint64_t dy) (uint64_t w) (uint64_t h) (uint64_t color)) GlyphRect)
    (var (static const GlyphRect) ([] GLYPH_RECTS 6)
      (init (init 0 0 14 18 QUIL_GLYPH_COLOR) (init 9 12 5 6 QUIL_TITLE_BAR_COLOR) (init 18 0 3 15 QUIL_GLYPH_COLOR)
            (init 27 0 3 15 QUIL_GLYPH_COLOR) (init 18 15 12 3 QUIL_GLYPH_COLOR) (init 38 0 3 18 QUIL_GLYPH_COLOR)))
    (fn (static void) draw_rect_glyph_text (void)
      (var uint64_t slot QUIL_RECT_SLOT_MIN)
      (for (var size_t i 0) (< i 6) (++ i)
        (if (<= slot QUIL_RECT_SLOT_MAX)
          (block
            (var (const GlyphRect) (* r) (& ([] GLYPH_RECTS i)))
            (call emit_rect_slot slot (+ 462 (-> r dx)) (+ 6 (-> r dy)) (-> r w) (-> r h) (-> r color))
            (+= slot 1))))
      (var uint64_t emitted (- slot QUIL_RECT_SLOT_MIN))
      (call sexos_line "[quil.rect_glyph_text.v1] text=QUIL_TEXT_ALIVE shown=%u rects=%llu" (?: (>= emitted 6) 3u (?: (>= emitted 5) 2u 1u))
        (cast (unsigned long long) emitted)))

    (comment "The palette panel (rect 0, redrawn on each key) and its five rows, the selected one highlighted with an accent.")
    (fn (static void) draw_palette ((Quil (* q)) (uint8_t selected))
      (call draw_fill (| (<< QUIL_PANEL_Y 32) QUIL_PANEL_X) (| (| (<< QUIL_ROW_INACTIVE 32) (<< QUIL_PANEL_H 16)) QUIL_PANEL_W))
      (if (call take (& (-> q palette_draw_log))) (call sexos_line "[quil.palette.draw] rows=%u selected=%u" (cast unsigned QUIL_ROWS) (cast unsigned selected)))
      (if (call take (& (-> q palette_panel_log)))
        (call sexos_line "[quil.palette.panel] x=%llu y=%llu w=%llu h=%llu" (cast (unsigned long long) QUIL_PANEL_X)
          (cast (unsigned long long) QUIL_PANEL_Y) (cast (unsigned long long) QUIL_PANEL_W) (cast (unsigned long long) QUIL_PANEL_H)))
      (if (> (+ (+ QUIL_ROW_Y0 (* (cast uint64_t QUIL_ROWS) QUIL_ROW_H)) (* (- (cast uint64_t QUIL_ROWS) 1) QUIL_ROW_GAP)) (+ QUIL_PANEL_Y QUIL_PANEL_H))
        (call sexos_line "[quil.palette.reject] action=draw reason=row_overflow"))
      (for (var uint8_t row 0) (< row QUIL_ROWS) (++ row)
        (block
          (var uint64_t y (+ QUIL_ROW_Y0 (* (+ QUIL_ROW_H QUIL_ROW_GAP) row)))
          (var bool is_selected (== row selected))
          (call draw_fill (| (<< y 32) QUIL_ROW_X) (| (| (<< (?: is_selected QUIL_ROW_SELECTED QUIL_ROW_INACTIVE) 32) (<< QUIL_ROW_H 16)) QUIL_ROW_W))
          (if is_selected
            (block
              (call draw_fill (| (<< y 32) QUIL_ROW_X) (| (| (<< QUIL_ACCENT_COLOR 32) (<< QUIL_ROW_H 16)) QUIL_ACCENT_W))
              (if (call take (& (-> q palette_selected_log))) (call sexos_line "[quil.palette.selected] row=%u" (cast unsigned row)))))
          (if (call take (& (-> q palette_row_log))) (call sexos_line "[quil.palette.row] row=%u selected=%u" (cast unsigned row) (cast unsigned is_selected))))))

    (comment "Palette keys: 1 up, 2 down, 3 enter, 4 esc, 0 none, over the scancode variants seen in this codebase.")
    (fn (static uint8_t) decode_palette_key ((uint64_t scancode))
      (switch (cast uint32_t scancode)
        (block
          (case 0x48 (case 0x67 (return 1)))
          (case 0x50 (case 0x6c (return 2)))
          (case 0x1c (case 0x0d (return 3)))
          (case 0x01 (case 0x1b (return 4)))
          (default (return 0)))))

    (comment "Scancode set 1 (US QWERTY) to ASCII: letters; digits, shifted to ! @ # $ % ^ & * ( ); the punctuation keys, ; and :, ' and \", , and <, . and >, / and ?; and space, which has no shifted form.")
    (typedef (struct KeyChar (uint8_t code) (uint8_t plain) (uint8_t shifted)) KeyChar)
    (var (static const KeyChar) ([] KEY_CHARS)
      (init (init 0x10 'q' 'Q') (init 0x11 'w' 'W') (init 0x12 'e' 'E') (init 0x13 'r' 'R') (init 0x14 't' 'T') (init 0x15 'y' 'Y')
            (init 0x16 'u' 'U') (init 0x17 'i' 'I') (init 0x18 'o' 'O') (init 0x19 'p' 'P') (init 0x1E 'a' 'A') (init 0x1F 's' 'S')
            (init 0x20 'd' 'D') (init 0x21 'f' 'F') (init 0x22 'g' 'G') (init 0x23 'h' 'H') (init 0x24 'j' 'J') (init 0x25 'k' 'K')
            (init 0x26 'l' 'L') (init 0x2C 'z' 'Z') (init 0x2D 'x' 'X') (init 0x2E 'c' 'C') (init 0x2F 'v' 'V') (init 0x30 'b' 'B')
            (init 0x31 'n' 'N') (init 0x32 'm' 'M')
            (init 0x02 '1' 0x21) (init 0x03 '2' 0x40) (init 0x04 '3' 0x23) (init 0x05 '4' 0x24) (init 0x06 '5' 0x25) (init 0x07 '6' 0x5E)
            (init 0x08 '7' 0x26) (init 0x09 '8' 0x2A) (init 0x0A '9' 0x28) (init 0x0B '0' 0x29) (init 0x27 0x3B 0x3A) (init 0x28 0x27 0x22)
            (init 0x33 0x2C 0x3C) (init 0x34 0x2E 0x3E) (init 0x35 0x2F 0x3F) (init 0x39 0x20 0x20)))
    (fn (static bool) scancode_to_char ((uint64_t scancode) (bool shift) (uint8_t (* out)))
      (for (var size_t i 0) (< i (/ (sizeof KEY_CHARS) (sizeof ([] KEY_CHARS 0)))) (++ i)
        (if (== (. ([] KEY_CHARS i) code) (cast uint8_t scancode))
          (block
            (= (* out) (?: shift (. ([] KEY_CHARS i) shifted) (. ([] KEY_CHARS i) plain)))
            (return true))))
      (return false))

    (comment "Undo: save the buffer and cursor in the ring before an edit; the oldest level is overwritten when full, and an edit clears redo.")
    (fn (static void) text_buffer_undo_push ((Quil (* q)))
      (= (-> q edited) true)
      (var uint8_t (* slot) ([] (-> q undo_ring) (-> q undo_head)))
      (for (var size_t i 0) (< i QUIL_BUFFER_MAX_LEN) (++ i) (= ([] slot i) (?: (< i (-> q buffer_len)) ([] (-> q buffer) i) 0)))
      (= ([] (-> q undo_lens) (-> q undo_head)) (-> q buffer_len))
      (= ([] (-> q undo_cursors) (-> q undo_head)) (-> q cursor_pos))
      (= (-> q undo_head) (% (+ (-> q undo_head) 1) UNDO_DEPTH))
      (if (< (-> q undo_count) UNDO_DEPTH) (+= (-> q undo_count) 1))
      (= (-> q undo_redo_count) 0)
      (call sexos_line "[quil.undo.push] idx=%zu len=%zu ok=1" (?: (== (-> q undo_head) 0) (- UNDO_DEPTH 1) (- (-> q undo_head) 1)) (-> q buffer_len)))

    (fn (static void) restore_level ((Quil (* q)) (size_t level))
      (var size_t len ([] (-> q undo_lens) level))
      (for (var size_t i 0) (< i len) (++ i) (= ([] (-> q buffer) i) ([] ([] (-> q undo_ring) level) i)))
      (= (-> q buffer_len) len)
      (= (-> q cursor_pos) ([] (-> q undo_cursors) level)))

    (fn (static bool) text_buffer_undo ((Quil (* q)))
      (if (== (-> q undo_count) 0) (return false))
      (var size_t old_len (-> q buffer_len))
      (if (< (-> q undo_redo_count) UNDO_DEPTH) (+= (-> q undo_redo_count) 1))
      (= (-> q undo_head) (?: (== (-> q undo_head) 0) (- UNDO_DEPTH 1) (- (-> q undo_head) 1)))
      (-= (-> q undo_count) 1)
      (call restore_level q (-> q undo_head))
      (cpp-if "SEXOS_QUIL_CURRENT_DOCUMENT" (then (call quil_mark_edited q)))
      (call sexos_line "[quil.undo.apply] old_len=%zu new_len=%zu ok=1" old_len (-> q buffer_len))
      (return true))

    (comment "Redo restores the level the head points at after an undo, then moves past it.")
    (fn (static bool) text_buffer_redo ((Quil (* q)))
      (if (== (-> q undo_redo_count) 0) (return false))
      (var size_t old_len (-> q buffer_len))
      (call restore_level q (-> q undo_head))
      (cpp-if "SEXOS_QUIL_CURRENT_DOCUMENT" (then (call quil_mark_edited q)))
      (= (-> q undo_head) (% (+ (-> q undo_head) 1) UNDO_DEPTH))
      (+= (-> q undo_count) 1)
      (-= (-> q undo_redo_count) 1)
      (call sexos_line "[quil.redo.apply] old_len=%zu new_len=%zu ok=1" old_len (-> q buffer_len))
      (return true))

    (comment "Open a gap of one byte at the cursor (QUIL_TEXT_V3: insertion at the cursor) and put CH there.")
    (fn (static void) insert_at_cursor ((Quil (* q)) (uint8_t ch))
      (if (> (-> q cursor_pos) (-> q buffer_len)) (= (-> q cursor_pos) (-> q buffer_len)))
      (for (var size_t i (-> q buffer_len)) (> i (-> q cursor_pos)) (-- i) (= ([] (-> q buffer) i) ([] (-> q buffer) (- i 1))))
      (= ([] (-> q buffer) (-> q cursor_pos)) ch)
      (+= (-> q buffer_len) 1)
      (+= (-> q cursor_pos) 1)
      (= (-> q goal_col) SIZE_MAX)
      (call quil_mark_edited q))

    (comment "Type a character at the cursor; control characters other than newline are dropped (after the undo push, as in the Rust).")
    (fn (static bool) text_buffer_append ((Quil (* q)) (uint8_t ch))
      (call text_buffer_undo_push q)
      (if (>= (-> q buffer_len) QUIL_BUFFER_MAX_LEN)
        (block
          (call sexos_line "[quil.text.append] len=%zu ch=%u ok=0 reason=buffer_full" (-> q buffer_len) (cast unsigned ch))
          (return false)))
      (if (&& (< ch 0x20) (!= ch 0x0A)) (return false))
      (call insert_at_cursor q ch)
      (call sexos_line "[quil.text.append] len=%zu ch=%u at=%zu" (-> q buffer_len) (cast unsigned ch) (- (-> q cursor_pos) 1))
      (return true))

    (comment "Backspace: delete the byte before the cursor; deleting a newline joins the lines.")
    (fn (static bool) text_buffer_backspace ((Quil (* q)))
      (call text_buffer_undo_push q)
      (if (> (-> q cursor_pos) (-> q buffer_len)) (= (-> q cursor_pos) (-> q buffer_len)))
      (if (|| (== (-> q buffer_len) 0) (== (-> q cursor_pos) 0))
        (block
          (call sexos_line "[quil.text.backspace] old=%zu new=%zu ok=0 reason=at_start" (-> q buffer_len) (-> q buffer_len))
          (return false)))
      (var size_t old (-> q buffer_len))
      (for (var size_t i (- (-> q cursor_pos) 1)) (< i (- (-> q buffer_len) 1)) (++ i) (= ([] (-> q buffer) i) ([] (-> q buffer) (+ i 1))))
      (-= (-> q buffer_len) 1)
      (-= (-> q cursor_pos) 1)
      (= ([] (-> q buffer) (-> q buffer_len)) 0)
      (= (-> q goal_col) SIZE_MAX)
      (call quil_mark_edited q)
      (call sexos_line "[quil.text.backspace] old=%zu new=%zu at=%zu ok=1" old (-> q buffer_len) (-> q cursor_pos))
      (return true))

    (fn (static bool) text_buffer_newline ((Quil (* q)))
      (call text_buffer_undo_push q)
      (if (>= (-> q buffer_len) QUIL_BUFFER_MAX_LEN)
        (block
          (call sexos_line "[quil.text.enter] line=0 len=%zu ok=0 reason=buffer_full" (-> q buffer_len))
          (return false)))
      (call insert_at_cursor q 0x0A)
      (call sexos_line "[quil.text.enter] line=%zu len=%zu at=%zu ok=1" (call text_buffer_line_count (-> q buffer) (-> q buffer_len))
        (-> q buffer_len) (- (-> q cursor_pos) 1))
      (return true))

    (comment "Remove COUNT bytes at FROM, zeroing the vacated tail.")
    (fn (static void) remove_range ((Quil (* q)) (size_t from) (size_t count))
      (var size_t end (?: (> (-> q buffer_len) count) (- (-> q buffer_len) count) 0))
      (for (var size_t i from) (< i end) (++ i) (= ([] (-> q buffer) i) ([] (-> q buffer) (+ i count))))
      (-= (-> q buffer_len) count)
      (for (var size_t i (-> q buffer_len)) (&& (< i (+ (-> q buffer_len) count)) (< i QUIL_BUFFER_MAX_LEN)) (++ i) (= ([] (-> q buffer) i) 0)))

    (comment "Delete the byte at the cursor.")
    (fn (static bool) text_buffer_delete_char ((Quil (* q)))
      (call text_buffer_undo_push q)
      (if (>= (-> q cursor_pos) (-> q buffer_len)) (return false))
      (var size_t old (-> q buffer_len))
      (call remove_range q (-> q cursor_pos) 1)
      (call quil_mark_edited q)
      (call sexos_line "[quil.text.delete] mode=char old=%zu new=%zu ok=1" old (-> q buffer_len))
      (return true))

    (comment "Delete from the cursor to the end of its line (the newline stays).")
    (fn (static bool) text_buffer_delete_to_eol ((Quil (* q)))
      (call text_buffer_undo_push q)
      (if (>= (-> q cursor_pos) (-> q buffer_len)) (return false))
      (var size_t eol (-> q cursor_pos))
      (while (&& (< eol (-> q buffer_len)) (!= ([] (-> q buffer) eol) 0x0A)) (+= eol 1))
      (var size_t count (- eol (-> q cursor_pos)))
      (if (== count 0) (return false))
      (var size_t old (-> q buffer_len))
      (call remove_range q (-> q cursor_pos) count)
      (call quil_mark_edited q)
      (call sexos_line "[quil.text.delete] mode=to_eol old=%zu new=%zu ok=1" old (-> q buffer_len))
      (return true))

    (comment "Delete the cursor's whole line with its newline. This edit does not set dirty, as in the Rust.")
    (fn (static bool) text_buffer_delete_line ((Quil (* q)))
      (call text_buffer_undo_push q)
      (if (== (-> q buffer_len) 0) (return false))
      (var size_t line_start (-> q cursor_pos))
      (while (&& (> line_start 0) (!= ([] (-> q buffer) (- line_start 1)) 0x0A)) (-= line_start 1))
      (var size_t line_end line_start)
      (while (&& (< line_end (-> q buffer_len)) (!= ([] (-> q buffer) line_end) 0x0A)) (+= line_end 1))
      (if (< line_end (-> q buffer_len)) (+= line_end 1))
      (var size_t old (-> q buffer_len))
      (call remove_range q line_start (- line_end line_start))
      (cpp-if "SEXOS_QUIL_CURRENT_DOCUMENT" (then (call quil_mark_edited q)))
      (if (> (-> q cursor_pos) (-> q buffer_len)) (= (-> q cursor_pos) (-> q buffer_len)))
      (call sexos_line "[quil.text.delete] mode=line old=%zu new=%zu ok=1" old (-> q buffer_len))
      (return true))

    (fn (static bool) buffer_matches (((const Quil) (* q)) (size_t at) ((const uint8_t) (* query)) (size_t qlen))
      (for (var size_t k 0) (< k qlen) (++ k) (if (!= ([] (-> q buffer) (+ at k)) ([] query k)) (return false)))
      (return true))

    (comment "Every occurrence of QUERY (1 to 32 bytes): the first index (0xFFFF none) and the count, a u8 that wraps.")
    (fn (static size_t) text_buffer_find (((const Quil) (* q)) ((const char) (* text)) (uint8_t (* count)))
