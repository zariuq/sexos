      (var int64_t e (call pdx_storage_call q OP_RAMFS_OPEN n0 n1 (<< RAMFS_O_CREATE 24) (& handle)))
      (if (!= e 0)
        (block
          (call sexos_line "[quil.save.fail] open error=%lld" (cast (long long) e))
          (return (call fail err e))))
