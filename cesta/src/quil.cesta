          (comment "QUIL_EDITOR_V1: clear the document (the disk copy stays until the next save); QUIL_DOC_V1: it is untitled until its first save.")
          (for (var size_t i 0) (< i QUIL_BUFFER_MAX_LEN) (++ i) (= ([] (-> q buffer) i) 0))
