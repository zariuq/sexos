(cesta native-c/1 compact-c/2
  (unit
    (include "sexfiles.h")

    (comment "SexFiles server: message defer ring, SexObject header adapter, RamFS backend, DiskFS V4 bridge, VFS dispatch, and trampoline entry (servers/sexfiles/src/{pdx,sexobject,backends/ramfs,vfs,trampoline,main}.rs).")

    (comment "Build-time proof flags and cfg gates (servers/sexfiles/src/trampoline.rs & build.rs).")
    (cpp-if "defined(SEXFILES_RAMFS_PROOF)"
      (then (define RAMFS_PROOF_ENABLED "1"))
      (else (define RAMFS_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_DISKFS_OBJECT_TABLE_PROOF)"
      (then (define DISKFS_OBJECT_TABLE_PROOF_ENABLED "1"))
      (else (define DISKFS_OBJECT_TABLE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SEXFILES_JOURNAL_PROOF)"
      (then (define SEXFILES_JOURNAL_PROOF_ENABLED "1"))
      (else (define SEXFILES_JOURNAL_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SEXFILES_REPLAY_PROOF)"
      (then (define SEXFILES_REPLAY_PROOF_ENABLED "1"))
      (else (define SEXFILES_REPLAY_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SEXFILES_CAP_RECORD_PROOF)"
      (then (define SEXFILES_CAP_RECORD_PROOF_ENABLED "1"))
      (else (define SEXFILES_CAP_RECORD_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_LINEN_SEXFILES_METADATA_PROOF)"
      (then (define LINEN_SEXFILES_METADATA_PROOF_ENABLED "1"))
      (else (define LINEN_SEXFILES_METADATA_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SEXFILES_FAULT_INJECTION_PROOF)"
      (then (define SEXFILES_FAULT_INJECTION_PROOF_ENABLED "1"))
      (else (define SEXFILES_FAULT_INJECTION_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SEXFILES_REAL_BLOCK_PROOF)"
      (then (define SEXFILES_REAL_BLOCK_PROOF_ENABLED "1"))
      (else (define SEXFILES_REAL_BLOCK_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SEXFILES_REBOOT_PROOF)"
      (then (define SEXFILES_REBOOT_PROOF_ENABLED "1"))
      (else (define SEXFILES_REBOOT_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SEXFILES_EXTENT_PROOF)"
      (then (define SEXFILES_EXTENT_PROOF_ENABLED "1"))
      (else (define SEXFILES_EXTENT_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SEXFILES_CHECKPOINT_PROOF)"
      (then (define SEXFILES_CHECKPOINT_PROOF_ENABLED "1"))
      (else (define SEXFILES_CHECKPOINT_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXFILES_ROUTE_AUDIT_ONLY)"
      (then (define SEXFILES_ROUTE_AUDIT_ONLY_ENABLED "1"))
      (else (define SEXFILES_ROUTE_AUDIT_ONLY_ENABLED "0")))
    (cpp-if "defined(SEXOS_SEXOBJECT_VIEW_PROOF)"
      (then (define SEXOBJECT_VIEW_PROOF_ENABLED "1"))
      (else (define SEXOBJECT_VIEW_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_LINEN_DISK_OBJECT_PROOF)"
      (then (define LINEN_DISK_OBJECT_PROOF_ENABLED "1"))
      (else (define LINEN_DISK_OBJECT_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXFS_V0_SUPERBLOCK_FORMAT_MOUNT_PROOF)"
      (then (define SEXFS_V0_SUPERBLOCK_FORMAT_MOUNT_PROOF_ENABLED "1"))
      (else (define SEXFS_V0_SUPERBLOCK_FORMAT_MOUNT_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOBJECT_TABLE_PERSIST_PROOF)"
      (then (define SEXOBJECT_TABLE_PERSIST_PROOF_ENABLED "1"))
      (else (define SEXOBJECT_TABLE_PERSIST_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOBJECT_TABLE_EXTENT_ALLOC_PROOF)"
      (then (define SEXOBJECT_TABLE_EXTENT_ALLOC_PROOF_ENABLED "1"))
      (else (define SEXOBJECT_TABLE_EXTENT_ALLOC_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOBJECT_EXTENT_WRITE_FULL_BLOCK_PROOF)"
      (then (define SEXOBJECT_EXTENT_WRITE_FULL_BLOCK_PROOF_ENABLED "1"))
      (else (define SEXOBJECT_EXTENT_WRITE_FULL_BLOCK_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOBJECT_WRITE_READ_PERSIST_PROOF)"
      (then (define SEXOBJECT_WRITE_READ_PERSIST_PROOF_ENABLED "1"))
      (else (define SEXOBJECT_WRITE_READ_PERSIST_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOBJECT_MULTI_OBJECT_PROOF)"
      (then (define SEXOBJECT_MULTI_OBJECT_PROOF_ENABLED "1"))
      (else (define SEXOBJECT_MULTI_OBJECT_PROOF_ENABLED "0")))

    (cpp-if "defined(sexfiles_diskfs100_ap4_write) || defined(SEXFILES_DISKFS_100_AP4_WRITE)"
      (then (define DISKFS_100_AP4_WRITE_PROOF_ENABLED "1"))
      (else (define DISKFS_100_AP4_WRITE_PROOF_ENABLED "0")))
    (cpp-if "defined(sexfiles_diskfs100_ap4_read) || defined(SEXFILES_DISKFS_100_AP4_READ) || defined(sexfiles_diskfs100_ap5_neg_read_no_write) || defined(SEXFILES_DISKFS_100_AP5_NEG_READ_NO_WRITE)"
      (then (define DISKFS_100_AP4_READ_PROOF_ENABLED "1"))
      (else (define DISKFS_100_AP4_READ_PROOF_ENABLED "0")))
    (cpp-if "defined(sexfiles_diskfs100_ap5_neg_read_no_write) || defined(SEXFILES_DISKFS_100_AP5_NEG_READ_NO_WRITE)"
      (then (define DISKFS_100_AP5_NEG_READ_NO_WRITE_ENABLED "1"))
      (else (define DISKFS_100_AP5_NEG_READ_NO_WRITE_ENABLED "0")))
    (cpp-if "defined(sexfiles_diskfs100_ap5_neg_mismatch) || defined(SEXFILES_DISKFS_100_AP5_NEG_MISMATCH)"
      (then (define DISKFS_100_AP5_NEG_MISMATCH_ENABLED "1"))
      (else (define DISKFS_100_AP5_NEG_MISMATCH_ENABLED "0")))
    (cpp-if "defined(sexfiles_diskfs100_ap5_neg_missing_image) || defined(SEXFILES_DISKFS_100_AP5_NEG_MISSING_IMAGE)"
      (then (define DISKFS_100_AP5_NEG_MISSING_IMAGE_ENABLED "1"))
      (else (define DISKFS_100_AP5_NEG_MISSING_IMAGE_ENABLED "0")))
    (cpp-if "defined(sexfiles_diskfs100_ap5_neg_flush_skip) || defined(SEXFILES_DISKFS_100_AP5_NEG_FLUSH_SKIP)"
      (then (define DISKFS_100_AP5_NEG_FLUSH_SKIP_ENABLED "1"))
      (else (define DISKFS_100_AP5_NEG_FLUSH_SKIP_ENABLED "0")))
    (cpp-if "defined(sexfiles_diskfs100_ap6_flush_fsync) || defined(SEXFILES_DISKFS_100_AP6_FLUSH_FSYNC)"
      (then (define DISKFS_100_AP6_FLUSH_FSYNC_ENABLED "1"))
      (else (define DISKFS_100_AP6_FLUSH_FSYNC_ENABLED "0")))
    (cpp-if "defined(sexfiles_diskfs_negative_bounds_auth_proof) || defined(SEXFILES_DISKFS_NEGATIVE_BOUNDS_AUTH_PROOF)"
      (then (define DISKFS_NEGATIVE_BOUNDS_AUTH_PROOF_ENABLED "1"))
      (else (define DISKFS_NEGATIVE_BOUNDS_AUTH_PROOF_ENABLED "0")))
    (cpp-if "defined(sexfiles_diskfs_bridge_strict_proof) || defined(SEXFILES_DISKFS_BRIDGE_STRICT_PROOF)"
      (then (define DISKFS_BRIDGE_STRICT_PROOF_ENABLED "1"))
      (else (define DISKFS_BRIDGE_STRICT_PROOF_ENABLED "0")))
    (cpp-if "defined(sexfiles_diskfs100_ap2_proof) || defined(SEXFILES_DISKFS_100_PROOF)"
      (then (define DISKFS_100_AP2_PROOF_ENABLED "1"))
      (else (define DISKFS_100_AP2_PROOF_ENABLED "0")))
    (cpp-if "defined(sexfiles_diskfs100_ap3_proof) || defined(SEXFILES_DISKFS_100_AP3_PROOF)"
      (then (define DISKFS_100_AP3_PROOF_ENABLED "1"))
      (else (define DISKFS_100_AP3_PROOF_ENABLED "0")))
    (cpp-if "defined(sexfiles_diskfs_multi_object_proof) || defined(SEXFILES_DISKFS_100_AP3_PROOF)"
      (then (define DISKFS_MULTI_OBJECT_PROOF_ENABLED "1"))
      (else (define DISKFS_MULTI_OBJECT_PROOF_ENABLED "0")))

    (var (type SexfilesState (_Alignas 4096)) sexfiles_state)

    (fn void sexfiles_state_init ((SexfilesState (* s)))
      (call memset s 0 (sizeof (* s)))
      (= (. (-> s listener) wrapper_budget) 8)
      (= (-> s trampoline_hot_log_budget) 120)
      (= (-> s tramp_listen_budget) 8)
      (= (-> s vfs_hot_log_budget) 200)
      (= (-> s diskfs_hot_log_budget) 200)
      (= (-> s ramfs_next_object_id) 1)
      (= (-> s ramfs_next_handle) 1)
      (= (. (-> s diskfs_state) next_tx_id) 1)
      (= (. (-> s diskfs_state) next_checkpoint_generation) 1)
      (= (-> s diskfs_next_object_id) 1))

    (fn bool sexfiles_take_budget ((uint32_t (* budget)))
      (if (> (* budget) 0)
        (block
          (-= (* budget) 1)
          (return true)))
      (return false))

    (comment "SEXFILES_DEFER_V1: defer ring for client messages arriving during diskfs_block_call (servers/sexfiles/src/pdx.rs).")
    (fn bool defer_stash ((uint64_t type_id) (uint32_t caller_pd) (uint64_t a0) (uint64_t a1) (uint64_t a2))
      (if (>= (. sexfiles_state defer_len) DEFER_CAP)
        (block
          (call sexos_line "[sexfiles.defer.drop] type=%#llx caller=%u reason=stash_full"
            (cast (unsigned long long) type_id) (cast unsigned caller_pd))
          (return false)))
      (var size_t i (. sexfiles_state defer_len))
      (= ([] (. sexfiles_state defer_ring) i)
        (compound DeferEntry
          (= (. type_id) type_id)
          (= (. caller_pd) caller_pd)
          (= (. a0) a0)
          (= (. a1) a1)
          (= (. a2) a2)))
      (= (. sexfiles_state defer_len) (+ i 1))
      (call sexos_line "[sexfiles.defer.stash] type=%#llx caller=%u depth=%zu"
        (cast (unsigned long long) type_id) (cast unsigned caller_pd) (+ i 1))
      (return true))

    (fn bool defer_pop ((DeferEntry (* out)))
      (if (== (. sexfiles_state defer_len) 0)
        (return false))
      (var DeferEntry m ([] (. sexfiles_state defer_ring) 0))
      (var size_t n (. sexfiles_state defer_len))
      (for (var size_t i 1) (< i n) (++ i)
        (= ([] (. sexfiles_state defer_ring) (- i 1)) ([] (. sexfiles_state defer_ring) i)))
      (= (. sexfiles_state defer_len) (- n 1))
      (call sexos_line "[sexfiles.defer.replay] type=%#llx caller=%u depth=%zu"
        (cast (unsigned long long) (. m type_id)) (cast unsigned (. m caller_pd)) (- n 1))
      (= (* out) m)
      (return true))

    (comment "SexObject header adapter (servers/sexfiles/src/sexobject.rs).")
    (fn uint64_t collar_rights_generation (((const SexfilesObjectEntry) (* entry)))
      (return (-> entry rights_generation)))

    (fn SexObjectHeader sexobject_header_from_entry (((const SexfilesObjectEntry) (* entry)))
      (return
        (compound SexObjectHeader
          (= (. object_id) (-> entry object_id))
          (= (. content_generation) (-> entry metadata_generation))
          (= (. rights_generation) (-> entry rights_generation))
          (= (. metadata_generation) (-> entry metadata_generation))
          (= (. object_size_bytes) (-> entry object_size_bytes))
          (= (. first_block) (-> entry first_block))
          (= (. owner_pd) (-> entry owner_pd))
          (= (. kind) (cast uint32_t (-> entry kind)))
          (= (. checksum) (-> entry checksum))
          (= (. flags) (?: (-> entry in_use) 0 SEX_OBJECT_FLAG_TOMBSTONED))
          (= (. reserved0) 0)
          (= (. reserved1) 0))))

    (comment "RamFs backend (servers/sexfiles/src/backends/ramfs.rs).")
    (fn (static size_t) ramfs_find_active_by_handle ((uint64_t handle))
      (for (var size_t i 0) (< i (. sexfiles_state ramfs_files_len)) (++ i)
        (block
          (var (const RamfsFileEntry) (* f) (& ([] (. sexfiles_state ramfs_files) i)))
          (if (&& (-> f in_use) (&& (-> f active) (== (-> f handle) handle)))
            (return i))))
      (return SIZE_MAX))

    (fn (static size_t) ramfs_find_any_by_name (((const uint8_t) (* name)) (size_t name_len))
      (for (var size_t i 0) (< i (. sexfiles_state ramfs_files_len)) (++ i)
        (block
          (var (const RamfsFileEntry) (* f) (& ([] (. sexfiles_state ramfs_files) i)))
          (if (&& (-> f in_use)
                  (&& (== (cast size_t (-> f name_len)) name_len)
                      (== (call memcmp (-> f name) name name_len) 0)))
            (return i))))
      (return SIZE_MAX))

    (fn (static int64_t) ramfs_allocate (((const uint8_t) (* name)) (size_t name_len) (uint32_t owner_pd) (uint64_t (* out_handle)))
      (var size_t active_count 0)
      (for (var size_t i 0) (< i (. sexfiles_state ramfs_files_len)) (++ i)
        (if (&& (. ([] (. sexfiles_state ramfs_files) i) in_use)
                (. ([] (. sexfiles_state ramfs_files) i) active))
          (++ active_count)))
      (if (|| (>= active_count RAMFS_MAX_FILES) (>= (. sexfiles_state ramfs_files_len) RAMFS_SLOT_CAP))
        (return ERR_FULL))
      (var uint64_t handle (. sexfiles_state ramfs_next_handle))
      (+= (. sexfiles_state ramfs_next_handle) 1)
      (var uint64_t object_id (. sexfiles_state ramfs_next_object_id))
      (+= (. sexfiles_state ramfs_next_object_id) 1)
      (var size_t idx (. sexfiles_state ramfs_files_len))
      (+= (. sexfiles_state ramfs_files_len) 1)
      (var RamfsFileEntry (* entry) (& ([] (. sexfiles_state ramfs_files) idx)))
      (call memset entry 0 (sizeof (* entry)))
      (= (-> entry handle) handle)
      (= (-> entry object_id) object_id)
      (= (-> entry active) true)
      (= (-> entry in_use) true)
      (= (-> entry owner_pd) owner_pd)
      (= (-> entry cap_generation) 1)
      (call memcpy (-> entry name) name name_len)
      (= (-> entry name_len) (cast uint8_t name_len))
      (= (-> entry data_len) 0)
      (= (* out_handle) handle)
      (return 0))

    (fn (static int64_t) ramfs_check_access ((uint32_t caller_pd) ((const RamfsFileEntry) (* entry)) (uint8_t required))
      (if (|| (== caller_pd 0) (== caller_pd (-> entry owner_pd)))
        (return 0))
      (for (var size_t i 0) (< i (. sexfiles_state ramfs_caps_len)) (++ i)
        (block
          (var RamfsCapRecord cap ([] (. sexfiles_state ramfs_caps) i))
          (if (&& (. cap valid)
                  (&& (== (. cap object_id) (-> entry object_id))
                      (&& (== (. cap subject_pd) caller_pd)
                          (&& (== (. cap generation) (-> entry cap_generation))
                              (== (& (. cap rights) required) required)))))
            (return 0))))
      (return ERR_PERM_DENIED))

    (fn (static int64_t) ramfs_check_access_any ((uint32_t caller_pd) ((const RamfsFileEntry) (* entry)) (uint8_t required_any))
      (if (|| (== caller_pd 0) (== caller_pd (-> entry owner_pd)))
        (return 0))
      (for (var size_t i 0) (< i (. sexfiles_state ramfs_caps_len)) (++ i)
        (block
          (var RamfsCapRecord cap ([] (. sexfiles_state ramfs_caps) i))
          (if (&& (. cap valid)
                  (&& (== (. cap object_id) (-> entry object_id))
                      (&& (== (. cap subject_pd) caller_pd)
                          (&& (== (. cap generation) (-> entry cap_generation))
                              (!= (& (. cap rights) required_any) 0)))))
            (return 0))))
      (return ERR_PERM_DENIED))

    (fn (static int64_t) ramfs_grant_cap_internal (((const RamfsFileEntry) (* entry)) (uint32_t subject_pd) (uint8_t rights))
      (if (== rights 0)
        (return ERR_PERM_DENIED))
      (for (var size_t i 0) (< i (. sexfiles_state ramfs_caps_len)) (++ i)
        (block
          (var RamfsCapRecord (* rec) (& ([] (. sexfiles_state ramfs_caps) i)))
          (if (&& (== (-> rec object_id) (-> entry object_id))
                  (== (-> rec subject_pd) subject_pd))
            (block
              (= (-> rec rights) rights)
              (= (-> rec generation) (-> entry cap_generation))
              (= (-> rec valid) true)
              (return 0)))))
      (if (>= (. sexfiles_state ramfs_caps_len) CAP_MAX_RECORDS)
        (return ERR_FULL))
      (var size_t idx (. sexfiles_state ramfs_caps_len))
      (+= (. sexfiles_state ramfs_caps_len) 1)
      (= ([] (. sexfiles_state ramfs_caps) idx)
        (compound RamfsCapRecord
          (= (. object_id) (-> entry object_id))
          (= (. subject_pd) subject_pd)
          (= (. rights) rights)
          (= (. generation) (-> entry cap_generation))
          (= (. valid) true)))
      (return 0))

    (fn (static void) ramfs_revoke_caps_internal ((uint64_t object_id))
      (for (var size_t i 0) (< i (. sexfiles_state ramfs_caps_len)) (++ i)
        (if (== (. ([] (. sexfiles_state ramfs_caps) i) object_id) object_id)
          (= (. ([] (. sexfiles_state ramfs_caps) i) valid) false))))

    (fn int64_t ramfs_proof_grant_caps_by_name ((uint32_t owner_pd) ((const uint8_t) (* name)) (size_t name_len) (uint32_t subject_pd) (uint8_t rights))
      (var size_t idx (call ramfs_find_any_by_name name name_len))
      (if (== idx SIZE_MAX)
        (return ERR_NOT_FOUND))
      (var (const RamfsFileEntry) (* entry) (& ([] (. sexfiles_state ramfs_files) idx)))
      (if (&& (!= owner_pd 0) (!= owner_pd (-> entry owner_pd)))
        (return ERR_PERM_DENIED))
      (return (call ramfs_grant_cap_internal entry subject_pd rights)))

    (fn int64_t ramfs_proof_revoke_caps_by_name ((uint32_t owner_pd) ((const uint8_t) (* name)) (size_t name_len))
      (var size_t idx (call ramfs_find_any_by_name name name_len))
      (if (== idx SIZE_MAX)
        (return ERR_NOT_FOUND))
      (var RamfsFileEntry (* entry) (& ([] (. sexfiles_state ramfs_files) idx)))
      (if (&& (!= owner_pd 0) (!= owner_pd (-> entry owner_pd)))
        (return ERR_PERM_DENIED))
      (if (< (-> entry cap_generation) UINT64_MAX)
        (+= (-> entry cap_generation) 1))
      (call ramfs_revoke_caps_internal (-> entry object_id))
      (return 0))

    (fn int64_t ramfs_proof_inject_stale_generation_cap (((const uint8_t) (* name)) (size_t name_len) (uint32_t subject_pd) (uint8_t rights) (uint64_t stale_generation))
      (var size_t idx (call ramfs_find_any_by_name name name_len))
      (if (== idx SIZE_MAX)
        (return ERR_NOT_FOUND))
      (var (const RamfsFileEntry) (* entry) (& ([] (. sexfiles_state ramfs_files) idx)))
      (if (>= (. sexfiles_state ramfs_caps_len) CAP_MAX_RECORDS)
        (return ERR_FULL))
      (var size_t cidx (. sexfiles_state ramfs_caps_len))
      (+= (. sexfiles_state ramfs_caps_len) 1)
      (= ([] (. sexfiles_state ramfs_caps) cidx)
        (compound RamfsCapRecord
          (= (. object_id) (-> entry object_id))
          (= (. subject_pd) subject_pd)
          (= (. rights) rights)
          (= (. generation) stale_generation)
          (= (. valid) true)))
      (return 0))

    (fn int64_t ramfs_object_id_for_handle ((uint64_t handle) (uint32_t caller_pd) (uint64_t (* out_id)))
      (var size_t idx (call ramfs_find_active_by_handle handle))
      (if (== idx SIZE_MAX)
        (return ERR_INVALID_HANDLE))
      (var (const RamfsFileEntry) (* entry) (& ([] (. sexfiles_state ramfs_files) idx)))
      (if (&& (!= caller_pd 0) (!= caller_pd (-> entry owner_pd)))
        (return ERR_PERM_DENIED))
      (= (* out_id) (-> entry object_id))
      (return 0))

    (fn int64_t ramfs_open (((const uint8_t) (* name)) (size_t name_len) (uint32_t flags) (uint32_t mode) (uint32_t caller_pd) (uint64_t (* out_handle)))
      (cast void mode)
      (if (> name_len RAMFS_MAX_NAME)
        (return ERR_NAME_TOO_LONG))
      (if (== name_len 0)
        (return ERR_NOT_FOUND))
      (var size_t idx (call ramfs_find_any_by_name name name_len))
      (if (!= idx SIZE_MAX)
        (block
          (if (!= (& flags RAMFS_O_EXCL) 0)
            (return ERR_NOT_FOUND))
          (var RamfsFileEntry (* existing) (& ([] (. sexfiles_state ramfs_files) idx)))
          (var int64_t err (call ramfs_check_access_any caller_pd existing CAP_RIGHT_OPEN_EXISTING))
          (if (!= err 0)
            (return err))
          (if (! (-> existing active))
            (block
              (= (-> existing active) true)
              (= (-> existing handle) (. sexfiles_state ramfs_next_handle))
              (+= (. sexfiles_state ramfs_next_handle) 1)))
          (= (* out_handle) (-> existing handle))
          (return 0)))
      (if (!= (& flags RAMFS_O_CREATE) 0)
        (return (call ramfs_allocate name name_len caller_pd out_handle)))
      (return ERR_NOT_FOUND))

    (fn int64_t ramfs_read ((uint64_t handle) (uint64_t offset) (uint8_t (* buf)) (size_t buf_len) (uint32_t caller_pd) (uint64_t (* out_n)))
      (var size_t idx (call ramfs_find_active_by_handle handle))
      (if (== idx SIZE_MAX)
        (return ERR_INVALID_HANDLE))
      (var (const RamfsFileEntry) (* entry) (& ([] (. sexfiles_state ramfs_files) idx)))
      (var int64_t err (call ramfs_check_access caller_pd entry CAP_RIGHT_READ))
      (if (!= err 0)
        (return err))
      (var size_t start (cast size_t offset))
      (if (>= start (-> entry data_len))
        (block
          (= (* out_n) 0)
          (return 0)))
      (var size_t avail (- (-> entry data_len) start))
      (var size_t to_read (?: (< buf_len avail) buf_len avail))
      (if (> to_read RAMFS_MAX_FILE_SIZE)
        (= to_read RAMFS_MAX_FILE_SIZE))
      (if (> to_read 0)
        (call memcpy buf (+ (-> entry data) start) to_read))
      (= (* out_n) (cast uint64_t to_read))
      (return 0))

    (fn int64_t ramfs_write ((uint64_t handle) (uint64_t offset) ((const uint8_t) (* data)) (size_t data_len) (uint32_t caller_pd) (uint64_t (* out_n)))
      (var size_t idx (call ramfs_find_active_by_handle handle))
      (if (== idx SIZE_MAX)
        (return ERR_INVALID_HANDLE))
      (var RamfsFileEntry (* entry) (& ([] (. sexfiles_state ramfs_files) idx)))
      (var size_t start (cast size_t offset))
      (var uint8_t required (?: (>= start (-> entry data_len)) CAP_RIGHT_APPEND CAP_RIGHT_WRITE))
      (var int64_t err (call ramfs_check_access caller_pd entry required))
      (if (!= err 0)
        (return err))
      (if (|| (> start RAMFS_MAX_FILE_SIZE) (> data_len (- RAMFS_MAX_FILE_SIZE start)))
        (return ERR_OVERFLOW))
      (var size_t end (+ start data_len))
      (if (> end (-> entry data_len))
        (block
          (call memset (+ (-> entry data) (-> entry data_len)) 0 (- end (-> entry data_len)))
          (= (-> entry data_len) end)))
      (if (> data_len 0)
