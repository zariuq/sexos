              (if (! (call v4_ensure buf_va (& err)))
                (return err))
              (var uint64_t reply (call handle_diskfs_create arg1 arg2 buf_va))
              (call sexos_line "[sexfiles.route.reply] op=0x42 caller=%u value=%#llx"
                (cast unsigned caller_pd) (cast (unsigned long long) reply))
              (return reply)))
          (case OP_DISKFS_LIST
            (block
              (if (call vfs_hot_log)
                (call sexos_line "[sexfiles.route.dispatch] op=0x43 name=list caller=%u" (cast unsigned caller_pd)))
              (var uint64_t buf_va (call diskfs_bridge_get_buf_va))
              (if (|| (== buf_va 0) (== buf_va UINT64_MAX))
                (return (cast uint64_t ERR_NOT_FOUND)))
              (var uint64_t err 0)
              (if (! (call v4_ensure buf_va (& err)))
                (return err))
              (return (call handle_diskfs_list arg0 arg1))))
          (case OP_DISKFS_DELETE
            (block
              (call sexos_line "[sexfiles.route.dispatch] op=0x47 name=delete caller=%u" (cast unsigned caller_pd))
              (var uint64_t buf_va (call diskfs_bridge_get_buf_va))
              (if (|| (== buf_va 0) (== buf_va UINT64_MAX))
                (return (cast uint64_t ERR_NOT_FOUND)))
              (var uint64_t err 0)
              (if (! (call v4_ensure buf_va (& err)))
                (return err))
              (return (call handle_diskfs_delete arg0 buf_va))))
          (case OP_DISKFS_RENAME
            (block
              (call sexos_line "[sexfiles.route.dispatch] op=0x48 name=rename caller=%u" (cast unsigned caller_pd))
              (var uint64_t buf_va (call diskfs_bridge_get_buf_va))
              (if (|| (== buf_va 0) (== buf_va UINT64_MAX))
                (return (cast uint64_t ERR_NOT_FOUND)))
              (var uint64_t err 0)
              (if (! (call v4_ensure buf_va (& err)))
                (return err))
              (return (call handle_diskfs_rename arg0 arg1 arg2 buf_va))))
          (case OP_DISKFS_TRUNCATE
            (block
              (call sexos_line "[sexfiles.route.dispatch] op=0x49 name=truncate caller=%u" (cast unsigned caller_pd))
              (var uint64_t reply (call handle_diskfs_truncate arg0 caller_pd))
              (call sexos_line "[sexfiles.route.reply] op=0x49 caller=%u value=%#llx"
                (cast unsigned caller_pd) (cast (unsigned long long) reply))
              (return reply)))
          (case OP_DISKFS_READ_V2
            (block
              (if (call vfs_hot_log)
                (call sexos_line "[sexfiles.route.dispatch] op=0x4A name=read_v2 caller=%u" (cast unsigned caller_pd)))
              (var uint64_t reply (call handle_diskfs_read_v2 arg0 arg1 caller_pd))
              (if (call vfs_hot_log)
                (call sexos_line "[sexfiles.route.reply] op=0x4A caller=%u value=%#llx"
                  (cast unsigned caller_pd) (cast (unsigned long long) reply)))
              (return reply)))
          (case OP_DISKFS_SELECT
            (block
              (if (call vfs_hot_log)
                (call sexos_line "[sexfiles.route.dispatch] op=0x3E name=select caller=%u" (cast unsigned caller_pd)))
              (var uint64_t reply (call handle_diskfs_select arg0 caller_pd))
              (if (call vfs_hot_log)
                (call sexos_line "[sexfiles.route.reply] op=0x3E caller=%u value=%#llx"
                  (cast unsigned caller_pd) (cast (unsigned long long) reply)))
              (return reply)))
          (case OP_SEXOBJECT_NATIVE_PERSIST_PROOF
            (block
              (if (call vfs_hot_log)
                (call sexos_line "[sexfiles.route.dispatch] op=0x40 ok=1 caller=%u" (cast unsigned caller_pd)))
              (var uint64_t object_id 0)
              (var int64_t err 0)
              (if (call sexobject_native_persist_linen_proof (& object_id) (& err))
                (block
                  (if (call vfs_hot_log)
                    (call sexos_line "[sexfiles.route.reply] op=0x40 status=S ok=1 caller=%u object_id=%llu"
                      (cast unsigned caller_pd) (cast (unsigned long long) object_id)))
                  (return object_id)))
              (if (call vfs_hot_log)
                (call sexos_line "[sexfiles.route.reply] op=0x40 status=E ok=0 caller=%u err=%lld"
                  (cast unsigned caller_pd) (cast (long long) err)))
              (return (cast uint64_t err))))
          (case OP_SEXOBJECT_READ_BACK
            (block
              (if (call vfs_hot_log)
                (call sexos_line "[sexfiles.route.dispatch] op=0x41 name=sexobject_read_back caller=%u" (cast unsigned caller_pd)))
              (var size_t len 0)
              (var int64_t err 0)
              (if (call sexobject_read_back_for_quil arg0 (& len) (& err))
                (block
                  (if (call vfs_hot_log)
                    (call sexos_line "[sexfiles.route.reply] op=0x41 caller=%u len=%zu ok=1"
                      (cast unsigned caller_pd) len))
                  (return (cast uint64_t len))))
              (if (call vfs_hot_log)
                (call sexos_line "[sexfiles.route.reply] op=0x41 caller=%u err=%lld"
                  (cast unsigned caller_pd) (cast (long long) err)))
              (return (cast uint64_t err))))
          (case OP_RAMFS_STATUS
            (block
              (call sexos_line "[sexfiles.status.query] object=%llu ok=1 reason=received" (cast (unsigned long long) arg0))
              (call sexos_line "[sexfiles.status.result] object=%llu exists=0 size=0 generation=0 ok=1 reason=phaseb1_marker"
                (cast (unsigned long long) arg0))
              (return 0)))
          (default
            (return (cast uint64_t ERR_NOT_FOUND))))))

    (comment "Trampoline initialization and PDX message loop (servers/sexfiles/src/trampoline.rs & main.rs).")
    (fn (static inline bool) tramp_hot_log (void)
      (return (call sexfiles_take_budget (& (. sexfiles_state trampoline_hot_log_budget)))))

    (fn (static void) trampoline_main (void)
      (call sexos_line "[sexfiles.trampoline.enter] ok=1")
      (call sexos_line "[sexfiles.trampoline.before_register] slot=1 ok=1")

      (if RAMFS_PROOF_ENABLED
        (call run_all_proofs))
      (if DISKFS_OBJECT_TABLE_PROOF_ENABLED
        (call run_diskfs_object_table_proofs))
      (if SEXFILES_JOURNAL_PROOF_ENABLED
        (call run_sexfiles_journal_proofs))
      (if SEXFILES_REPLAY_PROOF_ENABLED
        (call run_sexfiles_replay_proofs))
      (if SEXFILES_CAP_RECORD_PROOF_ENABLED
        (call run_sexfiles_cap_record_proofs))
      (if LINEN_SEXFILES_METADATA_PROOF_ENABLED
        (call run_linen_sexfiles_metadata_proofs))
      (if SEXFILES_FAULT_INJECTION_PROOF_ENABLED
        (call run_sexfiles_fault_injection_proofs))
      (if SEXFILES_REAL_BLOCK_PROOF_ENABLED
        (call run_sexfiles_real_block_proofs))
      (if SEXFILES_REBOOT_PROOF_ENABLED
        (call run_sexfiles_reboot_proofs))
      (if SEXFILES_EXTENT_PROOF_ENABLED
        (call run_sexfiles_extent_proofs))
      (if SEXFILES_CHECKPOINT_PROOF_ENABLED
        (call run_sexfiles_checkpoint_proofs))

      (if DISKFS_100_AP4_WRITE_PROOF_ENABLED
        (block
          (call run_diskfs100_ap4_write_proof)
          (return)))

      (if DISKFS_100_AP4_READ_PROOF_ENABLED
        (block
          (call run_diskfs100_ap4_read_proof)
          (if DISKFS_100_AP5_NEG_READ_NO_WRITE_ENABLED
            (call run_diskfs100_ap5_neg_read_no_write))
          (return)))

      (if DISKFS_100_AP5_NEG_MISMATCH_ENABLED
        (block
          (call run_diskfs100_ap5_neg_mismatch)
          (return)))

      (if DISKFS_100_AP5_NEG_MISSING_IMAGE_ENABLED
        (block
          (call run_diskfs100_ap5_neg_missing_image)
          (return)))

      (if DISKFS_100_AP5_NEG_FLUSH_SKIP_ENABLED
        (block
          (call run_diskfs100_ap5_neg_flush_skip)
          (return)))

      (if DISKFS_100_AP6_FLUSH_FSYNC_ENABLED
        (block
          (call run_diskfs100_ap6_flush_fsync)
          (return)))

      (if DISKFS_NEGATIVE_BOUNDS_AUTH_PROOF_ENABLED
        (block
          (call run_diskfs_negative_bounds_auth_proof)
          (return)))

      (if DISKFS_BRIDGE_STRICT_PROOF_ENABLED
        (block
          (call run_diskfs_bridge_strict_proof_v1)
          (return)))

      (if DISKFS_100_AP2_PROOF_ENABLED
        (block
          (call run_diskfs100_ap2_proof)
          (return)))

      (if DISKFS_100_AP3_PROOF_ENABLED
        (block
          (call run_diskfs_multi_object_proofs)
          (return)))

      (if DISKFS_MULTI_OBJECT_PROOF_ENABLED
        (block
          (if SEXFILES_ROUTE_AUDIT_ONLY_ENABLED
            (call sexos_line "[sexfiles.disk.multi.skip] reason=route_audit")
            (call run_diskfs_multi_object_proofs))))

      (if SEXOBJECT_VIEW_PROOF_ENABLED
        (call run_sexobject_view_proof))
      (if LINEN_DISK_OBJECT_PROOF_ENABLED
        (call run_linen_disk_object_proof))
      (if SEXFS_V0_SUPERBLOCK_FORMAT_MOUNT_PROOF_ENABLED
        (call run_sexfs_v0_superblock_format_mount_proofs))
      (if SEXOBJECT_TABLE_PERSIST_PROOF_ENABLED
        (call run_sexobject_table_persist_proofs))
      (if SEXOBJECT_TABLE_EXTENT_ALLOC_PROOF_ENABLED
        (call run_sexobject_table_extent_alloc_proofs))
      (if SEXOBJECT_EXTENT_WRITE_FULL_BLOCK_PROOF_ENABLED
        (call run_sexobject_extent_write_full_block_proofs))
      (if SEXOBJECT_WRITE_READ_PERSIST_PROOF_ENABLED
        (call run_sexobject_write_read_persist_proofs))
      (if SEXOBJECT_MULTI_OBJECT_PROOF_ENABLED
        (call run_sexobject_multi_object_proofs))

      (call sexos_line "[sexfiles.ready]")
      (call sexos_line "[sexfiles.init.ready] slot=1 ok=1")
      (call sexos_line "[sexfiles.trampoline.loop.enter] ok=1")

      (while 1
        (block
          (if (> (. sexfiles_state tramp_listen_budget) 0)
            (block
              (-= (. sexfiles_state tramp_listen_budget) 1)
              (if (call tramp_hot_log)
                (call sexos_line "[sexfiles.trampoline.listen.enter]"))))
          (var DeferEntry d)
          (var uint64_t type_id 0)
          (var uint32_t caller 0)
          (var uint64_t arg0 0)
          (var uint64_t arg1 0)
          (var uint64_t arg2 0)
          (if (call defer_pop (& d))
            (block
              (= type_id (. d type_id))
              (= caller (. d caller_pd))
              (= arg0 (. d a0))
              (= arg1 (. d a1))
              (= arg2 (. d a2)))
            (block
              (var SexosMessage m (call sexos_listen (& (. sexfiles_state listener)) 0))
              (= type_id (. m type_id))
              (= caller (. m caller_pd))
              (= arg0 (. m arg0))
              (= arg1 (. m arg1))
              (= arg2 (. m arg2))))
          (if (call tramp_hot_log)
            (call sexos_line "[sexfiles.trampoline.after_listen] type=%#llx caller=%u a0=%#llx a1=%#llx"
              (cast (unsigned long long) type_id) (cast unsigned caller)
              (cast (unsigned long long) arg0) (cast (unsigned long long) arg1)))
          (if (call tramp_hot_log)
            (call sexos_line "[sexfiles.route.recv] type=%#llx caller=%u a0=%#llx a1=%#llx"
              (cast (unsigned long long) type_id) (cast unsigned caller)
              (cast (unsigned long long) arg0) (cast (unsigned long long) arg1)))
          (var uint64_t reply (call handle_vfs_message type_id arg0 arg1 arg2 caller))
          (if (!= type_id 0)
            (block
              (if (== type_id OP_DISKFS_READ)
                (call sexos_line "[sexfiles.bridge.diskfs.read.reply.sent] caller=%u value=%#llx"
                  (cast unsigned caller) (cast (unsigned long long) reply)))
              (cast void (call sexos_reply caller reply)))))))

    (fn void sexfiles_main (void)
      (call sexfiles_state_init (& sexfiles_state))
      (call sexos_line "[sexfiles.init.start] ok=1")
      (call sexos_heap_init)
      (call sexos_line "[sexfiles.ready]")
      (call sexos_line "[sexfiles.init.before_trampoline] ok=1")
      (call trampoline_main)
      (call sexos_line "[sexfiles.trampoline.return.unexpected] ok=0")
      (while 1
        (call sexos_yield))))
)
