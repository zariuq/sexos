/* Drawn for any scalar without a glyph. */
static const uint8_t sexdisplay_font_unsupported[7] = {31, 17, 21, 21, 21, 17, 31};

void sexdisplay_scalar_glyph(uint32_t scalar, SexdisplayGlyph *out) {
    for (size_t i = 0; i < 7; i++)
        out->rows[i] = scalar == 9 ? 0 : sexdisplay_font_unsupported[i];
    if (scalar == 9)
        return;
    if (scalar >= 32 && scalar <= 126) {
        for (size_t i = 0; i < 7; i++)
            out->rows[i] = sexdisplay_font_ascii[scalar - 32][i];
        return;
    }
    for (size_t k = 0; k < 94; k++)
        if (sexdisplay_font_unicode[k].scalar == scalar) {
            for (size_t i = 0; i < 7; i++)
                out->rows[i] = sexdisplay_font_unicode[k].rows[i];
            return;
        }
}
