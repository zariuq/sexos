(cesta native-c/1 compact-c/2
  (unit
    (ownership (check-all)
    (unchecked (sexos_volatile_read8 sexos_volatile_read16 sexos_volatile_read32
                sexos_volatile_read64 sexos_volatile_write8 sexos_volatile_write16
                sexos_volatile_write32 sexos_volatile_write64 sexos_compiler_fence_seq_cst
                sexos_sfence)
      (obligation "Typed volatile MMIO and DMA accessors and device syscalls in inline assembly. They rely on the kernel's device leases and DMA quarantine.")))
  (cpp-if "!defined(SEXOS_CESTA_MMIO_H)"
      (then
        (define SEXOS_CESTA_MMIO_H "1")
        (include "sexos_server.h")
        (include "sexos_device_reset.h")
        (comment "Device-driver syscalls and typed volatile MMIO/DMA accessors for sexdrive, sexusb and sexnet.")

        (var void (* (function memcpy (void (* destination)) ((const void) (* source)) (size_t count))))
        (var void (* (function memset (void (* destination)) (int value) (size_t count))))
        (var int (function memcmp ((const void) (* first)) ((const void) (* second)) (size_t count)))

        (define SEXOS_SLOT_usb_host "UINT64_C(8)")
        (define SEXOS_SLOT_nvme_host "UINT64_C(16)")
        (define SEXOS_SLOT_nic "UINT64_C(19)")

        (comment "syscall 43: map BAR_INDEX of the PCI device in CAP_SLOT for MAP_SIZE bytes.")
        (var uint64_t (function sexos_map_pci_bar (uint64_t cap_slot) (uint64_t bar_index) (uint64_t map_size)))
        (comment "syscall 40: allocate a shared buffer of SIZE bytes for CONSUMER_DOMAIN.")
        (var uint64_t (function sexos_alloc_shared_buffer (uint64_t size) (uint64_t consumer_domain)))
        (comment "syscall 52: query kernel network diagnostic counter SELECTOR.")
        (var uint64_t (function sexos_net_diag (uint64_t selector)))

        (var void (function sexdrive_main void))
        (var void (function sexusb_main void))
        (var void (function sexnet_main void))

        (cpp-if "defined(SEXOS_HOST)"
          (then
            (var uint8_t (function sexos_volatile_read8 ((const uint8_t) (* addr))))
            (var uint16_t (function sexos_volatile_read16 ((const uint16_t) (* addr))))
            (var uint32_t (function sexos_volatile_read32 ((const uint32_t) (* addr))))
            (var uint64_t (function sexos_volatile_read64 ((const uint64_t) (* addr))))
            (var void (function sexos_volatile_write8 (uint8_t (* addr)) (uint8_t value)))
            (var void (function sexos_volatile_write16 (uint16_t (* addr)) (uint16_t value)))
            (var void (function sexos_volatile_write32 (uint32_t (* addr)) (uint32_t value)))
            (var void (function sexos_volatile_write64 (uint64_t (* addr)) (uint64_t value)))
            (var void (function sexos_compiler_fence_seq_cst void))
            (var void (function sexos_sfence void)))
          (else
            (fn (static inline uint8_t) sexos_volatile_read8 (((const uint8_t) (* addr)))
              (return (* (cast ((const volatile uint8_t) *) addr))))
            (fn (static inline uint16_t) sexos_volatile_read16 (((const uint16_t) (* addr)))
              (return (* (cast ((const volatile uint16_t) *) addr))))
            (fn (static inline uint32_t) sexos_volatile_read32 (((const uint32_t) (* addr)))
              (return (* (cast ((const volatile uint32_t) *) addr))))
            (fn (static inline uint64_t) sexos_volatile_read64 (((const uint64_t) (* addr)))
              (return (* (cast ((const volatile uint64_t) *) addr))))
            (fn (static inline void) sexos_volatile_write8 ((uint8_t (* addr)) (uint8_t value))
              (= (* (cast ((volatile uint8_t) *) addr)) value))
            (fn (static inline void) sexos_volatile_write16 ((uint16_t (* addr)) (uint16_t value))
              (= (* (cast ((volatile uint16_t) *) addr)) value))
            (fn (static inline void) sexos_volatile_write32 ((uint32_t (* addr)) (uint32_t value))
              (= (* (cast ((volatile uint32_t) *) addr)) value))
            (fn (static inline void) sexos_volatile_write64 ((uint64_t (* addr)) (uint64_t value))
              (= (* (cast ((volatile uint64_t) *) addr)) value))
            (native "
static inline void sexos_compiler_fence_seq_cst(void) {
    __asm__ volatile(\"\" : : : \"memory\");
}

static inline void sexos_sfence(void) {
    __asm__ volatile(\"sfence\" : : : \"memory\");
}
"))))
  )))
