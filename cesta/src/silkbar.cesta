(cesta native-c/1 compact-c/2
  (unit
    (include "sexos_server.h")
    (include "silkbar_model.h")
    (comment "SilkBar producer, translated from servers/silkbar/src/main.rs. The Rust function-local statics are fields of one owned Silkbar state; the loop keeps the Rust order of every budget, send and yield.")

    (comment "Build-time proof profiles (option_env! in the Rust source).")
    (cpp-if "defined(SEXOS_BELL_DELIVERY_PROOF)"
      (then (define BELL_DELIVERY_PROOF_ENABLED "1"))
      (else (define BELL_DELIVERY_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SILKBAR_CLOCK_FORCE_STALL_PROOF)"
      (then (define CLOCK_FORCE_STALL_PROOF_ENABLED "1"))
      (else (define CLOCK_FORCE_STALL_PROOF_ENABLED "0")))

    (comment "Clock cadence: ticks per logical second for each tick source.")
    (define STALE_REAL_TICK_FALLBACK_LOOPS "((uint16_t)16)")
    (define STALE_REAL_TICK_FALLBACK_THRESHOLD "((uint16_t)4)")
    (define STEADY_CLOCK_THRESHOLD "((uint16_t)62)")
    (define REAL_TICK_VISIBLE_CLOCK_THRESHOLD "STEADY_CLOCK_THRESHOLD")
    (define SYNTHETIC_VISIBLE_CLOCK_THRESHOLD "((uint16_t)8)")
    (define LIVE_CLOCK_THRESHOLD "REAL_TICK_VISIBLE_CLOCK_THRESHOLD")
    (define BELL_LIST_ARGS "(UINT64_C(0xFF) | (UINT64_C(1) << 8))")

    (typedef (struct Silkbar
      (bool degraded)
      (comment "SERIAL_DIET_V1: shared budget for hot-loop diagnostics.")
      (uint32_t hot_log)
      (bool cap_ready_display) (bool defer_emitted_display)
      (uint32_t edge_send) (uint64_t drop_counter) (uint32_t drop_log)
      (uint64_t clock_drop_counter) (uint32_t clock_drop_log)
      (uint32_t cadence_start) (uint32_t stall_after_start) (uint32_t stall_before_recv)
      (uint32_t stall_before_bell) (uint32_t bell_reply) (uint32_t bell_gen_changed) (uint32_t bell_gen_steady)
      (uint32_t bell_gen_denied) (uint32_t stall_after_bell) (uint32_t stall_after_recv)
      (uint32_t stall_before_shell_sync) (uint32_t stall_after_shell_sync)
      (uint32_t synthetic_visible) (uint32_t real_tick) (uint32_t real_tick_resume) (uint32_t stale)
      (uint32_t synthetic_threshold) (uint32_t cadence_done) (uint32_t loop_alive) (uint32_t clock_tick)
      (uint32_t bell_gen_cap_err) (uint32_t force_stall_suppress) (uint32_t cadence_sample)
      (uint32_t boot_canary) (uint32_t boot_canary_suppress) (uint32_t source_liveness)
      (uint32_t clock_send_count)) Silkbar)

    (comment "A budget allows its line while it lasts.")
    (fn (static bool) take ((uint32_t (* budget)))
      (if (== (* budget) 0) (return false))
      (-= (* budget) 1)
      (return true))

    (fn (static uint64_t) send_update_status ((Silkbar (* s)) (SilkBarUpdate update))
      (if (call take (& (-> s edge_send)))
        (call sexos_line "[bootgraph.edge.send from=silkbar to=sexdisplay slot=SLOT_DISPLAY op=OP_SILKBAR_UPDATE first=1]"))
      (var SexosReply result
        (call sexos_pdx_call SEXOS_SLOT_display SEXOS_SILKBAR_update (cast uint64_t (. update kind))
          (| (<< (cast uint64_t (. update index)) 32) (cast uint64_t (. update a))) (cast uint64_t (. update b))))
      (if (! (-> s cap_ready_display))
        (block
          (if (== (. result status) 0) (= (-> s cap_ready_display) true)
            (if (== (. result status) SEXOS_ERR_CAP_INVALID)
              (block
                (if (! (-> s defer_emitted_display))
                  (block
                    (= (-> s defer_emitted_display) true)
                    (call sexos_line "[bootgraph.edge.defer from=silkbar to=sexdisplay slot=5 reason=missing_cap]")))
                (return (. result status)))))))
      (if (!= (. result status) 0)
        (block
          (var uint64_t err (. result status))
          (var uint64_t n (-> s drop_counter))
          (+= (-> s drop_counter) 1)
          (if (call take (& (-> s drop_log)))
            (call sexos_line "[silkbar.send_update.drop] kind=%u idx=%u err=%#llx count=%llu"
              (cast unsigned (. update kind)) (cast unsigned (. update index))
              (cast (unsigned long long) err) (cast (unsigned long long) n)))
          (comment "Clock-specific drops: 64 entries, so starvation survives startup noise.")
          (if (== (. update kind) SILKBAR_UPDATE_SET_CLOCK)
            (block
              (var uint64_t cn (-> s clock_drop_counter))
              (+= (-> s clock_drop_counter) 1)
              (if (call take (& (-> s clock_drop_log)))
                (call sexos_line "[silkbar.send_update.drop.clock] count=%llu err=%#llx"
                  (cast (unsigned long long) cn) (cast (unsigned long long) err)))))
          (return err)))
      (return 0))

    (fn (static void) send_update ((Silkbar (* s)) (SilkBarUpdate update))
      (cast void (call send_update_status s update)))

    (comment "LIST asks Bell for its lane summary; the reply arrives through listen.")
    (fn (static bool) bell_list (void)
      (return (== (. (call sexos_pdx_call SEXOS_SLOT_bell SEXOS_BELL_list BELL_LIST_ARGS 0 0) status) 0)))

    (fn void silkbar_main (void)
      (var Silkbar s
        (compound Silkbar
          (= (. hot_log) 120) (= (. edge_send) 1) (= (. drop_log) 16) (= (. clock_drop_log) 64)
          (= (. cadence_start) 16) (= (. stall_after_start) 2) (= (. stall_before_recv) 2)
          (= (. stall_before_bell) 2) (= (. bell_reply) 8) (= (. bell_gen_changed) 8) (= (. bell_gen_steady) 1)
          (= (. bell_gen_denied) 8) (= (. stall_after_bell) 2) (= (. stall_after_recv) 2)
          (= (. stall_before_shell_sync) 2) (= (. stall_after_shell_sync) 2)
          (= (. synthetic_visible) 4) (= (. real_tick) 12) (= (. real_tick_resume) 4) (= (. stale) 8)
          (= (. synthetic_threshold) 1) (= (. cadence_done) 16) (= (. loop_alive) 16) (= (. clock_tick) 12)
          (= (. bell_gen_cap_err) 8) (= (. force_stall_suppress) 4) (= (. cadence_sample) 32)
          (= (. boot_canary) 8) (= (. boot_canary_suppress) 4) (= (. source_liveness) 32)))
      (call sexos_line "[silkbar.init.start]")
      (call sexos_line "[silkbar.boot.begin]")
      (call sexos_line "[bootgraph.silkbar.spawned]")
      (var uint32_t contract_err (call validate_silkbar_contract))
      (= (. s degraded) (!= contract_err 0))
      (if (. s degraded)
        (block
          (call sexos_line "[silk.de.contract.producer.fail] reason=%u abi=%u layout=%u theme=%u fp=0x%016llx"
            (cast unsigned contract_err) (cast unsigned SILK_DE_BAR_ABI_V1) (cast unsigned SILK_DE_BAR_LAYOUT_V1)
            (cast unsigned SILK_DE_BAR_THEME_V1) (cast (unsigned long long) (call silkbar_contract_fingerprint)))
          (call sexos_line "[silkbar.boot.contract.fail] code=%u" (cast unsigned contract_err))
          (call sexos_line "[bootgraph.silkbar.degraded] reason=contract_fail"))
        (block
          (call sexos_line "[silk.de.contract.producer.pass] abi=%u layout=%u theme=%u fp=0x%016llx"
            (cast unsigned SILK_DE_BAR_ABI_V1) (cast unsigned SILK_DE_BAR_LAYOUT_V1)
            (cast unsigned SILK_DE_BAR_THEME_V1) (cast (unsigned long long) (call silkbar_contract_fingerprint)))
          (call sexos_line "[silkbar.boot.contract.ok]")
          (call sexos_line "[bootgraph.silkbar.contract_ready]")))
      (call sexos_line "[silk.contract.validate.version] version=%llu" (cast (unsigned long long) SILKBAR_ABI_VERSION))

      (var uint8_t focus_state 0)
      (var uint8_t last_focus_state 0xFF)
      (var uint32_t last_options_mask 0)
      (var uint8_t chip_phase 0)
      (var bool chip0_net true)
      (comment "Software clock: one logical second per cadence of yields.")
      (var uint8_t hh (. DEFAULT_SILK_BAR clock_hh))
      (var uint8_t mm (. DEFAULT_SILK_BAR clock_mm))
      (var uint8_t ss (. DEFAULT_SILK_BAR clock_ss))
      (var uint64_t loop_iter 0)
      (var uint16_t cadence_yields 0)
      (comment "Prefer real monotonic ticks; fall back to counting yields when get_ticks is 0 or stalls.")
      (var uint64_t last_clock_ticks 0)
      (var bool clock_source_logged false)
      (var uint16_t stale_tick_loops 0)
      (var uint8_t boot_clock_sends 0)
      (var bool force_stall_seeded false)
      (var uint8_t force_stall_ss 0)
      (var uint16_t force_stall_repeat_sends 0)
      (comment "Cached Bell generation (0 forces the first LIST); a LIST awaiting its reply.")
      (var uint64_t bell_gen_cached 0)
      (var bool bell_pending_list false)

      (comment "Initial updates are deferred until the loop is live; the clock is not initialized.")
      (var SilkBarUpdate ([] init_deferred (+ SILKBAR_WORKSPACE_COUNT SILKBAR_CHIP_COUNT)))
      (var size_t init_deferred_count 0)
      (if (! (. s degraded))
        (block
          (for (var uint8_t ws_idx 0) (< ws_idx SILKBAR_WORKSPACE_COUNT) (++ ws_idx)
            (block
              (= ([] init_deferred init_deferred_count)
                (call silkbar_update SILKBAR_UPDATE_SET_WORKSPACE_ACTIVE ws_idx
                  (?: (== ws_idx SILKBAR_DEFAULT_ACTIVE_WORKSPACE_IDX) 1u 0u) 0))
              (++ init_deferred_count)))
          (for (var uint8_t chip_idx 0) (< chip_idx SILKBAR_CHIP_COUNT) (++ chip_idx)
            (block
              (= ([] init_deferred init_deferred_count) (call silkbar_update SILKBAR_UPDATE_SET_CHIP_VISIBLE chip_idx 1 0))
              (++ init_deferred_count)))))
      (var size_t init_deferred_next 0)
      (call sexos_line "[silkbar.boot.init.defer] count=%zu" init_deferred_count)
      (call sexos_line "[silkbar.ready]")

      (while 1
        (block
          (if (call take (& (. s cadence_start)))
            (call sexos_line "[silkbar.loop.cadence.start] iter=%llu" (cast (unsigned long long) loop_iter)))
          (if (call take (& (. s stall_after_start)))
            (call sexos_line "[silkbar.stall.after_start] iter=%llu" (cast (unsigned long long) loop_iter)))
          (if (== loop_iter 0) (call sexos_line "[bootgraph.silkbar.loop_ready]"))
          (comment "At most one upstream message per pass, without blocking.")
          (if (call take (& (. s stall_before_recv)))
            (call sexos_line "[silkbar.stall.before_recv] iter=%llu" (cast (unsigned long long) loop_iter)))
          (var SexosMessage msg)
          (if (call sexos_try_listen 0 (& msg))
            (block (if (== (. msg type_id) SEXOS_SILKBAR_workspace_active)
              (block
                (var uint8_t ws (cast uint8_t (. msg arg0)))
                (if (> ws SILKBAR_WORKSPACE_IDX_MAX)
                  (block
                    (call sexos_line "[silkbar.update.reject] kind=%llu idx=%u reason=out_of_bounds"
                      (cast (unsigned long long) (. msg type_id)) (cast unsigned ws))
                    (call sexos_line "[silkbar.cadence.no_skip] reason=workspace iter=%llu" (cast (unsigned long long) loop_iter))))
                (call sexos_line "[silkbar.workspace.recv] index=%u" (cast unsigned ws))
                (call sexos_line "[silkbar.workspace.active.set] index=%u" (cast unsigned ws))
                (call sexos_line "[silkbar.workspace.active.send.start] index=%u" (cast unsigned ws))
                (if (! (. s degraded))
                  (for (var uint8_t i 0) (< i SILKBAR_WORKSPACE_COUNT) (++ i)
                    (call send_update (& s) (call silkbar_update SILKBAR_UPDATE_SET_WORKSPACE_ACTIVE i (?: (== i ws) 1u 0u) 0))))
                (call sexos_line "[silkbar.workspace.active.send.ok] index=%u" (cast unsigned ws)))
              (if (== (. msg type_id) SEXOS_SILKBAR_focus_state)
                (block
                  (var uint8_t raw (cast uint8_t (. msg arg0)))
                  (if (> raw 3)
                    (block
                      (call sexos_line "[silkbar.update.reject] kind=%llu idx=%u reason=out_of_bounds"
                        (cast (unsigned long long) (. msg type_id)) (cast unsigned raw))
                      (call sexos_line "[silkbar.cadence.no_skip] reason=options iter=%llu" (cast (unsigned long long) loop_iter))))
                  (= focus_state raw)
                  (comment "Selected-window options travel in arg1; old senders pass 0.")
                  (var uint32_t options_mask (cast uint32_t (. msg arg1)))
                  (call sexos_line "[silkbar.selected.options.recv] mask=%#x" (cast unsigned options_mask))
                  (if (&& (! (. s degraded)) (!= options_mask last_options_mask))
                    (block
                      (= last_options_mask options_mask)
                      (call send_update (& s) (call silkbar_update SILKBAR_UPDATE_SET_SELECTED_OPTIONS 0 options_mask 0))
                      (call sexos_line "[silkbar.selected.options.forward] mask=%#x" (cast unsigned options_mask)))))
                (if (&& (== (. msg type_id) 1) (== (. msg caller_pd) 1))
                  (block
                    (comment "Bell reply: a LIST's packed counts, or a SUBSCRIBE's generation.")
                    (if (call take (& (. s stall_before_bell)))
                      (call sexos_line "[silkbar.stall.before_bell] iter=%llu" (cast (unsigned long long) loop_iter)))
                    (if bell_pending_list
                      (block
                        (comment "Repack for SetBellPresence: total | redacted << 8 | flags << 16; flags bit 0 = Bell answered.")
                        (= bell_pending_list false)
                        (var uint64_t packed (. msg arg0))
                        (var uint8_t total (cast uint8_t (& packed 0xFF)))
                        (var uint8_t redacted (cast uint8_t (& (>> packed 56) 0xFF)))
                        (var uint8_t flags 1)
                        (var uint32_t a (| (| (cast uint32_t total) (<< (cast uint32_t redacted) 8)) (<< (cast uint32_t flags) 16)))
                        (if (call take (& (. s bell_reply)))
                          (call sexos_line "[silkbar.bell.poll.reply] total=%u redacted=%u flags=%#x"
                            (cast unsigned total) (cast unsigned redacted) (cast unsigned flags)))
                        (if (! (. s degraded))
                          (call send_update (& s) (call silkbar_update SILKBAR_UPDATE_SET_BELL_PRESENCE 0 a 0)))
                        (if BELL_DELIVERY_PROOF_ENABLED
                          (block
                            (call sexos_line "[bell.poll.ok] total=%u redacted=%u flags=%#x"
                              (cast unsigned total) (cast unsigned redacted) (cast unsigned flags))
                            (call sexos_line "[silkbar.bell.state] total=%u redacted=%u flags=%#x"
                              (cast unsigned total) (cast unsigned redacted) (cast unsigned flags)))))
                      (block
                        (var uint64_t gen (. msg arg0))
                        (var unsigned changed (?: (&& (!= gen bell_gen_cached) (!= gen UINT64_MAX)) 1u 0u))
                        (if (?: changed (call take (& (. s bell_gen_changed))) (call take (& (. s bell_gen_steady))))
                          (call sexos_line "[silkbar.bell.gen.reply] gen=%llu changed=%u" (cast (unsigned long long) gen) changed))
                        (if (== gen UINT64_MAX)
                          (block
                            (comment "Denied: fall back to LIST.")
                            (if (call take (& (. s bell_gen_denied)))
                              (call sexos_line "[silkbar.bell.gen.fallback] reason=denied"))
                            (if (call bell_list) (= bell_pending_list true)
                              (if (! (. s degraded))
                                (call send_update (& s) (call silkbar_update SILKBAR_UPDATE_SET_BELL_PRESENCE 0 0 0)))))
                          (if (!= gen bell_gen_cached)
                            (block
                              (comment "Generation changed: ask for the new counts.")
                              (= bell_gen_cached gen)
                              (if (call bell_list) (= bell_pending_list true)))))))
                    (if (call take (& (. s stall_after_bell)))
                      (call sexos_line "[silkbar.stall.after_bell] iter=%llu" (cast (unsigned long long) loop_iter)))
                    (if (call take (& (. s hot_log)))
                      (call sexos_line "[silkbar.stall.after_bell_all] iter=%llu" (cast (unsigned long long) loop_iter))))
                  (call sexos_line "[pdx.opcode.unknown] silkbar type_id=%#llx caller=%u"
                    (cast (unsigned long long) (. msg type_id)) (cast unsigned (. msg caller_pd))))))))
          (if (call take (& (. s stall_after_recv)))
            (call sexos_line "[silkbar.stall.after_recv] iter=%llu" (cast (unsigned long long) loop_iter)))

          (if (call take (& (. s stall_before_shell_sync)))
            (call sexos_line "[silkbar.stall.before_shell_sync] iter=%llu" (cast (unsigned long long) loop_iter)))
          (if (!= focus_state last_focus_state)
            (block
              (comment "Focus drives the urgent highlight: none clears; shell, app and debug mark workspaces 0, 1 and 2.")
              (var int urgent_ws (?: (&& (>= focus_state 1) (<= focus_state 3)) (- (cast int focus_state) 1) (- 1)))
              (if (! (. s degraded))
                (for (var uint8_t ws 0) (< ws SILKBAR_WORKSPACE_COUNT) (++ ws)
                  (call send_update (& s)
                    (call silkbar_update SILKBAR_UPDATE_SET_WORKSPACE_URGENT ws (?: (== (cast int ws) urgent_ws) 1u 0u) 0))))
              (= last_focus_state focus_state)))
          (if (call take (& (. s stall_after_shell_sync)))
            (call sexos_line "[silkbar.stall.after_shell_sync] iter=%llu" (cast (unsigned long long) loop_iter)))

          (if (&& (! (. s degraded)) (< init_deferred_next init_deferred_count))
            (block
              (comment "Burst every deferred update in one pass, so sexdisplay redraws once.")
              (var size_t count init_deferred_count)
              (while (< init_deferred_next init_deferred_count)
                (block
                  (call send_update (& s) ([] init_deferred init_deferred_next))
                  (++ init_deferred_next)))
              (call sexos_line "[silkbar.boot.init.flush.burst.done] count=%zu" count)))

          (comment "Tick-watch cadence: one tick change is one cadence step; a threshold of steps is one logical second.")
          (var uint16_t cadence_threshold LIVE_CLOCK_THRESHOLD)
          (var uint64_t raw_ticks (call sexos_get_ticks))
          (if (== raw_ticks 0)
            (block
              (comment "QEMU TCG: count yields at the visible synthetic rate.")
              (= stale_tick_loops 0)
              (= cadence_threshold SYNTHETIC_VISIBLE_CLOCK_THRESHOLD)
              (= cadence_yields (cast uint16_t (+ cadence_yields 1)))
              (if (&& (! clock_source_logged) (>= loop_iter 10))
                (block
                  (call sexos_line "[silkbar.clock.source] kind=synthetic raw_ticks=0 threshold=%u" (cast unsigned cadence_threshold))
                  (= clock_source_logged true)))
              (if (call take (& (. s synthetic_visible)))
                (call sexos_line "[silkbar.clock.synthetic.visible] threshold=%u" (cast unsigned cadence_threshold))))
            (if (> raw_ticks last_clock_ticks)
              (block
                (comment "Real ticks advanced: resume from any stale fallback.")
                (var bool was_stale (>= stale_tick_loops STALE_REAL_TICK_FALLBACK_LOOPS))
                (= stale_tick_loops 0)
                (= last_clock_ticks raw_ticks)
                (= cadence_yields (cast uint16_t (+ cadence_yields 1)))
                (if (! clock_source_logged)
                  (block
                    (call sexos_line "[silkbar.clock.source] kind=real raw_ticks=%llu" (cast (unsigned long long) raw_ticks))
                    (= clock_source_logged true)))
                (if (call take (& (. s real_tick)))
                  (call sexos_line "[silkbar.clock.real_tick] ticks=%llu iter=%llu yield_count=%u"
                    (cast (unsigned long long) raw_ticks) (cast (unsigned long long) loop_iter) (cast unsigned cadence_yields)))
                (if (&& was_stale (call take (& (. s real_tick_resume))))
                  (call sexos_line "[silkbar.clock.real_tick.resume] ticks=%llu" (cast (unsigned long long) raw_ticks))))
              (block
                (comment "Real ticks exist but have not advanced: after a grace window, count yields instead.")
                (= stale_tick_loops (cast uint16_t (+ stale_tick_loops 1)))
                (if (>= stale_tick_loops STALE_REAL_TICK_FALLBACK_LOOPS)
                  (block
                    (= cadence_threshold STALE_REAL_TICK_FALLBACK_THRESHOLD)
                    (= cadence_yields (cast uint16_t (+ cadence_yields 1)))
                    (if (call take (& (. s stale)))
                      (call sexos_line "[silkbar.clock.real_tick.stale] ticks=%llu loops=%u fallback=synthetic threshold=%u"
                        (cast (unsigned long long) raw_ticks) (cast unsigned stale_tick_loops) (cast unsigned cadence_threshold))))))))
          (comment "Iteration 2 proof, at milestones of the cadence only.")
          (if (== loop_iter 2)
            (block
              (var uint16_t half (cast uint16_t (/ cadence_threshold 2)))
              (if (|| (|| (== cadence_yields 1) (== cadence_yields half))
                      (|| (== (cast uint16_t (+ cadence_yields 1)) cadence_threshold) (== cadence_yields cadence_threshold)))
                (call sexos_line "[silkbar.loop.cadence.count] iter=%llu yield_count=%u threshold=%u"
                  (cast (unsigned long long) loop_iter) (cast unsigned cadence_yields) (cast unsigned cadence_threshold)))))
          (if (&& (&& (== loop_iter 10) (> (. s synthetic_threshold) 0)) (== cadence_yields 1))
            (block
              (-= (. s synthetic_threshold) 1)
              (call sexos_line "[silkbar.clock.synthetic.threshold] iter=%llu threshold=%u reason=until_real_timer"
                (cast (unsigned long long) loop_iter) (cast unsigned cadence_threshold))))
          (call sexos_yield)
          (if (< cadence_yields cadence_threshold) continue)
          (= cadence_yields 0)
          (if (&& (call take (& (. s cadence_done))) (call take (& (. s hot_log))))
            (call sexos_line "[silkbar.loop.cadence.done] iter=%llu" (cast (unsigned long long) loop_iter)))

          (comment "One logical second per cadence.")
          (if (call take (& (. s hot_log)))
            (call sexos_line "[silkbar.loop.iter_advance] old=%llu new=%llu"
              (cast (unsigned long long) loop_iter) (cast (unsigned long long) (+ loop_iter 1))))
          (+= loop_iter 1)
          (if (&& (call take (& (. s loop_alive))) (call take (& (. s hot_log))))
            (call sexos_line "[silkbar.loop.alive] iter=%llu" (cast (unsigned long long) loop_iter)))
          (= ss (cast uint8_t (+ ss 1)))
          (if (>= ss 60)
            (block
              (= ss 0)
              (= mm (cast uint8_t (+ mm 1)))
              (if (>= mm 60)
                (block
                  (= mm 0)
                  (= hh (cast uint8_t (+ hh 1)))
                  (if (>= hh 24) (= hh 0))))))
          (if (call take (& (. s clock_tick)))
            (call sexos_line "[silkbar.clock.tick] hh=%u mm=%u ss=%u raw_ticks=%llu"
              (cast unsigned hh) (cast unsigned mm) (cast unsigned ss) (cast (unsigned long long) raw_ticks)))

          (comment "Bell presence poll every 2 seconds: SUBSCRIBE for the generation; on failure, LIST.")
          (if (&& (&& (! (. s degraded)) (== (% loop_iter 2) 0)) (! bell_pending_list))
            (block
              (var SexosReply result (call sexos_pdx_call SEXOS_SLOT_bell SEXOS_BELL_subscribe 0 0 0))
              (if (!= (. result status) 0)
                (block
                  (if (call take (& (. s bell_gen_cap_err)))
                    (call sexos_line "[silkbar.bell.gen.fallback] reason=cap_err err=%#llx" (cast (unsigned long long) (. result status))))
                  (if (call bell_list) (= bell_pending_list true)
                    (call send_update (& s) (call silkbar_update SILKBAR_UPDATE_SET_BELL_PRESENCE 0 0 0)))))))

          (comment "Status-chip stub: every 120 seconds, one bounded change.")
          (if (&& (! (. s degraded)) (== (% loop_iter 120) 0))
            (block
              (switch chip_phase
                (block
                  (case 0
                    (block
                      (call send_update (& s) (call silkbar_update SILKBAR_UPDATE_SET_CHIP_KIND SILKBAR_CHIP_SLOT_CHIP0
                        (?: chip0_net SILKBAR_CHIP_NET SILKBAR_CHIP_WIFI) 0))
                      (call send_update (& s) (call silkbar_update SILKBAR_UPDATE_SET_CHIP_KIND SILKBAR_CHIP_SLOT_CHIP1 SILKBAR_CHIP_WIFI 0))
                      (= chip0_net (! chip0_net))))
                  break
                  (case 1
                    (call send_update (& s) (call silkbar_update SILKBAR_UPDATE_SET_CHIP_KIND SILKBAR_CHIP_SLOT_CHIP2 SILKBAR_CHIP_BATTERY 0)))
                  break
                  (case 2
                    (call send_update (& s) (call silkbar_update SILKBAR_UPDATE_SET_CHIP_KIND SILKBAR_CHIP_SLOT_CLOCK SILKBAR_CHIP_NET 0)))
                  break
                  (default
                    (call send_update (& s) (call silkbar_update SILKBAR_UPDATE_SET_CHIP_KIND SILKBAR_CHIP_SLOT_CLOCK SILKBAR_CHIP_BATTERY 0)))))
              (= chip_phase (cast uint8_t (& (+ chip_phase 1) 3)))))

          (var bool clock_sent false)
          (var uint64_t clock_status UINT64_MAX)
          (if (! (. s degraded))
            (block (if CLOCK_FORCE_STALL_PROOF_ENABLED
              (block (if (! force_stall_seeded)
                (block
                  (= force_stall_seeded true)
                  (= force_stall_ss ss)
                  (= clock_sent true)
                  (call sexos_line "[silkbar.clock.force_stall.seed] hh=%u mm=%u ss=%u" (cast unsigned hh) (cast unsigned mm) (cast unsigned ss))
                  (= clock_status (call send_update_status (& s)
                    (call silkbar_update SILKBAR_UPDATE_SET_CLOCK 0 hh (| (<< (cast uint32_t mm) 8) ss)))))
                (if (< force_stall_repeat_sends 124)
                  (block
                    (var uint8_t burst 0)
                    (while (&& (< burst 4) (< force_stall_repeat_sends 124))
                      (block
                        (= force_stall_repeat_sends (cast uint16_t (+ force_stall_repeat_sends 1)))
                        (= clock_status (call send_update_status (& s)
                          (call silkbar_update SILKBAR_UPDATE_SET_CLOCK 0 hh (| (<< (cast uint32_t mm) 8) force_stall_ss))))
                        (= burst (cast uint8_t (+ burst 1)))))
                    (= clock_sent true)
                    (if (== (% force_stall_repeat_sends 20) 0)
                      (call sexos_line "[silkbar.clock.force_stall.repeat] ss=%u sends=%u"
                        (cast unsigned force_stall_ss) (cast unsigned force_stall_repeat_sends))))
                  (if (call take (& (. s force_stall_suppress)))
                    (call sexos_line "[silkbar.clock.force_stall.suppress] repeats=%u status=hold" (cast unsigned force_stall_repeat_sends))))))
              (block
                (comment "Bounded clock send: the cadence itself limits the rate.")
                (= clock_sent true)
                (= clock_status (call send_update_status (& s)
                  (call silkbar_update SILKBAR_UPDATE_SET_CLOCK 0 hh (| (<< (cast uint32_t mm) 8) ss))))))))
          (if (&& (&& clock_sent (call take (& (. s cadence_sample)))) (call take (& (. s hot_log))))
            (call sexos_line "[silkbar.clock.cadence.sample] ss=%u yields=%u threshold=%u sent=1 ok=1"
              (cast unsigned ss) (cast unsigned cadence_yields) (cast unsigned cadence_threshold)))
          (if (! (. s degraded))
            (block
              (if clock_sent (= boot_clock_sends (cast uint8_t (+ boot_clock_sends 1))))
              (if (call take (& (. s boot_canary)))
                (call sexos_line "[silkbar.clock.boot_canary] send=%u threshold=%u"
                  (cast unsigned boot_clock_sends) (cast unsigned cadence_threshold))))
            (if (call take (& (. s boot_canary_suppress)))
              (call sexos_line "[silkbar.clock.boot_canary] suppressed=degraded threshold=%u" (cast unsigned cadence_threshold))))
          (comment "Clock-source liveness, once per clock minute.")
          (if (&& (&& (&& (! (. s degraded)) clock_sent) (> loop_iter 0)) (== (% loop_iter 60) 0))
            (if (call take (& (. s source_liveness)))
              (call sexos_line "[silkbar.clock.source.liveness] iter=%llu ss=%u threshold=%u ok=1"
                (cast (unsigned long long) loop_iter) (cast unsigned ss) (cast unsigned cadence_threshold))))
          (if (== loop_iter 1)
            (block (if (. s degraded)
              (call sexos_line "[bootgraph.silkbar.degraded] reason=clock_send_disabled")
              (call sexos_line "[bootgraph.silkbar.clock_ready]"))))
          (comment "Clock-send liveness: the first 12 sends, then every 64th.")
          (+= (. s clock_send_count) 1)
          (if (|| (<= (. s clock_send_count) 12) (== (% (. s clock_send_count) 64) 0))
            (call sexos_line "[silkbar.clock.send] hh=%u mm=%u ss=%u status=%#llx"
              (cast unsigned hh) (cast unsigned mm) (cast unsigned ss) (cast (unsigned long long) clock_status))))))))
