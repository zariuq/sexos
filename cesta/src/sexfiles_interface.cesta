        (typedef (struct SexfilesSuperblock
          (uint64_t magic)
          (uint16_t version_major)
          (uint16_t version_minor)
          (uint32_t block_size)
          (uint64_t fs_generation)
          (uint64_t object_table_start_block)
          (uint32_t object_table_entry_count)
          (uint64_t feature_flags)
