        (typedef (struct DeferEntry
          (uint64_t type_id)
          (uint32_t caller_pd)
          (uint64_t a0)
          (uint64_t a1)
          (uint64_t a2)) DeferEntry)

        (typedef (struct RamfsFileEntry
          (uint64_t handle)
          (uint64_t object_id)
          (bool active)
          (bool in_use)
          (uint32_t owner_pd)
          (uint64_t cap_generation)
          (uint8_t ([] name RAMFS_MAX_NAME))
          (uint8_t name_len)
          (uint8_t ([] data RAMFS_MAX_FILE_SIZE))
          (size_t data_len)) RamfsFileEntry)

        (typedef (struct RamfsCapRecord
          (uint64_t object_id)
