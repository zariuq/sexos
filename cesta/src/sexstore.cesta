(cesta native-c/1 compact-c/2
  (unit
    (include "sexos_server.h")
    (include "sexstore.h")
    (comment "Key-value store server, translated from servers/sexstore/src/main.rs. The Rust statics (the slot table, the durable region and the log budgets) are fields of one owned Sexstore state. The Rust installs an allocator it never uses; this translation has none.")

    (comment "Build-time proof profile (option_env! in the Rust source).")
    (cpp-if "defined(SEXOS_SEXSTORE_KV_PROOF)"
      (then (define SEXSTORE_KV_PROOF_ENABLED "1"))
      (else (define SEXSTORE_KV_PROOF_ENABLED "0")))

    (comment "Opcodes, local to sexstore until silk-shell integration promotes them to sex-pdx.")
    (define OP_KV_GET "UINT64_C(0xB0)")
    (define OP_KV_PUT "UINT64_C(0xB1)")
    (define OP_KV_DEL "UINT64_C(0xB2)")

    (comment "Status codes (E6, aligned with E2). A GET hit replies with the stored value, bit 63 clear; every other reply is REPLY_STATUS_BIT over a code.")
    (define KV_OK "UINT64_C(0x00)")
    (define KV_NOT_FOUND "UINT64_C(0x01)")
    (define KV_FULL "UINT64_C(0x02)")
    (define KV_INVALID_KEY "UINT64_C(0x03)")
    (define KV_INVALID_VALUE "UINT64_C(0x04)")
    (define KV_DENIED "UINT64_C(0x05)")
    (define REPLY_STATUS_BIT "UINT64_C(0x8000000000000000)")

    (comment "silk-shell's domain in the fixed spawn order of kernel/src/init.rs (module_paths[2]); the only caller E4 authorizes. It must follow any change to that order.")
    (define KV_SHELL_CALLER "UINT64_C(3)")

    (typedef (struct Sexstore
      (KvTable kv)
      (Durable durable)
      (uint8_t proof_stage)
      (uint32_t log_put) (uint32_t log_get)
      (comment "E4: policy and validation markers.")
      (uint32_t log_policy_allow) (uint32_t log_policy_deny) (uint32_t log_key_invalid) (uint32_t log_value_invalid)
      (uint32_t log_reply_error)
      (comment "E6: generation and tombstone markers.")
      (uint32_t log_generation_bump) (uint32_t log_tombstone_record) (uint32_t log_tombstone_get)
      (uint32_t log_tombstone_revive)
      (comment "E7: structured allow and reject markers.")
      (uint32_t log_put_allow) (uint32_t log_put_reject) (uint32_t log_get_allow) (uint32_t log_get_reject)
      (uint32_t log_delete_allow) (uint32_t log_delete_reject)) Sexstore)

    (comment "A budget allows its line while it lasts.")
    (fn (static bool) take ((uint32_t (* budget)))
      (if (== (* budget) 0) (return false))
      (-= (* budget) 1)
      (return true))

    (comment "The owner class of a key: 0 invalid (key 0), 1 the shell range 0x01..0x0F, 2 reserved (0x10 and up).")
    (fn (static uint8_t) store_key_owner_class ((uint32_t key))
      (if (== key 0) (return 0))
      (if (<= key 0x0F) (return 1))
      (return 2))

    (comment "E4: only silk-shell, and only on the shell range.")
    (fn (static bool) store_cap_allowed ((uint64_t caller_pd) (uint32_t key))
      (return (&& (== (call store_key_owner_class key) 1) (== caller_pd KV_SHELL_CALLER))))

    (comment "Bit 63 would collide with REPLY_STATUS_BIT in a GET reply. Key 1 holds the scene settings envelope: magic 0xAC, version 0x01, and in byte 7 the XOR of bytes 0..6 masked to 7 bits, which keeps bit 63 clear.")
    (fn (static bool) store_validate_value ((uint32_t key) (uint64_t value))
      (if (!= (& value REPLY_STATUS_BIT) 0) (return false))
      (if (== key 0x01)
        (block
          (var uint8_t ([] b 8) (init 0))
          (for (var size_t i 0) (< i 8) (++ i) (= ([] b i) (cast uint8_t (>> value (* 8 i)))))
          (if (|| (!= ([] b 0) 0xAC) (!= ([] b 1) 0x01)) (return false))
          (var uint8_t chk 0)
          (for (var size_t i 0) (< i 7) (++ i) (^= chk ([] b i)))
          (if (!= ([] b 7) (& chk 0x7F)) (return false))))
      (return true))

    (comment "Generations count writes 1..255 and wrap to 1, never 0.")
    (fn (static void) bump_generation ((KvSlot (* slot)))
      (= (-> slot generation) (cast uint8_t (?: (>= (-> slot generation) 255) 1 (+ (-> slot generation) 1)))))

    (comment "The slot holding KEY, active or tombstoned, or KV_SLOT_COUNT.")
    (fn (static size_t) find_slot (((const KvTable) (* table)) (uint32_t key))
      (for (var size_t i 0) (< i KV_SLOT_COUNT) (++ i)
        (if (&& (!= (. ([] (-> table slots) i) state) SLOT_EMPTY) (== (. ([] (-> table slots) i) key) key)) (return i)))
      (return KV_SLOT_COUNT))

    (comment "The KV contract proof (SEXOS_SEXSTORE_KV_PROOF) drives the table directly through these, at boot.")
    (fn (static void) kv_reset_for_proof ((KvTable (* table)))
      (for (var size_t i 0) (< i KV_SLOT_COUNT) (++ i)
        (= ([] (-> table slots) i) (compound KvSlot (= (. state) SLOT_EMPTY)))))

    (fn (static uint64_t) kv_put_for_proof ((KvTable (* table)) (uint64_t caller) (uint32_t key) (uint64_t val))
      (if (! (call store_cap_allowed caller key))
        (return (| REPLY_STATUS_BIT (?: (== (call store_key_owner_class key) 0) KV_INVALID_KEY KV_DENIED))))
      (if (! (call store_validate_value key val)) (return (| REPLY_STATUS_BIT KV_INVALID_VALUE)))
      (var size_t found (call find_slot table key))
      (if (< found KV_SLOT_COUNT)
        (block
          (var KvSlot (* slot) (& ([] (-> table slots) found)))
          (= (-> slot state) SLOT_ACTIVE)
          (= (-> slot val) val)
          (call bump_generation slot)
          (return (| REPLY_STATUS_BIT KV_OK))))
      (comment "The first empty slot, else the first tombstoned one.")
      (var size_t empty KV_SLOT_COUNT)
      (var size_t tomb KV_SLOT_COUNT)
      (for (var size_t j 0) (< j KV_SLOT_COUNT) (++ j)
        (block
          (if (&& (== (. ([] (-> table slots) j) state) SLOT_EMPTY) (== empty KV_SLOT_COUNT)) (= empty j))
          (if (&& (== (. ([] (-> table slots) j) state) SLOT_TOMBSTONED) (== tomb KV_SLOT_COUNT)) (= tomb j))))
      (var size_t idx (?: (< empty KV_SLOT_COUNT) empty tomb))
      (if (== idx KV_SLOT_COUNT) (return (| REPLY_STATUS_BIT KV_FULL)))
      (= ([] (-> table slots) idx)
        (compound KvSlot (= (. state) SLOT_ACTIVE) (= (. generation) 1) (= (. key) key) (= (. val) val)))
      (return (| REPLY_STATUS_BIT KV_OK)))

    (fn (static uint64_t) kv_get_for_proof (((const KvTable) (* table)) (uint64_t caller) (uint32_t key))
      (if (! (call store_cap_allowed caller key))
        (return (| REPLY_STATUS_BIT (?: (== (call store_key_owner_class key) 0) KV_INVALID_KEY KV_DENIED))))
      (var size_t found (call find_slot table key))
      (if (&& (< found KV_SLOT_COUNT) (== (. ([] (-> table slots) found) state) SLOT_ACTIVE))
        (return (. ([] (-> table slots) found) val)))
      (return (| REPLY_STATUS_BIT KV_NOT_FOUND)))

    (comment "A put without policy or envelope checks; it never reclaims tombstones.")
    (fn (static uint64_t) kv_put_raw_for_proof ((KvTable (* table)) (uint32_t key) (uint64_t val))
      (var size_t found (call find_slot table key))
      (if (< found KV_SLOT_COUNT)
        (block
          (var KvSlot (* slot) (& ([] (-> table slots) found)))
          (= (-> slot state) SLOT_ACTIVE)
          (= (-> slot val) val)
          (call bump_generation slot)
          (return (| REPLY_STATUS_BIT KV_OK))))
      (for (var size_t j 0) (< j KV_SLOT_COUNT) (++ j)
        (if (== (. ([] (-> table slots) j) state) SLOT_EMPTY)
          (block
            (= ([] (-> table slots) j)
              (compound KvSlot (= (. state) SLOT_ACTIVE) (= (. generation) 1) (= (. key) key) (= (. val) val)))
            (return (| REPLY_STATUS_BIT KV_OK)))))
      (return (| REPLY_STATUS_BIT KV_FULL)))

    (fn (static void) run_kv_contract_proof_stage ((Sexstore (* s)))
      (var uint8_t stage (-> s proof_stage))
      (if (>= stage 6) (return))
      (= (-> s proof_stage) (cast uint8_t (+ stage 1)))
      (call sexos_line "[sexstore.kv.proof] stage=%u" (cast unsigned stage))
      (var KvTable (* kv) (& (-> s kv)))
      (if (== stage 0)
        (block
          (call kv_reset_for_proof kv)
          (var uint64_t put (call kv_put_for_proof kv KV_SHELL_CALLER 0x02 0x2A02))
          (var uint64_t get (call kv_get_for_proof kv KV_SHELL_CALLER 0x02))
          (call sexos_line "[sexstore.kv.proof.roundtrip] ok=%u put=%#llx get=%#llx"
            (cast unsigned (&& (== put (| REPLY_STATUS_BIT KV_OK)) (== get 0x2A02)))
            (cast (unsigned long long) put) (cast (unsigned long long) get))
          (return)))
      (if (== stage 1)
        (block
          (var uint64_t get (call kv_get_for_proof kv KV_SHELL_CALLER 0x03))
          (call sexos_line "[sexstore.kv.proof.missing_key] ok=%u res=%#llx"
            (cast unsigned (== get (| REPLY_STATUS_BIT KV_NOT_FOUND))) (cast (unsigned long long) get))
          (return)))
      (if (== stage 2)
        (block
          (var uint64_t put (call kv_put_for_proof kv KV_SHELL_CALLER 0x00 1))
          (call sexos_line "[sexstore.kv.proof.oversized_key] ok=%u res=%#llx bound=4bytes"
            (cast unsigned (== put (| REPLY_STATUS_BIT KV_INVALID_KEY))) (cast (unsigned long long) put))
          (return)))
      (if (== stage 3)
        (block
          (var uint64_t put (call kv_put_for_proof kv KV_SHELL_CALLER 0x01 REPLY_STATUS_BIT))
          (call sexos_line "[sexstore.kv.proof.oversized_value] ok=%u res=%#llx bound=8bytes"
            (cast unsigned (== put (| REPLY_STATUS_BIT KV_INVALID_VALUE))) (cast (unsigned long long) put))
          (return)))
      (if (== stage 4)
        (block
          (call kv_reset_for_proof kv)
          (var uint64_t last (| REPLY_STATUS_BIT KV_OK))
          (for (var size_t i 0) (< i KV_SLOT_COUNT) (++ i)
            (= last (call kv_put_raw_for_proof kv (cast uint32_t (+ i 1)) (+ (cast uint64_t i) 10))))
          (var uint64_t full (call kv_put_raw_for_proof kv (cast uint32_t (+ KV_SLOT_COUNT 1)) 0x55))
          (call sexos_line "[sexstore.kv.proof.table_full] ok=%u last=%#llx full=%#llx slots=%u"
            (cast unsigned (&& (== last (| REPLY_STATUS_BIT KV_OK)) (== full (| REPLY_STATUS_BIT KV_FULL))))
            (cast (unsigned long long) last) (cast (unsigned long long) full) (cast unsigned KV_SLOT_COUNT))
          (return)))
      (var uint64_t put (call kv_put_for_proof kv 99 0x01 0x1234))
      (var uint64_t get (call kv_get_for_proof kv 99 0x01))
      (call sexos_line "[sexstore.kv.proof.owner_deny] ok=%u put=%#llx get=%#llx"
        (cast unsigned (&& (== put (| REPLY_STATUS_BIT KV_DENIED)) (== get (| REPLY_STATUS_BIT KV_DENIED))))
        (cast (unsigned long long) put) (cast (unsigned long long) get)))

    (comment "A caller without authority for KEY: log the refusal under REJECT_MARKER and reply invalid_key (key 0) or denied. The GET path logs the denied class as a number, PUT and DEL as a name.")
    (fn (static void) refuse ((Sexstore (* s)) (uint64_t caller) (uint32_t key) ((const char) (* reject_marker))
                              (uint32_t (* reject_log)) (bool numeric_class))
      (var uint8_t cls (call store_key_owner_class key))
      (if (== cls 0)
        (block
          (if (call take (& (-> s log_key_invalid)))
            (call sexos_line "[sexstore.key.invalid] caller=%llu key=0x00" (cast (unsigned long long) caller))))
        (if (call take (& (-> s log_policy_deny)))
          (block
            (if numeric_class
              (call sexos_line "[sexstore.policy.deny] caller=%llu key=%u class=%u"
                (cast (unsigned long long) caller) (cast unsigned key) (cast unsigned cls))
              (if (== cls 2)
                (call sexos_line "[sexstore.policy.deny] caller=%llu key=%u class=reserved"
                  (cast (unsigned long long) caller) (cast unsigned key))
                (call sexos_line "[sexstore.policy.deny] caller=%llu key=%u class=shell reason=no_cap"
                  (cast (unsigned long long) caller) (cast unsigned key)))))))
      (if (call take reject_log)
        (block
          (if (== cls 0)
            (call sexos_line "%s caller=%llu key=%u status=invalid_key reason=zero_key"
              reject_marker (cast (unsigned long long) caller) (cast unsigned key))
            (call sexos_line "%s caller=%llu key=%u status=denied reason=no_cap"
              reject_marker (cast (unsigned long long) caller) (cast unsigned key)))))
      (cast void (call sexos_reply (cast uint32_t caller) (| REPLY_STATUS_BIT (?: (== cls 0) KV_INVALID_KEY KV_DENIED)))))

    (fn (static void) allow ((Sexstore (* s)) (uint64_t caller) (uint32_t key) ((const char) (* op)))
      (if (call take (& (-> s log_policy_allow)))
        (call sexos_line "[sexstore.policy.allow] caller=%llu key=%u op=%s" (cast (unsigned long long) caller) (cast unsigned key) op)))

    (fn (static void) handle_put ((Sexstore (* s)) (uint64_t caller) (uint32_t key) (uint64_t val))
      (if (! (call store_cap_allowed caller key))
        (block
          (call refuse s caller key "[sexstore.put.reject]" (& (-> s log_put_reject)) false)
          (return)))
      (call allow s caller key "PUT")
      (comment "E4: the value envelope of known keys.")
      (if (! (call store_validate_value key val))
        (block
          (if (call take (& (-> s log_value_invalid)))
            (call sexos_line "[sexstore.value.invalid] caller=%llu key=%u" (cast (unsigned long long) caller) (cast unsigned key)))
          (if (call take (& (-> s log_put_reject)))
            (call sexos_line "[sexstore.put.reject] caller=%llu key=%u status=invalid_value reason=envelope_fail"
              (cast (unsigned long long) caller) (cast unsigned key)))
          (cast void (call sexos_reply (cast uint32_t caller) (| REPLY_STATUS_BIT KV_INVALID_VALUE)))
          (return)))

      (comment "E6: update the key's slot, reviving a tombstone, else insert into an empty slot, else reclaim a tombstoned one. Each change is written durably after the RAM commit.")
      (var size_t found (call find_slot (& (-> s kv)) key))
      (var bool was_update (< found KV_SLOT_COUNT))
      (if was_update
        (block
          (var KvSlot (* slot) (& ([] (. (-> s kv) slots) found)))
          (var bool was_tombstoned (== (-> slot state) SLOT_TOMBSTONED))
          (= (-> slot val) val)
          (if was_tombstoned
            (block
              (= (-> slot state) SLOT_ACTIVE)
              (if (call take (& (-> s log_tombstone_revive)))
                (call sexos_line "[sexstore.tombstone.revive] key=%u old_gen=%u" (cast unsigned key) (cast unsigned (-> slot generation))))))
          (call bump_generation slot)
          (if (call take (& (-> s log_generation_bump)))
            (call sexos_line "[sexstore.generation.bump] key=%u slot=%u gen=%u op=%s" (cast unsigned key) (cast unsigned found)
              (cast unsigned (-> slot generation)) (?: was_tombstoned "revive" "put")))
          (if (call take (& (-> s log_put_allow)))
            (call sexos_line "[sexstore.put.allow] caller=%llu key=%u status=ok state=%u gen=%u" (cast (unsigned long long) caller)
              (cast unsigned key) (cast unsigned (-> slot state)) (cast unsigned (-> slot generation))))
          (cast void (call sexstore_durable_write_all (& (-> s durable)) (& (-> s kv))))
          (cast void (call sexos_reply (cast uint32_t caller) (| REPLY_STATUS_BIT KV_OK))))
        (block
          (var bool inserted false)
          (for (var size_t pass 0) (&& (< pass 2) (! inserted)) (++ pass)
            (for (var size_t i 0) (< i KV_SLOT_COUNT) (++ i)
              (block
                (var KvSlot (* slot) (& ([] (. (-> s kv) slots) i)))
                (if (== (-> slot state) (?: (== pass 0) SLOT_EMPTY SLOT_TOMBSTONED))
                  (block
                    (comment "A reclaimed slot starts a new key's lifecycle at generation 1 (E10).")
                    (= (* slot) (compound KvSlot (= (. state) SLOT_ACTIVE) (= (. generation) 1) (= (. key) key) (= (. val) val)))
                    (= inserted true)
                    (if (call take (& (-> s log_generation_bump)))
                      (call sexos_line "[sexstore.generation.bump] key=%u slot=%u gen=1 op=%s" (cast unsigned key) (cast unsigned i)
                        (?: (== pass 0) "insert" "reclaim")))
                    (cast void (call sexstore_durable_write_all (& (-> s durable)) (& (-> s kv))))
                    break)))))
          (comment "A full table changes nothing, so it writes nothing.")
          (if inserted
            (block
              (if (call take (& (-> s log_put_allow)))
                (call sexos_line "[sexstore.put.allow] caller=%llu key=%u status=ok state=1 gen=1"
                  (cast (unsigned long long) caller) (cast unsigned key))))
            (if (call take (& (-> s log_put_reject)))
              (call sexos_line "[sexstore.put.reject] caller=%llu key=%u status=full reason=table_full"
                (cast (unsigned long long) caller) (cast unsigned key))))
          (cast void (call sexos_reply (cast uint32_t caller) (| REPLY_STATUS_BIT (?: inserted KV_OK KV_FULL))))))
      (if (call take (& (-> s log_put)))
        (call sexos_line "[sexstore.kv.put] key=%u ok=%u" (cast unsigned key) (cast unsigned was_update))))

    (fn (static void) handle_get ((Sexstore (* s)) (uint64_t caller) (uint32_t key))
      (if (! (call store_cap_allowed caller key))
        (block
          (call refuse s caller key "[sexstore.get.reject]" (& (-> s log_get_reject)) true)
          (return)))
      (call allow s caller key "GET")
      (var size_t found (call find_slot (& (-> s kv)) key))
      (var uint8_t found_state (?: (< found KV_SLOT_COUNT) (. ([] (. (-> s kv) slots) found) state) SLOT_EMPTY))
      (if (== found_state SLOT_ACTIVE)
        (block
          (var (const KvSlot) (* slot) (& ([] (. (-> s kv) slots) found)))
          (if (call take (& (-> s log_get_allow)))
            (call sexos_line "[sexstore.get.allow] caller=%llu key=%u status=ok state=1 gen=%u"
              (cast (unsigned long long) caller) (cast unsigned key) (cast unsigned (-> slot generation))))
          (cast void (call sexos_reply (cast uint32_t caller) (-> slot val))))
        (block
          (if (== found_state SLOT_TOMBSTONED)
            (block
              (if (call take (& (-> s log_tombstone_get)))
                (call sexos_line "[sexstore.tombstone.get] key=%u slot=%u gen=%u" (cast unsigned key) (cast unsigned found)
                  (cast unsigned (. ([] (. (-> s kv) slots) found) generation))))
              (if (call take (& (-> s log_get_reject)))
                (call sexos_line "[sexstore.get.reject] caller=%llu key=%u status=not_found reason=tombstoned"
                  (cast (unsigned long long) caller) (cast unsigned key))))
            (if (call take (& (-> s log_get_reject)))
              (call sexos_line "[sexstore.get.reject] caller=%llu key=%u status=not_found reason=missing"
                (cast (unsigned long long) caller) (cast unsigned key))))
          (cast void (call sexos_reply (cast uint32_t caller) (| REPLY_STATUS_BIT KV_NOT_FOUND)))))
      (if (call take (& (-> s log_get)))
        (call sexos_line "[sexstore.kv.get] key=%u hit=%u" (cast unsigned key) (cast unsigned (== found_state SLOT_ACTIVE)))))

    (fn (static void) handle_delete ((Sexstore (* s)) (uint64_t caller) (uint32_t key))
      (if (! (call store_cap_allowed caller key))
        (block
          (call refuse s caller key "[sexstore.delete.reject]" (& (-> s log_delete_reject)) false)
          (return)))
      (call allow s caller key "DEL")
      (var size_t found (call find_slot (& (-> s kv)) key))
      (if (== found KV_SLOT_COUNT)
        (block
          (if (call take (& (-> s log_delete_reject)))
            (call sexos_line "[sexstore.delete.reject] caller=%llu key=%u status=not_found reason=missing"
              (cast (unsigned long long) caller) (cast unsigned key)))
          (cast void (call sexos_reply (cast uint32_t caller) (| REPLY_STATUS_BIT KV_NOT_FOUND)))
          (return)))
      (var KvSlot (* slot) (& ([] (. (-> s kv) slots) found)))
      (if (== (-> slot state) SLOT_ACTIVE)
        (block
          (comment "Active becomes tombstoned, with a generation bump.")
          (= (-> slot state) SLOT_TOMBSTONED)
          (call bump_generation slot)
          (if (call take (& (-> s log_tombstone_record)))
            (call sexos_line "[sexstore.tombstone.record] key=%u slot=%u gen=%u reason=delete" (cast unsigned key)
              (cast unsigned found) (cast unsigned (-> slot generation))))
          (if (call take (& (-> s log_generation_bump)))
            (call sexos_line "[sexstore.generation.bump] key=%u slot=%u gen=%u op=tombstone" (cast unsigned key)
              (cast unsigned found) (cast unsigned (-> slot generation))))
          (if (call take (& (-> s log_delete_allow)))
            (call sexos_line "[sexstore.delete.allow] caller=%llu key=%u status=ok state=2 gen=%u reason=delete"
              (cast (unsigned long long) caller) (cast unsigned key) (cast unsigned (-> slot generation)))))
        (block
          (comment "Already tombstoned: idempotent, and written again.")
          (if (call take (& (-> s log_tombstone_record)))
            (call sexos_line "[sexstore.tombstone.record] key=%u slot=%u gen=%u reason=delete_idempotent" (cast unsigned key)
              (cast unsigned found) (cast unsigned (-> slot generation))))
          (if (call take (& (-> s log_delete_allow)))
            (call sexos_line "[sexstore.delete.allow] caller=%llu key=%u status=ok reason=idempotent"
              (cast (unsigned long long) caller) (cast unsigned key)))))
      (cast void (call sexstore_durable_write_all (& (-> s durable)) (& (-> s kv))))
      (cast void (call sexos_reply (cast uint32_t caller) (| REPLY_STATUS_BIT KV_OK))))

    (fn void sexstore_main (void)
      (var Sexstore s
        (compound Sexstore
          (= (. durable) (call sexstore_durable_new))
          (= (. log_put) 32) (= (. log_get) 32)
          (= (. log_policy_allow) 32) (= (. log_policy_deny) 32) (= (. log_key_invalid) 8) (= (. log_value_invalid) 8)
          (= (. log_reply_error) 8)
          (= (. log_generation_bump) 64) (= (. log_tombstone_record) 32) (= (. log_tombstone_get) 32)
          (= (. log_tombstone_revive) 16)
          (= (. log_put_allow) 32) (= (. log_put_reject) 16) (= (. log_get_allow) 32) (= (. log_get_reject) 16)
          (= (. log_delete_allow) 16) (= (. log_delete_reject) 8)))
      (call sexos_line "[sexstore.init.start]")
      (comment "E13: the empty table first, then whatever the durable pages hold. A first boot writes page A.")
      (cast void (call sexstore_durable_init (& (. s durable)) (& (. s kv))))
      (cast void (call sexstore_durable_load_into_ram (& (. s durable)) (& (. s kv))))
      (call sexos_line "[sexstore.status.mapping] KV_OK=0x00 KV_NOT_FOUND=0x01 KV_FULL=0x02 KV_INVALID_KEY=0x03 KV_INVALID_VALUE=0x04 KV_DENIED=0x05 REPLY_BIT=0x8000")
      (if SEXSTORE_KV_PROOF_ENABLED
        (while (< (. s proof_stage) 6) (call run_kv_contract_proof_stage (& s))))
      (call sexos_line "[sexstore.ready]")
      (var SexosListener listener (compound SexosListener (= (. wrapper_budget) 8)))
      (while 1
        (block
          (comment "Slot 0 is the server's own message ring.")
          (var SexosMessage msg (call sexos_listen (& listener) 0))
          (var uint64_t caller (. msg caller_pd))
          (var uint32_t key (cast uint32_t (. msg arg0)))
          (if (== (. msg type_id) OP_KV_PUT)
            (call handle_put (& s) caller key (. msg arg1))
            (if (== (. msg type_id) OP_KV_GET)
              (call handle_get (& s) caller key)
              (if (== (. msg type_id) OP_KV_DEL)
                (call handle_delete (& s) caller key)
                (block
                  (comment "An unknown opcode is answered with 0.")
                  (if (call take (& (. s log_reply_error)))
                    (call sexos_line "[sexstore.reply.error] caller=%llu op=%#llx"
                      (cast (unsigned long long) caller) (cast (unsigned long long) (. msg type_id))))
                  (cast void (call sexos_reply (cast uint32_t caller) 0)))))))))))
