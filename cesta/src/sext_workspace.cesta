(cesta native-c/1 compact-c/2
  (unit
    (include "sext_service.h")
    (comment "Native memory boundary: the caller holds the completed retirement grant for the entire alias. Volatile access and compiler fences preserve the upstream workspace behavior.")
    (native "
#include <stdatomic.h>
void sext_backend_zero(uint64_t address,uint64_t bytes)
{
    uint8_t *p=(uint8_t *)(uintptr_t)address;
    for(uint64_t i=0;i<bytes;++i)p[i]=0;
    atomic_signal_fence(memory_order_release);
}
void sext_workspace_admit(SextWorkspace *out,uint64_t base,uint64_t bytes)
{
    if(!base || base%4096 || bytes<4096 || bytes%4096 || bytes>SIZE_MAX)
        sext_fatal(\"WORKSPACE_SIZE\",0);
    sext_backend_zero(base,bytes);
    atomic_signal_fence(memory_order_seq_cst);
    for(size_t i=0;i<(size_t)bytes/8;++i)
        if(((const volatile uint64_t *)(uintptr_t)base)[i]!=0)sext_fatal(\"WORKSPACE_ZERO\",0);
    *out=(SextWorkspace){base,(size_t)bytes,0,0};
}
uint64_t sext_workspace_record(SextWorkspace *w,uint32_t target,uint64_t token)
{
    size_t offset=w->next;
    volatile uint64_t *p=(volatile uint64_t *)((uint8_t *)(uintptr_t)w->base+offset);
    uint8_t *bytes=(uint8_t *)(uintptr_t)p;
    for(size_t i=0;i<24;++i)bytes[i]=0;
    p[0]=target;p[1]=token;
    if(w->records==UINT64_MAX)sext_fatal(\"WORKSPACE_RECORD_WRAP\",0);
    ++w->records;p[2]=w->records;
    if(p[0]!=target || p[1]!=token || p[2]!=w->records)sext_fatal(\"WORKSPACE_RECORD_VERIFY\",0);
    w->next=offset+48<=w->bytes?offset+24:0;
    return w->records;
}
void sext_workspace_rewind(SextWorkspace *w){w->next=0;}
")))

