(cesta native-c/1 compact-c/2
  (unit
    (ownership (check-all)
    (unchecked (cpu_clac cpu_cli cpu_cpuid cpu_fpu_state_init cpu_fxrstor cpu_fxsave cpu_hlt cpu_inb
                cpu_inl cpu_invlpg cpu_irq_restore cpu_irq_save cpu_lidt cpu_ltr cpu_outb cpu_outl
                cpu_outw cpu_pause cpu_rdmsr cpu_rdseed cpu_read_cr0 cpu_read_cr2 cpu_read_cr3
                cpu_read_cr4 cpu_read_rsp cpu_stac cpu_sti cpu_sti_hlt cpu_write_cr0 cpu_write_cr4
                cpu_wrmsr cpu_wrpkru cpu_xgetbv kernel_poll_consume kernel_poll_inspect
                kernel_poll_is_ready kernel_poll_publish kernel_poll_run kernel_reply_complete
                kernel_reply_inspect kernel_reply_is_heard kernel_reply_is_ready
                kernel_reply_publish kernel_reply_run kernel_rpc_claim kernel_rpc_syscall rpc_call
                rpc_find rpc_poll rpc_reply)
      (obligation "Kernel code on the serialized BSP lane with interrupts masked and application processors parked. It reaches physical frames, page tables and device registers through integer-derived pointers, volatile accesses and the kernel runtime's inline assembly and do-while helpers, which the native ownership profile does not admit. It relies on the kernel owning each frame and device exclusively from BOOT; here correlated request slots.")))
  (include "sexos_kernel.h")

    (comment "Correlated calls are separate from the legacy reply slot. Each caller owns a bounded set of outstanding requests. Only the peer that received a request may complete it; polling or cancellation consumes its identity.")

    (fn (static RpcSlot) * rpc_find ((Domain (* caller)) (uint64_t id))
      (if (== id 0) (return NULL))
      (for (var uint32_t i 0) (< i KERNEL_RPC_CAPACITY) (++ i)
        (if (&& (!= (. ([] (-> caller rpc) i) state) RPC_FREE)
                (== (. ([] (-> caller rpc) i) id) id))
          (return (& ([] (-> caller rpc) i)))))
      (return NULL))

    (fn (static void) rpc_call ((Domain (* caller)) (TrapFrame (* f)))
      (var (const Cap) (* cap) (call cap_get caller (-> f rdi)))
      (= (-> f rax) ERR_CAP_INVALID)
      (var uint64_t opcode (-> f rsi))
      (= (-> f rsi) 0)
      (if (== opcode 0) (return))
      (if (|| (== cap NULL) (!= (-> cap kind) CAP_DOMAIN)) (return))
      (var Domain (* peer) (call domain_get (-> cap target)))
      (if (== peer NULL) (return))
      (var uint32_t task (?: SEXOS_KERNEL_CURRENT_PDX (call kernel_current_task caller) 0))
      (if (&& SEXOS_KERNEL_CURRENT_PDX (== task 0)) (return))
      (if (! (-> peer rpc_enabled))
        (block (= (-> f rax) NO_ADDRESS) (return)))
      (= (-> f rax) ERR_SERVICE_NOT_READY)
      (if (== (-> caller rpc_next) UINT64_MAX) (return))
      (var RpcSlot (* vacant) NULL)
      (for (var uint32_t i 0) (< i KERNEL_RPC_CAPACITY) (++ i)
        (if (== (. ([] (-> caller rpc) i) state) RPC_FREE)
          (block (= vacant (& ([] (-> caller rpc) i))) break)))
      (if (== vacant NULL) (return))
      (var uint64_t id (+ (-> caller rpc_next) 1))
      (var RingEntry message (compound RingEntry
        (= (. type_id) opcode) (= (. caller) (-> caller id))
        (= (. sender) (-> caller id)) (= (. caller_task) (?: SEXOS_KERNEL_CURRENT_PDX task 0)) (= (. request_id) id)
        (= (. arg0) (-> f rdx)) (= (. arg1) (-> f r10)) (= (. arg2) (-> f r8))))
      (if (! (call domain_enqueue peer message)) (return))
      (= (* vacant) (compound RpcSlot (= (. id) id) (= (. peer) (-> peer id)) (= (. state) RPC_QUEUED)))
      (= (-> caller rpc_next) id)
      (= (-> f rsi) id)
      (= (-> f rax) 0))

    (fn bool kernel_rpc_claim ((Domain (* receiver)) ((const RingEntry) (* message)))
      (var Domain (* caller) (call domain_get (-> message sender)))
      (if (== caller NULL) (return false))
      (var RpcSlot (* request) (call rpc_find caller (-> message request_id)))
      (if (|| (== request NULL) (|| (!= (-> request peer) (-> receiver id))
                                  (!= (-> request state) RPC_QUEUED))) (return false))
      (= (-> request state) RPC_HEARD)
      (return true))

    (comment "A heard request is a certificate invalidated by completion. Polling copies the value before consuming the ready slot; publication uses that copy rather than a stale slot reference.")
    (native "
typedef struct KernelReplyContext {
    Domain *peer, *caller;
    TrapFrame *frame;
    RpcSlot *request;
    uint64_t id;
} KernelReplyContext;

static bool kernel_reply_is_heard(KernelReplyContext *c) {
    return c->request && c->request->id == c->id && c->request->peer == c->peer->id &&
           c->request->state == RPC_HEARD;
}

static bool kernel_reply_is_ready(KernelReplyContext *c) {
    return c->request && c->request->id == c->id && c->request->peer == c->peer->id &&
           c->request->state == RPC_READY;
}

static bool kernel_reply_inspect(KernelReplyContext *c) {
    if (c->frame->rdi >= KERNEL_MAX_DOMAINS)
        return false;
    c->caller = domain_get((uint32_t)c->frame->rdi);
    if (!c->caller)
        return false;
    c->id = c->frame->rsi;
    c->request = rpc_find(c->caller, c->id);
    return kernel_reply_is_heard(c);
}

static bool kernel_reply_complete(KernelReplyContext *c) {
    if (!kernel_reply_is_heard(c))
        return false;
    c->request->value = c->frame->rdx;
    c->request->state = RPC_READY;
    if (SEXOS_KERNEL_CURRENT_PDX)
        kernel_task_wake(c->caller);
    return true;
}

static bool kernel_reply_publish(KernelReplyContext *c) {
    if (!kernel_reply_is_ready(c))
        return false;
    c->frame->rax = 0;
    return true;
}

typedef struct KernelPollContext {
    Domain *caller;
    TrapFrame *frame;
    RpcSlot *request;
    uint64_t id, value;
    bool copied;
} KernelPollContext;

static bool kernel_poll_is_ready(KernelPollContext *c) {
    return c->request && c->request->id == c->id && c->request->state == RPC_READY;
}

static bool kernel_poll_is_copied(KernelPollContext *c) {
    return c->copied;
}

static bool kernel_poll_inspect(KernelPollContext *c) {
    c->id = c->frame->rdi;
    c->request = rpc_find(c->caller, c->id);
    if (!c->request)
        return false;
    c->frame->rax = ERR_SERVICE_NOT_READY;
    return kernel_poll_is_ready(c);
}

static bool kernel_poll_consume(KernelPollContext *c) {
    if (!kernel_poll_is_ready(c))
        return false;
    c->value = c->request->value;
    *c->request = (RpcSlot){.state = RPC_FREE};
    c->copied = true;
    return true;
}

static bool kernel_poll_publish(KernelPollContext *c) {
    if (!c->copied)
        return false;
    c->frame->rsi = c->value;
    c->frame->rax = 0;
    return true;
}

#define kernel_reply_run_CHECKED 1
#define kernel_poll_run_CHECKED 1
#define kernel_reply_run_CHECK_FAILURE(ctx, kind, id, expected)                                    \\
    kernel_halt(\"reply protocol invariant\")
#define kernel_poll_run_CHECK_FAILURE(ctx, kind, id, expected)                                     \\
    kernel_halt(\"poll protocol invariant\")
")
    (use-protocols "../interfaces/kernel_reply_protocol.module" Protocols)
    (use-protocols "../interfaces/kernel_poll_protocol.module" Protocols)
    (fn (static void) rpc_poll ((Domain (* caller)) (TrapFrame (* f)))
      (= (-> f rsi) 0)
      (= (-> f rax) ERR_CAP_INVALID)
      (var KernelPollContext context (compound KernelPollContext (= (. caller) caller) (= (. frame) f)))
      (cast void (call kernel_poll_run (& context))))

    (fn (static void) rpc_reply ((Domain (* peer)) (TrapFrame (* f)))
      (= (-> f rax) ERR_CAP_INVALID)
      (var KernelReplyContext context (compound KernelReplyContext (= (. peer) peer) (= (. frame) f)))
      (cast void (call kernel_reply_run (& context))))

    (fn void kernel_rpc_syscall ((Domain (* d)) (TrapFrame (* f)) (uint64_t number))
      (switch number
        (block
          (case SEXOS_RPC_register
            (block (= (-> d rpc_enabled) true) (= (-> f rax) 1))) break
          (case SEXOS_RPC_call (call rpc_call d f)) break
          (case SEXOS_RPC_poll (call rpc_poll d f)) break
          (case SEXOS_RPC_listen
            (block
              (var RingEntry message (call kernel_listen_message d (-> f rdi)))
              (= (-> f rax) (. message type_id))
              (= (-> f rsi) (. message caller))
              (= (-> f rdx) (. message arg0))
              (= (-> f r10) (. message arg1))
              (= (-> f r8) (. message arg2))
              (if SEXOS_KERNEL_CURRENT_PDX (= (-> f rdi) (. message caller_task)))
              (= (-> f r9) (. message request_id)))) break
          (case SEXOS_RPC_reply (call rpc_reply d f)) break
          (case SEXOS_RPC_cancel
            (block
              (var RpcSlot (* request) (call rpc_find d (-> f rdi)))
              (= (-> f rax) ERR_CAP_INVALID)
              (if (!= request NULL)
                (block
                  (= (* request) (compound RpcSlot (= (. state) RPC_FREE)))
                  (= (-> f rax) 0))))) break
          (default (= (-> f rax) NO_ADDRESS)))))))
