(cesta native-c/1 compact-c/2
  (unit
    (include "sexos_mmio.h")
    (include <stdatomic.h>)

    (comment "xHCI USB host controller and HID driver (servers/sexusb/src/main.rs).")

    (cpp-if "!defined(SEXUSB_SYNTHETIC)"
      (then (define SEXUSB_SYNTHETIC "0")))
    (cpp-if "!defined(SEXUSB_SLOT2_OWNERSHIP_PROOF)"
      (then (define SEXUSB_SLOT2_OWNERSHIP_PROOF "0")))
    (cpp-if "!defined(SEXUSB_SYNTHETIC_SLOT2)"
      (then (define SEXUSB_SYNTHETIC_SLOT2 "0")))
    (cpp-if "!defined(HID_VERBOSE_RING_LOG)"
      (then (define HID_VERBOSE_RING_LOG "0")))

    (define SLOT_USB_HOST "UINT64_C(8)")
    (define SLOT_USB_SEXINPUT "UINT64_C(9)")
    (define OP_USB_MOUSE_REPORT "UINT64_C(0x260)")
    (define OP_USB_KEYBOARD_REPORT "UINT64_C(0x261)")
    (define ERR_CAP_INVALID "UINT64_C(0xFFFFFFFFFFFFFFFC)")

    (define PAGE_SIZE "UINT64_C(4096)")
    (define TRB_SIZE "UINT64_C(16)")
    (define CMD_RING_TRBS "UINT64_C(64)")
    (define EVENT_RING_TRBS "UINT64_C(64)")
    (define ERST_ENTRIES "UINT64_C(1)")
    (define DCBAA_BYTES "PAGE_SIZE")
    (define MAP_BYTES "UINT64_C(0x10000)")

    (define XHCI_USBCMD "UINT64_C(0x00)")
    (define XHCI_USBSTS "UINT64_C(0x04)")
    (define XHCI_OP_CONFIG "UINT64_C(0x08)")
    (define USBCMD_RUN_STOP "(1u << 0)")
    (define USBCMD_HCRST "(1u << 1)")
    (define USBSTS_HCHALTED "(1u << 0)")
    (define USBSTS_CNR "(1u << 11)")
    (define POLL_BUDGET "((size_t)100000)")
    (define MAX_USB_DEVICES "((size_t)2)")
    (define MAX_USB_PORT_TRACKED "((size_t)16)")

    (define XHCI_CRCR "UINT64_C(0x18)")
    (define XHCI_DCBAAP "UINT64_C(0x30)")
    (define XHCI_CAP_DBOFF "UINT64_C(0x14)")
    (define XHCI_CAP_RTSOFF "UINT64_C(0x18)")
    (define XHCI_CAP_HCCPARAMS1 "UINT64_C(0x10)")
    (define XHCI_INTR_ERSTSZ "UINT64_C(0x08)")
    (define XHCI_INTR_ERSTBA "UINT64_C(0x10)")
    (define XHCI_INTR_ERDP "UINT64_C(0x18)")
    (define XHCI_INTR_BASE "UINT64_C(0x20)")

    (define TRB_TYPE_ENABLE_SLOT_CMD "9u")
    (define TRB_TYPE_ADDRESS_DEVICE_CMD "11u")
    (define TRB_TYPE_CONFIGURE_ENDPOINT_CMD "12u")
    (define TRB_TYPE_NOOP_CMD "23u")
    (define TRB_TYPE_EVALUATE_CONTEXT_CMD "13u")
    (define TRB_TYPE_CMD_COMPLETION_EVENT "33u")
    (define TRB_TYPE_TRANSFER_EVENT "32u")
    (define TRB_TYPE_SETUP_STAGE "2u")
    (define TRB_TYPE_DATA_STAGE "3u")
    (define TRB_TYPE_STATUS_STAGE "4u")
    (define TRB_TYPE_NORMAL "1u")
    (define TRB_TYPE_LINK "6u")
    (define TRB_CC_SUCCESS "1u")
    (define TRB_CC_SHORT_PACKET "13u")

    (define PORTSC_BASE "UINT64_C(0x400)")
    (define PORTSC_STRIDE "UINT64_C(0x10)")
    (define PORTSC_CCS "(1u << 0)")
    (define PORTSC_PED "(1u << 1)")

    (define ICC_DROP_NONE "0u")
    (define ICC_ADD_SLOT_EP0 "((1u << 0) | (1u << 1))")
    (define SLOT_CTX_ENTRIES_SHIFT "27u")
    (define SLOT_SPEED_SHIFT "20u")
    (define CERR_DEFAULT "3u")
    (define EP_TYPE_CTRL_SHIFT "3u")
    (define EP_TYPE_CTRL_VAL "2u")
    (define DCS_INITIAL "UINT64_C(1)")
    (define EP_TYPE_INTERRUPT_IN "7u")
    (define INTR_TR_RING_SIZE "UINT64_C(16)")
    (define HID_INFLIGHT "UINT64_C(8)")
    (define HID_BUF_STRIDE "UINT64_C(64)")
    (define HID_RING_LINK_INDEX "HID_INFLIGHT")
    (define HID_INTR_LIVENESS_BUDGET "(POLL_BUDGET * 4)")

    (typedef (enum HidRole
      (= HID_ROLE_KEYBOARD 0)
      (= HID_ROLE_POINTER_TABLET 1)
      (= HID_ROLE_POINTER_MOUSE 2)
      (= HID_ROLE_UNKNOWN 3)) HidRole)

    (typedef (struct BootMouseReport
        (uint8_t buttons)
        (int8_t dx)
        (int8_t dy)
        (int8_t wheel)) BootMouseReport)

    (typedef (struct TabletReport
        (uint8_t buttons)
        (uint16_t abs_x)
        (uint16_t abs_y)) TabletReport)

    (typedef (struct SingleHidBind
        (uint32_t slot_id)
        (uint64_t port)
        (HidRole role)
        (uint8_t ep_addr)
        (uint32_t ep_dci)
        (uint16_t max_packet)
        (uint8_t interval)) SingleHidBind)

    (typedef (struct HidDevice
        (bool active)
        (uint32_t slot_id)
        (HidRole role)
        (uint32_t intr_dci)
        (uint64_t intr_ring_phys)
        (uint64_t intr_ring_va)
        (uint64_t intr_report_phys)
        (uint64_t intr_report_va)
        (uint32_t intr_report_len)) HidDevice)

    (typedef (struct PortDiscoveryState
        (uint8_t port)
        (bool connected)
        (bool enabled)
        (bool reset_attempted)
        (uint32_t slot_id)) PortDiscoveryState)

    (typedef (struct SexusbState
        (atomic_bool cap_ready_sexinput)
        (atomic_bool defer_emitted_sexinput)
        (atomic_bool edge_send_emitted_sexinput)
        (atomic_bool route_ready_emitted_sexinput)
        (atomic_bool route_missing_emitted_sexinput)
        (atomic_bool bootgraph_proof_sent)
        (atomic_bool bootgraph_proof_marker_emitted)
        (uint32_t iface_diag_budget)
        (bool mouse_detect_proof_emitted)
        (bool tablet_detect_proof_emitted)
        (uint32_t ep_diag_budget)
        (uint32_t kick_budget)
        (uint32_t own_budget)
        (uint32_t own_miss_budget)
        (uint32_t c2b_event_budget)
        (uint32_t xfer_event_budget)
        (uint32_t s2_xfer_event_budget)
        (uint32_t s2_rearm_ok_budget)
        (uint32_t c2c_budget)
        (uint32_t rearm_ok_budget)
        (uint32_t intr_raw_budget)
        (uint32_t intr_raw_seq)
        (uint32_t intr_classify_kbd_budget)
        (uint32_t intr_classify_kbd_seq)
        (bool kbd_raw_proof_emitted)
        (uint32_t kbd_raw_budget)
        (bool kbd_decode_proof_emitted)
        (uint32_t kbd_forward_budget)
        (uint32_t intr_classify_tbl_budget)
        (uint32_t intr_classify_tbl_seq)
        (bool tablet_raw_proof_emitted)
        (uint64_t tablet_active_count)
        (bool tablet_pack_proof_emitted)
        (uint32_t pointer_candidate_tbl_budget)
        (uint32_t pointer_candidate_tbl_seq)
        (uint32_t tablet_abs_budget)
        (uint64_t tablet_report_count)
        (uint32_t forward_mouse_budget)
        (bool tablet_to_input_emitted)
        (uint16_t last_abs_x)
        (uint16_t last_abs_y)
        (uint32_t tablet_live_budget)
        (bool mouse_raw_proof_emitted)
        (uint32_t intr_classify_mouse_ok_budget)
        (uint32_t intr_classify_mouse_ok_seq)
        (uint32_t sexusb_pointer_raw_budget)
        (uint32_t pointer_candidate_mouse_budget)
        (uint32_t pointer_candidate_mouse_seq)
        (bool mouse_pack_proof_emitted)
        (uint32_t forward_mouse_budget_boot)
        (bool mouse_to_input_emitted)
        (uint32_t intr_classify_mouse_bad_budget)
        (uint32_t intr_classify_mouse_bad_seq)
        (uint32_t poll_yield_budget)) SexusbState)

    (var (static SexusbState) SEXUSB_STATE)

    (fn (static void) sexusb_state_init ((SexusbState (* st)))
      (block
        (call memset st 0 (sizeof (* st)))
        (call atomic_init (& (-> st cap_ready_sexinput)) false)
        (call atomic_init (& (-> st defer_emitted_sexinput)) false)
        (call atomic_init (& (-> st edge_send_emitted_sexinput)) false)
        (call atomic_init (& (-> st route_ready_emitted_sexinput)) false)
        (call atomic_init (& (-> st route_missing_emitted_sexinput)) false)
        (call atomic_init (& (-> st bootgraph_proof_sent)) false)
        (call atomic_init (& (-> st bootgraph_proof_marker_emitted)) false)
        (= (-> st iface_diag_budget) 16u)
        (= (-> st ep_diag_budget) 24u)
        (= (-> st kick_budget) 16u)
        (= (-> st own_budget) 64u)
        (= (-> st own_miss_budget) 8u)
        (= (-> st c2b_event_budget) 16u)
        (= (-> st xfer_event_budget) 32u)
        (= (-> st s2_xfer_event_budget) 32u)
        (= (-> st s2_rearm_ok_budget) 32u)
        (= (-> st c2c_budget) 16u)
        (= (-> st rearm_ok_budget) 32u)
        (= (-> st intr_raw_budget) 16u)
        (= (-> st intr_classify_kbd_budget) 16u)
        (= (-> st kbd_raw_budget) 128u)
        (= (-> st kbd_forward_budget) 128u)
        (= (-> st intr_classify_tbl_budget) 16u)
        (= (-> st pointer_candidate_tbl_budget) 16u)
        (= (-> st tablet_abs_budget) 2048u)
        (= (-> st forward_mouse_budget) 16u)
        (= (-> st last_abs_x) 0xFFFFu)
        (= (-> st last_abs_y) 0xFFFFu)
        (= (-> st tablet_live_budget) 16u)
        (= (-> st intr_classify_mouse_ok_budget) 16u)
        (= (-> st sexusb_pointer_raw_budget) 16u)
        (= (-> st pointer_candidate_mouse_budget) 16u)
        (= (-> st forward_mouse_budget_boot) 16u)
        (= (-> st intr_classify_mouse_bad_budget) 16u)
        (= (-> st poll_yield_budget) 64u)))

    (fn (static uint64_t) map_xhci_bar0 ((uint64_t map_size))
      (block
        (return (call sexos_map_pci_bar SLOT_USB_HOST 0ULL map_size))))

    (fn (static uint64_t) sys_alloc_phys ((uint64_t size))
      (block
        (return (call sexos_allocate_memory size))))

    (fn (static uint64_t) sys_map_phys ((uint64_t phys) (uint64_t size))
      (block
        (return (call sexos_map_memory phys size))))

    (fn (static uint32_t) mmio_read32 ((uint64_t base) (uint64_t offset))
      (block
        (return (call sexos_volatile_read32
          (cast ((const uint32_t) *) (cast uintptr_t (+ base offset)))))))

    (fn (static void) mmio_write32 ((uint64_t base) (uint64_t offset) (uint32_t value))
      (block
        (call sexos_volatile_write32
          (cast (uint32_t *) (cast uintptr_t (+ base offset))) value)))

    (fn (static void) trb_write_volatile
      ((uint64_t base_va) (uint64_t index)
       (uint32_t d0) (uint32_t d1) (uint32_t d2) (uint32_t d3))
      (block
        (var uint32_t (* p)
          (cast (uint32_t *) (cast uintptr_t (+ base_va (* index 16ULL)))))
        (call sexos_volatile_write32 (+ p 0) d0)
        (call sexos_volatile_write32 (+ p 1) d1)
        (call sexos_volatile_write32 (+ p 2) d2)
        (call sexos_volatile_write32 (+ p 3) d3)))

    (fn (static uint32_t) trb_read_dword
      ((uint64_t base_va) (uint64_t index) (size_t word))
      (block
        (var (const uint32_t) (* p)
          (cast ((const uint32_t) *) (cast uintptr_t (+ base_va (* index 16ULL)))))
        (return (call sexos_volatile_read32 (+ p word)))))

    (fn (static bool) wait_until
      ((uint64_t base) (uint64_t offset) (uint32_t mask)
       (bool expect_set) (size_t spins))
      (block
        (for (var size_t s 0) (< s spins) (++ s)
          (block
            (var uint32_t v (call mmio_read32 base offset))
            (var bool is_set (!= (& v mask) 0u))
            (if (== is_set expect_set)
              (return true))
            (call sexos_yield)))
        (return false)))

    (fn (static int8_t) wrap_i8 ((uint8_t v))
      (block
        (return (?: (< v 128u) (cast int8_t v) (cast int8_t (- (cast int v) 256))))))

    (fn (static bool) decode_boot_mouse_report
      (((const uint8_t) (* buf)) (size_t len) (BootMouseReport (* out)))
      (block
        (if (< len 3)
          (return false))
        (var int8_t wheel (?: (>= len 4) (call wrap_i8 ([] buf 3)) 0))
        (= (-> out buttons) ([] buf 0))
        (= (-> out dx) (call wrap_i8 ([] buf 1)))
        (= (-> out dy) (call wrap_i8 ([] buf 2)))
        (= (-> out wheel) wheel)
        (return true)))

    (fn (static bool) decode_tablet_report
      (((const uint8_t) (* buf)) (size_t len) (TabletReport (* out)))
      (block
        (if (< len 5)
          (return false))
        (var uint16_t abs_x (| (cast uint16_t ([] buf 1)) (cast uint16_t (<< (cast uint16_t ([] buf 2)) 8))))
        (var uint16_t abs_y (| (cast uint16_t ([] buf 3)) (cast uint16_t (<< (cast uint16_t ([] buf 4)) 8))))
        (= (-> out buttons) (& ([] buf 0) 0x07u))
        (= (-> out abs_x) abs_x)
        (= (-> out abs_y) abs_y)
        (return true)))

    (fn (static HidRole) classify_single_hid_role
      ((bool found_hid_keyboard) (bool found_hid_tablet) (bool found_hid_mouse))
      (block
        (if found_hid_keyboard
          (return HID_ROLE_KEYBOARD))
        (if (&& found_hid_tablet (! found_hid_mouse))
          (return HID_ROLE_POINTER_TABLET))
        (if found_hid_mouse
          (return HID_ROLE_POINTER_MOUSE))
        (return HID_ROLE_UNKNOWN)))

    (fn (static const char) * hid_role_debug_str ((HidRole role))
      (block
        (if (== role HID_ROLE_KEYBOARD) (return "Keyboard"))
        (if (== role HID_ROLE_POINTER_TABLET) (return "PointerTablet"))
        (if (== role HID_ROLE_POINTER_MOUSE) (return "PointerMouse"))
        (return "Unknown")))

    (fn (static uint64_t) send_report_to_sexinput
      ((SexusbState (* st)) (uint64_t op)
       (uint64_t arg0) (uint64_t arg1) (uint64_t arg2)
       (bool (* out_sent)))
      (block
        (if (call atomic_load_explicit (& (-> st cap_ready_sexinput)) memory_order_relaxed)
          (block
            (var SexosReply rep (call sexos_pdx_call SLOT_USB_SEXINPUT op arg0 arg1 arg2))
            (if (== (. rep status) 0ULL)
              (block
                (if (! (call atomic_exchange_explicit (& (-> st route_ready_emitted_sexinput)) true memory_order_relaxed))
                  (call sexos_line "[sexusb.route.sexinput.ready] slot=%llu ok=1"
                    (cast (unsigned long long) SLOT_USB_SEXINPUT)))
                (if (! (call atomic_exchange_explicit (& (-> st bootgraph_proof_marker_emitted)) true memory_order_relaxed))
                  (call sexos_line "[sexusb.bootgraph.proof_report]"))
                (if (! (call atomic_exchange_explicit (& (-> st edge_send_emitted_sexinput)) true memory_order_relaxed))
                  (call sexos_line "[bootgraph.edge.send from=sexusb to=sexinput slot=9 op=HID_REPORT first=1]"))
                (= (* out_sent) true)
                (return 0ULL))
              (block
                (= (* out_sent) false)
                (return (. rep status))))))

        (var SexosReply rep (call sexos_pdx_call SLOT_USB_SEXINPUT op arg0 arg1 arg2))
        (if (== (. rep status) 0ULL)
          (block
            (call atomic_store_explicit (& (-> st cap_ready_sexinput)) true memory_order_relaxed)
            (if (! (call atomic_exchange_explicit (& (-> st route_ready_emitted_sexinput)) true memory_order_relaxed))
              (call sexos_line "[sexusb.route.sexinput.ready] slot=%llu ok=1"
                (cast (unsigned long long) SLOT_USB_SEXINPUT)))
            (if (! (call atomic_exchange_explicit (& (-> st bootgraph_proof_marker_emitted)) true memory_order_relaxed))
              (call sexos_line "[sexusb.bootgraph.proof_report]"))
            (if (! (call atomic_exchange_explicit (& (-> st edge_send_emitted_sexinput)) true memory_order_relaxed))
              (call sexos_line "[bootgraph.edge.send from=sexusb to=sexinput slot=9 op=HID_REPORT first=1]"))
            (= (* out_sent) true)
            (return 0ULL)))
        (if (== (. rep status) ERR_CAP_INVALID)
          (block
            (if (! (call atomic_exchange_explicit (& (-> st route_missing_emitted_sexinput)) true memory_order_relaxed))
              (call sexos_line "[sexusb.route.sexinput.missing] slot=%llu ok=0"
                (cast (unsigned long long) SLOT_USB_SEXINPUT)))
            (if (! (call atomic_exchange_explicit (& (-> st defer_emitted_sexinput)) true memory_order_relaxed))
              (call sexos_line "[bootgraph.edge.defer from=sexusb to=sexinput slot=9 reason=missing_cap]"))
            (call sexos_yield)
            (= (* out_sent) false)
            (return 0ULL)))
        (= (* out_sent) false)
        (return (. rep status))))

    (fn (static void) send_synthetic_mouse_frame
      ((SexusbState (* st)) (uint32_t n) (uint8_t buttons)
       (int8_t dx) (int8_t dy))
      (block
        (var uint8_t ([] buf 4))
        (= ([] buf 0) buttons)
        (= ([] buf 1) (cast uint8_t dx))
        (= ([] buf 2) (cast uint8_t dy))
        (= ([] buf 3) 0u)
        (var BootMouseReport decoded)
        (if (call decode_boot_mouse_report buf 4 (& decoded))
          (block
            (var uint64_t packed_axes
              (| (| (cast uint64_t (cast uint8_t (. decoded dx)))
                    (<< (cast uint64_t (cast uint8_t (. decoded dy))) 8))
                 (<< (cast uint64_t (cast uint8_t (. decoded wheel))) 16)))
            (call sexos_line "[sexusb.synthetic.frame] n=%u dx=%d dy=%d buttons=%u"
              (cast unsigned n) (cast int (. decoded dx)) (cast int (. decoded dy))
              (cast unsigned (. decoded buttons)))
            (var bool sent false)
            (var uint64_t err
              (call send_report_to_sexinput st OP_USB_MOUSE_REPORT 0ULL
                (cast uint64_t (. decoded buttons)) packed_axes (& sent)))
            (if (== err 0ULL)
              (block
                (if sent
                  (call sexos_line "[sexusb.synthetic.send.ok]")))
              (call sexos_line "[sexusb.synthetic.send.fail] e=%llu"
                (cast (unsigned long long) err)))))))
    (fn void sexusb_main (void)
      (block
        (var SexusbState (* st) (& SEXUSB_STATE))
        (call sexusb_state_init st)
        (call sexos_line "[sexusb.init.start]")
        (call sexos_line "[sexusb] USB DRIVER STARTING (CUSTOM BUILD, NO SYNTHETIC)...")

        (call sexos_line "[usb.host.discovery.start]")
        (call sexos_line "[usb.host.pci.scan] slot=%llu bar=0"
          (cast (unsigned long long) SLOT_USB_HOST))

        (var uint64_t map_va 0ULL)
        (var uint32_t map_attempts 0u)
        (while (< map_attempts 3u)
          (block
            (+= map_attempts 1u)
            (= map_va (call map_xhci_bar0 MAP_BYTES))
            (if (&& (!= map_va 0ULL) (!= map_va UINT64_MAX))
              break)
            (call sexos_yield)))

        (if (|| (== map_va 0ULL) (== map_va UINT64_MAX))
          (block
            (call sexos_line "[sexusb.xhci.map.bad] reason=bar_zero_after_retry attempts=3 ok=0")
            (call sexos_line "[usb.host.controller.none] map_va=%#llx"
              (cast (unsigned long long) map_va))
            (call sexos_line "[usb.host.discovery.done]")
            (while true (call sexos_yield))))

        (call sexos_line "[usb.host.controller.found] slot=%llu bar=0 map_va=%#llx"
          (cast (unsigned long long) SLOT_USB_HOST) (cast (unsigned long long) map_va))
        (call sexos_line "[usb.host.discovery.done]")

        (call sexos_line "[sexusb.xhci.map.ok]")
        (call sexos_line "[sexusb.xhci.diag.after_map_ok]")

        (var (const uint32_t) (* regs)
          (cast ((const uint32_t) *) (cast uintptr_t map_va)))
        (var uint32_t cap0 (call sexos_volatile_read32 regs))
        (var uint8_t caplength (cast uint8_t (& cap0 0xFFu)))
        (var uint16_t hciversion (cast uint16_t (& (>> cap0 16) 0xFFFFu)))
        (var uint32_t hcsp1 (call sexos_volatile_read32 (+ regs 1)))
        (var uint32_t hcsp2 (call sexos_volatile_read32 (+ regs 2)))
        (var uint32_t hcc1 (call sexos_volatile_read32 (+ regs 4)))

        (call sexos_line "[sexusb.xhci.caplength] %#x" (cast unsigned caplength))
        (call sexos_line "[sexusb.xhci.hciversion] %#x" (cast unsigned hciversion))
        (call sexos_line "[sexusb.xhci.hcsp1] %#x" (cast unsigned hcsp1))
        (call sexos_line "[sexusb.xhci.hcsp2] %#x" (cast unsigned hcsp2))
        (call sexos_line "[sexusb.xhci.hcc1] %#x" (cast unsigned hcc1))
        (call sexos_line "[usb.host.caps] caplength=%#x hciversion=%#x hcsp1=%#x hcsp2=%#x hcc1=%#x"
          (cast unsigned caplength) (cast unsigned hciversion)
          (cast unsigned hcsp1) (cast unsigned hcsp2) (cast unsigned hcc1))
        (call sexos_line "[sexusb.xhci.probe.ok]")

        (var uint64_t op_base (+ map_va (cast uint64_t caplength)))
        (call sexos_line "[sexusb.xhci.reset.start]")

        (var uint32_t usbcmd (call mmio_read32 op_base XHCI_USBCMD))
        (if (!= (& usbcmd USBCMD_RUN_STOP) 0u)
          (block
            (&= usbcmd (~ USBCMD_RUN_STOP))
            (call mmio_write32 op_base XHCI_USBCMD usbcmd)))
        (if (call wait_until op_base XHCI_USBSTS USBSTS_HCHALTED true POLL_BUDGET)
          (call sexos_line "[sexusb.xhci.halted.ok]")
          (call sexos_line "[sexusb.xhci.halted.bad]"))

        (= usbcmd (| (call mmio_read32 op_base XHCI_USBCMD) USBCMD_HCRST))
        (call mmio_write32 op_base XHCI_USBCMD usbcmd)
        (var bool reset_done (call wait_until op_base XHCI_USBCMD USBCMD_HCRST false POLL_BUDGET))
        (var bool cnr_done (call wait_until op_base XHCI_USBSTS USBSTS_CNR false POLL_BUDGET))
        (if (&& reset_done cnr_done)
          (call sexos_line "[sexusb.xhci.reset.ok]")
          (call sexos_line "[sexusb.xhci.reset.bad]"))

        (call sexos_line "[sexusb.xhci.ring.alloc.start]")
        (var uint64_t erst_bytes PAGE_SIZE)

        (var uint64_t cmd_ring_phys (call sys_alloc_phys PAGE_SIZE))
        (var uint64_t event_ring_phys (call sys_alloc_phys PAGE_SIZE))
        (var uint64_t erst_phys (call sys_alloc_phys erst_bytes))
        (var uint64_t dcbaa_phys (call sys_alloc_phys DCBAA_BYTES))

