        (var uint32_t hid_setup_d3
          (| (| (<< TRB_TYPE_SETUP_STAGE 10) (<< 2u 16))
             (| (<< 1u 6) ep0_cycle)))
        (call trb_write_volatile ep0_ring_va hid_deq_index
          0x22000681u (| (<< report_len 16) (cast uint32_t hid_interface_number))
          8u hid_setup_d3)

        (var uint32_t hid_data_d3
          (| (| (<< TRB_TYPE_DATA_STAGE 10) (<< 1u 16)) ep0_cycle))
        (call trb_write_volatile ep0_ring_va (+ hid_deq_index 1ULL)
          (cast uint32_t (& desc_data_phys 0xFFFFFFFFULL))
          (cast uint32_t (>> desc_data_phys 32))
          (| report_len (<< 1u 18))
          hid_data_d3)

        (var uint32_t hid_status_d3
          (| (| (<< TRB_TYPE_STATUS_STAGE 10) (<< 1u 5)) ep0_cycle))
        (call trb_write_volatile ep0_ring_va (+ hid_deq_index 2ULL) 0u 0u 0u hid_status_d3)
        (call trb_write_volatile ep0_ring_va (+ hid_deq_index 3ULL) 0u 0u 0u (^ ep0_cycle 1u))

        (= ep0_idx (+ hid_deq_index 4ULL))
        (call mmio_write32 db_base (* (cast uint64_t en_slot_id) 4ULL) 1u)

        (var bool hid_ok false)
        (var uint32_t hid_residue 0u)
        (for (var size_t _p 0) (< _p POLL_BUDGET) (++ _p)
          (block
            (var uint32_t ev_d3 (call trb_read_dword event_ring_va ev_idx 3))
            (if (== (& ev_d3 1u) (cast uint32_t ev_dcs))
              (block
                (var uint32_t ev_type (& (>> ev_d3 10) 0x3Fu))
                (if (== ev_type TRB_TYPE_TRANSFER_EVENT)
                  (block
                    (var uint32_t ev_d2 (call trb_read_dword event_ring_va ev_idx 2))
                    (var uint32_t cc (& (>> ev_d2 24) 0xFFu))
                    (= hid_residue (& ev_d2 0xFFFFFFu))
                    (var uint32_t slot (& (>> ev_d3 24) 0xFFu))
                    (var uint32_t ep (& (>> ev_d3 16) 0x1Fu))
                    (if (&& (&& (== cc TRB_CC_SUCCESS) (== slot en_slot_id)) (== ep 1u))
                      (= hid_ok true)
                      (call sexos_line "[sexusb.xhci.hid.report_desc.event.bad] cc=%u slot=%u ep=%u"
