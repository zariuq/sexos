            (var uint8_t hb0 (call sexos_volatile_read8 (+ hid_buf (cast size_t si))))
            (var uint8_t hb1 (call sexos_volatile_read8 (+ hid_buf (+ (cast size_t si) 1))))
            (if (&& (== hb0 0x05u) (== hb1 0x01u))
              (= has_usage_page_gd true)
              (if (&& (== hb0 0x09u) (== hb1 0x02u))
                (= has_usage_mouse true)
                (if (&& (== hb0 0x09u) (== hb1 0x01u))
