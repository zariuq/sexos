        (call sexos_line "[sexusb.xhci.set_config.start] value=%u" (cast unsigned cfg_value))
        (var uint32_t setcfg_deq_dw2 (call sexos_volatile_read32 (+ cfg_deq_ep0_base 2)))
        (var uint32_t setcfg_deq_dw3 (call sexos_volatile_read32 (+ cfg_deq_ep0_base 3)))
        (var uint64_t setcfg_deq_ptr (| (<< (cast uint64_t setcfg_deq_dw3) 32) (cast uint64_t setcfg_deq_dw2)))
        (var uint64_t setcfg_deq_dcs (& setcfg_deq_ptr 1ULL))
        (var uint64_t setcfg_deq_phys (& setcfg_deq_ptr (~ 0xFULL)))
        (var uint64_t setcfg_deq_index (/ (- setcfg_deq_phys ep0_ring_phys) 16ULL))

        (if (|| (|| (!= setcfg_deq_dcs 1ULL) (< setcfg_deq_phys ep0_ring_phys))
