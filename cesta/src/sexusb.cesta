                    (+= ev_idx 1ULL)
                    (if (>= ev_idx EVENT_RING_TRBS)
                      (block
                        (= ev_idx 0ULL)
                        (^= ev_dcs 1ULL)))
                    (var uint64_t new_erdp (+ event_ring_phys (* ev_idx 16ULL)))
                    (call mmio_write32 intr_base XHCI_INTR_ERDP (cast uint32_t new_erdp))
                    (call mmio_write32 intr_base (+ XHCI_INTR_ERDP 4ULL) (cast uint32_t (>> new_erdp 32)))
                    break)
                  (block
                    (+= ev_idx 1ULL)
                    (if (>= ev_idx EVENT_RING_TRBS)
                      (block
                        (= ev_idx 0ULL)
                        (^= ev_dcs 1ULL)))
                    (var uint64_t new_erdp (+ event_ring_phys (* ev_idx 16ULL)))
                    (call mmio_write32 intr_base XHCI_INTR_ERDP (cast uint32_t new_erdp))
                    (call mmio_write32 intr_base (+ XHCI_INTR_ERDP 4ULL) (cast uint32_t (>> new_erdp 32)))))))
            (call sexos_yield)))

        (if (! hid_ok)
          (block
            (call sexos_line "[sexusb.xhci.hid.report_desc.timeout.bad]")
            (while true (call sexos_yield))))
        (if (> hid_residue report_len)
          (block
            (call sexos_line "[sexusb.xhci.hid.report_desc.residue.bad] residue=%u len=%u"
              (cast unsigned hid_residue) (cast unsigned report_len))
            (while true (call sexos_yield))))

        (var uint32_t hid_actual_len (- report_len hid_residue))
        (call sexos_line "[sexusb.xhci.hid.report_desc.event.ok] actual=%u residue=%u"
