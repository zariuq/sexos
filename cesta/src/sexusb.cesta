            (call sexos_line "[sexusb.xhci.config.no_hid.park]")
            (while true (call sexos_yield))))

        (var HidRole bind_role
          (call classify_single_hid_role found_hid_keyboard found_hid_tablet found_hid_mouse))
        (var (const char) (* kind_str)
          (?: (== bind_role HID_ROLE_KEYBOARD) "keyboard"
            (?: (== bind_role HID_ROLE_POINTER_MOUSE) "mouse"
              (?: (== bind_role HID_ROLE_POINTER_TABLET) "touchpad" "unknown"))))
        (call sexos_line "[sexusb.hid.candidate] slot=%u kind=%s" (cast unsigned en_slot_id) kind_str)
        (var bool is_tablet_device (== bind_role HID_ROLE_POINTER_TABLET))
        (var bool is_keyboard_device (== bind_role HID_ROLE_KEYBOARD))

        (if found_hid_keyboard
          (call sexos_line "[sexusb.kbd.found] intf=%u ep=0x%x"
            (cast unsigned hid_interface_number) (cast unsigned intr_ep_addr)))
        (var (const char) (* keyboard_ep_str) (?: (== keyboard_ep_addr 0u) "none" "set"))
        (var (const char) (* pointer_ep_str) (?: (== pointer_ep_addr 0u) "none" "set"))
        (var (const char) (* pointer_role_str)
          (?: (== pointer_role 2u) "mouse" (?: (== pointer_role 3u) "tablet" "none")))
        (call sexos_line "[sexusb.hid.bind.summary] keyboard_ep=%s pointer_ep=%s pointer_role=%s"
