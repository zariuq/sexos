        (= (. single_bind slot_id) en_slot_id)
        (= (. single_bind port) target_port)
        (= (. single_bind role) bind_role)
        (= (. single_bind ep_addr) intr_ep_addr)
        (= (. single_bind ep_dci) 3u)
        (= (. single_bind max_packet) intr_ep_mps)
        (= (. single_bind interval) intr_ep_interval)

        (call sexos_line "[sexusb.dev.hid.summary] slot=%u keyboard_ep=%s pointer_ep=%s pointer_role=%s"
          (cast unsigned en_slot_id) keyboard_ep_str pointer_ep_str pointer_role_str)
        (var uint32_t hid_devices (?: (|| (|| found_hid_keyboard found_hid_mouse) found_hid_tablet) 1u 0u))
        (var uint32_t pointer_devices (?: (!= pointer_ep_addr 0u) 1u 0u))
        (call sexos_line "[sexusb.enum.summary] ports_connected=%u slots_enabled=1 hid_devices=%u pointer_devices=%u"
          (cast unsigned ports_connected) (cast unsigned hid_devices) (cast unsigned pointer_devices))

        (var uint32_t report_len (cast uint32_t hid_report_desc_len))
        (if (|| (== report_len 0u) (> report_len 256u))
          (block
            (call sexos_line "[sexusb.xhci.hid.report_desc.len.bad] len=%u intf=%u"
              (cast unsigned report_len) (cast unsigned hid_interface_number))
            (while true (call sexos_yield))))

        (call sexos_line "[sexusb.xhci.hid.report_desc.start] intf=%u len=%u"
          (cast unsigned hid_interface_number) (cast unsigned report_len))

        (var uint32_t hid_deq_dw2 (call sexos_volatile_read32 (+ cfg_deq_ep0_base 2)))
        (var uint32_t hid_deq_dw3 (call sexos_volatile_read32 (+ cfg_deq_ep0_base 3)))
        (var uint64_t hid_deq_ptr (| (<< (cast uint64_t hid_deq_dw3) 32) (cast uint64_t hid_deq_dw2)))
        (var uint64_t hid_deq_dcs (& hid_deq_ptr 1ULL))
        (var uint64_t hid_deq_phys (& hid_deq_ptr (~ 0xFULL)))
        (var uint64_t hid_deq_index (/ (- hid_deq_phys ep0_ring_phys) 16ULL))

        (if (|| (|| (!= hid_deq_dcs 1ULL) (< hid_deq_phys ep0_ring_phys))
                (|| (>= hid_deq_phys (+ ep0_ring_phys PAGE_SIZE)) (!= (% hid_deq_phys 16ULL) 0ULL)))
          (block
            (call sexos_line "[sexusb.xhci.hid.report_desc.deq.bad] ptr=%#llx dcs=%llu"
              (cast (unsigned long long) hid_deq_ptr) (cast (unsigned long long) hid_deq_dcs))
            (while true (call sexos_yield))))
