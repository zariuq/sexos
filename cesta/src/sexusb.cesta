        (var bool has_usage_page_gd false)
        (var bool has_usage_mouse false)
        (var bool has_usage_pointer false)
        (var bool has_usage_keyboard false)
        (var bool has_collection_app false)
        (var bool has_usage_x false)
        (var bool has_usage_y false)
        (var uint32_t si 0u)
        (while (< (+ si 1u) hid_actual_len)
