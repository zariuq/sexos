                          (call sexos_line "[sexusb.xhci.config.hid_boot_mouse.found] intf=%u off=%llu"
                            (cast unsigned b_intf_num) (cast (unsigned long long) walk_off))
                          (if (! (-> st mouse_detect_proof_emitted))
                            (block
                              (= (-> st mouse_detect_proof_emitted) true)
                              (call sexos_line "[usb.mouse.detect] interface=%u boot=1 ok=1"
                                (cast unsigned b_intf_num)))))
                        (if is_boot_keyboard
                          (block
                            (= current_hid_role 1u)
                            (= found_hid_keyboard true)
                            (= hid_interface_number b_intf_num)
                            (call sexos_line "[sexusb.xhci.config.hid_boot_keyboard.found] intf=%u off=%llu"
                              (cast unsigned b_intf_num) (cast (unsigned long long) walk_off))
                            (call sexos_line "[usb.keyboard.detect] interface=%u boot=1 ok=1"
                              (cast unsigned b_intf_num)))
                          (if (!= b_protocol 0x01u)
                            (block
                              (= current_hid_role 3u)
                              (= found_hid_tablet true)
                              (= hid_interface_number b_intf_num)
                              (call sexos_line "[sexusb.xhci.config.hid_tablet.found] intf=%u off=%llu subclass=%u protocol=%u"
                                (cast unsigned b_intf_num) (cast (unsigned long long) walk_off)
                                (cast unsigned b_subclass) (cast unsigned b_protocol))
                              (if (! (-> st tablet_detect_proof_emitted))
                                (block
                                  (= (-> st tablet_detect_proof_emitted) true)
                                  (call sexos_line "[usb.mouse.detect] interface=%u boot=0 tablet=1 ok=1"
                                    (cast unsigned b_intf_num)))))
                            (= current_hid_role 4u)))))
                    (block
                      (= current_hid_role 0u)
                      (= inside_hid_iface false)
                      (= iface_is_boot_mouse false))))
                (block
                  (= current_hid_role 0u)
                  (= inside_hid_iface false)
                  (= iface_is_boot_mouse false)))
              (if (== b_type 0x21u)
                (block
                  (if inside_hid_iface
                    (block
                      (if (< b_len 9u)
                        (block
                          (call sexos_line "[sexusb.xhci.config.hid_desc.bad] short_len=%u" (cast unsigned b_len))
                          (while true (call sexos_yield))))
                      (var uint8_t hid_type (call sexos_volatile_read8 (+ walk_buf (+ (cast size_t walk_off) 6))))
                      (if (!= hid_type 0x22u)
                        (block
                          (call sexos_line "[sexusb.xhci.config.hid_desc.bad] type=%#x off=%llu"
                            (cast unsigned hid_type) (cast (unsigned long long) walk_off))
                          (while true (call sexos_yield))))
                      (var uint8_t rpt_len_lo (call sexos_volatile_read8 (+ walk_buf (+ (cast size_t walk_off) 7))))
                      (var uint8_t rpt_len_hi (call sexos_volatile_read8 (+ walk_buf (+ (cast size_t walk_off) 8))))
                      (= hid_report_desc_len
                        (| (cast uint16_t (<< (cast uint16_t rpt_len_hi) 8)) (cast uint16_t rpt_len_lo)))
                      (call sexos_line "[sexusb.xhci.config.hid_desc.ok] off=%llu report_len=%u"
                        (cast (unsigned long long) walk_off) (cast unsigned hid_report_desc_len)))))
                (if (== b_type 5u)
                  (if inside_hid_iface
                    (block
                      (if (< b_len 7u)
                        (block
                          (call sexos_line "[sexusb.xhci.config.intr_ep_short.bad] off=%llu len=%u"
                            (cast (unsigned long long) walk_off) (cast unsigned b_len))
                          (while true (call sexos_yield))))
                      (var uint8_t b_endpoint (call sexos_volatile_read8 (+ walk_buf (+ (cast size_t walk_off) 2))))
                      (var uint8_t bm_attrs (call sexos_volatile_read8 (+ walk_buf (+ (cast size_t walk_off) 3))))
                      (var uint8_t mps_lo (call sexos_volatile_read8 (+ walk_buf (+ (cast size_t walk_off) 4))))
                      (var uint8_t mps_hi (call sexos_volatile_read8 (+ walk_buf (+ (cast size_t walk_off) 5))))
                      (var uint16_t w_max_pkt
                        (| (cast uint16_t (<< (cast uint16_t mps_hi) 8)) (cast uint16_t mps_lo)))
                      (var uint16_t pkt_size (& w_max_pkt 0x07FFu))
                      (var uint8_t b_interval (call sexos_volatile_read8 (+ walk_buf (+ (cast size_t walk_off) 6))))
                      (var bool dir_in (!= (& b_endpoint 0x80u) 0u))
                      (var bool intr_type (== (& bm_attrs 0x03u) 0x03u))
                      (if (> (-> st ep_diag_budget) 0u)
                        (block
                          (-= (-> st ep_diag_budget) 1u)
                          (call sexos_line "[sexusb.hid.ep] if=%u ep=%#x attr=%#x maxpkt=%u interval=%u"
                            (cast unsigned hid_interface_number) (cast unsigned b_endpoint)
                            (cast unsigned bm_attrs) (cast unsigned pkt_size) (cast unsigned b_interval))))
                      (if (&& dir_in intr_type)
                        (block
                          (if (== pkt_size 0u)
                            (block
                              (call sexos_line "[sexusb.xhci.config.intr_ep_mps.bad] off=%llu mps=%u"
                                (cast (unsigned long long) walk_off) (cast unsigned pkt_size))
                              (while true (call sexos_yield))))
                          (= intr_ep_addr b_endpoint)
                          (= intr_ep_mps pkt_size)
                          (= intr_ep_interval b_interval)
                          (var (const char) (* ep_which)
                            (?: iface_is_boot_mouse "mouse" (?: found_hid_keyboard "keyboard" "tablet")))
                          (call sexos_line "[sexusb.xhci.config.intr_ep.%s] off=%llu addr=%#x mps=%u interval=%u"
                            ep_which (cast (unsigned long long) walk_off)
                            (cast unsigned b_endpoint) (cast unsigned pkt_size) (cast unsigned b_interval))
                          (if (== current_hid_role 1u)
                            (block
                              (= keyboard_ep_addr b_endpoint)
                              (call sexos_line "[sexusb.hid.bind] role=keyboard if=%u ep=%#x reason=hid_boot_keyboard"
                                (cast unsigned hid_interface_number) (cast unsigned b_endpoint)))
                            (if (== current_hid_role 2u)
                              (block
                                (= pointer_ep_addr b_endpoint)
                                (= pointer_role 2u)
                                (call sexos_line "[sexusb.hid.bind] role=mouse if=%u ep=%#x reason=hid_boot_mouse"
                                  (cast unsigned hid_interface_number) (cast unsigned b_endpoint)))
                              (if (== current_hid_role 3u)
                                (block
                                  (= pointer_ep_addr b_endpoint)
                                  (= pointer_role 3u)
                                  (call sexos_line "[sexusb.hid.bind] role=tablet if=%u ep=%#x reason=hid_pointer_like_interface"
                                    (cast unsigned hid_interface_number) (cast unsigned b_endpoint)))
                                (call sexos_line "[sexusb.hid.bind] role=unknown if=%u ep=%#x reason=unclassified_hid_interface"
                                  (cast unsigned hid_interface_number) (cast unsigned b_endpoint))))))))))))

            (+= walk_off (cast uint64_t b_len))))

        (call sexos_line "[sexusb.xhci.config.walk.done]")

        (var uint8_t cfg_value (call sexos_volatile_read8 (+ walk_buf 5)))
        (if (== cfg_value 0u)
          (block
            (call sexos_line "[sexusb.xhci.config.value.bad] value=0")
            (while true (call sexos_yield))))

        (if (&& (&& (! found_hid_mouse) (! found_hid_tablet)) (! found_hid_keyboard))
