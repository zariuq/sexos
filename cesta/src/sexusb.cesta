            (while true (call sexos_yield))))
        (if (>= (+ setcfg_deq_index 2ULL) (/ PAGE_SIZE TRB_SIZE))
          (block
            (call sexos_line "[sexusb.xhci.set_config.deq.ring.bad] idx=%llu"
              (cast (unsigned long long) setcfg_deq_index))
            (while true (call sexos_yield))))

        (var uint32_t setcfg_setup_d3
          (| (| (<< TRB_TYPE_SETUP_STAGE 10) (<< 1u 6)) ep0_cycle))
        (call trb_write_volatile ep0_ring_va setcfg_deq_index
          (| (<< (cast uint32_t cfg_value) 16) 0x0900u) 0u 8u setcfg_setup_d3)

        (var uint32_t setcfg_status_d3
          (| (| (<< TRB_TYPE_STATUS_STAGE 10) (<< 1u 16))
             (| (<< 1u 5) ep0_cycle)))
        (call trb_write_volatile ep0_ring_va (+ setcfg_deq_index 1ULL) 0u 0u 0u setcfg_status_d3)
        (call trb_write_volatile ep0_ring_va (+ setcfg_deq_index 2ULL) 0u 0u 0u (^ ep0_cycle 1u))

        (= ep0_idx (+ setcfg_deq_index 3ULL))
        (call mmio_write32 db_base (* (cast uint64_t en_slot_id) 4ULL) 1u)

        (var bool setcfg_ok false)
        (var uint32_t setcfg_residue 0u)
        (for (var size_t _p 0) (< _p POLL_BUDGET) (++ _p)
          (block
            (var uint32_t ev_d3 (call trb_read_dword event_ring_va ev_idx 3))
            (if (== (& ev_d3 1u) (cast uint32_t ev_dcs))
              (block
                (var uint32_t ev_type (& (>> ev_d3 10) 0x3Fu))
                (if (== ev_type TRB_TYPE_TRANSFER_EVENT)
                  (block
                    (var uint32_t ev_d2 (call trb_read_dword event_ring_va ev_idx 2))
                    (var uint32_t cc (& (>> ev_d2 24) 0xFFu))
                    (= setcfg_residue (& ev_d2 0xFFFFFFu))
                    (var uint32_t slot (& (>> ev_d3 24) 0xFFu))
                    (var uint32_t ep (& (>> ev_d3 16) 0x1Fu))
                    (if (&& (&& (== cc TRB_CC_SUCCESS) (== slot en_slot_id)) (== ep 1u))
                      (= setcfg_ok true)
                      (call sexos_line "[sexusb.xhci.set_config.event.bad] cc=%u slot=%u ep=%u"
                        (cast unsigned cc) (cast unsigned slot) (cast unsigned ep)))
                    (+= ev_idx 1ULL)
                    (if (>= ev_idx EVENT_RING_TRBS)
                      (block
                        (= ev_idx 0ULL)
                        (^= ev_dcs 1ULL)))
                    (var uint64_t new_erdp (+ event_ring_phys (* ev_idx 16ULL)))
                    (call mmio_write32 intr_base XHCI_INTR_ERDP (cast uint32_t new_erdp))
                    (call mmio_write32 intr_base (+ XHCI_INTR_ERDP 4ULL) (cast uint32_t (>> new_erdp 32)))
                    break)
                  (block
                    (+= ev_idx 1ULL)
                    (if (>= ev_idx EVENT_RING_TRBS)
                      (block
                        (= ev_idx 0ULL)
                        (^= ev_dcs 1ULL)))
                    (var uint64_t new_erdp (+ event_ring_phys (* ev_idx 16ULL)))
                    (call mmio_write32 intr_base XHCI_INTR_ERDP (cast uint32_t new_erdp))
                    (call mmio_write32 intr_base (+ XHCI_INTR_ERDP 4ULL) (cast uint32_t (>> new_erdp 32)))))))
            (call sexos_yield)))

        (if (! setcfg_ok)
          (block
            (call sexos_line "[sexusb.xhci.set_config.timeout.bad]")
            (while true (call sexos_yield))))
        (if (!= setcfg_residue 0u)
