        (if is_tablet_shape
          (call sexos_line "[sexusb.xhci.hid.report_desc.tablet_shape.ok]"))
        (if is_mouse_shape
          (call sexos_line "[sexusb.xhci.hid.report_desc.mouse_shape.ok]"))
        (if (&& (&& (! is_mouse_shape) (! is_tablet_shape)) (! is_keyboard_shape))
          (call sexos_line "[sexusb.xhci.hid.report_desc.shape.warn] mouse=%s tablet=%s keyboard=%s"
            (?: is_mouse_shape "true" "false")
            (?: is_tablet_shape "true" "false")
            (?: is_keyboard_shape "true" "false")))

