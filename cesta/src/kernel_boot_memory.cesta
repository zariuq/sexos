(cesta native-c/1 compact-c/2
  (unit
    (ownership (check-all)
    (unchecked (backing_id_free backing_is_held backing_record boot_backing_reserve boot_region_dma
                boot_region_map boot_region_pair boot_region_publish boot_slot_free cpu_clac cpu_cli
                cpu_cpuid cpu_fpu_state_init cpu_fxrstor cpu_fxsave cpu_hlt cpu_inb cpu_inl
                cpu_invlpg cpu_irq_restore cpu_irq_save cpu_lidt cpu_ltr cpu_outb cpu_outl cpu_outw
                cpu_pause cpu_rdmsr cpu_rdseed cpu_read_cr0 cpu_read_cr2 cpu_read_cr3 cpu_read_cr4
                cpu_read_rsp cpu_stac cpu_sti cpu_sti_hlt cpu_write_cr0 cpu_write_cr4 cpu_wrmsr
                cpu_wrpkru cpu_xgetbv kernel_boot_display_frames)
      (obligation "Kernel code on the serialized BSP lane with interrupts masked and application processors parked. It reaches physical frames, page tables and device registers through integer-derived pointers, volatile accesses and the kernel runtime's inline assembly and do-while helpers, which the native ownership profile does not admit. It relies on the kernel owning each frame and device exclusively from BOOT; here BOOT reservations and per-holder aliases.")))
  (include "sexos_kernel.h")
    (comment "BOOT reservations and per-holder aliases. A failed construction must stop BOOT before task admission; these helpers do not promise rollback of already-created page tables. Runtime queries use the immutable grants and never invoke this layer.")
    (native "
static bool boot_size(uint64_t length) {
    return length && !(length % KERNEL_PAGE_SIZE) && length <= (KERNEL_PAGE_SIZE << 18);
}

static bool backing_id_free(uint32_t id) {
    if (!id || kernel.boot_backing_count >= KERNEL_BOOT_REGIONS)
        return false;
    for (uint32_t i = 0; i < kernel.boot_backing_count; ++i)
        if (kernel.boot_backings[i].region_id == id)
            return false;
    return true;
}

bool boot_backing_reserve(uint32_t id, uint64_t length, BootBacking *out) {
    if (kernel.genesis_sealed || !boot_size(length) || !backing_id_free(id))
        return false;
    uint32_t order = 0;
    while ((KERNEL_PAGE_SIZE << order) < length)
        ++order;
    uint64_t physical = frames_alloc(order), reserved = KERNEL_PAGE_SIZE << order;
    if (physical == NO_ADDRESS)
        return false;
    BootBacking b = {.region_id = id, .physical = physical, .length = length, .reserved = reserved};
    kernel.boot_backings[kernel.boot_backing_count++] = b;
    *out = b;
    return true;
}

static bool backing_is_held(const BootBacking *b) {
    for (uint32_t i = 0; i < kernel.boot_backing_count; ++i) {
        BootBacking held = kernel.boot_backings[i];
        if (held.region_id == b->region_id && held.physical == b->physical &&
            held.length == b->length && held.reserved == b->reserved)
            return true;
    }
    return false;
}

static BootBacking *backing_record(uint32_t id) {
    for (uint32_t i = 0; i < kernel.boot_backing_count; ++i)
        if (kernel.boot_backings[i].region_id == id)
            return &kernel.boot_backings[i];
    return NULL;
}

bool boot_region_map(uint32_t holder, const BootBacking *b, bool writable, uint64_t *out) {
    if (kernel.genesis_sealed || !backing_is_held(b))
        return false;
    Domain *d = domain_get(holder);
    if (!d || !d->key || d->key >= 16 || !boot_size(b->length) || b->physical % KERNEL_PAGE_SIZE ||
        b->physical >= REGION_PHYSICAL_END || b->length > REGION_PHYSICAL_END - b->physical)
        return false;
    uint64_t va = va_alloc(b->length);
    if (va == NO_ADDRESS)
        return false;
    uint64_t flags = PTE_USER | PTE_NO_EXECUTE;
    if (writable)
        flags |= PTE_WRITABLE;
    for (uint64_t offset = 0; offset < b->length; offset += KERNEL_PAGE_SIZE)
        if (!map_page(va + offset, b->physical + offset, flags, d->key))
            return false;
    *out = va;
    return true;
}

static bool boot_slot_free(Domain *d, uint64_t slot) {
    return d && slot && slot < KERNEL_CAP_SLOTS && !cap_get(d, slot);
}

static bool boot_region_publish(Domain *d, uint64_t slot, MemoryRegionGrant grant) {
    MemoryRegionCapability capability = {true, grant};
    if (sexos_region_info(&capability).error)
        return false;
    return cap_set(d, slot, (Cap){.kind = CAP_REGION, .region = capability});
}

bool boot_region_dma(uint32_t holder, uint64_t slot, uint32_t id, uint64_t length) {
    Domain *d = domain_get(holder);
    if (kernel.genesis_sealed || !boot_slot_free(d, slot) || !d->key || d->key >= 16 ||
        !cap_boot_available(1) || !boot_size(length) || !backing_id_free(id))
        return false;
    BootBacking backing = {0};
    uint64_t va = 0;
    if (!boot_backing_reserve(id, length, &backing) ||
        !boot_region_map(holder, &backing, true, &va))
        return false;
    BootBacking *held = backing_record(id);
    if (!held)
        return false;
    held->aliases[0] = (BootRegionAlias){holder, va, d->key, true};
    held->alias_count = 1;
    MemoryRegionGrant grant = {.region_id = id,
                               .virtual_base = va,
                               .length = length,
                               .rights = REGION_QUERY | REGION_READ | REGION_WRITE | REGION_DMA,
                               .has_dma = true,
                               .dma_base = backing.physical};
    return boot_region_publish(d, slot, grant);
}

/* Checked packed-XRGB geometry and reservation sizes; no backing is acquired. */
bool display_frame_layout(uint64_t width, uint64_t height, uint64_t pitch,
                          DisplayFrameLayout *out) {
    if (!width || !height || width > DISPLAY_FRAME_MAX_WIDTH || height > DISPLAY_FRAME_MAX_HEIGHT ||
        pitch != width * 4 || pitch > UINT32_MAX)
        return false;
    uint64_t frame = pitch * height;
    uint64_t span = (frame + KERNEL_PAGE_SIZE - 1) / KERNEL_PAGE_SIZE * KERNEL_PAGE_SIZE;
    uint64_t total = span * 2, pages = 1;
    while (pages < total / KERNEL_PAGE_SIZE)
        pages <<= 1;
    *out = (DisplayFrameLayout){width, height, (uint32_t)pitch,         frame,
                                span,  total,  pages * KERNEL_PAGE_SIZE};
    return true;
}

static bool display_frame_reply(MemoryRegionReply r, uint64_t status, uint64_t v0, uint64_t v1,
                                uint64_t v2, uint64_t v3) {
    return r.status == status && r.value0 == v0 && r.value1 == v1 && r.value2 == v2 &&
           r.value3 == v3;
}

/* Immutable Display-only frame storage, reserved at geometry-known genesis: one
 * buddy reservation holding two page-aligned, disjoint frame spans. This is
 * PD-held memory authority; tasks within the PD share its access. */
void kernel_boot_display_frames(uint32_t display, const DisplayFrameLayout *layout) {
    Domain *d = domain_get(display);
    if (kernel.genesis_sealed || kernel.scheduler_running || !d || !d->task_id || !d->key ||
        d->key >= 16 || !boot_slot_free(d, DISPLAY_FRAME_SLOT) || !cap_boot_available(1))
        kernel_halt(\"BOOT_DISPLAY_FRAME_DOMAIN\");
    uint64_t total = layout->total_bytes, rights = REGION_QUERY | REGION_READ | REGION_WRITE;
    BootBacking backing = {0};
    uint64_t va = 0;
    if (!boot_backing_reserve(DISPLAY_FRAME_REGION_ID, total, &backing) ||
        backing.reserved != layout->buddy_bytes || !boot_region_map(display, &backing, true, &va))
        kernel_halt(\"BOOT_DISPLAY_FRAME_BACKING\");
    BootBacking *held = backing_record(DISPLAY_FRAME_REGION_ID);
    if (!held)
        kernel_halt(\"BOOT_DISPLAY_FRAME_BACKING\");
    held->aliases[0] = (BootRegionAlias){display, va, d->key, true};
    held->alias_count = 1;
    MemoryRegionGrant grant = {.region_id = DISPLAY_FRAME_REGION_ID,
                               .virtual_base = va,
                               .length = total,
                               .rights = rights};
    if (!boot_region_publish(d, DISPLAY_FRAME_SLOT, grant))
        kernel_halt(\"BOOT_DISPLAY_FRAME_SLOT_OCCUPIED\");
    const Cap *readback = cap_get(d, DISPLAY_FRAME_SLOT);
    if (!readback || readback->kind != CAP_REGION ||
        readback->region.grant.region_id != grant.region_id ||
        readback->region.grant.virtual_base != va || readback->region.grant.length != total ||
        readback->region.grant.rights != rights || readback->region.grant.has_dma ||
        readback->region.grant.has_peer)
        kernel_halt(\"BOOT_DISPLAY_FRAME_READBACK\");
    if (!display_frame_reply(kernel_region_reply(d, 55, DISPLAY_FRAME_SLOT, 0, 0, 0), 0, total,
                             rights, 0, DISPLAY_FRAME_REGION_ID))
        kernel_halt(\"BOOT_DISPLAY_FRAME_INFO_DISPATCH\");
    if (!display_frame_reply(kernel_region_reply(d, 54, DISPLAY_FRAME_SLOT, 0, total, rights), 0,
                             va, total, 0, DISPLAY_FRAME_REGION_ID))
        kernel_halt(\"BOOT_DISPLAY_FRAME_VIEW_DISPATCH\");
    const uint64_t denied_slot[3] = {(UINT64_C(1) << 32) | DISPLAY_FRAME_SLOT, DISPLAY_FRAME_SLOT,
                                     DISPLAY_FRAME_SLOT};
    const uint64_t denied_offset[3] = {0, total, 0}, denied_length[3] = {total, 1, total};
    const uint64_t denied_rights[3] = {rights, REGION_QUERY | REGION_READ, rights | REGION_DMA};
    for (size_t i = 0; i < 3; ++i)
        if (!display_frame_reply(kernel_region_reply(d, 54, denied_slot[i], denied_offset[i],
                                                     denied_length[i], denied_rights[i]),
                                 UINT64_MAX, 0, 0, 0, 0))
            kernel_halt(\"BOOT_DISPLAY_FRAME_NEGATIVE_DISPATCH\");
    for (uint32_t id = 1; id < KERNEL_MAX_DOMAINS; ++id) {
        Domain *other = id == display ? 0 : domain_get(id);
        if (other && !display_frame_reply(
                         kernel_region_reply(other, 54, DISPLAY_FRAME_SLOT, 0, total, rights),
                         UINT64_MAX, 0, 0, 0, 0))
            kernel_halt(\"BOOT_DISPLAY_FRAME_FOREIGN_DISPATCH\");
    }
    /* Actual backing and leaf permissions before sealing: present, writable,
     * user, no-execute, Display's key, and zero contents. */
    for (uint64_t offset = 0; offset < total; offset += KERNEL_PAGE_SIZE) {
        uint64_t pte = 0;
        if (!read_pte(va + offset, &pte) || (pte & 7) != 7 || !(pte >> 63) ||
            ((pte >> 59) & 15) != d->key)
            kernel_halt(\"BOOT_DISPLAY_FRAME_PERMISSIONS\");
        const volatile uint64_t *words = phys_to_virt(backing.physical + offset);
        for (size_t word = 0; word < KERNEL_PAGE_SIZE / 8; ++word)
            if (words[word])
                kernel_halt(\"BOOT_DISPLAY_FRAME_NOT_ZERO\");
    }
    klog(
        \"[boot.display.frames] pd=%u task=%u slot=%u region=%u width=%llu height=%llu pitch=%u frame_bytes=%llu span_bytes=%llu total_bytes=%llu reserved_bytes=%llu buffers=2 pkey=%u private=1 zero=1 readback=1 sealed_later=1 runtime_mint=0\\n\",
        display, d->task_id, DISPLAY_FRAME_SLOT, DISPLAY_FRAME_REGION_ID,
        (unsigned long long)layout->width, (unsigned long long)layout->height, layout->pitch,
        (unsigned long long)layout->frame_bytes, (unsigned long long)layout->span_bytes,
        (unsigned long long)total, (unsigned long long)layout->buddy_bytes, d->key);
}

bool boot_region_pair(uint32_t first, uint32_t second, uint64_t first_slot, uint64_t second_slot,
                      uint32_t id, uint64_t length, bool second_writable) {
    Domain *a = domain_get(first), *b = domain_get(second);
    if (kernel.genesis_sealed || first == second || !boot_slot_free(a, first_slot) ||
        !boot_slot_free(b, second_slot) || !cap_boot_available(2) || !a->key || !b->key ||
        a->key >= 16 || b->key >= 16 || a->key == b->key || !boot_size(length) ||
        !backing_id_free(id))
        return false;
    BootBacking backing = {0};
    uint64_t av = 0, bv = 0;
    if (!boot_backing_reserve(id, length, &backing) ||
        !boot_region_map(first, &backing, true, &av) ||
        !boot_region_map(second, &backing, false, &bv))
        return false;
    BootBacking *held = backing_record(id);
    if (!held)
        return false;
    held->aliases[0] = (BootRegionAlias){first, av, a->key, true};
    held->aliases[1] = (BootRegionAlias){second, bv, b->key, second_writable};
    held->alias_count = 2;
    if (second_writable)
        held->writer = (RegionWriterState){true, id, first, second, first, 1, 0};
    MemoryRegionGrant producer = {.region_id = id,
                                  .virtual_base = av,
                                  .length = length,
                                  .rights = REGION_QUERY | REGION_READ | REGION_WRITE,
                                  .has_peer = true,
                                  .peer_pd = second};
    MemoryRegionGrant consumer = {
        .region_id = id,
        .virtual_base = bv,
        .length = length,
        .rights = (uint8_t)(REGION_QUERY | REGION_READ | (second_writable ? REGION_WRITE : 0)),
        .has_peer = true,
        .peer_pd = first};
    return boot_region_publish(a, first_slot, producer) &&
           boot_region_publish(b, second_slot, consumer);
}
")))
