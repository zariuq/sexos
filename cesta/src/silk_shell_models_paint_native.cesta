(cesta native-c/1 compact-c/2
 (unit (ownership (check-all)
    (unchecked shell_models_peer_object_count (obligation "Native binding between the single shell state and the checked component contexts: records carrying references without field contracts, nested LinenObject labels and the legacy address-word ABI. It relies on the single-threaded shell loop lending each context for one call and retaining no loan."))
    (record LinenObject (field display_name (static nullable))))
  (native "
#include \"silk_shell_models_paint.h\"

size_t shell_models_peer_object_count(const ShellLinenRenderContext *ctx) {
    size_t count = 0;
    for (size_t i = 0; i < LINEN_MAX_OBJECTS; ++i)
        if (ctx->shell.models->LINEN_OBJECTS[i].present)
            ++count;
    return count;
}
")))
