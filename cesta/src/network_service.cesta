(cesta native-c/1 compact-c/2
  (unit
    (include "network_service.h")
    (var (static NetworkDevice) device)
    (var (static HttpResponse) response)
    (var (static uint32_t) published)
    (fn (static uint64_t) body_word
      ((size_t index))
      (if (|| (!= (call NetworkResult_kind published) 1) (> index (/ SIZE_MAX 8)))
        (return UINT64_MAX))
      (var size_t start (* index 8))
      (if (>= start (. response length))
        (return UINT64_MAX))
      (var size_t count (- (. response length) start))
      (if (> count 8)
        (= count 8))
      (return (call packed_words_load_le64 (compound cesta_read_bytes (+ (. response body) start) count))))
    (fn (static uint64_t) service_answer
      (((const SexosMessage) (* message)))
      (if (== (-> message type_id) SEXOS_NET_dns_resolve)
        (return 0))
      (if (!= (-> message type_id) SEXOS_NET_request)
        (return UINT64_MAX))
      (switch
        (-> message arg0)
        (block
          (case SEXOS_NET_http_result (return published))
          (case
            SEXOS_NET_body_length
            (return (?: (== (call NetworkResult_kind published) 1) (. response length) 0)))
          (case SEXOS_NET_body_chunk (return (call body_word (cast size_t (-> message arg1)))))
          (case SEXOS_NET_text_length (return 0))
          (case SEXOS_NET_text_chunk (return UINT64_MAX))
          (default (return UINT64_MAX)))))
    (fn void network_service_main
      (void)
      (var bool correlated (== (call sexos_rpc_register) 1))
      (var NetworkFailure failure NET_OK)
      (call http_response_init (& response))
      (if (! (call network_device_open (& device)))
        (= failure (. device failure))
        (= failure (call network_fetch (& device) (& response))))
      (var bool complete (&& (== failure NET_OK) (== (. response state) HTTP_COMPLETE)))
      (if (&& (! complete) (== failure NET_OK))
        (= failure NET_HTTP_ERROR))
      (=
        published
        (call
          NetworkResult_encode
          (?: complete 1 2)
          failure
          (. response error)
          (. response status)
          (?: complete (. response length) 0)
          0))
      (if (! (call NetworkResult_valid published))
        (call sexos_fail))
      (call
        sexos_line
        "[network.fetch.result] kind=%u transport=%u framing=%u status=%u bytes=%zu"
        (?: complete 1u 2u)
        (cast unsigned failure)
        (cast unsigned (. response error))
        (cast unsigned (. response status))
        (?: complete (. response length) 0))
      (if complete
        (call
          network_trace_body
          "network.fetch.body"
          (compound cesta_read_bytes (. response body) (. response length))))
      (for ()
        ()
        ()
        (block
          (var SexosRequest request (call sexos_receive_request correlated))
          (var uint64_t answer (call service_answer (& (. request message))))
          (var uint64_t delivered (call sexos_answer_request (& request) answer))
          (if delivered
            (call sexos_line "[network.reply.refused] status=%llu" (cast (unsigned long long) delivered))))))
  ))
