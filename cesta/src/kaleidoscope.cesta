(cesta native-c/1 compact-c/2
  (unit
    (include "sexos_client.h")
    (include "kaleidoscope_body.h")
    (include "kaleidoscope_html.h")
    (cpp-if "!defined(SEXOS_KALEIDOSCOPE_CURRENT)" (then (define SEXOS_KALEIDOSCOPE_CURRENT "0")))
    (define KALEIDO_SURFACE_ID "UINT64_C(300)")
    (define TEXT_COLOR "UINT32_C(0x00CDD6F4)")

    (fn (static size_t) receive_text
      ((SexosListener (* listener)) (uint8_t (* destination)) (size_t capacity) (bool body))
      (var (const char) (* prefix) (?: body "browser.body" "browser.packed_text"))
      (var uint64_t length_operation (?: body SEXOS_NET_body_length SEXOS_NET_text_length))
      (var uint64_t chunk_operation (?: body SEXOS_NET_body_chunk SEXOS_NET_text_chunk))
      (call sexos_pdx_call SEXOS_SLOT_net SEXOS_NET_request length_operation 0 0)
      (var SexosMessage reply (call sexos_listen listener 0))
      (if (!= (. reply type_id) 1) (return 0))
      (var size_t reported (cast size_t (. reply arg0)))
      (if (> reported capacity) (= reported capacity))
      (if (&& body (== reported 0)) (return 0))
      (call sexos_line "[%s.len.recv] len=%zu" prefix reported)
      (var size_t chunks (/ (+ reported 7) 8))
      (var size_t received 0)
      (for (var size_t index 0) (< index chunks) (++ index)
        (block
          (call sexos_pdx_call SEXOS_SLOT_net SEXOS_NET_request chunk_operation index 0)
          (= reply (call sexos_listen listener 0))
          (if (!= (. reply type_id) 1) break)
          (var size_t start (* index 8))
          (var size_t count (- reported start))
          (if (> count 8) (= count 8))
          (var cesta_write_bytes part (compound cesta_write_bytes (+ destination start) count))
          (call packed_words_store_le64 part (. reply arg0))
          (call sexos_line "[%s.chunk.recv] idx=%zu bytes=%zu" prefix index count)
          (= received (+ start count))))
      (call sexos_line "[%s.text.set] live=1 len=%zu" prefix received)
      (if (! body)
        (call sexos_line "[browser.async_reply.proof.done] len=%zu text_recv=%zu" reported received))
      (return received))

    (fn (static void) send_text
      (((const uint8_t) (* text)) (size_t length) (size_t base_offset))
      (var size_t chunks (/ (+ length 7) 8))
      (for (var size_t index 0) (< index chunks) (++ index)
        (block
          (var size_t offset (* index 8))
          (var size_t count (- length offset))
          (if (> count 8) (= count 8))
          (var cesta_read_bytes part (compound cesta_read_bytes (+ text offset) count))
          (var uint64_t packed (call packed_words_load_le64 part))
          (var uint64_t metadata
            (call packed_words_display_metadata (+ base_offset offset) count TEXT_COLOR))
          (call sexos_pdx_call SEXOS_SLOT_display SEXOS_DISPLAY_text_chunk
            KALEIDO_SURFACE_ID packed metadata))))

    (fn (static void) initialize_browser ((SexosListener (* listener)))
      (call sexos_line "[browser.slot.net.static_grant.begin]")
      (var SexosReply result (call sexos_pdx_call SEXOS_SLOT_net SEXOS_NET_request 0 0 0))
      (call sexos_line "[browser.slot.net.route.call] status=%llu"
        (cast (unsigned long long) (. result status)))
      (call sexos_line "[browser.slot.net.static_grant.proof.done] ok=1 network=0")
      (call sexos_line "[browser.dns.resolve.request] host_id=1 ok=1")
      (= result (call sexos_pdx_call SEXOS_SLOT_net SEXOS_NET_dns_resolve 1 0 0))
      (if (!= (. result value) 0)
        (block
          (var uint32_t ip (cast uint32_t (. result value)))
          (call sexos_line "[browser.dns.resolve.ok] addr=%u.%u.%u.%u ok=1"
            (cast unsigned (& (>> ip 24) 255u))
            (cast unsigned (& (>> ip 16) 255u))
            (cast unsigned (& (>> ip 8) 255u))
            (cast unsigned (& ip 255u))))
        (call sexos_line "[browser.dns.resolve.miss] host_id=1 ok=1 reason=cache_miss"))

      (call sexos_line "[browser.packed_text.begin]")
      (var uint8_t ([] live_text 64) (init 0))
      (var size_t live_length (call receive_text listener live_text (sizeof live_text) false))
      (call sexos_line "[browser.packed_text.proof.done]")
      (call sexos_line "[browser.body.begin]")
      (var uint8_t ([] body_text 64) (init 0))
      (var size_t body_length (call receive_text listener body_text (sizeof body_text) true))
      (call sexos_line "[browser.render.live_text.begin] len=%zu" live_length)
      (call sexos_line "[browser.visible.polish.begin] sid=%llu"
        (cast (unsigned long long) KALEIDO_SURFACE_ID))
      (call sexos_pdx_call SEXOS_SLOT_display SEXOS_DISPLAY_create_surface KALEIDO_SURFACE_ID
        (| (<< 120ull 32) 80ull)
        (| (<< 120ull 32) 520ull))
      (call sexos_line "[browser.render.buffer.ready] virt=surface pfn=surface sid=%llu"
        (cast (unsigned long long) KALEIDO_SURFACE_ID))

      (cpp-if "SEXOS_KALEIDOSCOPE_CURRENT"
        (then
          (block
            (var bool rendered_html false)
            (if (&& (> body_length 0) (call kaleidoscope_html_looks_like body_text body_length))
              (block
                (var (static KaleidoscopeHtmlWorkspace) html_workspace (init 0))
                (var (static uint8_t) ([] html_text KALEIDOSCOPE_BODY_CAPACITY) (init 0))
                (var KaleidoscopeHtmlConverted converted (init 0))
                (if (== (call kaleidoscope_html_convert body_text body_length html_text
                          (sizeof html_text) (& html_workspace) (& converted)) 0)
                  (block
                    (call send_text html_text (. converted len) 0)
                    (call sexos_line "[browser.html.converted] source_bytes=%zu text_bytes=%zu links=%zu truncated=%u scripts_run=%u scripts_refused=%u"
                      body_length (. converted len) (. converted links)
                      (cast unsigned (. converted truncated))
                      (cast unsigned (. converted scripts_run))
                      (cast unsigned (. converted scripts_refused)))
                    (= rendered_html true)))))
            (if (! rendered_html)
              (block
                (var KaleidoscopeBodySource body_source (init 0))
                (var KaleidoscopeBodySource summary_source (init 0))
                (= (. body_source len) body_length)
                (= (. summary_source len) live_length)
                (for (var size_t i 0) (< i body_length) (++ i)
                  (= ([] (. body_source bytes) i) ([] body_text i)))
                (for (var size_t i 0) (< i live_length) (++ i)
                  (= ([] (. summary_source bytes) i) ([] live_text i)))
                (var KaleidoscopeBodyPreview preview (init 0))
                (call kaleidoscope_body_build (& body_source) (& summary_source) (& preview))
                (call send_text (. preview bytes) (. preview len) 0)
                (call sexos_line "[browser.preview.layout] bytes=%zu newline=1 cached_or_sample=1"
                  (. preview len))))
            (if (> body_length 0) (call sexos_line "[browser.body.render.done]"))))
        (else
          (block
            (var (static const uint8_t) ([] title) "Kaleidoscope")
            (call send_text title (- (sizeof title) 1) 0)
            (call sexos_line "[browser.visible.polish.text] line=0 len=%zu" (- (sizeof title) 1))
            (var (static const uint8_t) ([] status_line) "HTTP 200 from 10.0.2.2")
            (call send_text status_line (- (sizeof status_line) 1) 32)
            (call sexos_line "[browser.visible.polish.text] line=1 len=%zu" (- (sizeof status_line) 1))
            (if (== body_length 0) (call send_text live_text live_length 64))
            (if (> body_length 0)
              (block
                (call sexos_line "[browser.body.render.begin]")
                (call send_text body_text body_length 64)
                (call sexos_line "[browser.body.render.done]"))))))
      (call sexos_line "[browser.render.draw_text] live=1 len=%zu" live_length)
      (call sexos_pdx_call SEXOS_SLOT_display SEXOS_DISPLAY_commit KALEIDO_SURFACE_ID 50 100)
      (call sexos_line "[browser.render.commit.request] window=%llu"
        (cast (unsigned long long) KALEIDO_SURFACE_ID))
      (call sexos_line "[browser.render.live_text.done]")
      (call sexos_line "[browser.visible.polish.done]"))

    (fn void kaleidoscope_main (void)
      (var SexosListener listener (init 8u))
      (call initialize_browser (& listener))
      (while true
        (block
          (var SexosMessage message (call sexos_listen (& listener) 1))
          (if (== (. message type_id) 65535ull) break)))
      (call sexos_pdx_call SEXOS_SLOT_kernel SEXOS_KERNEL_exit 0 0 0))
  ))
