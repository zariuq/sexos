(cesta native-c/1 compact-c/2
  (unit
    (cpp-if "!defined(SEXOS_CESTA_SERVER_H)"
      (then
        (define SEXOS_CESTA_SERVER_H "1")
        (include "sexos_client.h")
        (include "sexos_memory_regions.h")
        (include "sexos_region_writer.h")
        (comment "Server-side calls of crates/sex-pdx beyond the client interface.")
        (comment "Capability error sentinels; must match kernel/src/ipc.rs.")
        (define SEXOS_ERR_SERVICE_NOT_READY "UINT64_C(0xFFFFFFFFFFFFFFFE)")
        (define SEXOS_ERR_CAP_INVALID "UINT64_C(0xFFFFFFFFFFFFFFFC)")
        (comment "get_ticks: the kernel tick counter (0 under QEMU TCG).")
        (var uint64_t (function sexos_get_ticks void))
        (comment "pdx_try_listen_raw: one listen; when nothing waits, yield once and report none.")
        (var bool (function sexos_try_listen (uint64_t slot) (SexosMessage (* out))))
        (comment "sys_set_state: announce the service state (SEXOS_SERVICE_STATE_*).")
        (var uint64_t (function sexos_set_state (uint64_t state)))
        (comment "Memory syscalls of sex-rt; each returns all ones on failure.")
        (var uint64_t (function sexos_allocate_memory (uint64_t size)))
        (var uint64_t (function sexos_map_memory (uint64_t pfn) (uint64_t size)))
        (comment "MemLend syscalls of sex-pdx (sys_grant_mem_lend / sys_map_mem_lend).")
        (var uint64_t (function sexos_grant_mem_lend (uint64_t domain_slot) (uint64_t length) (uint64_t lend_slot)))
        (var uint64_t (function sexos_map_mem_lend (uint64_t cap_slot)))
        (comment "Bounded static and current-run arena of sex-rt.")
        (typedef (struct SexosHeapUsage (size_t used) (size_t free) (size_t total)) SexosHeapUsage)
        (var void (function sexos_heap_init void))
        (var void (* (function sexos_malloc (size_t size) (size_t align))))
        (var void (function sexos_free (void (* pointer)) (size_t size) (size_t align)))
        (var void (* (function sexos_calloc (size_t count) (size_t size) (size_t align))))
        (var void (* (function sexos_realloc (void (* pointer)) (size_t old_size) (size_t new_size) (size_t align))))
        (var SexosHeapUsage (function sexos_heap_usage void))
        (comment "pdx_reply: answer the caller of the message being served.")
        (var uint64_t (function sexos_reply (uint32_t target_pd) (uint64_t value)))
        (var void (function silkbar_main void))
        (var void (function sexinput_main void))
        (var void (function sexstore_main void))
        (var void (function sexdisplay_main void))
        (var void (function sexbell_main void))
        (var void (function linen_main void))
        (var void (function quil_main void))
        (var void (function spindle_main void))
        (var void (function purple_scanout_main void))
        (var void (function sexfiles_main void))
        (comment "core::hint::spin_loop: one pause, a hint to the processor inside a busy wait.")
        (var void (function sexos_spin_loop_hint void))
        (comment "A counted inline pause loop, avoiding one external C call per Rust spin-loop hint.")
        (var void (function sexos_spin_loop_count (uint64_t count)))
        (comment "A Rust panic handler that spins: never returns.")
        (var (_Noreturn void) (function sexos_spin_forever void)))
  )))
