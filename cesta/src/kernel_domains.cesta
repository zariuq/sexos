                kernel_epoch_current kernel_epoch_record_event kernel_fpu_restore
                kernel_fpu_save_current kernel_idle_loop kernel_input_epoch_log
                kernel_input_pop_commit kernel_input_pop_current kernel_input_pop_is_snapshotted
                kernel_input_pop_is_swapped kernel_input_pop_is_transformed kernel_input_pop_run
                kernel_input_pop_snapshot kernel_input_pop_swap kernel_input_pop_transform
                kernel_input_push_commit kernel_input_push_current kernel_input_push_is_snapshotted
                kernel_input_push_is_swapped kernel_input_push_is_transformed kernel_input_push_run
                kernel_input_push_snapshot kernel_input_push_swap kernel_input_push_transform
                kernel_nvme_msix_enable kernel_nvme_msix_set_mask kernel_nvme_reset_bind
                kernel_ring_advance kernel_ring_copy kernel_ring_inspect kernel_ring_is_copied
                kernel_ring_is_current kernel_ring_is_swapped kernel_ring_push_commit
                kernel_ring_push_current kernel_ring_push_is_snapshotted kernel_ring_push_is_swapped
                kernel_ring_push_is_transformed kernel_ring_push_run kernel_ring_push_snapshot
                kernel_ring_push_swap kernel_ring_push_transform kernel_ring_run kernel_ring_swap
