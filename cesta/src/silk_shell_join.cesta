    shell_diagnostics_surface_input_lifetime_mark_click_target(ctx->proofs_a, sid, live, committed,
                                                               ok);
}

void shell_chrome_peer_surface_input_lifetime_mark_drag_target(ShellChromeContext *ctx,
                                                               uint64_t sid, uint8_t live,
                                                               const char *phase, uint8_t ok) {
    bind_chrome(ctx);
    ShellDiagnosticLabel label = {0};
    while (phase && phase[label.len] && label.len + 1 < sizeof label.bytes) {
        label.bytes[label.len] = (uint8_t)phase[label.len];
        ++label.len;
    }
    shell_diagnostics_surface_input_lifetime_mark_drag_target(ctx->proofs_a, sid, live, &label, ok);
}

