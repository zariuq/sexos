void clear_hover_if_wrong_scene(void) {
    uint32_t hovered = SILK_SHELL_STATE.chrome.HOVERED_FRAME_ID;
    if (!hovered)
        return;
    for (size_t i = 0; i < MAX_FRAMES; ++i)
        if (SILK_SHELL_STATE.chrome.FRAMES[i].present &&
            SILK_SHELL_STATE.chrome.FRAMES[i].frame_id == hovered) {
            if (SILK_SHELL_STATE.chrome.FRAMES[i].scene_id ==
                SILK_SHELL_STATE.chrome.ACTIVE_SCENE_IDX)
                return;
            break;
        }
    SILK_SHELL_STATE.chrome.HOVERED_FRAME_ID = 0;
    SILK_SHELL_STATE.chrome.HOVERED_FRAME_LIGHT = 0;
    SILK_SHELL_STATE.chrome.HOVER_KIND = 0;
}

