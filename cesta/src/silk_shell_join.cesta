bool shell_chrome_peer_app_closeable(ShellChromeContext *ctx, uint64_t sid, bool *out) {
    bind_chrome(ctx);
    for (size_t i = 0; i < sizeof(APP_SURFACES) / sizeof(APP_SURFACES[0]); ++i)
        if (APP_SURFACES[i].surface_id == sid) {
            if (out)
                *out = APP_SURFACES[i].closeable;
            return true;
        }
    for (size_t i = 0; i < SHELL_APP_COUNT; ++i)
        if (ctx->apps->present[i] && shell_custody_owns_surface(&ctx->apps->entries[i], sid)) {
            ShellCustodyWord slot = shell_custody_close_slot(&ctx->apps->entries[i]);
            if (out)
                *out = slot.present;
            return true;
        }
    return false;
}

bool shell_chrome_peer_app_focusable(ShellChromeContext *ctx, uint64_t sid) {
    bind_chrome(ctx);
    return shell_custody_has_surface(sid, false);
}

void shell_chrome_peer_shell_request_app_close(ShellChromeContext *ctx, uint64_t sid) {
    bind_chrome(ctx);
    for (size_t i = 0; i < SHELL_APP_COUNT; ++i)
        if (ctx->apps->present[i] && shell_custody_owns_surface(&ctx->apps->entries[i], sid)) {
            (void)shell_custody_request_close(&ctx->apps->entries[i]);
            return;
        }
}

