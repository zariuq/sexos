bool shell_surfaces_peer_native_launcher_available(ShellSurfacesContext *ctx, uint32_t target) {
    bind_surfaces(ctx);
    for (size_t i = 0; i < SHELL_APP_COUNT; ++i)
        if (ctx->shell.apps->present[i] && ctx->shell.apps->entries[i].target == target)
            return !ctx->shell.apps->entries[i].dead;
    return true;
}

ShellPaletteStatus shell_surfaces_peer_native_launcher_status(ShellSurfacesContext *ctx,
                                                              uint32_t target) {
    bool available = shell_surfaces_peer_native_launcher_available(ctx, target);
    return (ShellPaletteStatus){available, join_text(available ? \"READY\" : \"CLOSED\"),
                                join_text(available ? \"available\" : \"dead\")};
}

bool shell_custody_has_surface(uint64_t sid, bool terminal_only) {
    (void)terminal_only;
    for (size_t i = 0; i < SHELL_APP_COUNT; ++i)
        if (SILK_SHELL_STATE.apps.present[i] &&
            shell_custody_owns_surface(&SILK_SHELL_STATE.apps.entries[i], sid))
            return true;
    return sid == SURFACE_ID_APP || sid == SURFACE_ID_STATIC || sid == SURFACE_ID_QUIL ||
           sid == SURFACE_ID_LINEN;
}

bool shell_draw_text(uint64_t sid, const uint8_t *text, size_t len, uint64_t color,
                     size_t *out_drawn) {
    if (len > SHELL_TEXT_CAPACITY || (!text && len))
        return false;
    ShellTextBytes bounded = {0};
    bounded.len = len;
    for (size_t i = 0; i < len; ++i)
        bounded.bytes[i] = text[i];
    ShellDiagnosticDraw result = shell_diagnostics_shell_draw_text(sid, &bounded, color);
    if (out_drawn)
        *out_drawn = result.attempted;
    return result.admitted;
}

size_t strlen(const char *text) {
    size_t n = 0;
    while (text && text[n])
        ++n;
    return n;
}

void write_str(const char *text) {
    if (text)
        sexos_raw_print(text, strlen(text));
}

void write_u64_dec(uint64_t value) {
    char out[21];
    size_t n = 0;
    if (!value)
        out[n++] = '0';
    else {
        char reverse[20];
        size_t r = 0;
        while (value) {
            reverse[r++] = (char)('0' + value % 10);
            value /= 10;
        }
        while (r)
            out[n++] = reverse[--r];
    }
    sexos_raw_print(out, n);
}

void write_debug_lifecycle_state(uint8_t state) {
    write_u64_dec(state);
}

void write_debug_resize_edge(uint8_t edge) {
    write_u64_dec(edge);
}

void write_debug_tombstone_reason(uint8_t reason) {
    write_u64_dec(reason);
}
