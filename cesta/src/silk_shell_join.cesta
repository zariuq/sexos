#include \"silk_shell_core.h\"
#include \"silk_shell_chrome.h\"
#include \"silk_shell_input.h\"
#include \"silk_shell_atlas.h\"
#include \"silk_shell_surfaces.h\"
#include \"silk_shell_models_bell.h\"
#include \"silk_shell_models_root.h\"
#include \"silk_shell_diagnostics_a.h\"

static ShellChromeContext join_chrome(void) {
    return (ShellChromeContext){&SILK_SHELL_STATE.chrome, &SILK_SHELL_STATE.models,
                                &SILK_SHELL_STATE.apps, &SILK_SHELL_STATE.input,
                                &SILK_SHELL_STATE.proofs_a};
}

static ShellInputContext join_input(void) {
    return (ShellInputContext){join_chrome(), &SILK_SHELL_STATE.atlas, &SILK_SHELL_STATE.surfaces};
}

static ShellAtlasContext join_atlas(void) {
    return (ShellAtlasContext){&SILK_SHELL_STATE.atlas, &SILK_SHELL_STATE.chrome,
                               &SILK_SHELL_STATE.models};
}

static ShellSurfacesContext join_surfaces(void) {
    return (ShellSurfacesContext){join_chrome(), &SILK_SHELL_STATE.surfaces};
}

static void bind_chrome(const ShellChromeContext *ctx) {
    if (ctx && ctx->chrome == &SILK_SHELL_STATE.chrome && ctx->models == &SILK_SHELL_STATE.models &&
        ctx->apps == &SILK_SHELL_STATE.apps && ctx->input == &SILK_SHELL_STATE.input &&
        ctx->proofs_a == &SILK_SHELL_STATE.proofs_a)
        return;
    sexos_fail();
}

static void bind_surfaces(const ShellSurfacesContext *ctx) {
    bind_chrome(&ctx->shell);
    if (ctx->surfaces != &SILK_SHELL_STATE.surfaces)
        sexos_fail();
}

static ShellPaletteString join_text(const char *text) {
    ShellPaletteString out = {0};
    while (text && text[out.len] && out.len + 1 < sizeof out.bytes) {
        out.bytes[out.len] = text[out.len];
        ++out.len;
    }
    return out;
}

