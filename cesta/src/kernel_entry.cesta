(cesta native-c/1 compact-c/2
  (unit
    (include "sexos_kernel.h")
    (comment "Boot, the processor's tables, and traps. Translated from kernel/src/lib.rs (kernel_init), hal/x86_64.rs, gdt.rs, pku.rs and interrupts.rs.")

    (define MSR_EFER "0xC0000080u")
    (define MSR_STAR "0xC0000081u")
    (define MSR_LSTAR "0xC0000082u")
    (define MSR_SFMASK "0xC0000084u")
    (comment "SYSCALL clears IF, TF, DF and AC: system calls run with interrupts off, and a user-set AC cannot lift SMAP for the kernel.")
    (define SYSCALL_FLAG_MASK "UINT64_C(0x40700)")
    (define CR0_MP "(UINT64_C(1) << 1)")
    (define CR0_EM "(UINT64_C(1) << 2)")
    (define CR0_TS "(UINT64_C(1) << 3)")
    (define CR0_WP "(UINT64_C(1) << 16)")
    (define CR4_OSFXSR "(UINT64_C(1) << 9)")
    (define CR4_OSXMMEXCPT "(UINT64_C(1) << 10)")
    (define CR4_OSXSAVE "(UINT64_C(1) << 18)")
    (define CR4_SMEP "(UINT64_C(1) << 20)")
    (define CR4_SMAP "(UINT64_C(1) << 21)")
    (define CR4_PKE "(UINT64_C(1) << 22)")
    (define TIMER_VECTOR "0x20u")
    (define KEYBOARD_VECTOR "0x21u")
    (define SPURIOUS_VECTOR "0xFFu")

    (comment "The reference's GDT: null, kernel code, kernel data, a 32-bit user code pad (so SYSRET finds user data and user code above it), user data, user code, and the TSS in two entries.")
    (var (static uint64_t) ([] gdt 8))
    (comment "The TSS as 26 words: rsp0 at bytes 4 to 11, ist1 at 36 to 43, the I/O map base at 102.")
    (var (static uint32_t) ([] tss 26))
    (var (static uint64_t) ([] idt 512))
    (var (static uint64_t) ([] double_fault_stack 2048))
    (comment "Descriptor-table pointers: a 16-bit limit and a 64-bit base.")
    (var (static uint16_t) ([] gdt_pointer 5))
    (var (static uint16_t) ([] idt_pointer 5))

    (fn void tss_set_rsp0 ((uint64_t top))
      (= ([] tss 1) (cast uint32_t top))
      (= ([] tss 2) (cast uint32_t (>> top 32))))

    (fn (static void) set_pointer ((uint16_t (* pointer)) (uint16_t limit) (uint64_t base))
      (= ([] pointer 0) limit)
      (for (var unsigned i 0) (< i 4) (++ i)
        (= ([] pointer (+ i 1)) (cast uint16_t (>> base (* 16 i))))))

    (fn (static void) set_gate ((unsigned vector) (uint64_t handler) (uint64_t ist))
      (= ([] idt (* 2 vector)) (| (& handler 0xFFFF) (| (<< (cast uint64_t KERNEL_CS) 16) (| (<< ist 32) (| (<< (cast uint64_t 0x8E) 40) (<< (& (>> handler 16) 0xFFFF) 48))))))
      (= ([] idt (+ (* 2 vector) 1)) (>> handler 32)))

    (fn (static void) cpu_tables_init (void)
      (= ([] gdt 0) 0)
      (= ([] gdt 1) 0x00af9b000000ffffULL)
      (= ([] gdt 2) 0x00cf93000000ffffULL)
      (= ([] gdt 3) 0x00cffb000000ffffULL)
      (= ([] gdt 4) 0x00cff3000000ffffULL)
      (= ([] gdt 5) 0x00affb000000ffffULL)
      (call memset tss 0 (sizeof tss))
      (= ([] tss 25) (<< 104u 16))
      (var uint64_t ist (& (+ (cast uint64_t (cast uintptr_t double_fault_stack)) (sizeof double_fault_stack)) (~ (cast uint64_t 15))))
      (= ([] tss 9) (cast uint32_t ist))
      (= ([] tss 10) (cast uint32_t (>> ist 32)))
      (var uint64_t base (cast uint64_t (cast uintptr_t tss)))
      (var uint64_t limit (- (sizeof tss) 1))
      (= ([] gdt 6) (| (& limit 0xFFFF) (| (<< (& base 0xFFFFFF) 16) (| (<< (cast uint64_t 0x89) 40) (| (<< (& (>> limit 16) 0xF) 48) (<< (& (>> base 24) 0xFF) 56))))))
      (= ([] gdt 7) (>> base 32))
      (call set_pointer gdt_pointer (cast uint16_t (- (sizeof gdt) 1)) (cast uint64_t (cast uintptr_t gdt)))
      (call cpu_load_gdt gdt_pointer KERNEL_CS KERNEL_DS)
      (call cpu_ltr KERNEL_TSS_SELECTOR)
      (for (var unsigned v 0) (< v 35) (++ v)
        (call set_gate v ([] kernel_isr_table v) (?: (== v 8) 1 0)))
      (call set_gate SPURIOUS_VECTOR ([] kernel_isr_table 35) 0)
      (call set_pointer idt_pointer (cast uint16_t (- (sizeof idt) 1)) (cast uint64_t (cast uintptr_t idt)))
      (call cpu_lidt idt_pointer)
      (call cpu_wrmsr MSR_EFER (| (call cpu_rdmsr MSR_EFER) 1))
      (call cpu_wrmsr MSR_STAR (| (<< (cast uint64_t 0x1B) 48) (<< (cast uint64_t KERNEL_CS) 32)))
      (call cpu_wrmsr MSR_LSTAR (cast uint64_t (cast uintptr_t kernel_syscall_entry)))
      (call cpu_wrmsr MSR_SFMASK SYSCALL_FLAG_MASK)
      (call klog "X86Hal: GDT/TSS, IDT and SYSCALL ready (interrupts masked during system calls)\n"))

    (comment "Protection keys as the reference enables them, plus what it leaves off: SMEP (the kernel never executes user pages), SMAP (the kernel touches user pages only in its checked copies) and write protection of read-only pages in kernel mode.")
    (fn (static void) features_init (void)
      (var uint32_t ([] r 4))
      (call cpu_cpuid 0 0 r)
      (var uint32_t ebx 0)
      (var uint32_t ecx 0)
      (if (>= ([] r 0) 7)
        (block
          (call cpu_cpuid 7 0 r)
          (= ebx ([] r 1))
          (= ecx ([] r 2))))
      (if SEXOS_KERNEL_CURRENT_FPU
        (block
          (var uint32_t edx1 0)
          (call cpu_cpuid 1 0 r)
          (= edx1 ([] r 3))
          (if (!= (& edx1 (| (<< 1u 24) (| (<< 1u 25) (<< 1u 26)))) (| (<< 1u 24) (| (<< 1u 25) (<< 1u 26))))
            (call kernel_halt "FXSAVE, SSE and SSE2 required for user contexts"))))
      (= (. kernel smep) (!= (& ebx (<< 1u 7)) 0))
      (= (. kernel smap) (!= (& ebx (<< 1u 20)) 0))
      (= (. kernel pku) (!= (& ecx (<< 1u 3)) 0))
      (if (! (. kernel pku)) (call kernel_halt "protection keys required for domain isolation"))
      (var uint64_t cr4 (call cpu_read_cr4))
      (if (. kernel smep) (|= cr4 CR4_SMEP))
      (if (. kernel smap) (|= cr4 CR4_SMAP))
      (if (. kernel pku) (|= cr4 CR4_PKE))
      (if SEXOS_KERNEL_CURRENT_FPU (|= cr4 (| CR4_OSFXSR CR4_OSXMMEXCPT)))
      (call cpu_write_cr4 cr4)
      (call cpu_write_cr0
        (?: SEXOS_KERNEL_CURRENT_FPU
          (& (| (call cpu_read_cr0) (| CR0_MP CR0_WP)) (~ (| CR0_EM CR0_TS)))
          (| (call cpu_read_cr0) CR0_WP)))
      (= kernel_smap_enabled (?: (. kernel smap) 1 0))
      (call cpu_wrpkru 0)
      (call klog "PKU: Protection Keys enabled in CR4.\n")
      (comment "XRSTOR can load the key register only when XCR0 enables its state component (bit 9).")
      (if (!= (& cr4 CR4_OSXSAVE) 0)
        (if (!= (& (call cpu_xgetbv 0) (<< (cast uint64_t 1) 9)) 0)
          (call kernel_halt "XCR0 lets XRSTOR load the key register")))
      (call klog "kernel: SMEP=%u SMAP=%u PKU=%u WP=1\n" (cast unsigned (. kernel smep)) (cast unsigned (. kernel smap)) (cast unsigned (. kernel pku))))

    (fn (_Noreturn void) kernel_halt (((const char) (* reason)))
      (call klog "KERNEL PANIC: %s\n" reason)
      (while 1
        (block (call cpu_cli) (call cpu_hlt))))

    (comment "The current profile forwards eligible user data faults to the held pager; all other user faults terminate their domain. The frozen Rust reference halted the whole kernel on a protection fault or key violation.")
    (fn (static TrapFrame) * fault_user ((TrapFrame (* frame)))
      (var uint64_t address (?: (== (-> frame vector) 14) (call cpu_read_cr2) 0))
      (var Domain (* faulted) (call domain_get (. kernel current)))
      (if (&& SEXOS_KERNEL_CURRENT_PDX (== (-> frame vector) 14))
        (call klog "[paging.fault.trap] pd=%u addr=%#llx rip=%#llx error=%#llx eligible=%u\n" (. kernel current)
          (cast (unsigned long long) address) (cast (unsigned long long) (-> frame rip))
          (cast (unsigned long long) (-> frame error)) (cast unsigned (call pager_fault_eligible address (-> frame error) (-> frame cs)))))
      (if (&& SEXOS_KERNEL_CURRENT_PDX (&& (!= faulted NULL) (&& (== (-> frame vector) 14) (call kernel_pager_forward faulted frame address))))
        (return (call kernel_dispatch_blocked)))
      (call klog "fault.kill pd=%u vector=%llu err=%#llx rip=%#llx addr=%#llx\n" (. kernel current)
        (cast (unsigned long long) (-> frame vector)) (cast (unsigned long long) (-> frame error))
        (cast (unsigned long long) (-> frame rip)) (cast (unsigned long long) address))
      (var Domain (* d) (call domain_get (. kernel current)))
      (if (!= d NULL)
        (block
          (= (-> d task_state) TASK_EXITED)
          (if (! (call kernel_region_writer_recover_dead d))
            (call kernel_halt "dead writer recovery invariant"))
          (if (! (call kernel_device_reset_owner_dead d))
            (call kernel_halt "dead device reset custody invariant"))))
      (= (. kernel current) 0)
      (var uint32_t next (call run_pop))
      (if (!= next 0) (return (call switch_to next)))
      (call kernel_idle))

    (fn TrapFrame * kernel_trap ((TrapFrame (* frame)))
      (if (. kernel pku) (call cpu_wrpkru 0))
      (var uint64_t vector (-> frame vector))
      (var bool from_user (== (& (-> frame cs) 3) 3))
      (if (&& SEXOS_KERNEL_CURRENT_PDX from_user)
        (block
          (var Domain (* owner) (call domain_get (. kernel current)))
          (if (!= owner NULL) (= (-> owner frame) frame))
          (cpp-if "SEXOS_KERNEL_CURRENT_FPU" (then (call kernel_fpu_save_current)))))
      (if SEXOS_KERNEL_CURRENT_PDX (call kernel_task_poll))
      (if (== vector TIMER_VECTOR)
        (block
          (+= (. kernel ticks) 1)
          (if SEXOS_KERNEL_CURRENT_PDX (call kernel_task_poll))
          (call lapic_eoi)
          (if (! (. kernel scheduler_running)) (return frame))
          (if from_user (return (call schedule_tick frame)))
          (if (== (. kernel current) 0)
            (block
              (var uint32_t next (call run_pop))
              (if (!= next 0) (return (call switch_to next)))))
          (return frame)))
      (if (== vector KEYBOARD_VECTOR)
        (block
          (var uint8_t scancode 0)
          (if (call keyboard_read (& scancode)) (call input_push scancode))
          (call lapic_eoi)
          (return (call resume_frame frame))))
      (if (== vector SPURIOUS_VECTOR) (return (call resume_frame frame)))
      (if (< vector 32)
        (block
          (if from_user (return (call fault_user frame)))
          (call klog "KERNEL PANIC: exception vector=%llu error=%#llx rip=%#llx cr2=%#llx\n" (cast (unsigned long long) vector)
            (cast (unsigned long long) (-> frame error)) (cast (unsigned long long) (-> frame rip)) (cast (unsigned long long) (call cpu_read_cr2)))
          (call kernel_halt "kernel-mode exception")))
      (comment "A routed device interrupt: the owning domain hears a hardware-interrupt message, which listen reports with type 0xFF as the reference does.")
      (if (== ([] (. kernel vector_revision) vector) UINT64_MAX)
        (call kernel_halt "device interrupt revision exhausted"))
      (+= ([] (. kernel vector_revision) vector) 1)
      (var uint32_t owner ([] (. kernel vector_owner) vector))
      (var Domain (* d) (call domain_get owner))
      (if (!= d NULL)
        (block
          (var uint64_t generation (?: (&& (. (. kernel device_reset) present)
              (&& (== (. (. kernel device_reset) vector) vector)
                  (== (. (. kernel device_reset) owner) owner)))
            (. (. kernel device_reset) generation) (?: (== vector 0x22) 1ULL 0ULL)))
          (call domain_enqueue d (compound RingEntry (= (. type_id) 0xFF) (= (. caller) 1)
            (= (. arg0) vector) (= (. arg1) ([] (. kernel vector_revision) vector))
            (= (. arg2) generation)))))
      (call lapic_eoi)
      (return (call resume_frame frame)))

    (fn void kernel_main (void)
      (call kernel_serial_init)
      (var (const LimineHhdmResponse) (* hhdm) (. limine_hhdm_request response))
      (if (== hhdm NULL) (call kernel_halt "FATAL: Limine HHDM missing"))
      (= hhdm_offset (-> hhdm offset))
      (call features_init)
      (call cpu_tables_init)
      (var (const LimineMemmapResponse) (* map) (. limine_memmap_request response))
      (if (== map NULL) (call kernel_halt "FATAL: Limine memmap missing"))
      (call memory_init map)
      (var (const LimineRsdpResponse) (* rsdp) (. limine_rsdp_request response))
      (if (!= rsdp NULL)
        (block
          (var uint64_t address (-> rsdp address))
          (if (>= address hhdm_offset) (-= address hhdm_offset))
          (call klog "kernel: RSDP Physical Address: %#llx\n" (cast (unsigned long long) address))
          (call platform_init address))
        (call klog "X86Hal: WARNING - RSDP not found, skipping APIC/Timer.\n"))
      (call keyboard_init)
      (call domains_boot)
      (cpp-if "SEXOS_KERNEL_CURRENT_SMP"
        (then (if (! (call kernel_smp_park_boot)) (call kernel_halt "SMP park/quiescence failed"))))
      (if SEXOS_KERNEL_CURRENT_PDX (call kernel_current_boot_audit))
      (if SEXOS_KERNEL_BOOT_AUDIT (call kernel_idle))
      (call cpu_cli)
      (= (. kernel scheduler_running) true)
      (var uint32_t next (call run_pop))
      (if (== next 0)
        (block
          (call klog "scheduler: no runnable domain\n")
          (call kernel_idle)))
      (call kernel_resume (call switch_to next)))))
