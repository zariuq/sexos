(cesta native-c/1 compact-c/2
  (unit
    (include "sexstore.h")
    (ownership
      (check-all)
      (view cesta_read_bytes data len read)
      (view cesta_write_bytes data len write)
      (function page_view (returns-borrow 0 bytes))
      (foreign sexos_fail (obligation "Terminates execution without retaining a reference."))
      (foreign sexos_line (variadic-read) (obligation "Reads formatting arguments during this call and retains no pointers."))
      (foreign sexstore_pages_page_seq (obligation "Checked byte codec: reads only inside the supplied view."))
      (foreign sexstore_pages_page_begin (obligation "Checked byte codec: writes only inside the supplied view."))
      (foreign sexstore_pages_page_put_record (obligation "Checked byte codec: writes only inside the supplied view."))
      (foreign sexstore_pages_page_seal (obligation "Checked byte codec: reads and writes only inside the supplied view."))
      (foreign sexstore_pages_record_valid (obligation "Checked byte codec: reads only inside the supplied view."))
      (foreign sexstore_pages_record_state (obligation "Checked byte codec: reads only inside the supplied view."))
      (foreign sexstore_pages_record_generation (obligation "Checked byte codec: reads only inside the supplied view."))
      (foreign sexstore_pages_record_key (obligation "Checked byte codec: reads only inside the supplied view."))
      (foreign sexstore_pages_record_value (obligation "Checked byte codec: reads only inside the supplied view.")))
    (comment "Two validated snapshots with reserved-zero cyclic sequence numbers. Publication replaces the inactive page; recovery assumes valid pages lie within one half-cycle. Checksums detect damage but do not prove media atomicity.")

    (comment "A failed check in the page codec (an out-of-range view or index) is fatal.")
    (fn void sexstore_pages_failure (void)
      (call sexos_fail))

    (fn (static bool) take ((uint32_t (* budget)))
      (if (== (* budget) 0) (return false))
      (-= (* budget) 1)
      (return true))

    (fn (static cesta_read_bytes) page_view (((const DurablePage) (* page)))
      (return (compound cesta_read_bytes (= (. data) (-> page bytes)) (= (. len) DURABLE_PAGE_SIZE))))

    (fn Durable sexstore_durable_new (void)
      (return (compound Durable (= (. write_log) 16) (= (. write_fail_log) 8))))

    (fn (static void) page_read (((const Durable) (* durable)) (size_t page_offset) (DurablePage (* page)))
      (if (! (|| (== page_offset DURABLE_PAGE_A_OFFSET) (== page_offset DURABLE_PAGE_B_OFFSET)))
        (call sexos_fail))
      (for (var size_t i 0) (< i DURABLE_PAGE_SIZE) (++ i)
        (= ([] (-> page bytes) i) ([] (-> durable region) (+ page_offset i)))))

    (comment "Write, then verify by reading back: always equal in RAM, kept for media whose readback can differ.")
    (fn (static bool) page_write ((Durable (* durable)) (size_t page_offset) ((const DurablePage) (* page)))
      (if (! (|| (== page_offset DURABLE_PAGE_A_OFFSET) (== page_offset DURABLE_PAGE_B_OFFSET)))
        (call sexos_fail))
      (for (var size_t i 0) (< i DURABLE_PAGE_SIZE) (++ i)
        (= ([] (-> durable region) (+ page_offset i)) ([] (-> page bytes) i)))
      (var DurablePage readback (init 0))
      (call page_read durable page_offset (& readback))
      (for (var size_t i 0) (< i DURABLE_PAGE_SIZE) (++ i)
        (if (!= ([] (. readback bytes) i) ([] (-> page bytes) i)) (return false)))
      (return true))

    (comment "The sequence number of a valid page, or 0.")
    (fn (static uint32_t) page_seq (((const DurablePage) (* page)))
      (return (call sexstore_pages_page_seq (call page_view page))))

    (comment "Zero denotes absence. The live cycle has UINT32_MAX values because zero is reserved. A tie selects the first page; an unrestricted history has no globally transitive serial order.")
    (fn (static bool) sequence_current ((uint32_t first) (uint32_t second))
      (if (== first 0) (return (== second 0)))
      (if (|| (== second 0) (== first second)) (return true))
      (var uint32_t distance (?: (<= second first) (- first second) (+ (- UINT32_MAX second) first)))
      (return (<= distance (/ UINT32_MAX 2u))))

    (fn DurablePage sexstore_durable_build_page (((const KvTable) (* table)) (uint32_t seq))
      (var DurablePage page (init 0))
      (block
        (var cesta_write_bytes out (compound cesta_write_bytes (= (. data) (. page bytes)) (= (. len) DURABLE_PAGE_SIZE)))
        (call sexstore_pages_page_begin out seq)
        (for (var size_t i 0) (< i DURABLE_RECORD_COUNT) (++ i)
          (block
            (var (const KvSlot) (* slot) (& ([] (-> table slots) i)))
            (call sexstore_pages_page_put_record out i (-> slot state) (-> slot generation) (-> slot key) (-> slot val))))
        (call sexstore_pages_page_seal out))
      (return page))

    (fn bool sexstore_durable_write_all ((Durable (* durable)) ((const KvTable) (* table)))
      (var DurablePage page_a (init 0))
      (var DurablePage page_b (init 0))
      (call page_read durable DURABLE_PAGE_A_OFFSET (& page_a))
      (call page_read durable DURABLE_PAGE_B_OFFSET (& page_b))
      (var uint32_t seq_a (call page_seq (& page_a)))
      (var uint32_t seq_b (call page_seq (& page_b)))
      (var bool a_current (call sequence_current seq_a seq_b))
      (var size_t target (?: a_current DURABLE_PAGE_B_OFFSET DURABLE_PAGE_A_OFFSET))
      (var uint32_t next_seq (+ (?: a_current seq_a seq_b) 1u))
      (if (== next_seq 0) (= next_seq 1))
      (var DurablePage snapshot (call sexstore_durable_build_page table next_seq))
      (if (call page_write durable target (& snapshot))
        (block
          (comment "The first slot's key stands for the snapshot; every slot is written.")
          (if (call take (& (-> durable write_log)))
            (call sexos_line "[sexstore.durable.write] key=%u seq=%u page=%s"
              (cast unsigned (. ([] (-> table slots) 0) key)) (cast unsigned next_seq)
              (?: (== target DURABLE_PAGE_A_OFFSET) "A" "B")))
          (return true)))
      (if (call take (& (-> durable write_fail_log)))
        (call sexos_line "[sexstore.durable.write.fail] reason=verify_fail"))
      (return false))

    (fn (static DurableLoad) load_page (((const DurablePage) (* authoritative)) (KvTable (* table)))
      (var DurableLoad load (init 0))
      (var uint32_t auth_seq (call page_seq authoritative))
      (if (== auth_seq 0) (return load))
      (var cesta_read_bytes page (call page_view authoritative))
      (for (var size_t i 0) (< i DURABLE_RECORD_COUNT) (++ i)
        (block
          (+= (. load total) 1)
          (if (! (call sexstore_pages_record_valid page i))
            (block
              (+= (. load corrupt) 1)
              continue))
          (var KvSlot (* slot) (& ([] (-> table slots) i)))
          (= (-> slot state) (call sexstore_pages_record_state page i))
          (= (-> slot generation) (call sexstore_pages_record_generation page i))
          (= (-> slot key) (call sexstore_pages_record_key page i))
          (= (-> slot val) (call sexstore_pages_record_value page i))
          (+= (. load valid) 1)))
      (call sexos_line "[sexstore.durable.load] seq=%u records=%u valid=%u corrupt=%u"
        (cast unsigned auth_seq) (cast unsigned (. load total)) (cast unsigned (. load valid)) (cast unsigned (. load corrupt)))
      (if (&& (> (. load total) 0) (== (. load valid) 0))
        (call sexos_line "[sexstore.durable.all_corrupt] reason=all_records_invalid"))
      (return load))

    (fn DurableLoad sexstore_durable_load_into_ram (((const Durable) (* durable)) (KvTable (* table)))
      (var DurablePage page_a (init 0))
      (var DurablePage page_b (init 0))
      (call page_read durable DURABLE_PAGE_A_OFFSET (& page_a))
      (call page_read durable DURABLE_PAGE_B_OFFSET (& page_b))
      (var uint32_t seq_a (call page_seq (& page_a)))
      (var uint32_t seq_b (call page_seq (& page_b)))
      (if (call sequence_current seq_a seq_b) (return (call load_page (& page_a) table)))
      (return (call load_page (& page_b) table)))

    (fn bool sexstore_durable_init ((Durable (* durable)) ((const KvTable) (* table)))
      (var DurablePage page_a (init 0))
      (var DurablePage page_b (init 0))
      (call page_read durable DURABLE_PAGE_A_OFFSET (& page_a))
      (call page_read durable DURABLE_PAGE_B_OFFSET (& page_b))
      (if (|| (!= (call page_seq (& page_a)) 0) (!= (call page_seq (& page_b)) 0)) (return false))
      (var DurablePage snapshot (call sexstore_durable_build_page table 1))
      (var bool ok (call page_write durable DURABLE_PAGE_A_OFFSET (& snapshot)))
      (call sexos_line "[sexstore.durable.load] seq=1 records=16 valid=16 corrupt=0 init=%s" (?: ok "ok" "fail"))
      (return true))))
