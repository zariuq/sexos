(cesta native-c/1 compact-c/2
 (unit
 (include "sexos_document_client_transport.h")
 (ownership (check-all)
  (foreign memset (returns-borrow 0) (obligation "Writes exactly the requested bytes of the destination and retains no reference."))
  (foreign sexos_rpc_begin (obligation "Admits one correlated request or reports that no request was enqueued."))
  (foreign sexos_rpc_poll (obligation "Polls only the named correlated request and consumes no unrelated reply."))
  (foreign sexos_rpc_cancel (obligation "Cancels only the named correlated request when it remains cancellable."))
  (foreign sexos_document_header (obligation "Encodes the request by value and retains no reference."))
  (foreign document_client_action (obligation "Advances only the supplied client state and returns its next request by value."))
  (foreign document_client_sent (obligation "Settles admission only for the named client request sequence."))
  (foreign document_client_reply (obligation "Settles only an exact server reply for the supplied client state."))
  (foreign document_client_transport_lost (obligation "Fences only the named admitted request after transport loss."))
  (foreign document_client_close (obligation "Closes and scrubs only the supplied client state.")))
 (native "
void document_client_transport_init(DocumentClientTransport *state) {
    memset(state, 0, sizeof *state);
}

static size_t document_transport_free(const DocumentClientTransport *state) {
    for (size_t i = 0; i < DOCUMENT_CLIENT_TRANSPORT_SLOTS; i++)
        if (!state->entries[i].present)
            return i;
    return SIZE_MAX;
}

bool document_client_transport_step(DocumentClient *client, DocumentClientTransport *transport,
                                    DocumentClientEvent *event) {
    if (event)
        *event = (DocumentClientEvent){0};
    size_t pending = 0;
    for (size_t i = 0; i < DOCUMENT_CLIENT_TRANSPORT_SLOTS; i++) {
        DocumentClientTransportEntry entry = transport->entries[i];
        if (!entry.present)
            continue;
        SexosReply reply = sexos_rpc_poll(entry.request_id);
        if (!reply.status) {
            memset(&transport->entries[i], 0, sizeof transport->entries[i]);
            (void)document_client_reply(client, SEXOS_DOCUMENT_SERVER_PD, reply.value, event);
            if (event && event->present)
                return true;
        } else if (reply.status != SEXOS_RPC_BUSY) {
            memset(&transport->entries[i], 0, sizeof transport->entries[i]);
            (void)document_client_transport_lost(client, entry.sequence, SEXOS_DOCUMENT_DENIED,
                                                 event);
            if (event && event->present)
                return true;
        }
    }
    for (size_t i = 0; i < DOCUMENT_CLIENT_TRANSPORT_SLOTS; i++)
        if (transport->entries[i].present)
            pending++;
    if (pending && (client->phase != DOCUMENT_PHASE_READ && client->phase != DOCUMENT_PHASE_WRITE))
        return false;
    if (pending >= SEXOS_DOCUMENT_WINDOW)
        return false;
    DocumentClientAction action = document_client_action(client, event);
    if (event && event->present)
        return true;
    if (!action.present)
        return false;
    size_t slot = document_transport_free(transport);
    if (slot == SIZE_MAX)
        return false;
    SexosReply admitted =
        sexos_rpc_begin(SEXOS_SLOT_storage, SEXOS_DOCUMENT_OP,
                        sexos_document_header(action.request), action.request.a, action.request.b);
    if (!admitted.status && admitted.value) {
        transport->entries[slot] =
            (DocumentClientTransportEntry){true, action.request.seq, admitted.value};
        (void)document_client_sent(client, action.request.seq, true, false, event);
    } else
        (void)document_client_sent(
            client, action.request.seq, false,
            admitted.status == SEXOS_RPC_BUSY || admitted.status == SEXOS_RPC_UNSUPPORTED, event);
    return event && event->present;
}

bool document_client_transport_pending(const DocumentClientTransport *transport) {
    for (size_t i = 0; i < DOCUMENT_CLIENT_TRANSPORT_SLOTS; i++)
        if (transport->entries[i].present)
            return true;
    return false;
}

void document_client_transport_close(DocumentClient *client, DocumentClientTransport *transport) {
    for (size_t i = 0; i < DOCUMENT_CLIENT_TRANSPORT_SLOTS; i++)
        if (transport->entries[i].present)
            (void)sexos_rpc_cancel(transport->entries[i].request_id);
    memset(transport, 0, sizeof *transport);
    document_client_close(client);
}
")))
