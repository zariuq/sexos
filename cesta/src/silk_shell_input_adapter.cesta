    (native "
#include \"silk_shell_input.h\"
bool desktop_shortcut(uint8_t code, uint64_t value);
bool quil_has_focus(void);
bool spindle_has_focus(void);

static ShellInputContext input_context(void) {
    return (ShellInputContext){.shell = {.input = &SILK_SHELL_STATE.input,
                                         .chrome = &SILK_SHELL_STATE.chrome,
                                         .models = &SILK_SHELL_STATE.models,
                                         .apps = &SILK_SHELL_STATE.apps,
                                         .proofs_a = &SILK_SHELL_STATE.proofs_a},
                               .atlas = &SILK_SHELL_STATE.atlas,
                               .surfaces = &SILK_SHELL_STATE.surfaces};
}

static void input_binding(const ShellInputContext *ctx) {
    if (ctx && ctx->shell.input == &SILK_SHELL_STATE.input &&
        ctx->shell.chrome == &SILK_SHELL_STATE.chrome && ctx->atlas == &SILK_SHELL_STATE.atlas &&
        ctx->surfaces == &SILK_SHELL_STATE.surfaces &&
        ctx->shell.proofs_a == &SILK_SHELL_STATE.proofs_a &&
        ctx->shell.models == &SILK_SHELL_STATE.models && ctx->shell.apps == &SILK_SHELL_STATE.apps)
        return;
    sexos_fail();
    for (;;) {
    }
}

bool shell_input_peer_access_handle_keyboard_action(ShellInputContext *ctx, uint8_t action) {
    input_binding(ctx);
    return access_handle_keyboard_action(action);
}

