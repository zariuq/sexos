(cesta native-c/1 compact-c/2
  (unit
    (include "sexos_kernel.h")
    (comment "The platform: ACPI's interrupt table, the local and I/O APICs, the PIT-calibrated local APIC timer, the PS/2 keyboard, and PCI configuration space. Translated from kernel/src/apic.rs, keyboard.rs, hal/pci.rs and drivers/pci.rs; the reference parses ACPI with the acpi crate, this kernel reads only the tables it uses, by their layouts in the ACPI specification.")

    (define MAX_IOAPICS "4u")
    (define LAPIC_ID "0x020u")
    (define LAPIC_EOI "0x0B0u")
    (define LAPIC_SVR "0x0F0u")
    (define LAPIC_LVT_TIMER "0x320u")
    (define LAPIC_TIMER_INITIAL "0x380u")
    (define LAPIC_TIMER_CURRENT "0x390u")
    (define LAPIC_TIMER_DIVIDE "0x3E0u")
    (define TIMER_VECTOR "0x20u")
    (define KEYBOARD_VECTOR "0x21u")

    (typedef (struct IoApic (uint8_t id) (uint32_t address) (uint32_t gsi_base)) IoApic)
    (typedef (struct SourceOverride (bool present) (uint8_t isa_source) (bool active_low) (bool level)) SourceOverride)
    (typedef (struct Platform
      (uint64_t lapic) (IoApic ([] ioapics MAX_IOAPICS)) (uint32_t ioapic_count)
      (SourceOverride ([] overrides 256))) Platform)

    (var (static Platform) platform)

    (fn (static uint32_t) mmio_read32 ((uint64_t address))
      (return (* (cast ((volatile uint32_t) *) (cast uintptr_t address)))))

    (fn (static void) mmio_write32 ((uint64_t address) (uint32_t value))
      (= (* (cast ((volatile uint32_t) *) (cast uintptr_t address))) value))

    (fn (static uint32_t) lapic_read ((uint32_t reg)) (return (call mmio_read32 (+ (. platform lapic) reg))))
    (fn (static void) lapic_write ((uint32_t reg) (uint32_t value)) (call mmio_write32 (+ (. platform lapic) reg) value))

    (fn void lapic_eoi (void)
      (if (!= (. platform lapic) 0)
        (call lapic_write LAPIC_EOI 0)
        (block (call cpu_outb 0x20 0x20) (call cpu_outb 0xA0 0x20))))

    (fn (static uint8_t) read8 ((uint64_t phys)) (return (* (cast ((const uint8_t) *) (call phys_to_virt phys)))))
    (fn (static uint16_t) read16 ((uint64_t phys))
      (return (cast uint16_t (| (call read8 phys) (<< (cast uint16_t (call read8 (+ phys 1))) 8)))))
    (fn (static uint32_t) read32 ((uint64_t phys))
      (return (| (call read16 phys) (<< (cast uint32_t (call read16 (+ phys 2))) 16))))
    (fn (static uint64_t) read64 ((uint64_t phys))
      (return (| (call read32 phys) (<< (cast uint64_t (call read32 (+ phys 4))) 32))))

    (fn (static bool) signature_is ((uint64_t phys) ((const char) (* signature)))
      (for (var unsigned i 0) (< i 4) (++ i)
        (if (!= (call read8 (+ phys i)) (cast uint8_t ([] signature i))) (return false)))
      (return true))

    (comment "The MADT, through the XSDT when the RSDP has revision 2 or later, otherwise through the RSDT.")
    (fn (static uint64_t) find_madt ((uint64_t rsdp))
      (var bool extended (>= (call read8 (+ rsdp 15)) 2))
      (var uint64_t root (?: extended (call read64 (+ rsdp 24)) (call read32 (+ rsdp 16))))
      (if (== root 0) (return 0))
      (var uint32_t length (call read32 (+ root 4)))
      (var uint32_t width (?: extended 8 4))
      (for (var uint32_t offset 36) (<= (+ offset width) length) (+= offset width)
        (block
          (var uint64_t table (?: extended (call read64 (+ root offset)) (call read32 (+ root offset))))
          (if (&& (!= table 0) (call signature_is table "APIC")) (return table))))
      (return 0))

    (comment "LAPIC timer calibration against PIT channel 2, as apic.rs::init_timer does it: divide by 16, count down from all ones while the PIT counts 10 ms, then program the measured count per millisecond as the periodic interval. A failed calibration falls back to 1,000,000.")
    (fn (static void) timer_init (void)
      (call lapic_write LAPIC_TIMER_DIVIDE 0x3)
      (var uint32_t pit_count (cast uint32_t (/ (* 1193182 10) 1000)))
      (call cpu_cli)
      (call lapic_write LAPIC_LVT_TIMER (| 0x10000 TIMER_VECTOR))
      (call lapic_write LAPIC_TIMER_INITIAL 0xFFFFFFFFu)
      (call lapic_write LAPIC_LVT_TIMER TIMER_VECTOR)
      (call cpu_outb 0x43 0xB0)
      (call cpu_outb 0x42 (cast uint8_t (& pit_count 0xFF)))
      (call cpu_outb 0x42 (cast uint8_t (& (>> pit_count 8) 0xFF)))
      (var bool timed_out false)
      (for (var uint32_t i 0) (< i 1000000) (++ i)
        (block
          (if (!= (& (call cpu_inb 0x61) 0x20) 0) break)
          (call cpu_pause)))
      (if (== (& (call cpu_inb 0x61) 0x20) 0) (= timed_out true))
      (var uint32_t remaining (call lapic_read LAPIC_TIMER_CURRENT))
      (var uint32_t elapsed (?: (|| timed_out (>= remaining 0xFFFFFFFEu)) 0 (+ (- 0xFFFFFFFFu remaining) 1)))
      (var uint32_t ticks_per_ms (/ elapsed 10))
      (call cpu_sti)
      (if (|| (== ticks_per_ms 0) (> ticks_per_ms 10000000))
        (block
          (call klog "APIC: LAPIC timer calibration failed (elapsed=%u pit_count=%u); using fallback=1000000\n" elapsed pit_count)
          (= ticks_per_ms 1000000))
        (call klog "APIC: LAPIC timer calibrated: %u ticks/ms (elapsed=%u over 10ms)\n" ticks_per_ms elapsed))
      (call lapic_write LAPIC_LVT_TIMER (| 0x20000 TIMER_VECTOR))
      (call lapic_write LAPIC_TIMER_INITIAL ticks_per_ms)
      (call klog "APIC: LAPIC Timer initialized at Vector 0x20.\n"))

    (comment "Route an ISA interrupt to a vector on the boot processor, with the polarity and trigger of its source override. As in the reference, the ISA line is taken as its GSI.")
    (fn (static void) ioapic_map ((uint32_t gsi) (uint8_t vector))
      (if (== (. platform ioapic_count) 0) (return))
      (var (const IoApic) (* io) (& ([] (. platform ioapics) 0)))
      (for (var uint32_t i 0) (< i (. platform ioapic_count)) (++ i)
        (block
          (var (const IoApic) (* candidate) (& ([] (. platform ioapics) i)))
          (if (&& (>= gsi (-> candidate gsi_base)) (< gsi (+ (-> candidate gsi_base) 24)))
            (block (= io candidate) break))))
      (var uint64_t base (+ hhdm_offset (-> io address)))
      (var uint32_t index (+ 0x10 (* (- gsi (-> io gsi_base)) 2)))
      (var uint32_t low vector)
      (if (&& (< gsi 256) (. ([] (. platform overrides) gsi) present))
        (block
          (if (. ([] (. platform overrides) gsi) active_low) (|= low (<< 1 13)))
          (if (. ([] (. platform overrides) gsi) level) (|= low (<< 1 15)))))
      (call mmio_write32 base index)
      (call mmio_write32 (+ base 0x10) low)
      (call mmio_write32 base (+ index 1))
      (call mmio_write32 (+ base 0x10) 0)
      (call klog "APIC: Mapped GSI %u (IOAPIC %u) to Vector %u (Dest LAPIC 0, low=%#x)\n" gsi (-> io id) vector low))

    (fn bool platform_init ((uint64_t rsdp))
      (comment "Mask both legacy PICs: interrupts come through the APICs.")
      (call cpu_outb 0x21 0xFF)
      (call cpu_outb 0xA1 0xFF)
      (var uint64_t madt (call find_madt rsdp))
      (if (== madt 0)
        (block (call klog "APIC: MADT not found\n") (return false)))
      (var uint64_t lapic_phys (call read32 (+ madt 36)))
      (var uint32_t length (call read32 (+ madt 4)))
      (var uint32_t offset 44)
      (while (< (+ offset 2) length)
        (block
          (var uint8_t type (call read8 (+ madt offset)))
          (var uint8_t entry_length (call read8 (+ (+ madt offset) 1)))
          (if (< entry_length 2) break)
          (var uint64_t e (+ madt offset))
          (if (&& (== type 1) (< (. platform ioapic_count) MAX_IOAPICS))
            (block
              (= ([] (. platform ioapics) (. platform ioapic_count))
                 (compound IoApic (= (. id) (call read8 (+ e 2))) (= (. address) (call read32 (+ e 4))) (= (. gsi_base) (call read32 (+ e 8)))))
              (+= (. platform ioapic_count) 1)))
          (if (== type 2)
            (block
              (var uint32_t gsi (call read32 (+ e 4)))
              (var uint16_t flags (call read16 (+ e 8)))
              (if (< gsi 256)
                (= ([] (. platform overrides) gsi)
                   (compound SourceOverride (= (. present) true) (= (. isa_source) (call read8 (+ e 3)))
                     (= (. active_low) (== (& flags 3) 3)) (= (. level) (== (& (>> flags 2) 3) 3)))))))
          (if (== type 5) (= lapic_phys (call read64 (+ e 4))))
          (+= offset entry_length)))
      (= (. platform lapic) (+ hhdm_offset lapic_phys))
      (call klog "APIC: Found LAPIC at %#llx\n" (cast (unsigned long long) lapic_phys))
      (for (var uint32_t i 0) (< i (. platform ioapic_count)) (++ i)
        (call klog "APIC: Found I/O APIC %u at %#x\n" (. ([] (. platform ioapics) i) id) (. ([] (. platform ioapics) i) address)))
      (for (var uint32_t gsi 0) (< gsi 256) (++ gsi)
        (if (. ([] (. platform overrides) gsi) present)
          (call klog "APIC: ISO GSI %u <- ISA %u (active_low=%s, level=%s)\n" gsi (. ([] (. platform overrides) gsi) isa_source)
            (?: (. ([] (. platform overrides) gsi) active_low) "true" "false") (?: (. ([] (. platform overrides) gsi) level) "true" "false"))))
      (comment "Software-enable the local APIC with spurious vector 0xFF.")
      (call lapic_write LAPIC_SVR (| (call lapic_read LAPIC_SVR) 0x1FF))
      (call timer_init)
      (call ioapic_map 1 KEYBOARD_VECTOR)
      (return true))

    (comment "The i8042 controller as keyboard.rs sets it up: translation and the keyboard interrupt on, the keyboard clock enabled, scanning enabled. Bytes arriving before setup completes are drained and dropped by the interrupt handler.")
    (fn void keyboard_init (void)
      (if (== (call cpu_inb 0x64) 0xFF) (return))
      (call cpu_outb 0x64 0x20)
      (var uint8_t config (call cpu_inb 0x60))
      (if (== config 0xFF) (return))
      (|= config 0x41)
      (&= config (cast uint8_t (~ 0x10)))
      (call cpu_outb 0x64 0x60)
      (call cpu_outb 0x60 config)
      (call cpu_outb 0x64 0xAE)
      (call cpu_outb 0x60 0xF4)
      (call cpu_inb 0x60)
      (= (. kernel keyboard_ready) true))

    (comment "Read port 0x60 on every keyboard interrupt, so the controller can raise the next one; report the byte only once the keyboard is ready.")
    (fn bool keyboard_read ((uint8_t (* scancode)))
      (var uint8_t byte (call cpu_inb 0x60))
      (if (! (. kernel keyboard_ready)) (return false))
      (= (* scancode) byte)
      (return true))

    (fn (static uint32_t) pci_address ((uint8_t bus) (uint8_t dev) (uint8_t func) (uint8_t offset))
      (return (| 0x80000000u (| (<< (cast uint32_t bus) 16) (| (<< (cast uint32_t dev) 11) (| (<< (cast uint32_t func) 8) (& offset 0xFC)))))))

    (fn uint32_t pci_read ((uint8_t bus) (uint8_t dev) (uint8_t func) (uint8_t offset))
      (call cpu_outl 0xCF8 (call pci_address bus dev func offset))
      (return (call cpu_inl 0xCFC)))

    (fn void pci_write ((uint8_t bus) (uint8_t dev) (uint8_t func) (uint8_t offset) (uint32_t value))
      (call cpu_outl 0xCF8 (call pci_address bus dev func offset))
      (call cpu_outl 0xCFC value))

    (comment "A BAR's base: I/O BARs drop their two low bits, 64-bit memory BARs join the next register.")
    (fn uint64_t pci_bar ((uint8_t bus) (uint8_t dev) (uint8_t func) (uint8_t index))
      (var uint8_t offset (cast uint8_t (+ 0x10 (* index 4))))
      (var uint32_t bar (call pci_read bus dev func offset))
      (if (!= (& bar 1) 0) (return (& bar 0xFFFFFFFCu)))
      (if (== (& (>> bar 1) 3) 2)
        (return (| (<< (cast uint64_t (call pci_read bus dev func (cast uint8_t (+ offset 4)))) 32) (& bar 0xFFFFFFF0u))))
      (return (& bar 0xFFFFFFF0u)))

    (comment "Every present function, bus by bus, as hal/pci.rs::enumerate_bus lists them.")
    (fn uint32_t pci_scan ((PciFunction (* out)) (uint32_t max))
      (var uint32_t count 0)
      (for (var uint32_t bus 0) (< bus 256) (++ bus)
        (for (var uint32_t dev 0) (< dev 32) (++ dev)
          (block
            (if (== (& (call pci_read (cast uint8_t bus) (cast uint8_t dev) 0 0) 0xFFFF) 0xFFFF) continue)
            (for (var uint32_t func 0) (< func 8) (++ func)
              (block
                (var uint32_t id (call pci_read (cast uint8_t bus) (cast uint8_t dev) (cast uint8_t func) 0))
                (if (|| (== (& id 0xFFFF) 0xFFFF) (>= count max)) continue)
                (var uint32_t class_rev (call pci_read (cast uint8_t bus) (cast uint8_t dev) (cast uint8_t func) 8))
                (= ([] out count) (compound PciFunction (= (. bus) (cast uint8_t bus)) (= (. dev) (cast uint8_t dev)) (= (. func) (cast uint8_t func))
                  (= (. vendor_id) (cast uint16_t (& id 0xFFFF))) (= (. device_id) (cast uint16_t (>> id 16)))
                  (= (. class_id) (cast uint8_t (>> class_rev 24))) (= (. subclass_id) (cast uint8_t (>> class_rev 16)))
                  (= (. prog_if) (cast uint8_t (>> class_rev 8)))))
                (+= count 1))))))
      (return count))))
