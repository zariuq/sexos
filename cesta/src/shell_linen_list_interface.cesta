(cesta native-c/1 compact-c/2 (unit (native "#ifndef SEXOS_SHELL_LINEN_LIST_H\n#define SEXOS_SHELL_LINEN_LIST_H\n#include \"shell_text_delivery.h\"\nenum {SHELL_LINEN_LIST_CAPACITY=16,SHELL_LINEN_LIST_NAME_CAPACITY=126};\ntypedef struct ShellLinenListItem {uint64_t id;uint8_t name[126];size_t len;} ShellLinenListItem;\ntypedef struct ShellLinenItems {ShellLinenListItem items[16];size_t count;} ShellLinenItems;\ntypedef struct ShellLinenLine {uint8_t bytes[128];size_t len;} ShellLinenLine;\ntypedef struct ShellLinenList {ShellTextBytes text;size_t first,rows;bool has_selected;size_t selected_row;uint32_t row_y,row_h;} ShellLinenList;\nShellLinenList shell_linen_list(const ShellLinenItems *items,uint64_t selected,uint32_t width,uint32_t height);\n#endif\n")))
