        (?: list_ok 1u 0u) (?: list_ok "ok" "dispatch_fail"))
      (var bool open_ok (call dispatch sp (call cstr_slice "linen-open 1")))
      (call sexos_line "[spindle.linen.proof] stage=3 action=linen_open ok=%u reason=%s"
        (?: open_ok 1u 0u) (?: open_ok "ok" "dispatch_fail"))
      (var bool open_missing_ok (call dispatch sp (call cstr_slice "linen-open")))
      (call sexos_line "[spindle.linen.proof] stage=4 action=linen_open_missing ok=%u reason=%s"
        (?: open_missing_ok 1u 0u) (?: open_missing_ok "ok" "dispatch_fail"))
      (call sexos_line "[spindle.linen.proof] stage=5 action=safety ok=1 reason=no_blocking_async_enqueue_only")
      (var bool all_ok (&& (&& (&& status_ok list_ok) open_ok) open_missing_ok))
      (call sexos_line "[spindle.linen.proof.done] ok=%u" (?: all_ok 1u 0u)))

    (fn (static void) run_status_panel_proof ((Spindle (* sp)))
      (call sexos_line "[spindle.status.proof] stage=0 command=start ok=1")
      (var bool ok1 (call dispatch sp (call cstr_slice "status")))
      (call sexos_line "[spindle.status.proof] stage=1 command=status ok=%u" (?: ok1 1u 0u))
      (var bool ok2 (call dispatch sp (call cstr_slice "apps")))
      (call sexos_line "[spindle.status.proof] stage=2 command=apps ok=%u" (?: ok2 1u 0u))
      (var bool ok3 (call dispatch sp (call cstr_slice "blockers")))
