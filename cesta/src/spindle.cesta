(cesta native-c/1 compact-c/2
  (unit
    (include "sexos_server.h")
    (comment "Spindle command console server, translated from apps/spindle/src/main.rs. The Rust statics (scrollback, history, the 2x2 surface subgrid cache and the log budgets) and the locals of _start (the event ring and the vi-mode command line) are fields of one Spindle state in static storage (~116 KiB).")

    (comment "Build-time proof profiles: option_env! in the Rust source.")
    (cpp-if "defined(SEXOS_SPINDLE_APPS_REGISTRY_PROOF)" (then (define APPS_REGISTRY_PROOF_ENABLED "1")) (else (define APPS_REGISTRY_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_COMMAND_HISTORY_PROOF)" (then (define CMD_HISTORY_PROOF_ENABLED "1")) (else (define CMD_HISTORY_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_PERSIST_HISTORY_PROOF)" (then (define PERSIST_PROOF_ENABLED "1")) (else (define PERSIST_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_FILES_COMMANDS_PROOF)" (then (define FILES_COMMANDS_PROOF_ENABLED "1")) (else (define FILES_COMMANDS_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_BELL_BRIDGE_PROOF)" (then (define BELL_BRIDGE_PROOF_ENABLED "1")) (else (define BELL_BRIDGE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_LINEN_BRIDGE_PROOF)" (then (define LINEN_BRIDGE_PROOF_ENABLED "1")) (else (define LINEN_BRIDGE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_STATUS_PANEL_PROOF)" (then (define STATUS_PANEL_PROOF_ENABLED "1")) (else (define STATUS_PANEL_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_DAILY_SUMMARY_PROOF)" (then (define DAILY_SUMMARY_PROOF_ENABLED "1")) (else (define DAILY_SUMMARY_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_HELP_POLISH_PROOF)" (then (define HELP_POLISH_PROOF_ENABLED "1")) (else (define HELP_POLISH_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_ALIASES_PROOF)" (then (define SPINDLE_ALIASES_PROOF_ENABLED "1")) (else (define SPINDLE_ALIASES_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_APP_LAUNCH_COMMANDS_PROOF)" (then (define APP_LAUNCH_COMMANDS_PROOF_ENABLED "1")) (else (define APP_LAUNCH_COMMANDS_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_APP_LAUNCH_EXEC_PROOF)" (then (define SPINDLE_LAUNCH_EXEC_PROOF_ENABLED "1")) (else (define SPINDLE_LAUNCH_EXEC_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_APP_REGISTRY_STATIC_V2_PROOF)" (then (define APP_REGISTRY_STATIC_V2_PROOF_ENABLED "1")) (else (define APP_REGISTRY_STATIC_V2_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_LINEN_WORKFLOW_PROOF)" (then (define SPINDLE_LINEN_WORKFLOW_PROOF_ENABLED "1")) (else (define SPINDLE_LINEN_WORKFLOW_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_QUIL_WORKFLOW_PROOF)" (then (define SPINDLE_QUIL_WORKFLOW_PROOF_ENABLED "1")) (else (define SPINDLE_QUIL_WORKFLOW_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_EDITOR_V2_PROOF)" (then (define SPINDLE_EDITOR_V2_PROOF_ENABLED "1")) (else (define SPINDLE_EDITOR_V2_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_APP_LIFECYCLE_PROOF)" (then (define SPINDLE_APP_LIFECYCLE_PROOF_ENABLED "1")) (else (define SPINDLE_APP_LIFECYCLE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_LIFECYCLE_HELP_V2_PROOF)" (then (define SPINDLE_LIFECYCLE_HELP_V2_PROOF_ENABLED "1")) (else (define SPINDLE_LIFECYCLE_HELP_V2_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_EDITOR_STATUS_PROOF)" (then (define SPINDLE_EDITOR_STATUS_PROOF_ENABLED "1")) (else (define SPINDLE_EDITOR_STATUS_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_SEARCH_HELP_PROOF)" (then (define SPINDLE_SEARCH_HELP_PROOF_ENABLED "1")) (else (define SPINDLE_SEARCH_HELP_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_WINDOW_WORKFLOW_PROOF)" (then (define SPINDLE_WINDOW_WORKFLOW_PROOF_ENABLED "1")) (else (define SPINDLE_WINDOW_WORKFLOW_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_BROWSER_STUB_PROOF)" (then (define SPINDLE_BROWSER_STUB_PROOF_ENABLED "1")) (else (define SPINDLE_BROWSER_STUB_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_FRAME_CHROME_PROOF)" (then (define SPINDLE_FRAME_CHROME_PROOF_ENABLED "1")) (else (define SPINDLE_FRAME_CHROME_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_FRAME_RIM_PROOF)" (then (define SPINDLE_FRAME_RIM_PROOF_ENABLED "1")) (else (define SPINDLE_FRAME_RIM_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_FRAME_LIGHTS_PROOF)" (then (define SPINDLE_FRAME_LIGHTS_PROOF_ENABLED "1")) (else (define SPINDLE_FRAME_LIGHTS_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_ATLAS_PROOF)" (then (define SPINDLE_ATLAS_PROOF_ENABLED "1")) (else (define SPINDLE_ATLAS_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_EDITOR_QUALITY_PROOF)" (then (define SPINDLE_EDITOR_QUALITY_PROOF_ENABLED "1")) (else (define SPINDLE_EDITOR_QUALITY_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_EDITOR_POLISH_PROOF)" (then (define SPINDLE_EDITOR_POLISH_PROOF_ENABLED "1")) (else (define SPINDLE_EDITOR_POLISH_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_EDITOR_V3_PROOF)" (then (define SPINDLE_EDITOR_V3_PROOF_ENABLED "1")) (else (define SPINDLE_EDITOR_V3_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SPINDLE_EDITOR_FINISH_PROOF)" (then (define SPINDLE_EDITOR_FINISH_PROOF_ENABLED "1")) (else (define SPINDLE_EDITOR_FINISH_PROOF_ENABLED "0")))

    (define OP_HID_EVENT "UINT64_C(0x202)")
    (define OP_LINEN_LIST_OBJECTS "UINT64_C(0x42)")
    (define OP_LINEN_OPEN_INTENT "UINT64_C(0x46)")
    (define OP_LINEN_SEARCH_OBJECTS "UINT64_C(0x47)")
    (define OP_RAMFS_OPEN "UINT64_C(0x30)")
    (define OP_RAMFS_READ "UINT64_C(0x31)")
    (define OP_RAMFS_WRITE "UINT64_C(0x32)")
    (define OP_RAMFS_CLOSE "UINT64_C(0x33)")
    (define OP_RAMFS_LIST "UINT64_C(0x34)")
    (define RAMFS_O_CREATE "UINT64_C(0x01)")

    (define OP_DISKFS_WRITE_SPINDLE "UINT64_C(0x38)")
    (define OP_DISKFS_READ_SPINDLE "UINT64_C(0x39)")
    (define OP_DISKFS_STAT_SPINDLE "UINT64_C(0x3B)")
    (define OP_DISKFS_SELECT_SPINDLE "UINT64_C(0x3E)")
    (define OP_DISKFS_CREATE_SPINDLE "UINT64_C(0x42)")
    (define OP_DISKFS_LIST_SPINDLE "UINT64_C(0x43)")
    (define OP_DISKFS_DELETE_SPINDLE "UINT64_C(0x47)")
    (define OP_DISKFS_RENAME_SPINDLE "UINT64_C(0x48)")
    (define OP_DISKFS_TRUNCATE_SPINDLE "UINT64_C(0x49)")
    (define OP_DISKFS_READ_V2_SPINDLE "UINT64_C(0x4A)")
    (define DISKFS_V3_SLOTS_SPINDLE "UINT64_C(15)")
    (define DISKFS_V2_MAX_READ "UINT64_C(6)")
    (define DISKFS_V2_STATUS_OK "((uint8_t)0x00)")
    (define DISKFS_V2_STATUS_EOF "((uint8_t)0x01)")

    (define CONTENT_SID "UINT64_C(0x9A)")
    (define SURF_COLS "((size_t)20)")
    (define SURF_ROWS "((size_t)6)")
    (define SURF_BYTES "((size_t)120)")
    (define GRID_SURF_X "((size_t)2)")
    (define GRID_SURF_Y "((size_t)2)")
    (define GRID_SURFACES "((size_t)4)")
    (define GRID_COLS "((size_t)40)")
    (define GRID_ROWS "((size_t)12)")
    (define GRID_BYTES "((size_t)480)")
    (define SURF_W "UINT32_C(132)")
    (define SURF_H "UINT32_C(80)")
    (define GRID_X0 "1008")
    (define GRID_Y0 "632")
    (define CONTENT_TEXT_COLOR "UINT64_C(0x00E8FFFF)")

    (define CMD_MAX "((size_t)256)")
    (define MAX_HISTORY "((size_t)128)")
    (define HIST_LINE_BYTES "((size_t)256)")
    (define MAX_EVENTS "((size_t)32)")
    (define EV_BYTES "((size_t)80)")
    (define MAX_SCROLLBACK "((size_t)1024)")
    (define MAX_LINE_BYTES "((size_t)80)")

    (define VI_INSERT "((uint8_t)0)")
    (define VI_NORMAL "((uint8_t)1)")

    (define EV_CMD_OK "((uint8_t)0)")
    (define EV_CMD_FAIL "((uint8_t)1)")
    (define EV_CMD_UNKNOWN "((uint8_t)2)")
    (define EV_INFO "((uint8_t)3)")

    (var (static const uint64_t) ([] GRID_SIDS GRID_SURFACES) (init 0x9Au 0xA0u 0xA1u 0xA2u))
    (var (static const uint8_t) ([] HISTORY_FILE 15)
      (init 115 112 105 110 100 108 101 95 104 105 115 116 111 114 121))

    (typedef (struct ByteSlice ((const uint8_t) (* ptr)) (size_t len)) ByteSlice)
    (typedef (struct TokenPair (ByteSlice cmd) (ByteSlice args)) TokenPair)
    (typedef (struct CharText (char ([] text 2))) CharText)
    (typedef (struct SliceText (char ([] text 260))) SliceText)
    (typedef (struct DebugText (char ([] text 520))) DebugText)

    (typedef (struct CmdLine
      (uint8_t ([] buf CMD_MAX))
      (size_t len)
      (size_t cur)
      (uint8_t mode)
      (uint8_t ([] prev_buf CMD_MAX))
      (size_t prev_len)
      (bool pending_d)
      (bool has_hist_nav)
      (size_t hist_nav)
      (uint8_t ([] nav_saved CMD_MAX))
      (size_t nav_saved_len)) CmdLine)

    (typedef (struct History
      (uint8_t ([] ([] ring MAX_HISTORY) HIST_LINE_BYTES))
      (size_t write_pos)
      (uint32_t total)) History)

    (typedef (struct SpindleEvent
      (uint8_t kind)
      (uint8_t ([] line EV_BYTES))
      (uint8_t len)) SpindleEvent)

    (typedef (struct EventRing
      (SpindleEvent ([] e MAX_EVENTS))
      (size_t p)
      (uint32_t t)) EventRing)

    (typedef (struct Scrollback
      (uint8_t ([] ([] ring MAX_SCROLLBACK) MAX_LINE_BYTES))
      (size_t write_pos)
      (uint32_t total_lines)
      (uint32_t scroll_offset)) Scrollback)

    (typedef (struct Spindle
      (Scrollback sb)
      (History hist)
      (EventRing ev)
      (CmdLine line)
      (uint8_t ([] ([] grid_prev GRID_SURFACES) SURF_BYTES))
      (SexosListener listener)
      (uint32_t disk_hid_drop_budget)
      (uint32_t frame_budget)
      (uint32_t raw_budget)
      (uint32_t key_recv_budget)
      (uint32_t echo_budget)) Spindle)

    (var (static Spindle) spindle_state)

    (fn (static size_t) min_size ((size_t a) (size_t b)) (return (?: (< a b) a b)))
    (fn (static uint32_t) min_u32 ((uint32_t a) (uint32_t b)) (return (?: (< a b) a b)))
    (fn (static uint64_t) min_u64 ((uint64_t a) (uint64_t b)) (return (?: (< a b) a b)))
    (fn (static size_t) max_size ((size_t a) (size_t b)) (return (?: (> a b) a b)))
    (fn (static size_t) sat_sub_size ((size_t a) (size_t b)) (return (?: (> a b) (- a b) 0)))
    (fn (static uint32_t) sat_sub_u32 ((uint32_t a) (uint32_t b)) (return (?: (> a b) (- a b) 0u)))
    (fn (static uint32_t) sat_add_u32 ((uint32_t a) (uint32_t b))
      (return (?: (> a (- UINT32_MAX b)) UINT32_MAX (+ a b))))
    (fn (static uint32_t) sat_mul_u32 ((uint32_t a) (uint32_t b))
      (if (|| (== a 0u) (== b 0u)) (return 0u))
      (return (?: (> a (/ UINT32_MAX b)) UINT32_MAX (* a b))))
    (fn (static uint64_t) sat_mul_u64 ((uint64_t a) (uint64_t b))
      (if (|| (== a 0u) (== b 0u)) (return 0u))
      (return (?: (> a (/ UINT64_MAX b)) UINT64_MAX (* a b))))
    (fn (static uint64_t) sat_add_u64 ((uint64_t a) (uint64_t b))
      (return (?: (> a (- UINT64_MAX b)) UINT64_MAX (+ a b))))

    (fn (static bool) is_negative ((uint64_t word)) (return (!= (>> word 63) 0)))
    (fn (static int64_t) wrap_i64 ((uint64_t word))
      (return (?: (call is_negative word) (- (- (cast int64_t (~ word))) 1) (cast int64_t word))))

    (fn (static bool) take ((uint32_t (* budget)))
      (if (== (* budget) 0u) (return false))
      (-= (* budget) 1u)
      (return true))

    (fn (static CharText) char_text ((uint8_t ch))
      (return (compound CharText (= (. text) (init (cast char ch) 0)))))

    (fn (static ByteSlice) cstr_slice (((const char) (* s)))
      (return (compound ByteSlice (= (. ptr) (cast ((const uint8_t) *) s)) (= (. len) (call sexos_strlen s)))))

    (fn (static bool) slice_eq ((ByteSlice a) ((const char) (* b)))
      (var size_t blen (call sexos_strlen b))
      (if (!= (. a len) blen) (return false))
      (for (var size_t i 0) (< i blen) (++ i)
        (if (!= ([] (. a ptr) i) (cast uint8_t ([] b i))) (return false)))
      (return true))

    (fn (static bool) bytes_eq (((const uint8_t) (* a)) ((const uint8_t) (* b)) (size_t n))
      (for (var size_t i 0) (< i n) (++ i)
        (if (!= ([] a i) ([] b i)) (return false)))
      (return true))

    (fn (static SliceText) slice_to_text ((ByteSlice s))
      (var SliceText out (init 0))
      (var size_t n (call min_size (. s len) 256))
      (for (var size_t i 0) (< i n) (++ i)
        (block
          (var uint8_t b ([] (. s ptr) i))
          (if (>= b 0x80u)
            (return (compound SliceText (= (. text) (init 63 0)))))
          (= ([] (. out text) i) (cast char b))))
      (= ([] (. out text) n) 0)
      (return out))

    (fn (static DebugText) slice_to_debug ((ByteSlice s))
      (var DebugText out (init 0))
      (var size_t w 0)
      (= ([] (. out text) (post++ w)) 34)
      (var size_t n (call min_size (. s len) 256))
      (for (var size_t i 0) (< i n) (++ i)
        (block
          (var uint8_t b ([] (. s ptr) i))
          (if (|| (== b 34u) (== b 92u))
            (block
              (= ([] (. out text) (post++ w)) 92)
              (= ([] (. out text) (post++ w)) (cast char b)))
            (if (== b 9u)
              (block
                (= ([] (. out text) (post++ w)) 92)
                (= ([] (. out text) (post++ w)) 116))
              (= ([] (. out text) (post++ w)) (cast char b))))))
      (= ([] (. out text) (post++ w)) 34)
      (= ([] (. out text) w) 0)
      (return out))

    (fn (static void) spindle_init ((Spindle (* sp)))
      (var uint8_t (* raw) (cast (uint8_t *) sp))
      (for (var size_t i 0) (< i (sizeof (* sp))) (++ i) (= ([] raw i) 0))
      (for (var size_t i 0) (< i MAX_EVENTS) (++ i)
        (= (. ([] (. (-> sp ev) e) i) kind) EV_INFO))
      (= (. (-> sp listener) wrapper_budget) 8u)
      (= (-> sp disk_hid_drop_budget) 8u)
      (= (-> sp frame_budget) 8u)
      (= (-> sp raw_budget) 32u)
      (= (-> sp key_recv_budget) 64u)
      (= (-> sp echo_budget) 16u))

    (comment "CmdLine operations.")
    (fn (static void) cmdline_clear ((CmdLine (* line)))
      (= (-> line len) 0)
      (= (-> line cur) 0))

    (fn (static ByteSlice) cmdline_as_bytes (((const CmdLine) (* line)))
      (return (compound ByteSlice (= (. ptr) (-> line buf)) (= (. len) (-> line len)))))

    (fn (static void) cmdline_insert_at ((CmdLine (* line)) (size_t pos) (uint8_t b))
      (if (|| (>= (-> line len) CMD_MAX) (|| (> pos (-> line len)) (|| (< b 0x20u) (> b 0x7Eu))))
        (return))
      (var size_t i (-> line len))
      (while (> i pos)
        (block
          (= ([] (-> line buf) i) ([] (-> line buf) (- i 1)))
          (-= i 1)))
      (= ([] (-> line buf) pos) b)
      (+= (-> line len) 1)
      (= (-> line cur) (call min_size (+ pos 1) (-> line len))))

    (fn (static void) cmdline_delete_at ((CmdLine (* line)) (size_t pos))
      (if (>= pos (-> line len)) (return))
      (var size_t i pos)
      (while (< (+ i 1) (-> line len))
        (block
          (= ([] (-> line buf) i) ([] (-> line buf) (+ i 1)))
          (+= i 1)))
      (= ([] (-> line buf) (- (-> line len) 1)) 0)
      (-= (-> line len) 1)
      (if (> (-> line cur) (-> line len)) (= (-> line cur) (-> line len))))

    (fn (static void) cmdline_cursor_left ((CmdLine (* line)))
      (if (> (-> line cur) 0) (-= (-> line cur) 1)))

    (fn (static void) cmdline_cursor_right ((CmdLine (* line)))
      (if (< (-> line cur) (-> line len)) (+= (-> line cur) 1)))

    (fn (static void) cmdline_cursor_home ((CmdLine (* line)))
      (= (-> line cur) 0))

    (fn (static void) cmdline_word_fwd ((CmdLine (* line)))
      (var size_t c (-> line cur))
      (while (&& (< c (-> line len)) (!= ([] (-> line buf) c) 32u)) (+= c 1))
      (while (&& (< c (-> line len)) (== ([] (-> line buf) c) 32u)) (+= c 1))
      (= (-> line cur) c))

    (fn (static void) cmdline_word_back ((CmdLine (* line)))
      (var size_t c (-> line cur))
      (while (&& (> c 0) (== ([] (-> line buf) (- c 1)) 32u)) (-= c 1))
      (while (&& (> c 0) (!= ([] (-> line buf) (- c 1)) 32u)) (-= c 1))
      (= (-> line cur) c))

    (fn (static void) cmdline_word_end ((CmdLine (* line)))
      (if (>= (-> line cur) (-> line len)) (return))
      (var size_t c (+ (-> line cur) 1))
      (while (&& (< c (-> line len)) (== ([] (-> line buf) c) 32u)) (+= c 1))
      (while (&& (< (+ c 1) (-> line len)) (!= ([] (-> line buf) (+ c 1)) 32u)) (+= c 1))
      (= (-> line cur) (call min_size c (call sat_sub_size (-> line len) 1))))

    (fn (static void) cmdline_save_undo ((CmdLine (* line)))
      (for (var size_t i 0) (< i CMD_MAX) (++ i) (= ([] (-> line prev_buf) i) ([] (-> line buf) i)))
      (= (-> line prev_len) (-> line len)))

    (fn (static void) cmdline_undo ((CmdLine (* line)))
      (for (var size_t i 0) (< i CMD_MAX) (++ i) (= ([] (-> line buf) i) ([] (-> line prev_buf) i)))
      (= (-> line len) (-> line prev_len))
      (if (> (-> line cur) (-> line len)) (= (-> line cur) (-> line len))))

    (fn (static void) cmdline_set_from_slice ((CmdLine (* line)) (ByteSlice src))
      (var size_t n (call min_size (. src len) CMD_MAX))
      (for (var size_t i 0) (< i n) (++ i) (= ([] (-> line buf) i) ([] (. src ptr) i)))
      (for (var size_t i n) (< i CMD_MAX) (++ i) (= ([] (-> line buf) i) 0))
      (= (-> line len) n)
      (= (-> line cur) n))

    (fn (static void) cmdline_save_nav_snapshot ((CmdLine (* line)))
      (for (var size_t i 0) (< i (-> line len)) (++ i) (= ([] (-> line nav_saved) i) ([] (-> line buf) i)))
      (for (var size_t i (-> line len)) (< i CMD_MAX) (++ i) (= ([] (-> line nav_saved) i) 0))
      (= (-> line nav_saved_len) (-> line len)))

    (fn (static void) cmdline_restore_nav_snapshot ((CmdLine (* line)))
      (var size_t n (call min_size (-> line nav_saved_len) CMD_MAX))
      (var uint8_t ([] tmp CMD_MAX) (init 0))
      (for (var size_t i 0) (< i n) (++ i) (= ([] tmp i) ([] (-> line nav_saved) i)))
      (call cmdline_set_from_slice line (compound ByteSlice (= (. ptr) tmp) (= (. len) n))))

    (comment "Bounded command history ring.")
    (fn (static size_t) history_push ((History (* hist)) (ByteSlice line))
      (var size_t idx (-> hist write_pos))
      (var size_t n (call min_size (. line len) HIST_LINE_BYTES))
      (for (var size_t i 0) (< i n) (++ i) (= ([] ([] (-> hist ring) (-> hist write_pos)) i) ([] (. line ptr) i)))
      (for (var size_t i n) (< i HIST_LINE_BYTES) (++ i) (= ([] ([] (-> hist ring) (-> hist write_pos)) i) 0))
      (= (-> hist write_pos) (% (+ (-> hist write_pos) 1) MAX_HISTORY))
      (= (-> hist total) (call sat_add_u32 (-> hist total) 1u))
      (return idx))

    (fn (static bool) history_get (((const History) (* hist)) (size_t n) (ByteSlice (* out)))
      (if (|| (>= n (cast size_t (-> hist total))) (>= n MAX_HISTORY)) (return false))
      (var size_t idx (% (- (+ (-> hist write_pos) MAX_HISTORY) (+ 1 n)) MAX_HISTORY))
      (var (const uint8_t) (* raw) ([] (-> hist ring) idx))
      (var size_t len 0)
      (while (&& (< len HIST_LINE_BYTES) (!= ([] raw len) 0u)) (+= len 1))
      (= (* out) (compound ByteSlice (= (. ptr) raw) (= (. len) len)))
      (return true))

    (fn (static void) history_clear ((History (* hist)))
      (for (var size_t i 0) (< i MAX_HISTORY) (++ i)
        (for (var size_t j 0) (< j HIST_LINE_BYTES) (++ j)
          (= ([] ([] (-> hist ring) i) j) 0)))
      (= (-> hist write_pos) 0)
      (= (-> hist total) 0u))

    (fn (static bool) history_nav ((CmdLine (* line)) ((const History) (* hist)) (bool up))
      (var size_t count (call min_size (cast size_t (-> hist total)) MAX_HISTORY))
      (if (== count 0)
        (block
          (call sexos_line "[spindle.history.nav] dir=%s idx=0 len=0 ok=0" (?: up "up" "down"))
          (return false)))
      (if up
        (block
          (if (! (-> line has_hist_nav))
            (block
              (call cmdline_save_nav_snapshot line)
              (= (-> line has_hist_nav) true)
              (= (-> line hist_nav) 0))
            (if (< (+ (-> line hist_nav) 1) count)
              (+= (-> line hist_nav) 1)))
          (if (-> line has_hist_nav)
            (block
              (var size_t i (-> line hist_nav))
              (var ByteSlice entry)
              (if (call history_get hist i (& entry))
                (block
                  (call cmdline_set_from_slice line entry)
                  (call sexos_line "[spindle.history.nav] dir=up idx=%zu len=%zu ok=1" i (-> line len))
                  (return true)))))
          (call sexos_line "[spindle.history.nav] dir=up idx=0 len=%zu ok=0" (-> line len))
          (return false))
        (block
          (if (! (-> line has_hist_nav))
            (block
              (call sexos_line "[spindle.history.nav] dir=down idx=0 len=%zu ok=0" (-> line len))
              (return false)))
          (if (== (-> line hist_nav) 0)
            (block
              (= (-> line has_hist_nav) false)
              (call cmdline_restore_nav_snapshot line)
              (call sexos_line "[spindle.history.nav] dir=down idx=0 len=%zu ok=1" (-> line len))
              (return true)))
          (var size_t ni (- (-> line hist_nav) 1))
          (= (-> line hist_nav) ni)
          (var ByteSlice entry)
          (if (call history_get hist ni (& entry))
            (block
              (call cmdline_set_from_slice line entry)
              (call sexos_line "[spindle.history.nav] dir=down idx=%zu len=%zu ok=1" ni (-> line len))
              (return true)))
          (call sexos_line "[spindle.history.nav] dir=down idx=%zu len=%zu ok=0" ni (-> line len))
          (return false))))

    (fn (static bool) ghost_suffix (((const CmdLine) (* line)) ((const History) (* hist)) (uint8_t (* suffix_out)) (size_t (* slen_out)))
      (if (|| (== (-> line len) 0) (!= (-> line cur) (-> line len))) (return false))
      (var size_t count (call min_size (cast size_t (-> hist total)) MAX_HISTORY))
      (for (var size_t i 0) (< i count) (++ i)
        (block
          (var ByteSlice entry)
          (if (call history_get hist i (& entry))
            (if (&& (> (. entry len) (-> line len)) (call bytes_eq (. entry ptr) (-> line buf) (-> line len)))
              (block
                (var size_t slen (- (. entry len) (-> line len)))
                (for (var size_t j 0) (< j CMD_MAX) (++ j) (= ([] suffix_out j) 0))
                (for (var size_t j 0) (< j slen) (++ j) (= ([] suffix_out j) ([] (. entry ptr) (+ (-> line len) j))))
                (= (* slen_out) slen)
                (return true))))))
      (return false))

    (fn (static bool) ghost_accept ((CmdLine (* line)) ((const History) (* hist)))
      (var uint8_t ([] suffix CMD_MAX) (init 0))
      (var size_t slen 0)
      (if (call ghost_suffix line hist suffix (& slen))
        (block
          (for (var size_t i 0) (< i slen) (++ i)
            (call cmdline_insert_at line (-> line len) ([] suffix i)))
          (call sexos_line "[spindle.ghost.accept] len=%zu" slen)
          (return true)))
      (return false))

    (comment "Local event ring.")
    (fn (static void) event_ring_push ((EventRing (* ev)) (uint8_t k) (ByteSlice l))
      (var size_t n (call min_size (. l len) EV_BYTES))
      (var SpindleEvent (* r) (& ([] (-> ev e) (-> ev p))))
      (= (-> r kind) k)
      (for (var size_t i 0) (< i n) (++ i) (= ([] (-> r line) i) ([] (. l ptr) i)))
      (= (-> r len) (cast uint8_t n))
      (= (-> ev p) (% (+ (-> ev p) 1) MAX_EVENTS))
      (= (-> ev t) (call sat_add_u32 (-> ev t) 1u)))

    (fn (static bool) event_ring_get (((const EventRing) (* ev)) (size_t n) (SpindleEvent (* out)))
      (if (|| (>= n (cast size_t (-> ev t))) (>= n MAX_EVENTS)) (return false))
      (= (* out) ([] (-> ev e) (% (- (+ (-> ev p) MAX_EVENTS) (+ 1 n)) MAX_EVENTS)))
      (return true))

    (fn (static void) event_ring_clear ((EventRing (* ev)))
      (for (var size_t i 0) (< i MAX_EVENTS) (++ i)
        (block
          (= (. ([] (-> ev e) i) kind) EV_INFO)
          (for (var size_t j 0) (< j EV_BYTES) (++ j) (= ([] (. ([] (-> ev e) i) line) j) 0))
          (= (. ([] (-> ev e) i) len) 0u)))
      (= (-> ev p) 0)
      (= (-> ev t) 0u))

    (comment "Bounded scrollback ring.")
    (fn (static void) scrollback_clear ((Scrollback (* sb)))
      (for (var size_t i 0) (< i MAX_SCROLLBACK) (++ i)
        (for (var size_t j 0) (< j MAX_LINE_BYTES) (++ j)
          (= ([] ([] (-> sb ring) i) j) 0)))
      (= (-> sb write_pos) 0)
      (= (-> sb total_lines) 0u)
      (= (-> sb scroll_offset) 0u))

    (fn (static void) scrollback_push ((Scrollback (* sb)) (ByteSlice line))
      (var size_t n (call min_size (. line len) MAX_LINE_BYTES))
      (for (var size_t i 0) (< i n) (++ i) (= ([] ([] (-> sb ring) (-> sb write_pos)) i) ([] (. line ptr) i)))
      (for (var size_t i n) (< i MAX_LINE_BYTES) (++ i) (= ([] ([] (-> sb ring) (-> sb write_pos)) i) 0))
      (= (-> sb write_pos) (% (+ (-> sb write_pos) 1) MAX_SCROLLBACK))
      (= (-> sb total_lines) (call sat_add_u32 (-> sb total_lines) 1u))
      (if (> (-> sb scroll_offset) 0u)
        (= (-> sb scroll_offset) (call sat_sub_u32 (-> sb scroll_offset) 1u))))

    (fn (static void) sb_push_cstr ((Scrollback (* sb)) ((const char) (* s)))
      (call scrollback_push sb (call cstr_slice s)))

    (fn (static ByteSlice) scrollback_get (((const Scrollback) (* sb)) (size_t ring_idx))
      (var (const uint8_t) (* raw) ([] (-> sb ring) (% ring_idx MAX_SCROLLBACK)))
      (var size_t len 0)
      (while (&& (< len MAX_LINE_BYTES) (!= ([] raw len) 0u)) (+= len 1))
      (return (compound ByteSlice (= (. ptr) raw) (= (. len) len))))

    (fn (static TokenPair) tokenize ((ByteSlice line))
      (var size_t start 0)
      (while (&& (< start (. line len)) (== ([] (. line ptr) start) 32u)) (+= start 1))
      (var (const uint8_t) (* rem_ptr) (+ (. line ptr) start))
      (var size_t rem_len (- (. line len) start))
      (var size_t cmd_end 0)
      (while (&& (< cmd_end rem_len) (!= ([] rem_ptr cmd_end) 32u)) (+= cmd_end 1))
      (var ByteSlice cmd (compound ByteSlice (= (. ptr) rem_ptr) (= (. len) cmd_end)))
      (var size_t args_start cmd_end)
      (while (&& (< args_start rem_len) (== ([] rem_ptr args_start) 32u)) (+= args_start 1))
      (var ByteSlice args (compound ByteSlice (= (. ptr) (+ rem_ptr args_start)) (= (. len) (- rem_len args_start))))
      (return (compound TokenPair (= (. cmd) cmd) (= (. args) args))))

    (fn (static void) pack_doc_name ((ByteSlice name) (uint64_t (* lo_out)) (uint64_t (* hi_out)))
      (var uint64_t lo 0)
      (var uint64_t hi 0)
      (var size_t n (call min_size (. name len) 16))
      (for (var size_t i 0) (< i n) (++ i)
        (block
          (var uint64_t b (cast uint64_t ([] (. name ptr) i)))
          (if (< i 8)
            (|= lo (<< b (* i 8)))
            (|= hi (<< b (* (- i 8) 8))))))
      (= (* lo_out) lo)
      (= (* hi_out) hi))

    (fn (static bool) parse_doc_id ((ByteSlice args) (uint64_t (* id_out)))
      (var size_t pos 0)
      (while (&& (< pos (. args len)) (== ([] (. args ptr) pos) 32u)) (+= pos 1))
      (if (>= pos (. args len)) (return false))
      (var uint64_t v 0)
      (var bool any false)
      (for (var size_t i pos) (< i (. args len)) (++ i)
        (block
          (var uint8_t b ([] (. args ptr) i))
          (if (== b 32u) break)
          (if (|| (< b 48u) (> b 57u)) (return false))
          (= v (+ (* v 10u) (cast uint64_t (- b 48u))))
          (= any true)))
      (if (! any) (return false))
      (= (* id_out) v)
      (return true))

    (fn (static uint8_t) diskfs_v2_status ((uint64_t reply))
      (return (cast uint8_t (& (>> reply 56) 0xFFu))))

    (fn (static uint8_t) diskfs_v2_len_field ((uint64_t reply))
      (return (cast uint8_t (& (>> reply 48) 0xFFu))))

    (fn (static void) spindle_storage_settle (void)
      (var uint32_t quiet 0)
      (var uint32_t total 0)
      (var uint32_t eaten 0)
      (while (&& (< quiet 8000u) (< total 200000u))
        (block
          (var SexosMessage msg)
          (if (call sexos_try_listen 0 (& msg))
            (block
              (= quiet 0u)
              (+= eaten 1u)
              (if (&& (!= (. msg type_id) 0x1u) (!= (. msg type_id) OP_HID_EVENT))
                (cast void (call sexos_reply (. msg caller_pd) 0))))
            (+= quiet 1u))
          (+= total 1u)))
      (call sexos_line "[spindle.disk.settle] eaten=%u" eaten))

    (fn (static bool) spindle_storage_sync ((Spindle (* sp)) (uint64_t op) (uint64_t a0) (uint64_t a1) (uint64_t a2) (uint64_t (* ok_out)) (int64_t (* err_out)))
      (var uint32_t tries 0)
      (while 1
        (block
          (var SexosReply r (call sexos_pdx_call SEXOS_SLOT_storage op a0 a1 a2))
          (if (== (. r status) 0u) break)
          (+= tries 1u)
          (if (>= tries 32u)
            (block
              (call sexos_line "[spindle.disk.enqueue.fail] op=%#llx status=%#llx"
                (cast (unsigned long long) op) (cast (unsigned long long) (. r status)))
              (= (* err_out) (call wrap_i64 (. r status)))
              (return false)))
          (call sexos_yield)))
      (var uint32_t msgs 0)
      (var uint32_t polls 0)
      (while 1
        (block
          (var SexosMessage msg)
          (if (! (call sexos_try_listen 0 (& msg)))
            (block
              (+= polls 1u)
              (if (>= polls 300000u)
                (block
                  (call sexos_line "[spindle.disk.reply.timeout] op=%#llx" (cast (unsigned long long) op))
                  (= (* err_out) (- 101))
                  (return false)))
              continue))
          (if (== (. msg type_id) 0x1u)
            (block
              (var int64_t v (call wrap_i64 (. msg arg0)))
              (if (< v 0)
                (block
                  (= (* err_out) v)
                  (return false)))
              (= (* ok_out) (. msg arg0))
              (return true)))
          (if (== (. msg type_id) OP_HID_EVENT)
            (block
              (if (call take (& (-> sp disk_hid_drop_budget)))
                (call sexos_line "[spindle.disk.hid.drop] code=%#llx" (cast (unsigned long long) (. msg arg0)))))
            (cast void (call sexos_reply (. msg caller_pd) 0)))
          (+= msgs 1u)
          (if (>= msgs 64u)
            (block
              (= (* err_out) (- 100))
              (return false))))))

    (fn (static void) spindle_grid_create (void)
      (for (var size_t si 0) (< si GRID_SURFACES) (++ si)
        (block
          (var int32_t sx (+ GRID_X0 (* (cast int32_t (% si GRID_SURF_X)) (cast int32_t SURF_W))))
          (var int32_t sy (+ GRID_Y0 (* (cast int32_t (/ si GRID_SURF_X)) (cast int32_t SURF_H))))
          (var uint64_t a1 (| (<< (cast uint64_t (cast uint32_t sy)) 32) (& (cast uint64_t (cast uint32_t sx)) 0xFFFFFFFFu)))
          (var uint64_t a2 (| (<< (cast uint64_t SURF_H) 32) (cast uint64_t SURF_W)))
          (var SexosReply r (call sexos_pdx_call SEXOS_SLOT_display 0xECu ([] GRID_SIDS si) a1 a2))
          (call sexos_line "[spindle.grid.surface.ok] sid=%llu idx=%zu"
            (cast (unsigned long long) ([] GRID_SIDS si)) si)
          (if (== si 0)
            (call sexos_line "[spindle.surface.create.ok] sid=%llu status=%llu"
              (cast (unsigned long long) CONTENT_SID) (cast (unsigned long long) (. r status)))))))

    (fn (static void) spindle_grid_destroy (void)
      (for (var size_t si 0) (< si GRID_SURFACES) (++ si)
        (cast void (call sexos_pdx_call SEXOS_SLOT_display 0xEEu ([] GRID_SIDS si) 0 0)))
      (call sexos_line "[spindle.grid.destroy.ok] surfaces=%zu" GRID_SURFACES))

    (fn (static bool) persist_history (((const History) (* hist)))
      (var uint64_t n0 0)
      (var uint64_t n1 0)
      (var uint64_t n2 0)
      (for (var size_t i 0) (< i 15) (++ i)
        (block
          (var uint64_t b (cast uint64_t ([] HISTORY_FILE i)))
          (if (< i 8)
            (|= n0 (<< b (* i 8)))
            (|= n1 (<< b (* (- i 8) 8))))))
      (var uint64_t flags (<< RAMFS_O_CREATE 24))
      (cast void (call sexos_pdx_call SEXOS_SLOT_storage OP_RAMFS_OPEN n0 n1 (| n2 flags)))
      (call sexos_line "[spindle.sexfiles.open] file=\"spindle_history\"")
      (var uint32_t count (call min_u32 (-> hist total) 128u))
      (var uint64_t global_offset 0)
      (for (var size_t i 0) (< i (cast size_t count)) (++ i)
        (block
          (var ByteSlice entry)
          (if (call history_get hist i (& entry))
            (block
              (var size_t chunks (/ (+ (. entry len) 7) 8))
              (for (var size_t c 0) (< c chunks) (++ c)
                (block
                  (var uint64_t chunk 0)
                  (var size_t base (* c 8))
                  (var size_t rem (call min_size 8 (call sat_sub_size (. entry len) base)))
                  (for (var size_t j 0) (< j rem) (++ j)
                    (|= chunk (<< (cast uint64_t ([] (. entry ptr) (+ base j))) (* j 8))))
                  (cast void (call sexos_pdx_call SEXOS_SLOT_storage OP_RAMFS_WRITE 0 global_offset chunk))
                  (+= global_offset 8u)))))))
      (cast void (call sexos_pdx_call SEXOS_SLOT_storage OP_RAMFS_CLOSE 0 0 0))
      (call sexos_line "[spindle.history.save] count=%u ok=1 reason=ramfs_fire_and_forget" count)
      (return true))

    (fn (static uint32_t) restore_history ((History (* hist)))
      (cast void hist)
      (var uint64_t n0 0)
      (var uint64_t n1 0)
      (var uint64_t n2 0)
      (for (var size_t i 0) (< i 15) (++ i)
        (block
          (var uint64_t b (cast uint64_t ([] HISTORY_FILE i)))
          (if (< i 8)
            (|= n0 (<< b (* i 8)))
            (|= n1 (<< b (* (- i 8) 8))))))
      (cast void (call sexos_pdx_call SEXOS_SLOT_storage OP_RAMFS_OPEN n0 n1 n2))
      (cast void (call sexos_pdx_call SEXOS_SLOT_storage OP_RAMFS_CLOSE 0 0 0))
      (call sexos_line "[spindle.history.load] count=0 ok=1 reason=async_limited_sync_readback_unavailable")
      (return 0u))

    (fn (static void) surf_flush ((uint64_t sid) ((const uint8_t) (* sub)))
      (cast void (call sexos_pdx_call SEXOS_SLOT_display 0xFAu sid 0 0))
      (var size_t c (/ SURF_BYTES 8))
      (while (> c 0)
        (block
          (-= c 1)
          (var size_t off (* c 8))
          (var uint64_t packed 0)
          (for (var size_t i 0) (< i 8) (++ i)
            (|= packed (<< (cast uint64_t ([] sub (+ off i))) (* i 8))))
          (var uint64_t a2 (| (| (cast uint64_t off) (<< (cast uint64_t 8u) 8)) (<< CONTENT_TEXT_COLOR 32)))
          (cast void (call sexos_pdx_call SEXOS_SLOT_display 0xFBu sid packed a2)))))

    (fn (static void) content_render ((Spindle (* sp)))
      (var uint8_t ([] grid GRID_BYTES))
      (for (var size_t i 0) (< i GRID_BYTES) (++ i) (= ([] grid i) 0x20u))
      (var size_t total (cast size_t (. (-> sp sb) total_lines)))
      (var size_t avail (call min_size total (- GRID_ROWS 1)))
      (var size_t end (call max_size (call sat_sub_size total (cast size_t (. (-> sp sb) scroll_offset))) avail))
      (var size_t start (- end avail))
      (for (var size_t r 0) (< r avail) (++ r)
        (block
          (var size_t line_idx (+ start r))
          (var ByteSlice src (call scrollback_get (& (-> sp sb)) (% line_idx MAX_SCROLLBACK)))
          (var size_t n (call min_size (. src len) GRID_COLS))
          (var size_t dst (* (+ (- (- GRID_ROWS 1) avail) r) GRID_COLS))
          (for (var size_t i 0) (< i n) (++ i) (= ([] grid (+ dst i)) ([] (. src ptr) i)))))
      (var size_t prow (* (- GRID_ROWS 1) GRID_COLS))
      (= ([] grid prow) 62u)
      (var ByteSlice lb (call cmdline_as_bytes (& (-> sp line))))
      (var size_t vis (call min_size (. lb len) (- GRID_COLS 2)))
      (var size_t lstart (- (. lb len) vis))
      (for (var size_t i 0) (< i vis) (++ i) (= ([] grid (+ (+ prow 2) i)) ([] (. lb ptr) (+ lstart i))))
      (var uint32_t flushed 0)
      (for (var size_t s 0) (< s GRID_SURFACES) (++ s)
        (block
          (var size_t band (/ s GRID_SURF_X))
          (var size_t half (% s GRID_SURF_X))
          (var uint8_t ([] sub SURF_BYTES))
          (for (var size_t row 0) (< row SURF_ROWS) (++ row)
            (block
              (var size_t goff (+ (* (+ (* band SURF_ROWS) row) GRID_COLS) (* half SURF_COLS)))
              (for (var size_t col 0) (< col SURF_COLS) (++ col)
                (= ([] sub (+ (* row SURF_COLS) col)) ([] grid (+ goff col))))))
          (if (! (call bytes_eq sub ([] (-> sp grid_prev) s) SURF_BYTES))
            (block
              (for (var size_t i 0) (< i SURF_BYTES) (++ i) (= ([] ([] (-> sp grid_prev) s) i) ([] sub i)))
              (call surf_flush ([] GRID_SIDS s) sub)
              (+= flushed 1u)))))
      (if (&& (> flushed 0u) (call take (& (-> sp frame_budget))))
        (call sexos_line "[spindle.grid.render.ok] cols=%zu rows=%zu surfaces=%zu"
          GRID_COLS GRID_ROWS GRID_SURFACES)))

    (fn (static bool) dispatch ((Spindle (* sp)) (ByteSlice line))
      (var Scrollback (* sb) (& (-> sp sb)))
      (var History (* hist) (& (-> sp hist)))
      (var EventRing (* ev) (& (-> sp ev)))
      (var TokenPair tp (call tokenize line))
      (var ByteSlice raw_cmd (. tp cmd))
      (var ByteSlice args (. tp args))
      (var ByteSlice cmd raw_cmd)
      (if (call slice_eq raw_cmd "d")
        (block
          (= cmd (call cstr_slice "daily"))
          (call sexos_line "[spindle.alias.exec] alias=d target=daily ok=1"))
        (if (call slice_eq raw_cmd "b")
          (block
            (= cmd (call cstr_slice "blockers"))
            (call sexos_line "[spindle.alias.exec] alias=b target=blockers ok=1"))
          (if (call slice_eq raw_cmd "k")
            (block
              (= cmd (call cstr_slice "keys"))
              (call sexos_line "[spindle.alias.exec] alias=k target=keys ok=1"))
            (if (call slice_eq raw_cmd "a")
              (block
                (= cmd (call cstr_slice "apps"))
                (call sexos_line "[spindle.alias.exec] alias=a target=apps ok=1"))
              (if (call slice_eq raw_cmd "q")
                (block
                  (= cmd (call cstr_slice "status"))
                  (call sexos_line "[spindle.alias.exec] alias=q target=status ok=1"))
                (if (call slice_eq raw_cmd "n")
                  (block
                    (= cmd (call cstr_slice "notify"))
                    (call sexos_line "[spindle.alias.exec] alias=n target=notify ok=1")
                    (call sexos_line "[spindle.alias.notify.len] len=%zu ok=1" (. args len)))))))))
      (if SPINDLE_ALIASES_PROOF_ENABLED
        (call sexos_line "[spindle.alias.proof.summary] alias_count=6 ok=1"))
      (if (== (. cmd len) 0) (return true))
      (var bool recognized false)
      (if (call slice_eq cmd "help")
        (block
          (call sexos_line "[spindle.help.section] name=basics commands=6")
          (call sb_push_cstr sb "--- Basics ---")
          (call sb_push_cstr sb "  help         show this help")
          (call sb_push_cstr sb "  clear        clear scrollback")
          (call sb_push_cstr sb "  echo <msg>   print message")
          (call sb_push_cstr sb "  about        Spindle version + identity")
          (call sb_push_cstr sb "  route        input/surface route info")
          (call sb_push_cstr sb "  close        session lifecycle status")
          (call sexos_line "[spindle.help.command] name=help ok=1")
          (call sexos_line "[spindle.help.command] name=clear ok=1")
          (call sexos_line "[spindle.help.command] name=echo ok=1")
          (call sexos_line "[spindle.help.command] name=about ok=1")
          (call sexos_line "[spindle.help.command] name=route ok=1")
          (call sexos_line "[spindle.help.command] name=close ok=1")
          (call sexos_line "[spindle.help.section] name=status_audit commands=8")
          (call sb_push_cstr sb "--- Status & Audit ---")
          (call sb_push_cstr sb "  status       keyboard control center overview")
          (call sb_push_cstr sb "  apps         app keyboard readiness table")
          (call sb_push_cstr sb "  blockers     known V1 limitations")
          (call sb_push_cstr sb "  keys         keyboard proven path summary")
          (call sb_push_cstr sb "  daily        daily-driver boot summary")
          (call sb_push_cstr sb "  pd           list protection domains")
          (call sb_push_cstr sb "  servers      list known servers")
          (call sb_push_cstr sb "  input        keyboard input status")
          (call sexos_line "[spindle.help.command] name=status ok=1")
          (call sexos_line "[spindle.help.command] name=apps ok=1")
          (call sexos_line "[spindle.help.command] name=blockers ok=1")
          (call sexos_line "[spindle.help.command] name=keys ok=1")
          (call sexos_line "[spindle.help.command] name=daily ok=1")
          (call sexos_line "[spindle.help.command] name=pd ok=1")
          (call sexos_line "[spindle.help.command] name=servers ok=1")
          (call sexos_line "[spindle.help.command] name=input ok=1")
          (call sexos_line "[spindle.help.section] name=history_events commands=4")
          (call sb_push_cstr sb "--- History & Events ---")
          (call sb_push_cstr sb "  history      show command history")
          (call sb_push_cstr sb "  history clr  clear command history")
          (call sb_push_cstr sb "  events       show event log")
          (call sb_push_cstr sb "  events clr   clear event log")
          (call sexos_line "[spindle.help.command] name=history ok=1")
          (call sexos_line "[spindle.help.command] name=history_clear ok=1")
          (call sexos_line "[spindle.help.command] name=events ok=1")
          (call sexos_line "[spindle.help.command] name=events_clear ok=1")
          (call sexos_line "[spindle.help.section] name=storage commands=3")
          (call sb_push_cstr sb "--- Storage (SexFiles) ---")
          (call sb_push_cstr sb "  save         persist history (async fire-and-forget)")
          (call sb_push_cstr sb "  load         restore history (async-limited)")
          (call sb_push_cstr sb "  ls           list SexFiles objects (async-limited)")
          (call sexos_line "[spindle.help.command] name=save ok=1")
