                            (call sexos_line "[spindle.atlas.command] name=atlas ok=1 reason=status_overview")
                            (= recognized true))
                          (if (call slice_eq cmd "frame-chrome")
                            (block
                              (call sb_push_cstr sb "Frame Chrome Model: Scene->Frame->Tab->Surface")
                              (call sb_push_cstr sb "  Silk chrome state: hidden/rim_only/tab_visible/tab_strip/minimized_card/zoomed")
                              (call sb_push_cstr sb "  Current: tab_visible (Spindle, Quil, Linen)")
                              (call sb_push_cstr sb "  close_allowed=0 (core apps not disposable)")
                              (call sb_push_cstr sb "  Hover tab: deferred until pointer stability")
                              (call sb_push_cstr sb "  Visual rim: future Phase 3")
                              (call sb_push_cstr sb "  Atlas scene: future Phase 7")
                              (call sexos_line "[spindle.frame.chrome.command] name=frame-chrome ok=1 reason=model_overview")
                              (= recognized true))
                            (if (call slice_eq cmd "frame-lights")
                              (block
                                (call sb_push_cstr sb "Frame Lights -- keyboard actions (no pointer):")
                                (call sb_push_cstr sb "  Red:    close tab -- DISABLED (close_allowed=0)")
                                (call sb_push_cstr sb "  Yellow: minimize -- Enter key (AccessActivate)")
                                (call sb_push_cstr sb "  Green:  zoom     -- Esc key (AccessZoomToggle)")
                                (call sb_push_cstr sb "  Key mapping: Enter=minimize/restore, Esc=zoom/unzoom")
                                (call sb_push_cstr sb "  Red disabled: no close key mapping, pointer=0")
                                (call sb_push_cstr sb "  Visual: rendered (dim close, normal yellow/green)")
                                (call sb_push_cstr sb "  Use frame-lights-keys for keyboard dispatch detail.")
                                (call sexos_line "[spindle.frame.lights.command] name=frame-lights ok=1 reason=status_overview")
                                (= recognized true))
                              (if (call slice_eq cmd "frame-lights-keys")
                                (block
                                  (call sb_push_cstr sb "Frame Lights Keyboard Dispatch:")
                                  (call sb_push_cstr sb "  Yellow minimize/restore:")
                                  (call sb_push_cstr sb "    Key: Enter (scancode 0x1C)")
                                  (call sb_push_cstr sb "    Action: SurfaceAction::AccessActivate")
                                  (call sb_push_cstr sb "    Dispatch: toggle_minimize_focused_frame()")
                                  (call sb_push_cstr sb "    Mapped to FRAME_LIGHT_MINIMIZE=2")
                                  (call sb_push_cstr sb "  Green zoom/unzoom:")
                                  (call sb_push_cstr sb "    Key: Esc (scancode 0x01)")
                                  (call sb_push_cstr sb "    Action: SurfaceAction::AccessZoomToggle")
                                  (call sb_push_cstr sb "    Dispatch: toggle_zoom_focused_frame()")
                                  (call sb_push_cstr sb "    Mapped to FRAME_LIGHT_ZOOM=3")
                                  (call sb_push_cstr sb "  Red close -- DISABLED:")
                                  (call sb_push_cstr sb "    Key: F11 (scancode 0x57) mapped to SurfaceAction::AccessClose")
                                  (call sb_push_cstr sb "    Dispatch: close_focused_tab_or_frame_safe()")
                                  (call sb_push_cstr sb "    Blocked: close_allowed=0, no disposable surfaces")
                                  (call sb_push_cstr sb "    Mapped to FRAME_LIGHT_CLOSE=1 (ok=0)")
                                  (call sb_push_cstr sb "  pointer=0 click=0 hover=0 -- keyboard only.")
                                  (call sexos_line "[spindle.frame.lights.keys.command] name=frame-lights-keys ok=1 reason=keyboard_dispatch_detail")
                                  (= recognized true))
                                (if (call slice_eq cmd "frame-rim")
                                  (block
                                    (call sb_push_cstr sb "Frame Rim -- model/proof only (no visual render):")
                                    (call sb_push_cstr sb "  Frame 0 Spindle: rim=focused intensity=2 (active)")
                                    (call sb_push_cstr sb "  Frame 1 Quil:    rim=dim intensity=1 (background)")
                                    (call sb_push_cstr sb "  Frame 2 Linen:   rim=dim intensity=1 (background)")
                                    (call sb_push_cstr sb "  render_allowed=0 (future Phase 3)")
                                    (call sb_push_cstr sb "  Rim states: hidden/dim/focused/urgent/minimized/zoomed")
                                    (call sb_push_cstr sb "  No pointer hover. No alpha/blur/shadow.")
                                    (call sexos_line "[spindle.frame.rim.command] name=frame-rim ok=1 reason=rim_state_overview")
                                    (= recognized true))
                                  (if (call slice_eq cmd "scene-status")
                                    (block
                                      (call sb_push_cstr sb "Scene Status: Workspace (scene=0)")
                                      (call sb_push_cstr sb "  active=1  frames=3")
                                      (call sb_push_cstr sb "  Frame 0: Spindle (focused)")
                                      (call sb_push_cstr sb "  Frame 1: Quil")
                                      (call sb_push_cstr sb "  Frame 2: Linen")
                                      (call sb_push_cstr sb "Chrome: tab_visible on all frames.")
                                      (call sexos_line "[spindle.frame.chrome.command] name=scene-status ok=1 reason=scene_summary")
                                      (= recognized true))
                                    (if (call slice_eq cmd "scene-lifecycle")
                                      (block
                                        (call sb_push_cstr sb "Scene Lifecycle -- marker-only (no switching, no visuals):")
                                        (call sb_push_cstr sb "  Workspace (scene=0): state=active frames=3")
                                        (call sb_push_cstr sb "  Lifecycle states:")
                                        (call sb_push_cstr sb "    active        = 1 (default workspace)")
                                        (call sb_push_cstr sb "    ready         = 1 (active implies ready)")
                                        (call sb_push_cstr sb "    inactive      = 0 (single scene, always active)")
                                        (call sb_push_cstr sb "    empty         = 0 (has 3 frames)")
                                        (call sb_push_cstr sb "    has_minimized = 0 (none minimized at boot)")
                                        (call sb_push_cstr sb "    has_urgent    = 0 (no Bell urgency at boot)")
                                        (call sb_push_cstr sb "    blocked       = 0")
                                        (call sb_push_cstr sb "    overview_only = 0")
                                        (call sb_push_cstr sb "  switching=0 visual=0 pointer=0")
                                        (call sb_push_cstr sb "  Use scene-lifecycle-status for summary.")
                                        (call sexos_line "[spindle.scene.lifecycle.command] name=scene-lifecycle ok=1 reason=lifecycle_state_list")
                                        (= recognized true))
                                      (if (call slice_eq cmd "scene-lifecycle-status")
                                        (block
                                          (call sb_push_cstr sb "Scene Lifecycle Summary:")
                                          (call sb_push_cstr sb "  scenes=1 active=1 ready=1")
                                          (call sb_push_cstr sb "  minimized=0 urgent=0 switching=0")
                                          (call sb_push_cstr sb "  visual=0 pointer=0 -- marker-only, no visuals.")
                                          (call sb_push_cstr sb "  No scene switching support.")
                                          (call sb_push_cstr sb "  Derived from existing Frame and Atlas model.")
                                          (call sexos_line "[spindle.scene.lifecycle.command] name=scene-lifecycle-status ok=1 reason=lifecycle_summary")
                                          (= recognized true))
                                        (if (call slice_eq cmd "scene-keys")
                                          (block
                                            (call sb_push_cstr sb "Scene Keyboard Switch -- blocked (single scene):")
                                            (call sb_push_cstr sb "  Keys: Ctrl+Right (next), Ctrl+Left (prev)")
                                            (call sb_push_cstr sb "  Deferred binding: SurfaceAction::AccessSceneNext/Prev")
                                            (call sb_push_cstr sb "  Status: BLOCKED -- only 1 scene (Workspace)")
                                            (call sb_push_cstr sb "  Switching requires >= 2 active scenes.")
                                            (call sb_push_cstr sb "  scene_count=1 switched=0 blocked=3")
                                            (call sb_push_cstr sb "  No state change. visual=0 pointer=0.")
                                            (call sb_push_cstr sb "  Use scene-switch-status for summary.")
                                            (call sexos_line "[spindle.scene.keys.command] name=scene-keys ok=1 reason=blocked_single_scene")
                                            (= recognized true))
                                          (if (call slice_eq cmd "scene-switch-status")
                                            (block
                                              (call sb_push_cstr sb "Scene Switch Summary:")
                                              (call sb_push_cstr sb "  scene_count=1 (Workspace only)")
                                              (call sb_push_cstr sb "  keyboard bindings: deferred (AccessSceneNext/Prev)")
                                              (call sb_push_cstr sb "  next/prev requests: accepted but blocked (idempotent)")
                                              (call sb_push_cstr sb "  switched=0 blocked=3 visual=0 pointer=0")
                                              (call sb_push_cstr sb "  Multi-scene switching: future phase.")
                                              (call sexos_line "[spindle.scene.keys.command] name=scene-switch-status ok=1 reason=switch_summary")
                                              (= recognized true))
                                            (if (call slice_eq cmd "windows")
                                              (block
                                                (call sb_push_cstr sb "Window Workflow -- shell-owned actions:")
                                                (call sb_push_cstr sb "  focus_next/prev  cycle active window focus")
                                                (call sb_push_cstr sb "  minimize/restore hide/show windows")
                                                (call sb_push_cstr sb "  zoom/unzoom      frame resize")
                                                (call sb_push_cstr sb "  close            only safe for disposable surfaces")
                                                (call sb_push_cstr sb "  focus-help        key bindings for window control")
                                                (call sb_push_cstr sb "All actions executed by silk-shell, not Spindle.")
                                                (call sb_push_cstr sb "Spindle has no SLOT_SHELL route for execution.")
                                                (call sexos_line "[spindle.window.command] name=windows ok=1 reason=help_rendered")
                                                (= recognized true))
                                              (if (call slice_eq cmd "focus-help")
                                                (block
                                                  (call sb_push_cstr sb "Window Focus -- shell-owned, keyboard-driven:")
                                                  (call sb_push_cstr sb "  Alt+digit  focus app by launcher slot")
                                                  (call sb_push_cstr sb "  Alt+Tab    cycle focus next (planned)")
                                                  (call sb_push_cstr sb "  Alt+F4     close focused window")
                                                  (call sb_push_cstr sb "  Alt+Z      zoom focused window")
                                                  (call sb_push_cstr sb "  Alt+M      minimize focused window")
                                                  (call sb_push_cstr sb "Spindle: help only. No remote focus capability.")
                                                  (call sexos_line "[spindle.window.command] name=focus-help ok=1 reason=keybindings_help")
                                                  (= recognized true))
                                                (if (call slice_eq cmd "window-keys")
                                                  (block
                                                    (call sb_push_cstr sb "Window Keys -- silk-shell keyboard dispatch:")
                                                    (call sb_push_cstr sb "  Alt+F4 close  Alt+Z zoom  Alt+M minimize")
                                                    (call sb_push_cstr sb "  Ctrl+arrows   scene switch")
                                                    (call sb_push_cstr sb "  F8/F9/F10     Bell/Quil/Atlas toggles")
                                                    (call sb_push_cstr sb "  backtick      command palette")
                                                    (call sb_push_cstr sb "All keys routed through silk-shell input handler.")
                                                    (call sexos_line "[spindle.window.command] name=window-keys ok=1 reason=keybindings_list")
                                                    (= recognized true))
                                                  (if (call slice_eq cmd "search")
                                                    (block
                                                      (call sb_push_cstr sb "Search/Find Help V3:")
                                                      (call sb_push_cstr sb "  Quil find:     buffer scan, 32-byte query (V10)")
                                                      (call sb_push_cstr sb "  Quil find-nav: next/prev over last query (V12)")
                                                      (call sb_push_cstr sb "  Quil select:   copy to clipboard, delete selection (V12)")
                                                      (call sb_push_cstr sb "  Quil dirty:    dirty flag, cleared on save (V12)")
                                                      (call sb_push_cstr sb "  Quil stats:    bytes/lines/words/cursor (V11)")
                                                      (call sb_push_cstr sb "  Quil word:     word-left/right nav (V11)")
                                                      (call sb_push_cstr sb "  Quil mod:      shift tracking, lowercase (V11)")
                                                      (call sb_push_cstr sb "  Linen search:  ABI-blocked (OP_LINEN_SEARCH_OBJECTS=0x47)")
                                                      (call sb_push_cstr sb "See: object-search, linen-search, edit-help, edit-status.")
                                                      (call sexos_line "[spindle.editor.polish.help] ok=1 commands=8")
                                                      (= recognized true))
                                                    (if (call slice_eq cmd "linen-search")
                                                      (block
                                                        (if (== (. args len) 0)
                                                          (block
                                                            (call sb_push_cstr sb "linen-search: specify a search token.")
                                                            (call sexos_line "[spindle.linen.search.send] token= status=0 err=no_token"))
                                                          (block
                                                            (var uint64_t a0 0)
                                                            (var uint64_t a1 0)
                                                            (var size_t n (call min_size (. args len) 16))
                                                            (for (var size_t i 0) (< i n) (++ i)
                                                              (block
                                                                (var uint64_t b (cast uint64_t ([] (. args ptr) i)))
                                                                (if (< i 8)
                                                                  (|= a0 (<< b (* i 8)))
                                                                  (|= a1 (<< b (* (- i 8) 8))))))
                                                            (var SliceText tstr (call slice_to_text args))
                                                            (var SexosReply r (call sexos_pdx_call SEXOS_SLOT_linen 0x47u a0 a1 0))
                                                            (call sb_push_cstr sb "Linen search sent (OP_LINEN_SEARCH_OBJECTS=0x47).")
                                                            (call sb_push_cstr sb "Fire-and-forget -- check Linen markers for results.")
                                                            (call sexos_line "[spindle.linen.search.send] token=%s status=%llu err=%lld"
                                                              (. tstr text)
                                                              (cast (unsigned long long) (. r status))
                                                              (cast (long long) (?: (== (. r status) 0u) 0 (call wrap_i64 (. r status)))))))
                                                        (call sexos_line "[spindle.linen.workflow.command] name=linen-search ok=1 reason=fire_and_forget_op47")
                                                        (= recognized true))
                                                      (call event_ring_push ev EV_CMD_UNKNOWN cmd))))))))))))))))))))))))))
      (if recognized (call event_ring_push ev EV_CMD_OK cmd))
      (return recognized))

    (fn (static bool) scancode_to_ascii ((uint8_t code) (uint8_t (* ch_out)))
      (switch code
        (block
          (case 0x02u (block (= (* ch_out) 49u) (return true)))
        (case 0x03u (block (= (* ch_out) 50u) (return true)))
        (case 0x04u (block (= (* ch_out) 51u) (return true)))
        (case 0x05u (block (= (* ch_out) 52u) (return true)))
        (case 0x06u (block (= (* ch_out) 53u) (return true)))
        (case 0x07u (block (= (* ch_out) 54u) (return true)))
        (case 0x08u (block (= (* ch_out) 55u) (return true)))
        (case 0x09u (block (= (* ch_out) 56u) (return true)))
        (case 0x0Au (block (= (* ch_out) 57u) (return true)))
        (case 0x0Bu (block (= (* ch_out) 48u) (return true)))
        (case 0x10u (block (= (* ch_out) 113u) (return true)))
        (case 0x11u (block (= (* ch_out) 119u) (return true)))
        (case 0x12u (block (= (* ch_out) 101u) (return true)))
        (case 0x13u (block (= (* ch_out) 114u) (return true)))
        (case 0x14u (block (= (* ch_out) 116u) (return true)))
        (case 0x15u (block (= (* ch_out) 121u) (return true)))
        (case 0x16u (block (= (* ch_out) 117u) (return true)))
        (case 0x17u (block (= (* ch_out) 105u) (return true)))
        (case 0x18u (block (= (* ch_out) 111u) (return true)))
        (case 0x19u (block (= (* ch_out) 112u) (return true)))
        (case 0x1Eu (block (= (* ch_out) 97u) (return true)))
        (case 0x1Fu (block (= (* ch_out) 115u) (return true)))
        (case 0x20u (block (= (* ch_out) 100u) (return true)))
        (case 0x21u (block (= (* ch_out) 102u) (return true)))
        (case 0x22u (block (= (* ch_out) 103u) (return true)))
        (case 0x23u (block (= (* ch_out) 104u) (return true)))
        (case 0x24u (block (= (* ch_out) 106u) (return true)))
        (case 0x25u (block (= (* ch_out) 107u) (return true)))
        (case 0x26u (block (= (* ch_out) 108u) (return true)))
        (case 0x2Cu (block (= (* ch_out) 122u) (return true)))
        (case 0x2Du (block (= (* ch_out) 120u) (return true)))
        (case 0x2Eu (block (= (* ch_out) 99u) (return true)))
        (case 0x2Fu (block (= (* ch_out) 118u) (return true)))
        (case 0x30u (block (= (* ch_out) 98u) (return true)))
        (case 0x31u (block (= (* ch_out) 110u) (return true)))
        (case 0x32u (block (= (* ch_out) 109u) (return true)))
        (case 0x39u (block (= (* ch_out) 32u) (return true)))
        (case 0x0Cu (block (= (* ch_out) 45u) (return true)))
        (case 0x0Du (block (= (* ch_out) 61u) (return true)))
        (case 0x1Au (block (= (* ch_out) 91u) (return true)))
        (case 0x1Bu (block (= (* ch_out) 93u) (return true)))
        (case 0x27u (block (= (* ch_out) 59u) (return true)))
        (case 0x28u (block (= (* ch_out) 39u) (return true)))
        (case 0x29u (block (= (* ch_out) 96u) (return true)))
        (case 0x2Bu (block (= (* ch_out) 92u) (return true)))
        (case 0x33u (block (= (* ch_out) 44u) (return true)))
        (case 0x34u (block (= (* ch_out) 46u) (return true)))
        (case 0x35u (block (= (* ch_out) 47u) (return true)))
        (case 0x0Fu (block (= (* ch_out) 9u) (return true)))
        (default (return false)))))

    (fn (static void) scrollback_page ((Scrollback (* sb)) (bool up))
      (var uint32_t page (cast uint32_t (- GRID_ROWS 1)))
      (if up
        (block
          (var uint32_t total (-> sb total_lines))
          (var uint32_t usable (call min_u32 total (cast uint32_t MAX_SCROLLBACK)))
          (var uint32_t max_off (call sat_sub_u32 usable page))
          (= (-> sb scroll_offset) (call min_u32 (+ (-> sb scroll_offset) page) max_off)))
        (= (-> sb scroll_offset) (call sat_sub_u32 (-> sb scroll_offset) page)))
      (call sexos_line "[spindle.page.nav] dir=%s offset=%u ok=1"
        (?: up "up" "down") (-> sb scroll_offset)))

    (fn (static void) handle_key_insert ((Spindle (* sp)) (uint8_t scancode))
      (var CmdLine (* line) (& (-> sp line)))
      (var History (* hist) (& (-> sp hist)))
      (switch scancode
        (block
          (case 0x1Cu
          (block
            (var DebugText dbg (call slice_to_debug (call cmdline_as_bytes line)))
            (call sexos_line "[spindle.line.enter] len=%zu mode=insert text=%s"
              (-> line len) (. dbg text))
            (call sexos_line "[spindle.key.enter]")
            (call sexos_line "[spindle.input.recv] key=enter len=%zu" (-> line len))
            (call cmdline_clear line)
            break))
        (case 0x0Eu
          (block
            (if (> (-> line cur) 0) (call cmdline_delete_at line (- (-> line cur) 1)))
            (call sexos_line "[spindle.line.backspace] len=%zu" (-> line len))
            (call sexos_line "[spindle.text.backspace]")
            (call sexos_line "[spindle.input.recv] key=backspace len=%zu" (-> line len))
            (call sexos_line "[spindle.line.cursor] pos=%zu len=%zu" (-> line cur) (-> line len))
            break))
        (case 0x01u
          (block
            (= (-> line mode) VI_NORMAL)
            (if (&& (> (-> line cur) 0) (== (-> line cur) (-> line len)))
              (-= (-> line cur) 1))
            (call sexos_line "[spindle.vi.mode] mode=normal")
            (call sexos_line "[spindle.line.cursor] pos=%zu len=%zu" (-> line cur) (-> line len))
            break))
        (case 0x48u
          (block
            (cast void (call history_nav line hist true))
            break))
        (case 0x50u
          (block
            (cast void (call history_nav line hist false))
            break))
        (case 0x49u
          (block
            (call scrollback_page (& (-> sp sb)) true)
            break))
        (case 0x51u
          (block
            (call scrollback_page (& (-> sp sb)) false)
            break))
        (case 0x4Du
          (block
            (if (! (call ghost_accept line hist))
              (call sexos_line "[spindle.key.right] no_ghost"))
            break))
        (case 0x0Fu
          (block
            (if (! (call ghost_accept line hist))
              (call sexos_line "[spindle.key.tab] no_ghost"))
            break))
        (default
          (block
            (var uint8_t ch 0)
            (if (call scancode_to_ascii scancode (& ch))
              (block
                (call cmdline_insert_at line (-> line cur) ch)
                (= (-> line has_hist_nav) false)
                (var CharText ct (call char_text ch))
                (call sexos_line "[spindle.line.append] ch=%s len=%zu" (. ct text) (-> line len))
                (call sexos_line "[spindle.text.append] ch=%u" (cast unsigned ch))
                (call sexos_line "[spindle.input.recv] key=printable ch=%s len=%zu" (. ct text) (-> line len))
                (call sexos_line "[spindle.line.cursor] pos=%zu len=%zu" (-> line cur) (-> line len))
                (call sexos_line "[spindle.line.edit.ok] op=insert ch=%s" (. ct text))))
            break)))))

    (fn (static void) handle_key_normal ((Spindle (* sp)) (uint8_t scancode))
      (var CmdLine (* line) (& (-> sp line)))
      (var History (* hist) (& (-> sp hist)))
      (switch scancode
        (block
          (case 0x1Cu
          (block
            (var DebugText dbg (call slice_to_debug (call cmdline_as_bytes line)))
            (call sexos_line "[spindle.line.enter] len=%zu mode=normal text=%s"
              (-> line len) (. dbg text))
            (call sexos_line "[spindle.key.enter]")
            (call sexos_line "[spindle.input.recv] key=enter len=%zu" (-> line len))
            (call cmdline_clear line)
            (= (-> line mode) VI_INSERT)
            (= (-> line pending_d) false)
            break))
        (case 0x01u
          (block
            (= (-> line pending_d) false)
            (call sexos_line "[spindle.vi.mode] mode=normal already")
            break))
        (case 0x0Eu
          (block
            (call cmdline_cursor_left line)
            (call sexos_line "[spindle.line.cursor] pos=%zu len=%zu" (-> line cur) (-> line len))
            break))
        (case 0x48u
          (block
            (cast void (call history_nav line hist true))
            break))
        (case 0x50u
          (block
            (cast void (call history_nav line hist false))
            break))
        (case 0x49u
          (block
            (call scrollback_page (& (-> sp sb)) true)
            break))
        (case 0x51u
          (block
            (call scrollback_page (& (-> sp sb)) false)
            break))
        (default
          (block
            (if (-> line pending_d)
              (block
                (= (-> line pending_d) false)
                (if (== scancode 0x20u)
                  (block
                    (call cmdline_save_undo line)
                    (call cmdline_clear line)
                    (call sexos_line "[spindle.line.edit.ok] op=dd")
                    (call sexos_line "[spindle.line.cursor] pos=0 len=0")))
                (return)))
            (var uint8_t ch 0)
            (if (call scancode_to_ascii scancode (& ch))
              (switch ch
                (block
                  (case 104u
                  (block
                    (call cmdline_cursor_left line)
                    (call sexos_line "[spindle.line.cursor] pos=%zu len=%zu" (-> line cur) (-> line len))
                    break))
                (case 108u
                  (block
                    (call cmdline_cursor_right line)
                    (call sexos_line "[spindle.line.cursor] pos=%zu len=%zu" (-> line cur) (-> line len))
                    break))
                (case 48u
                  (block
                    (call cmdline_cursor_home line)
                    (call sexos_line "[spindle.line.cursor] pos=0 len=%zu" (-> line len))
                    (call sexos_line "[spindle.line.edit.ok] op=home")
                    break))
                (case 119u
                  (block
                    (call cmdline_word_fwd line)
                    (call sexos_line "[spindle.line.cursor] pos=%zu len=%zu" (-> line cur) (-> line len))
                    (call sexos_line "[spindle.line.edit.ok] op=word_fwd")
                    break))
                (case 98u
                  (block
                    (call cmdline_word_back line)
                    (call sexos_line "[spindle.line.cursor] pos=%zu len=%zu" (-> line cur) (-> line len))
                    (call sexos_line "[spindle.line.edit.ok] op=word_back")
                    break))
                (case 101u
                  (block
                    (call cmdline_word_end line)
                    (call sexos_line "[spindle.line.cursor] pos=%zu len=%zu" (-> line cur) (-> line len))
                    (call sexos_line "[spindle.line.edit.ok] op=word_end")
                    break))
                (case 105u
                  (block
                    (= (-> line mode) VI_INSERT)
                    (call sexos_line "[spindle.vi.mode] mode=insert")
                    break))
                (case 97u
                  (block
                    (call cmdline_cursor_right line)
                    (= (-> line mode) VI_INSERT)
                    (call sexos_line "[spindle.vi.mode] mode=insert cursor=%zu" (-> line cur))
                    break))
                (case 100u
                  (block
                    (= (-> line pending_d) true)
                    break))
                (case 117u
                  (block
                    (call cmdline_undo line)
                    (call sexos_line "[spindle.line.edit.ok] op=undo len=%zu" (-> line len))
                    (call sexos_line "[spindle.line.cursor] pos=%zu len=%zu" (-> line cur) (-> line len))
                    break))
                (default break))))
            break)))))

    (fn (static void) handle_key ((Spindle (* sp)) (uint8_t scancode))
      (if (== (. (-> sp line) mode) VI_INSERT)
        (call handle_key_insert sp scancode)
        (call handle_key_normal sp scancode)))

    (fn (static void) run_command_history_proof ((Spindle (* sp)))
      (var CmdLine line (init 0))
      (call sexos_line "[spindle.command.history.proof] stage=0 action=start ok=1")
      (var (const char) (* ([] cmds 4)) (init "help" "echo spindle" "history" "clear"))
      (for (var size_t i 0) (< i 4) (++ i)
        (block
          (call cmdline_set_from_slice (& line) (call cstr_slice ([] cmds i)))
          (call sexos_line "[spindle.cmd.recv] line_len=%zu" (. line len))
          (var size_t idx (call history_push (& (-> sp hist)) (call cmdline_as_bytes (& line))))
          (call sexos_line "[spindle.history.push] idx=%zu len=%zu" idx (. line len))
          (var bool recognized (call dispatch sp (call cmdline_as_bytes (& line))))
          (var TokenPair tp (call tokenize (call cmdline_as_bytes (& line))))
          (var SliceText nt (call slice_to_text (. tp cmd)))
          (call sexos_line "[spindle.cmd.exec] name=%s ok=%u reason=%s"
            (. nt text) (?: recognized 1u 0u) (?: recognized "ok" "unknown_command"))
          (call sexos_line "[spindle.command.history.proof] stage=%zu action=exec_%s ok=%u"
            (+ i 1) (. nt text) (?: recognized 1u 0u))
          (call cmdline_clear (& line))))
      (var bool nav_up_ok (call history_nav (& line) (& (-> sp hist)) true))
      (call sexos_line "[spindle.command.history.proof] stage=5 action=nav_up ok=%u" (?: nav_up_ok 1u 0u))
      (var bool nav_down_ok (call history_nav (& line) (& (-> sp hist)) false))
      (call sexos_line "[spindle.command.history.proof] stage=6 action=nav_down ok=%u" (?: nav_down_ok 1u 0u))
      (var bool history_ok (call dispatch sp (call cstr_slice "history")))
      (call sexos_line "[spindle.cmd.exec] name=history ok=%u reason=%s"
        (?: history_ok 1u 0u) (?: history_ok "ok" "unknown_command"))
      (call sexos_line "[spindle.command.history.proof] stage=7 action=history_show ok=%u" (?: history_ok 1u 0u))
      (var bool all_ok (&& (&& nav_up_ok nav_down_ok) history_ok))
      (call sexos_line "[spindle.command.history.proof.done] ok=%u" (?: all_ok 1u 0u)))

    (fn (static void) run_persist_proof ((Spindle (* sp)))
      (call sexos_line "[spindle.persist.proof] stage=0 action=start ok=1")
      (cast void (call history_push (& (-> sp hist)) (call cstr_slice "help")))
      (cast void (call history_push (& (-> sp hist)) (call cstr_slice "echo persist_test")))
      (cast void (call history_push (& (-> sp hist)) (call cstr_slice "status")))
      (var bool stage1_ok (>= (. (-> sp hist) total) 3u))
      (call sexos_line "[spindle.persist.proof] stage=1 action=push_entries ok=%u" (?: stage1_ok 1u 0u))
      (var bool save_ok (call dispatch sp (call cstr_slice "save")))
      (call sexos_line "[spindle.persist.proof] stage=2 action=save ok=%u" (?: save_ok 1u 0u))
      (var bool stage3_ok (>= (. (-> sp hist) total) 3u))
      (call sexos_line "[spindle.persist.proof] stage=3 action=history_intact ok=%u" (?: stage3_ok 1u 0u))
      (var bool load_ok (call dispatch sp (call cstr_slice "load")))
      (call sexos_line "[spindle.persist.proof] stage=4 action=load ok=%u reason=async_limited" (?: load_ok 1u 0u))
      (var bool stage5_ok true)
      (call sexos_line "[spindle.persist.proof] stage=5 action=load_graceful ok=%u" (?: stage5_ok 1u 0u))
      (var bool all_ok (&& (&& (&& (&& stage1_ok save_ok) stage3_ok) load_ok) stage5_ok))
      (call sexos_line "[spindle.persist.proof.done] ok=%u" (?: all_ok 1u 0u)))

    (fn (static void) run_files_commands_proof ((Spindle (* sp)))
      (call sexos_line "[spindle.files.proof] stage=0 command=start ok=1 reason=files_commands_proof_begin")
      (var uint32_t lb1 (. (-> sp sb) total_lines))
      (var bool save_ok (call dispatch sp (call cstr_slice "save")))
      (var uint32_t ob1 (call sat_mul_u32 (call sat_sub_u32 (. (-> sp sb) total_lines) lb1) 84u))
      (call sexos_line "[spindle.cmd.exec] name=save ok=%u reason=fire_and_forget" (?: save_ok 1u 0u))
      (call sexos_line "[spindle.cmd.output] name=save bytes=%u" ob1)
      (call sexos_line "[spindle.files.proof] stage=1 command=save ok=%u reason=fire_and_forget" (?: save_ok 1u 0u))

      (var uint32_t lb2 (. (-> sp sb) total_lines))
      (var bool load_ok (call dispatch sp (call cstr_slice "load")))
      (var uint32_t ob2 (call sat_mul_u32 (call sat_sub_u32 (. (-> sp sb) total_lines) lb2) 84u))
      (call sexos_line "[spindle.cmd.exec] name=load ok=%u reason=async_limited" (?: load_ok 1u 0u))
      (call sexos_line "[spindle.cmd.output] name=load bytes=%u" ob2)
      (call sexos_line "[spindle.files.proof] stage=2 command=load ok=%u reason=async_limited_sync_readback_unavailable" (?: load_ok 1u 0u))

      (var uint32_t lb3 (. (-> sp sb) total_lines))
      (var bool ls_ok (call dispatch sp (call cstr_slice "ls")))
      (var uint32_t ob3 (call sat_mul_u32 (call sat_sub_u32 (. (-> sp sb) total_lines) lb3) 84u))
      (call sexos_line "[spindle.cmd.exec] name=ls ok=%u reason=async_limited_static_fallback" (?: ls_ok 1u 0u))
      (call sexos_line "[spindle.cmd.output] name=ls bytes=%u" ob3)
      (call sexos_line "[spindle.files.proof] stage=3 command=ls ok=%u reason=async_limited_static_fallback" (?: ls_ok 1u 0u))

      (var uint32_t lb4 (. (-> sp sb) total_lines))
      (var bool files_ok (call dispatch sp (call cstr_slice "files")))
      (var uint32_t ob4 (call sat_mul_u32 (call sat_sub_u32 (. (-> sp sb) total_lines) lb4) 84u))
      (call sexos_line "[spindle.cmd.exec] name=files ok=%u reason=status_report" (?: files_ok 1u 0u))
      (call sexos_line "[spindle.cmd.output] name=files bytes=%u" ob4)
      (call sexos_line "[spindle.files.proof] stage=4 command=files ok=%u reason=status_report" (?: files_ok 1u 0u))

      (var uint32_t lb5 (. (-> sp sb) total_lines))
      (var bool status_ok (call dispatch sp (call cstr_slice "status")))
      (var uint32_t ob5 (call sat_mul_u32 (call sat_sub_u32 (. (-> sp sb) total_lines) lb5) 84u))
      (call sexos_line "[spindle.cmd.exec] name=status ok=%u reason=status_ok" (?: status_ok 1u 0u))
      (call sexos_line "[spindle.cmd.output] name=status bytes=%u" ob5)
      (call sexos_line "[spindle.files.proof] stage=5 command=status ok=%u reason=status_ok" (?: status_ok 1u 0u))

      (var uint32_t lb6 (. (-> sp sb) total_lines))
      (var bool session_ok (call dispatch sp (call cstr_slice "session")))
      (var uint32_t ob6 (call sat_mul_u32 (call sat_sub_u32 (. (-> sp sb) total_lines) lb6) 84u))
      (call sexos_line "[spindle.cmd.exec] name=session ok=%u reason=session_summary" (?: session_ok 1u 0u))
      (call sexos_line "[spindle.cmd.output] name=session bytes=%u" ob6)
      (call sexos_line "[spindle.files.proof] stage=6 command=session ok=%u reason=session_summary" (?: session_ok 1u 0u))

      (call sexos_line "[spindle.files.proof] stage=7 command=history_intact ok=1 reason=no_storage_mutation_from_status")
      (call sexos_line "[spindle.files.proof] stage=8 command=safety ok=1 reason=no_blocking_no_unbounded_waits")
      (var bool all_ok (&& (&& (&& (&& (&& save_ok load_ok) ls_ok) files_ok) status_ok) session_ok))
      (call sexos_line "[spindle.files.proof.done] ok=%u" (?: all_ok 1u 0u)))

    (fn (static void) run_bell_bridge_proof ((Spindle (* sp)))
      (call sexos_line "[spindle.bell.proof] stage=0 action=start ok=1 reason=bell_bridge_proof_begin")
      (var bool status_ok (call dispatch sp (call cstr_slice "bell-status")))
      (call sexos_line "[spindle.bell.proof] stage=1 action=bell_status ok=%u reason=%s"
        (?: status_ok 1u 0u) (?: status_ok "ok" "dispatch_fail"))
      (var bool test_ok (call dispatch sp (call cstr_slice "bell-test")))
      (call sexos_line "[spindle.bell.proof] stage=2 action=bell_test ok=%u reason=%s"
        (?: test_ok 1u 0u) (?: test_ok "ok" "dispatch_fail"))
      (var bool notify_ok (call dispatch sp (call cstr_slice "notify spindle-proof")))
      (call sexos_line "[spindle.bell.proof] stage=3 action=notify ok=%u reason=%s"
        (?: notify_ok 1u 0u) (?: notify_ok "ok" "dispatch_fail"))
      (var bool notify_empty_ok (call dispatch sp (call cstr_slice "notify")))
      (call sexos_line "[spindle.bell.proof] stage=4 action=notify_empty ok=%u reason=%s"
        (?: notify_empty_ok 1u 0u) (?: notify_empty_ok "ok" "dispatch_fail"))
      (var bool bell_ok (call dispatch sp (call cstr_slice "bell")))
      (call sexos_line "[spindle.bell.proof] stage=5 action=bell_info ok=%u reason=%s"
        (?: bell_ok 1u 0u) (?: bell_ok "ok" "dispatch_fail"))
      (var bool launch_outcomes_ok (call dispatch sp (call cstr_slice "launch-outcomes")))
      (call sexos_line "[spindle.bell.proof] stage=5b action=launch_outcomes ok=%u reason=%s"
        (?: launch_outcomes_ok 1u 0u) (?: launch_outcomes_ok "ok" "dispatch_fail"))
      (var bool bell_launch_ok (call dispatch sp (call cstr_slice "bell-launch-events")))
      (call sexos_line "[spindle.bell.proof] stage=5c action=bell_launch_events ok=%u reason=%s"
        (?: bell_launch_ok 1u 0u) (?: bell_launch_ok "ok" "dispatch_fail"))
      (call sexos_line "[spindle.bell.proof] stage=6 action=safety ok=1 reason=no_blocking_no_unbounded_waits")
      (var bool all_ok (&& (&& (&& (&& (&& (&& status_ok test_ok) notify_ok) notify_empty_ok) bell_ok) launch_outcomes_ok) bell_launch_ok))
      (call sexos_line "[spindle.bell.proof.done] ok=%u" (?: all_ok 1u 0u)))

    (fn (static void) run_linen_bridge_proof ((Spindle (* sp)))
      (call sexos_line "[spindle.linen.proof] stage=0 action=start ok=1 reason=linen_bridge_proof_begin")
      (var bool status_ok (call dispatch sp (call cstr_slice "linen-status")))
      (call sexos_line "[spindle.linen.proof] stage=1 action=linen_status ok=%u reason=%s"
