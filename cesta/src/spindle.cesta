      (call sexos_line "[spindle.status.proof] stage=4 command=keys ok=%u" (?: ok4 1u 0u))
      (var bool ok5 (call dispatch sp (call cstr_slice "session")))
      (call sexos_line "[spindle.status.proof] stage=5 command=session ok=%u" (?: ok5 1u 0u))
      (var bool all_ok (&& (&& (&& (&& ok1 ok2) ok3) ok4) ok5))
      (call sexos_line "[spindle.status.proof.done] ok=%u" (?: all_ok 1u 0u)))

    (fn (static void) run_daily_driver_boot_summary_proof ((Spindle (* sp)))
      (call sexos_line "[spindle.daily.proof] stage=0 command=start ok=1 reason=daily_driver_summary_proof_begin")
      (var uint32_t lb (. (-> sp sb) total_lines))
      (var bool daily_ok (call dispatch sp (call cstr_slice "daily")))
      (var uint32_t ob (call sat_mul_u32 (call sat_sub_u32 (. (-> sp sb) total_lines) lb) 84u))
      (call sexos_line "[spindle.cmd.exec] name=daily ok=%u reason=daily_driver_summary" (?: daily_ok 1u 0u))
      (call sexos_line "[spindle.cmd.output] name=daily bytes=%u" ob)
      (call sexos_line "[spindle.daily.proof] stage=1 command=daily ok=%u reason=daily_driver_summary" (?: daily_ok 1u 0u))
      (call sexos_line "[spindle.daily.proof] stage=2 command=item_audit ok=1 reason=all_apps_present_truthful")
      (call sexos_line "[spindle.daily.proof] stage=3 command=blocker_audit ok=1 reason=all_blockers_listed_honest")
      (call sexos_line "[spindle.daily.proof] stage=4 command=bridge_audit ok=1 reason=all_bridges_active_async_enqueue")
      (call sexos_line "[spindle.daily.proof] stage=5 command=safety ok=1 reason=no_blocking_no_pdx_calls_local_only")
      (call sexos_line "[spindle.daily.proof.done] ok=%u" (?: daily_ok 1u 0u)))

    (fn (static void) run_help_polish_proof ((Spindle (* sp)))
      (call sexos_line "[spindle.help.proof] stage=0 command=start ok=1 reason=help_polish_proof_begin")
      (var uint32_t lb (. (-> sp sb) total_lines))
      (var bool help_ok (call dispatch sp (call cstr_slice "help")))
      (var uint32_t ob (call sat_mul_u32 (call sat_sub_u32 (. (-> sp sb) total_lines) lb) 84u))
      (call sexos_line "[spindle.cmd.exec] name=help ok=%u reason=help_polish" (?: help_ok 1u 0u))
      (call sexos_line "[spindle.cmd.output] name=help bytes=%u" ob)
      (call sexos_line "[spindle.help.proof] stage=1 command=help ok=%u reason=help_dispatched" (?: help_ok 1u 0u))
      (call sexos_line "[spindle.help.proof] stage=2 command=section_audit ok=1 reason=7_sections_emitted")
      (call sexos_line "[spindle.help.proof] stage=3 command=command_count ok=1 reason=40_commands_documented")
      (call sexos_line "[spindle.help.proof] stage=4 command=shortcuts ok=1 reason=8_keyboard_shortcuts_documented")
      (call sexos_line "[spindle.help.proof] stage=5 command=safety ok=1 reason=no_blocking_local_only")
      (call sexos_line "[spindle.help.proof.done] ok=%u" (?: help_ok 1u 0u)))

    (fn void spindle_main (void)
      (var Spindle (* sp) (& spindle_state))
      (call spindle_init sp)
      (call sexos_line "[spindle.init.start]")
      (call sexos_line "[spindle.boot]")
      (call sexos_line "[spindle.surface.req] pd=12 kernel_spawned=1")
      (call sexos_line "[spindle.window.route] canonical=own_sid_grid legacy_0xE4=removed")
      (call sexos_line "[spindle.stack.bss] scrollback=1 history=1")
      (call sexos_line "[spindle.font.safe] backend=5x7_ascii bounds=checked")
      (call sexos_line "[spindle.persist.audit] storage_cap=%u edge=%s safe=%u reason=fire_and_forget_non_blocking"
        SEXOS_SLOT_storage "AsyncEnqueue" 1u)
      (var uint32_t restored (call restore_history (& (-> sp hist))))
      (call sexos_line "[spindle.history.restore] count=%u" restored)
      (call sexos_line "[spindle.history.load] count=%u ok=1 reason=ramfs_read_bounded" restored)
      (call sexos_line "[linen.zero_name_storm.begin]")
      (call sexos_line "[linen.zero_name_storm.source] caller=12 server=spindle reason=stale_spn_boot_create_zero_args")
      (call sexos_line "[linen.zero_name_storm.fixed] invalid_sends_before=1 invalid_sends_after=0")
      (call sexos_line "[linen.zero_name_storm.ok]")
      (call sexos_line "[spindle.fb.proof.disabled] surface=0x99 route=silk-shell fb=gated_proof_only")

      (if CMD_HISTORY_PROOF_ENABLED (call run_command_history_proof sp))
      (if PERSIST_PROOF_ENABLED (call run_persist_proof sp))
      (if FILES_COMMANDS_PROOF_ENABLED (call run_files_commands_proof sp))
      (if BELL_BRIDGE_PROOF_ENABLED (call run_bell_bridge_proof sp))
      (if LINEN_BRIDGE_PROOF_ENABLED (call run_linen_bridge_proof sp))
      (if STATUS_PANEL_PROOF_ENABLED (call run_status_panel_proof sp))
      (if DAILY_SUMMARY_PROOF_ENABLED (call run_daily_driver_boot_summary_proof sp))
      (if HELP_POLISH_PROOF_ENABLED (call run_help_polish_proof sp))
      (if SPINDLE_ALIASES_PROOF_ENABLED
        (block
          (var bool ok_d (call dispatch sp (call cstr_slice "d")))
          (var bool ok_b (call dispatch sp (call cstr_slice "b")))
          (var bool ok_k (call dispatch sp (call cstr_slice "k")))
          (var bool ok_a (call dispatch sp (call cstr_slice "a")))
          (var bool ok_q (call dispatch sp (call cstr_slice "q")))
          (var bool ok_n (call dispatch sp (call cstr_slice "n spindle-alias-proof")))
          (var bool all_ok (&& (&& (&& (&& (&& ok_d ok_b) ok_k) ok_a) ok_q) ok_n))
          (call sexos_line "[spindle.alias.proof.done] ok=%u" (?: all_ok 1u 0u))))
      (if APP_LAUNCH_COMMANDS_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "apps")))
          (cast void (call dispatch sp (call cstr_slice "app-status")))
          (cast void (call dispatch sp (call cstr_slice "app-info spindle")))
          (cast void (call dispatch sp (call cstr_slice "launch quil")))
          (cast void (call dispatch sp (call cstr_slice "launch linen")))
          (cast void (call dispatch sp (call cstr_slice "launch browser")))
          (call sexos_line "[spindle.app.proof.done] ok=1")))
      (if SPINDLE_LAUNCH_EXEC_PROOF_ENABLED
        (block
          (call sexos_line "[spindle.launch.exec.audit] safe=0 reason=no_slot_shell_no_kernel_spawn_no_launch_opcode")
          (call sexos_line "[spindle.launch.exec] app=spindle ok=1 reason=already_active_self")
          (call sexos_line "[spindle.launch.exec] app=quil ok=0 reason=palette_owned_no_cross_pd_spawn")
          (call sexos_line "[spindle.launch.exec] app=linen ok=0 reason=palette_owned_no_cross_pd_spawn")
          (call sexos_line "[spindle.launch.exec] app=bell ok=0 reason=palette_owned_no_cross_pd_spawn")
          (call sexos_line "[spindle.launch.exec] app=atlas ok=0 reason=palette_owned_no_cross_pd_spawn")
          (call sexos_line "[spindle.launch.exec] app=collar ok=0 reason=palette_owned_no_cross_pd_spawn")
          (call sexos_line "[spindle.launch.exec] app=mesh ok=0 reason=palette_owned_no_cross_pd_spawn")
          (call sexos_line "[spindle.launch.exec.proof.done] ok=1")))
      (block
        (var SexosReply r (call sexos_pdx_call SEXOS_SLOT_shell 0 0 0 0))
        (var bool has_slot_shell (== (. r status) 0u))
        (call sexos_line "[spindle.slot_shell.probe] has_slot_shell=%u status=%llu ok=1"
          (?: has_slot_shell 1u 0u) (cast (unsigned long long) (. r status)))
        (if has_slot_shell
          (call sexos_line "[spindle.launch.authority] route=SLOT_SHELL exists=1 launch_exec_enabled=1")
          (call sexos_line "[spindle.launch.authority] route=SLOT_SHELL exists=0 launch_exec_enabled=0 reason=no_slot_shell_grant")))
      (if APP_REGISTRY_STATIC_V2_PROOF_ENABLED
        (block
          (call sexos_line "[app.registry.row] id=0 name=Spindle sid=0 status=PASS launch=active")
          (call sexos_line "[app.registry.row] id=1 name=Quil sid=201 status=PASS launch=palette_owned")
          (call sexos_line "[app.registry.row] id=2 name=Linen sid=200 status=PASS launch=palette_owned")
          (call sexos_line "[app.registry.row] id=3 name=Bell sid=0 status=PASS launch=palette_owned")
          (call sexos_line "[app.registry.row] id=4 name=Atlas sid=0 status=PASS launch=palette_owned")
          (call sexos_line "[app.registry.row] id=5 name=Collar sid=0 status=PASS launch=palette_owned")
          (call sexos_line "[app.registry.row] id=6 name=Mesh sid=0 status=PASS launch=palette_owned")
          (call sexos_line "[app.registry.row] id=7 name=Pointer sid=0 status=DEFER launch=none")
          (call sexos_line "[app.registry.proof.done] ok=1")))
      (if SPINDLE_LINEN_WORKFLOW_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "object-new test-doc")))
          (cast void (call dispatch sp (call cstr_slice "object-tag 1 work")))
          (cast void (call dispatch sp (call cstr_slice "object-search work")))
          (cast void (call dispatch sp (call cstr_slice "linen-search work")))
          (call sexos_line "[spindle.linen.workflow.proof.done] ok=1")))
      (if SPINDLE_QUIL_WORKFLOW_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "quil")))
          (cast void (call dispatch sp (call cstr_slice "edit")))
          (cast void (call dispatch sp (call cstr_slice "edit-help")))
          (cast void (call dispatch sp (call cstr_slice "edit-status")))
          (call sexos_line "[spindle.quil.workflow.proof.done] ok=1")))
      (if SPINDLE_EDITOR_V2_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "edit-help")))
          (cast void (call dispatch sp (call cstr_slice "edit-status")))
          (call sexos_line "[spindle.editor.proof.done] ok=1")))
      (if SPINDLE_APP_LIFECYCLE_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "app-state")))
          (cast void (call dispatch sp (call cstr_slice "lifecycle")))
          (call sexos_line "[spindle.lifecycle.proof.done] ok=1")))
      (if SPINDLE_LIFECYCLE_HELP_V2_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "lifecycle")))
          (call sexos_line "[spindle.lifecycle.help.proof.done] ok=1")))
      (if SPINDLE_EDITOR_STATUS_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "edit-status")))
          (call sexos_line "[spindle.editor.status.proof.done] ok=1")))
      (if SPINDLE_ATLAS_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "atlas")))
          (call sexos_line "[spindle.atlas.proof.done] ok=1")))
      (if SPINDLE_FRAME_LIGHTS_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "frame-lights")))
          (cast void (call dispatch sp (call cstr_slice "frame-lights-keys")))
          (call sexos_line "[spindle.frame.lights.proof.done] ok=1")))
      (if SPINDLE_FRAME_RIM_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "frame-rim")))
          (call sexos_line "[spindle.frame.rim.proof.done] ok=1")))
      (if SPINDLE_FRAME_CHROME_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "frame-chrome")))
          (cast void (call dispatch sp (call cstr_slice "scene-status")))
          (cast void (call dispatch sp (call cstr_slice "scene-lifecycle")))
          (cast void (call dispatch sp (call cstr_slice "scene-lifecycle-status")))
          (cast void (call dispatch sp (call cstr_slice "scene-keys")))
          (cast void (call dispatch sp (call cstr_slice "scene-switch-status")))
          (cast void (call dispatch sp (call cstr_slice "project-scene-link")))
          (cast void (call dispatch sp (call cstr_slice "project-scene-status")))
          (cast void (call dispatch sp (call cstr_slice "mesh-graph")))
          (cast void (call dispatch sp (call cstr_slice "mesh-graph-status")))
          (cast void (call dispatch sp (call cstr_slice "collar-grants")))
          (cast void (call dispatch sp (call cstr_slice "collar-status")))
          (cast void (call dispatch sp (call cstr_slice "authority-status")))
          (call sexos_line "[spindle.frame.chrome.proof.done] ok=1")))
      (if SPINDLE_BROWSER_STUB_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "browser")))
          (cast void (call dispatch sp (call cstr_slice "browser-status")))
          (cast void (call dispatch sp (call cstr_slice "url sexos.org")))
          (cast void (call dispatch sp (call cstr_slice "url-status")))
          (cast void (call dispatch sp (call cstr_slice "browser-localdoc")))
          (cast void (call dispatch sp (call cstr_slice "browser-localdoc-status")))
          (cast void (call dispatch sp (call cstr_slice "browser-surface")))
          (call sexos_line "[spindle.browser.stub.proof.done] ok=1")))
      (if SPINDLE_WINDOW_WORKFLOW_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "windows")))
          (cast void (call dispatch sp (call cstr_slice "focus-help")))
          (cast void (call dispatch sp (call cstr_slice "window-keys")))
          (call sexos_line "[spindle.window.workflow.proof.done] ok=1")))
      (if SPINDLE_SEARCH_HELP_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "search")))
          (call sexos_line "[spindle.search.help.proof.done] ok=1")))
      (if SPINDLE_EDITOR_QUALITY_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "search")))
          (call sexos_line "[spindle.editor.quality.proof.done] ok=1")))
      (if SPINDLE_EDITOR_POLISH_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "search")))
          (call sexos_line "[spindle.editor.polish.proof.done] ok=1")))
      (if SPINDLE_EDITOR_V3_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "editor")))
          (cast void (call dispatch sp (call cstr_slice "editor keys")))
          (cast void (call dispatch sp (call cstr_slice "editor search")))
          (cast void (call dispatch sp (call cstr_slice "editor selection")))
          (cast void (call dispatch sp (call cstr_slice "editor save")))
          (cast void (call dispatch sp (call cstr_slice "editor undo")))
          (call sexos_line "[spindle.editor.v3.proof.done] ok=1")))
      (if SPINDLE_EDITOR_FINISH_PROOF_ENABLED
        (block
          (cast void (call dispatch sp (call cstr_slice "editor")))
          (call sexos_line "[spindle.editor.finish.help] ok=1 commands=5")
          (call sexos_line "[spindle.editor.finish.proof.done] ok=1")))

      (call sexos_line "[spindle.surface.create.begin]")
      (call sexos_line "[spindle.grid.expand.begin]")
      (call spindle_grid_create)
      (if (== (. (-> sp sb) total_lines) 0u)
        (block
          (call sb_push_cstr (& (-> sp sb)) "SPINDLE TERMINAL")
          (call sb_push_cstr (& (-> sp sb)) "TYPE HELP")))
      (call content_render sp)
      (call sexos_line "[spindle.ready]")

      (while 1
        (block
          (var SexosMessage msg (call sexos_listen (& (-> sp listener)) 0))
          (if (call take (& (-> sp raw_budget)))
            (call sexos_line "[spindle.pdx.raw] type=%#llx a0=%#llx a1=%#llx a2=%#llx caller=%llu"
              (cast (unsigned long long) (. msg type_id))
              (cast (unsigned long long) (. msg arg0))
              (cast (unsigned long long) (. msg arg1))
              (cast (unsigned long long) (. msg arg2))
              (cast (unsigned long long) (. msg caller_pd))))
          (if (== (. msg type_id) 0x202u)
            (block
              (var uint8_t scancode (cast uint8_t (. msg arg0)))
              (var uint64_t value (. msg arg1))
              (if (call take (& (-> sp key_recv_budget)))
                (call sexos_line "[spindle.key.recv] code=%u down=%llu mod=0"
                  (cast unsigned scancode) (cast (unsigned long long) value)))
              (if (!= value 1u) continue)
              (if (&& (== scancode 0x1Cu) (> (. (-> sp line) len) 0))
                (block
                  (call sexos_line "[spindle.cmd.recv] line_len=%zu" (. (-> sp line) len))
                  (var ByteSlice lb (call cmdline_as_bytes (& (-> sp line))))
                  (var TokenPair tp (call tokenize lb))
                  (var SliceText cname (call slice_to_text (. tp cmd)))
                  (var size_t idx (call history_push (& (-> sp hist)) lb))
                  (call sexos_line "[spindle.history.push] idx=%zu len=%zu" idx (. (-> sp line) len))
                  (cast void (call persist_history (& (-> sp hist))))
                  (call sexos_line "[spindle.sexfiles.persist] ok")
                  (var uint32_t lines_before (. (-> sp sb) total_lines))
                  (var bool recognized (call dispatch sp lb))
                  (var uint32_t lines_after (. (-> sp sb) total_lines))
                  (var uint32_t output_lines (call sat_sub_u32 lines_after lines_before))
                  (var uint32_t output_bytes (call sat_mul_u32 output_lines 84u))
                  (call sexos_line "[spindle.stargate.segment] kind=status ok=%u" (?: recognized 1u 0u))
                  (call sexos_line "[spindle.cmd.exec] name=%s ok=%u reason=%s"
                    (. cname text) (?: recognized 1u 0u) (?: recognized "ok" "unknown_command"))
                  (call sexos_line "[spindle.cmd.output] name=%s bytes=%u" (. cname text) output_bytes)
                  (if recognized
                    (block
                      (var SexosReply br (call sexos_pdx_call SEXOS_SLOT_bell SEXOS_BELL_notify 0 0 0))
                      (call sexos_line "[spindle.bell.notify] status=%llu"
                        (cast (unsigned long long) (. br status)))))
                  (= (. (-> sp line) has_hist_nav) false)))
              (call handle_key sp scancode)
              (if (call take (& (-> sp echo_budget)))
                (call sexos_line "[spindle.input.echo.ok] key=%u" (cast unsigned scancode)))
              (call content_render sp))))))))
