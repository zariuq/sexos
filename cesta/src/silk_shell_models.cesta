      (var QuilBuffer buffer)
      (var bool object_valid (call linen_object_by_id object_id (& object)))
      (var bool buffer_valid (call quil_buffer_by_id buffer_id (& buffer)))
      (if (|| (! object_valid) (! buffer_valid))
        (block
          (call
            sexos_line
            "[bell.event.reject.missing] object_valid=%s buffer_valid=%s"
            (?: object_valid "true" "false")
            (?: buffer_valid "true" "false"))
          (call sexos_line "[bell.event.done] reason=rejected")
          (return)))
      (if (!= (. buffer linen_object_ref) object_id)
        (block
          (call
            sexos_line
            "[bell.event.reject.missing] reason=buffer_ref_mismatch expected=%llu actual=%llu"
            (cast (unsigned long long) object_id)
            (cast (unsigned long long) (. buffer linen_object_ref)))
          (call sexos_line "[bell.event.done] reason=rejected")
          (return)))
