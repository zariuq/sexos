    (fn bool app_capability_bits_validate
      ((uint8_t bits) (AppCapabilityBits (* out)))
      (if (!= (& bits (cast uint8_t (~ APP_CAP_KNOWN))) 0)
        (return false))
      (if (!= out NULL)
        (= (-> out bits) bits))
      (return true))
    (fn uint8_t app_capability_bits_bits
      ((AppCapabilityBits self))
      (return (. self bits)))
    (fn bool app_capability_bits_has_bell
      ((AppCapabilityBits self))
      (return (!= (& (. self bits) APP_CAP_BELL) 0)))
    (fn bool app_capability_bits_has_sexfiles
      ((AppCapabilityBits self))
      (return (!= (& (. self bits) APP_CAP_SEXFILES) 0)))
    (fn (const char) *
      app_capability_bits_describe
      ((AppCapabilityBits self))
      (switch
        (. self bits)
        (block
          (case APP_CAP_NONE (return "none"))
          (case APP_CAP_BELL (return "bell"))
          (case APP_CAP_SEXFILES (return "sexfiles"))
          (case APP_CAP_KNOWN (return "bell+sexfiles"))
          (default (return "unknown")))))
    (fn void app_manifest_pack
      (((const AppManifest) (* self)) (uint64_t (* arg0)) (uint64_t (* arg1)) (uint64_t (* arg2)))
      (if (!= arg0 NULL)
        (= (* arg0) (-> self surface_id)))
      (if (!= arg1 NULL)
        (= (* arg1) (-> self title_id)))
      (if (!= arg2 NULL)
        (= (* arg2) (| (<< (cast uint64_t (-> self app_id)) 8) (. (-> self capabilities) bits)))))
    (fn bool app_manifest_unpack
      ((uint64_t surface_id) (uint64_t title_id) (uint64_t arg2) (AppManifest (* out)))
      (if (!= (& arg2 (call UINT64_C 0xFFFFFFFFFF000000)) 0)
        (return false))
      (var AppCapabilityBits capabilities)
      (if (! (call app_capability_bits_validate (cast uint8_t arg2) (& capabilities)))
        (return false))
      (if (!= out NULL)
        (block
          (=
            (* out)
            (compound,
              AppManifest
              (= (. surface_id) surface_id)
              (= (. title_id) title_id)
              (= (. app_id) (cast uint16_t (>> arg2 8)))
              (= (. capabilities) capabilities)))))
      (return true))
    (fn bool app_manifest_has_identity
      (((const AppManifest) (* self)))
      (return (!= (-> self app_id) 0)))
    (fn Canvas canvas_new
      ((uint32_t (* fb_ptr)) (uint32_t w) (uint32_t h))
      (return
        (compound
          Canvas
          (= (. fb) fb_ptr)
          (= (. fb_len) (cast size_t (* w h)))
          (= (. width) w)
          (= (. height) h))))
    (fn void canvas_fill_rect
      ((Canvas (* self)) (uint32_t x) (uint32_t y) (uint32_t w) (uint32_t h) (uint32_t color))
      (var uint32_t y_end (+ y h))
      (var uint32_t x_end (+ x w))
      (if (> y_end (-> self height))
        (= y_end (-> self height)))
      (if (> x_end (-> self width))
        (= x_end (-> self width)))
      (for (var uint32_t py y)
        (< py y_end)
        (++ py)
        (block
          (for (var uint32_t px x)
            (< px x_end)
            (++ px)
            (block
              (var size_t index (cast size_t (+ (* py (-> self width)) px)))
              (if (< index (-> self fb_len))
                (= ([] (-> self fb) index) color)))))))
    (fn void canvas_draw_panel
      ((Canvas (* self)) ((const ShellState) (* state)))
      (call canvas_fill_rect self 0 0 (-> self width) PANEL_HEIGHT (call UINT32_C 0xFF0A0A14))
      (if (-> state is_launcher_open)
        (call canvas_fill_rect self 0 PANEL_HEIGHT LAUNCHER_WIDTH 400 (call UINT32_C 0xFF1E1E2E))))
    (fn uint32_t pdx_compositor_client_create_window
      ((int32_t x) (int32_t y) (uint32_t w) (uint32_t h))
      (cast void h)
      (return
        (cast
          uint32_t
          (. (call sexos_pdx_call SLOT_DISPLAY OP_WINDOW_CREATE (cast uint64_t x) (cast uint64_t y) w) value))))
    (fn void pdx_compositor_client_set_bg
      ((uint32_t color))
      (cast void (call sexos_pdx_call SLOT_DISPLAY OP_SET_BG color 0 0)))
    (fn void pdx_compositor_client_render_bar
      ((uint32_t window_id))
      (cast void (call sexos_pdx_call SLOT_DISPLAY OP_RENDER_BAR window_id 0 0)))
    (fn void linen_object_table_init
      (void)
      (for (var size_t i 0)
        (< i (/ (sizeof LINEN_SEED_OBJECTS) (sizeof ([] LINEN_SEED_OBJECTS 0))))
        (++ i)
        (block
          (if (< i LINEN_MAX_OBJECTS)
            (block
              (var LinenObject object ([] LINEN_SEED_OBJECTS i))
              (= (. object present) true)
              (= ([] (. (. SILK_SHELL_STATE models) LINEN_OBJECTS) i) object)
              (call
                sexos_line
                "[linen.object.seed] id=%llu kind=%u name=%s"
                (cast (unsigned long long) (. object object_id))
                (cast unsigned (. object kind))
                (. object display_name))))))
      (call
        sexos_line
        "[linen.object_table.init] count=%zu"
        (/ (sizeof LINEN_SEED_OBJECTS) (sizeof ([] LINEN_SEED_OBJECTS 0)))))
    (fn size_t linen_object_count
      (void)
      (var size_t count 0)
      (for (var size_t i 0)
        (< i LINEN_MAX_OBJECTS)
        (++ i)
        (if (. ([] (. (. SILK_SHELL_STATE models) LINEN_OBJECTS) i) present)
          (++ count)))
      (return count))
    (fn bool linen_object_by_id
      ((uint64_t id) (LinenObject (* out)))
      (for (var size_t i 0)
        (< i LINEN_MAX_OBJECTS)
        (++ i)
        (block
          (var (const LinenObject) (* object) (& ([] (. (. SILK_SHELL_STATE models) LINEN_OBJECTS) i)))
          (if (&& (-> object present) (== (-> object object_id) id))
            (block
              (if (!= out NULL)
                (= (* out) (* object)))
              (return true)))))
      (return false))
    (fn (const char) *
      linen_object_kind_name
      ((uint8_t kind))
      (switch
        kind
        (block
          (case LINEN_OBJ_KIND_PROJECT (return "Project"))
          (case LINEN_OBJ_KIND_DOCUMENT (return "Document"))
          (case LINEN_OBJ_KIND_CODE_FILE (return "CodeFile"))
          (case LINEN_OBJ_KIND_MEDIA_ASSET (return "MediaAsset"))
          (case LINEN_OBJ_KIND_BUILD_ARTIFACT (return "BuildArtifact"))
          (case LINEN_OBJ_KIND_FOLDER (return "Folder"))
          (case LINEN_OBJ_KIND_REFERENCE (return "Reference"))
          (case LINEN_OBJ_KIND_IMPORT_PLACEHOLDER (return "ImportPlaceholder"))
          (case LINEN_OBJ_KIND_BELL_EVENT_REFERENCE (return "BellEventRef"))
          (case LINEN_OBJ_KIND_QUIL_WORKSPACE_REFERENCE (return "QuilWorkspaceRef"))
          (case LINEN_OBJ_KIND_MESH_DIAGNOSTIC_REFERENCE (return "MeshDiagRef"))
          (default (return "unknown")))))
    (fn (const char) *
      linen_object_state_name
      ((uint8_t state))
      (switch
        state
        (block
          (case LINEN_OBJ_STATE_ALLOCATED (return "Allocated"))
          (case LINEN_OBJ_STATE_LOADED (return "Loaded"))
          (case LINEN_OBJ_STATE_MODIFIED (return "Modified"))
          (case LINEN_OBJ_STATE_SAVED (return "Saved"))
          (case LINEN_OBJ_STATE_ARCHIVED (return "Archived"))
          (default (return "unknown")))))
    (fn void linen_select_first_valid_object
      (void)
      (for (var size_t i 0)
        (< i LINEN_MAX_OBJECTS)
        (++ i)
        (block
          (var (const LinenObject) (* object) (& ([] (. (. SILK_SHELL_STATE models) LINEN_OBJECTS) i)))
          (if (-> object present)
            (block
              (= (. (. SILK_SHELL_STATE models) SELECTED_LINEN_OBJECT_ID) (-> object object_id))
              (call
                sexos_line
                "[linen.object_select.current] id=%llu"
                (cast (unsigned long long) (-> object object_id)))
              (return)))))
      (= (. (. SILK_SHELL_STATE models) SELECTED_LINEN_OBJECT_ID) 0))
    (fn uint64_t linen_selected_object_id
      (void)
      (if (== (. (. SILK_SHELL_STATE models) SELECTED_LINEN_OBJECT_ID) 0)
