    (fn void mesh_render_pd_graph
      (void)
      (var uint8_t ([] buffer 120))
      (call memset buffer (char "' '") (sizeof buffer))
      (call memcpy buffer "PD GRAPH RO" 11)
      (var (const char) (* ([] names 5)) (init "SPINDLE" "QUIL" "LINEN" "MESH" "BELL"))
      (var uint64_t ([] surfaces 5)
        (init
          SURFACE_ID_SPINDLE
          SURFACE_ID_QUIL
          SURFACE_ID_LINEN
          SURFACE_ID_MESH
          SURFACE_ID_BELL_PLACEHOLDER))
      (for (var size_t i 0)
        (< i 5)
        (++ i)
        (block
          (var size_t base (* (+ i 1) 20))
          (var size_t length (call strlen ([] names i)))
          (if (> length 8)
            (= length 8))
          (call memcpy (+ buffer base) ([] names i) length)
          (var uint64_t surface ([] surfaces i))
          (= ([] buffer (+ base 8)) (cast uint8_t (+ '0' (% (/ surface 100) 10))))
          (= ([] buffer (+ base 9)) (cast uint8_t (+ '0' (% (/ surface 10) 10))))
          (= ([] buffer (+ base 10)) (cast uint8_t (+ '0' (% surface 10))))
          (var uint8_t state '-')
          (var uint32_t frame_id)
          (if (call frame_for_surface surface (& frame_id))
            (block
              (for (var size_t j 0)
                (< j MAX_FRAMES)
                (++ j)
                (block
                  (var (const ShellFrame) (* frame) (& ([] (. (. SILK_SHELL_STATE chrome) FRAMES) j)))
                  (if (&& (-> frame present) (== (-> frame frame_id) frame_id))
                    (block
                      (= state (?: (!= (& (-> frame flags) FRAME_FLAG_MINIMIZED) 0) 'M' 'V'))
                      break))))))
          (= ([] buffer (+ base 12)) state)
          (=
            ([] buffer (+ base 14))
            (?: (== (. (. SILK_SHELL_STATE chrome) FOCUSED_SURFACE_ID) surface) 'F' '-'))))
      (cast void (call sexos_pdx_call SLOT_DISPLAY OP_TEXT_CLEAR SURFACE_ID_MESH 0 0))
      (var size_t drawn)
      (var bool accepted
        (call shell_draw_text SURFACE_ID_MESH buffer (sizeof buffer) (call UINT64_C 0x00E8FFFF) (& drawn)))
      (call sexos_line "[mesh.pd_graph.render.ok] rows=6 bytes=%zu ok=%u" drawn (cast unsigned accepted)))
    (fn void bell_emit_object_link_event
      ((uint64_t object_id) (uint64_t buffer_id))
      (call
        sexos_line
        "[bell.event.stub] kind=ObjectLinkedToBuffer object_id=%llu buffer_id=%llu"
        (cast (unsigned long long) object_id)
        (cast (unsigned long long) buffer_id))
