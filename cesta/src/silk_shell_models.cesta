        sexos_line
        "[bell.event.object_link] object_id=%llu object_kind=%s buffer_id=%llu buffer_kind=%s"
        (cast (unsigned long long) object_id)
        (call linen_object_kind_name (. object kind))
        (cast (unsigned long long) buffer_id)
        (call quil_buffer_kind_name (. buffer kind)))
      (call bell_record_event object_id buffer_id)
      (call
        sexos_line
        "[bell.ring.done] count=%zu event_id=%llu"
        (call bell_ring_count)
        (cast (unsigned long long) (- (. (. SILK_SHELL_STATE models) BELL_EVENT_SEQUENCE) 1)))
      (if (call bell_is_visible_in_active_scene)
        (block
          (call
            sexos_line
            "[bell.render.refresh] reason=visible_after_link object_id=%llu buffer_id=%llu"
            (cast (unsigned long long) object_id)
            (cast (unsigned long long) buffer_id))
          (call bell_render_event_list)))
      (call sexos_line "[bell.event.done] reason=emitted"))
    (fn (static bool) model_take_budget
      ((uint32_t (* budget)))
      (if (== (* budget) 0)
        (return false))
      (-- (* budget))
      (return true))
    (fn (static void) model_send_current_tokens
      (void)
      (var uint32_t ([] tokens 8))
      (call resolve_scene_render_tokens tokens)
      (call push_token_preset tokens))
    (fn (static void) model_store_current_settings
      (void)
      (var (const SceneAppearanceState) (* state)
        (& (. (. SILK_SHELL_STATE models) SCENE_APPEARANCE_STATE)))
      (var uint64_t blob
        (call
          pack_scene_settings_blob
          (-> state preset_idx)
          (-> state chrome_flags)
          (-> state accessibility_flags)))
      (cast void (call sexos_pdx_call SLOT_SEXSTORE OP_KV_PUT SCENE_SETTINGS_KEY_APPEARANCE blob 0)))
    (fn void send_scene_render_tokens
      (void)
      (var SilkShellModelsState (* state) (& (. SILK_SHELL_STATE models)))
      (call model_send_current_tokens)
      (if (call model_take_budget (& (-> state send_scene_render_tokens__SHELL_TOKEN_SEND_BUDGET)))
        (call sexos_line "[shell.appearance.tokens.send] seq=2 sent"))
      (if (call model_take_budget (& (-> state send_scene_render_tokens__STATE_BUDGET)))
        (block
          (var (const SceneAppearanceState) (* appearance) (& (-> state SCENE_APPEARANCE_STATE)))
          (call
            sexos_line
            "[shell.appearance.state] preset=%u custom=%u chrome=%u access=%u"
            (cast unsigned (-> appearance preset_idx))
            (cast unsigned (-> appearance use_custom_colors))
            (cast unsigned (-> appearance chrome_flags))
            (cast unsigned (-> appearance accessibility_flags))))))
    (fn void handle_sexstore_get_reply
      ((uint64_t value))
      (var SilkShellModelsState (* state) (& (. SILK_SHELL_STATE models)))
      (if (call store_reply_is_status value)
        (block
          (var uint64_t code (call store_reply_status value))
          (if (call model_take_budget (& (-> state handle_sexstore_get_reply__STATUS_BUDGET)))
            (block
              (var (const char) (* name) NULL)
              (switch
                code
                (block
                  (case STORE_KV_NOT_FOUND (= name "not_found"))
                  break
                  (case STORE_KV_DENIED (= name "denied"))
                  break
                  (case STORE_KV_FULL (= name "full"))
                  break
                  (case STORE_KV_INVALID_KEY (= name "invalid_key"))
                  break
                  (case STORE_KV_INVALID_VALUE (= name "invalid_value"))
                  break
                  (case STORE_KV_OK (= name "ok"))
                  break
                  (default break)))
              (if (!= name NULL)
                (call sexos_line "[shell.store.reply.status] code=%s key=0x01" name)
                (call sexos_line "[shell.store.reply.reject] code=0x%llx key=0x01" (cast (unsigned long long) code)))))
          (if (call model_take_budget (& (-> state handle_sexstore_get_reply__DEFAULT_BUDGET)))
            (call sexos_line "[shell.store.default] reason=status_reply"))
          (return)))
      (call sexos_line "[shell.store.reply.value] key=0x01")
      (decl uint8_t preset chrome access)
      (if (call unpack_scene_settings_blob value (& preset) (& chrome) (& access))
        (block
          (var uint8_t clamped (?: (< preset PRESET_COUNT) preset 0))
          (= (. (-> state SCENE_APPEARANCE_STATE) preset_idx) clamped)
          (= (. (-> state SCENE_APPEARANCE_STATE) chrome_flags) chrome)
          (= (. (-> state SCENE_APPEARANCE_STATE) accessibility_flags) access)
          (= (. (-> state SCENE_APPEARANCE_STATE) use_custom_colors) 0)
          (call
            memset
            (. (-> state SCENE_APPEARANCE_STATE) custom_colors)
            0
            (sizeof (. (-> state SCENE_APPEARANCE_STATE) custom_colors)))
          (= (-> state ACTIVE_TINT_IDX) 0)
          (call model_send_current_tokens)
          (if (call model_take_budget (& (-> state handle_sexstore_get_reply__LOAD_OK_BUDGET)))
            (call
              sexos_line
              "[shell.scene.settings.load] ok=1 preset=%u chrome=%u access=%u"
              (cast unsigned clamped)
              (cast unsigned chrome)
              (cast unsigned access))))
        (if (call model_take_budget (& (-> state handle_sexstore_get_reply__LOAD_FAIL_BUDGET)))
          (block
            (call sexos_line "[shell.scene.settings.load] ok=0 %s" (?: (== value 0) "not-found" "corrupt"))))))
    (fn void boot_load_scene_settings
      (void)
      (var SexosReply reply
        (call sexos_pdx_call SLOT_SEXSTORE OP_KV_GET SCENE_SETTINGS_KEY_APPEARANCE 0 0))
      (if (call
  model_take_budget
  (& (. (. SILK_SHELL_STATE models) boot_load_scene_settings__BOOT_LOAD_BUDGET)))
        (block
          (if (== (. reply status) 0)
            (block
              (= (. (. SILK_SHELL_STATE models) SEXSTORE_LOAD_PENDING) true)
              (call sexos_line "[shell.scene.settings.load.request] ok=1 pending"))
            (block
              (call
                sexos_line
                "[shell.scene.settings.load.request] ok=0 status=%llu"
                (cast (unsigned long long) (. reply status))))))))
    (fn void cycle_scene_render_token_preset
      (void)
      (var SilkShellModelsState (* state) (& (. SILK_SHELL_STATE models)))
      (=
        (. (-> state SCENE_APPEARANCE_STATE) preset_idx)
        (% (cast uint8_t (+ (. (-> state SCENE_APPEARANCE_STATE) preset_idx) 1)) PRESET_COUNT))
      (= (. (-> state SCENE_APPEARANCE_STATE) use_custom_colors) 0)
      (= (-> state ACTIVE_TINT_IDX) 0)
      (call model_send_current_tokens)
      (if (call model_take_budget (& (-> state cycle_scene_render_token_preset__CYCLE_BUDGET)))
        (call
          sexos_line
          "[shell.appearance.preset] idx=%u"
          (cast unsigned (. (-> state SCENE_APPEARANCE_STATE) preset_idx))))
      (call model_store_current_settings)
      (if (call model_take_budget (& (-> state cycle_scene_render_token_preset__SAVE_BUDGET)))
        (call
          sexos_line
          "[shell.scene.settings.save] preset=%u"
          (cast unsigned (. (-> state SCENE_APPEARANCE_STATE) preset_idx)))))
    (fn void cycle_prev_scene_render_token_preset
      (void)
      (var SilkShellModelsState (* state) (& (. SILK_SHELL_STATE models)))
      (var uint8_t old (. (-> state SCENE_APPEARANCE_STATE) preset_idx))
      (=
        (. (-> state SCENE_APPEARANCE_STATE) preset_idx)
        (?: (== old 0) (- PRESET_COUNT 1) (cast uint8_t (- old 1))))
      (= (. (-> state SCENE_APPEARANCE_STATE) use_custom_colors) 0)
      (= (-> state ACTIVE_TINT_IDX) 0)
      (call model_send_current_tokens)
      (if (call model_take_budget (& (-> state cycle_prev_scene_render_token_preset__CYCLE_PREV_BUDGET)))
        (call
          sexos_line
          "[shell.appearance.preset] idx=%u"
          (cast unsigned (. (-> state SCENE_APPEARANCE_STATE) preset_idx))))
      (call model_store_current_settings)
      (if (call model_take_budget (& (-> state cycle_prev_scene_render_token_preset__SAVE_PREV_BUDGET)))
        (call
          sexos_line
          "[shell.scene.settings.save] preset=%u"
          (cast unsigned (. (-> state SCENE_APPEARANCE_STATE) preset_idx)))))
    (fn void apply_custom_tint_bundle
      ((size_t index))
      (var SceneAppearanceState (* state) (& (. (. SILK_SHELL_STATE models) SCENE_APPEARANCE_STATE)))
      (if (== index 0)
        (block
          (= (-> state use_custom_colors) 0))
        (block
          (call
            memcpy
            (-> state custom_colors)
            ([] CUSTOM_TINT_BUNDLES index)
            (sizeof (-> state custom_colors)))
          (= (-> state use_custom_colors) 1))))
    (fn void cycle_custom_tint
      (void)
      (var SilkShellModelsState (* state) (& (. SILK_SHELL_STATE models)))
      (= (-> state ACTIVE_TINT_IDX) (% (cast uint8_t (+ (-> state ACTIVE_TINT_IDX) 1)) TINT_COUNT))
      (call apply_custom_tint_bundle (-> state ACTIVE_TINT_IDX))
      (call model_send_current_tokens)
      (if (call model_take_budget (& (-> state cycle_custom_tint__TINT_BUDGET)))
        (call
          sexos_line
          "[shell.appearance.custom] mode=tint tint=%u"
          (cast unsigned (-> state ACTIVE_TINT_IDX)))))
    (fn void handle_scene_settings_cmd
      ((uint64_t command) (uint64_t value) (uint64_t flags))
      (cast void flags)
      (var SilkShellModelsState (* state) (& (. SILK_SHELL_STATE models)))
      (var uint32_t (* budget) (& (-> state handle_scene_settings_cmd__CMD_BUDGET)))
      (switch
        command
        (block
          (case
            CMD_SET_PRESET
            (block
              (var uint8_t index (?: (< (cast size_t value) PRESET_COUNT) (cast uint8_t value) 0))
              (= (. (-> state SCENE_APPEARANCE_STATE) preset_idx) index)
              (= (. (-> state SCENE_APPEARANCE_STATE) use_custom_colors) 0)
              (call
                memset
                (. (-> state SCENE_APPEARANCE_STATE) custom_colors)
                0
                (sizeof (. (-> state SCENE_APPEARANCE_STATE) custom_colors)))
              (= (-> state ACTIVE_TINT_IDX) 0)
              (call model_send_current_tokens)
              (call model_store_current_settings)
              (if (call model_take_budget budget)
                (call sexos_line "[shell.scene.settings.cmd] cmd=1 preset=%u ok=1" (cast unsigned index)))
              break))
          (case CMD_CYCLE_PRESET (call cycle_scene_render_token_preset))
          (if (call model_take_budget budget)
            (call sexos_line "[shell.scene.settings.cmd] cmd=2 ok=1"))
          break
          (case
            CMD_SET_TINT
            (block
              (var uint8_t index (% (cast uint8_t value) TINT_COUNT))
              (= (-> state ACTIVE_TINT_IDX) index)
              (call apply_custom_tint_bundle index)
              (call model_send_current_tokens)
              (if (call model_take_budget budget)
                (call sexos_line "[shell.scene.settings.cmd] cmd=3 tint=%u ok=1" (cast unsigned index)))
              break))
          (case CMD_CYCLE_TINT (call cycle_custom_tint))
          (if (call model_take_budget budget)
            (call sexos_line "[shell.scene.settings.cmd] cmd=4 ok=1"))
          break
          (case
            CMD_SET_CHROME_FLAGS
            (= (. (-> state SCENE_APPEARANCE_STATE) chrome_flags) (cast uint8_t value)))
          (call model_send_current_tokens)
          (call model_store_current_settings)
          (if (call model_take_budget budget)
            (call
              sexos_line
              "[shell.scene.settings.cmd] cmd=5 flags=%u ok=1"
              (cast unsigned (cast uint8_t value))))
          break
          (case CMD_TOGGLE_TOP_BAR (call toggle_top_bar_for_active_frame))
          (if (call model_take_budget budget)
            (call sexos_line "[shell.scene.settings.cmd] cmd=6 ok=1"))
          break
          (case
            CMD_SET_ACCESSIBILITY
            (= (. (-> state SCENE_APPEARANCE_STATE) accessibility_flags) (cast uint8_t value)))
          (call model_send_current_tokens)
          (call model_store_current_settings)
          (if (call model_take_budget budget)
            (call
              sexos_line
              "[shell.scene.settings.cmd] cmd=7 flags=%u ok=1"
              (cast unsigned (cast uint8_t value))))
          break
          (case CMD_RESET_DEFAULTS (= (-> state SCENE_APPEARANCE_STATE) DEFAULT_SCENE_APPEARANCE))
          (= (-> state ACTIVE_TINT_IDX) 0)
          (call model_send_current_tokens)
          (call model_store_current_settings)
          (if (call model_take_budget budget)
            (call sexos_line "[shell.scene.settings.cmd] cmd=8 ok=1"))
          break
          (default
            (if (call model_take_budget budget)
              (call
                sexos_line
                "[shell.scene.settings.cmd] cmd=%llu ok=0 unknown"
                (cast (unsigned long long) command))))
          break)))
    (fn uint8_t shell_view_mode
      (void)
      (return (?: (. (. SILK_SHELL_STATE chrome) ATLAS_MODE_ENABLED) SHELL_VIEW_ATLAS SHELL_VIEW_DESKTOP)))









    (native "
uint8_t collar_check_operation(uint8_t operation, uint64_t object_id, uint64_t buffer_id) {
    uint64_t caller = SILK_SHELL_STATE.chrome.FOCUSED_SURFACE_ID;
    sexos_line(\"[collar.policy.check] op=%u object_id=%llu buffer_id=%llu caller_sid=%llu\",
               (unsigned)operation, (unsigned long long)object_id, (unsigned long long)buffer_id,
               (unsigned long long)caller);
    bool object_required =
        operation == COLLAR_OP_OPEN_OBJECT || operation == COLLAR_OP_LINK_OBJECT_TO_BUFFER ||
        operation == COLLAR_OP_RENAME_OBJECT || operation == COLLAR_OP_ARCHIVE_OBJECT;
    if (object_required && object_id != 0 && !linen_object_by_id(object_id, NULL)) {
        sexos_line(\"[collar.gate.reject] reason=missing_object op=%u object_id=%llu\",
                   (unsigned)operation, (unsigned long long)object_id);
        record_collar_audit(operation, object_id, caller, COLLAR_DECISION_DENY_MISSING_OBJECT, 0,
                            1);
        return COLLAR_DECISION_DENY_MISSING_OBJECT;
    }
    if (operation == COLLAR_OP_LINK_OBJECT_TO_BUFFER && buffer_id != 0 &&
        !quil_buffer_by_id(buffer_id, NULL)) {
        sexos_line(\"[collar.gate.reject] reason=missing_buffer op=%u buffer_id=%llu\",
                   (unsigned)operation, (unsigned long long)buffer_id);
        record_collar_audit(operation, buffer_id, caller, COLLAR_DECISION_DENY_MISSING_BUFFER, 0,
                            2);
        return COLLAR_DECISION_DENY_MISSING_BUFFER;
    }
    bool system_capability =
        operation == COLLAR_OP_ACCESS_BELL || operation == COLLAR_OP_ACCESS_SEXFILES;
    if (operation == COLLAR_OP_OPEN_OBJECT || operation == COLLAR_OP_LINK_OBJECT_TO_BUFFER ||
        system_capability) {
        if (system_capability) {
            if (caller == SURFACE_ID_SPINDLE || caller == SURFACE_ID_LINEN ||
                caller == SURFACE_ID_QUIL || caller == SURFACE_ID_MESH ||
                caller == SURFACE_ID_COLLAR || caller == SURFACE_ID_BELL_PLACEHOLDER) {
                sexos_line(
                    \"[collar.policy.allow] op=%u object=%llu caller=%llu grant=0 reason=core_app\",
                    (unsigned)operation, (unsigned long long)object_id, (unsigned long long)caller);
                record_collar_audit(operation, object_id, caller, COLLAR_DECISION_ALLOW, 0, 8);
                return COLLAR_DECISION_ALLOW;
            }
            if (caller < 300) {
                sexos_line(\"[collar.gate.reject] reason=unknown_app op=%u caller=%llu\",
                           (unsigned)operation, (unsigned long long)caller);
                record_collar_audit(operation, object_id, caller, COLLAR_DECISION_DENY, 0, 7);
                if (COLLAR_ENFORCE_PROOF_ENABLED)
                    sexos_line(
                        \"[collar.enforce.deny] op=%u caller=%llu target=%llu reason=unknown_app\",
                        (unsigned)operation, (unsigned long long)caller,
                        (unsigned long long)object_id);
                return COLLAR_DECISION_DENY;
            }
        }
        bool explicit_denial = false;
        if (!system_capability) {
            for (size_t i = 0; i < COLLAR_GRANT_CAP; ++i) {
                const CollarGrant *g = &SILK_SHELL_STATE.models.COLLAR_GRANTS[i];
                if (g->present && g->subject_id == caller && g->object_id == object_id &&
                    (g->operation_mask & (UINT64_C(1) << operation)) &&
                    g->state != COLLAR_GRANT_ACTIVE) {
                    explicit_denial = true;
                    break;
                }
            }
            if (explicit_denial) {
                record_collar_audit(operation, object_id, caller, COLLAR_DECISION_DENY, 0, 9);
                return COLLAR_DECISION_DENY;
            }
        }
        for (size_t i = 0; i < COLLAR_GRANT_CAP; ++i) {
            const CollarGrant *grant = &SILK_SHELL_STATE.models.COLLAR_GRANTS[i];
            if (!grant->present || grant->state != COLLAR_GRANT_ACTIVE ||
                grant->subject_id != caller)
                continue;
            if (grant->object_id != object_id) {
                bool workspace = false;
                if (!system_capability && grant->object_id == UINT64_MAX) {
                    for (size_t j = 0; j < LINEN_MAX_OBJECTS; ++j) {
                        const LinenObject *o = &SILK_SHELL_STATE.models.LINEN_OBJECTS[j];
                        if (o->present &&
                            shell_workspace_allows(
                                caller, operation, object_id, o->object_id, o->disk_path,
                                SILK_SHELL_STATE.models.LINEN_REMOTE_REAL, true, explicit_denial)) {
                            workspace = true;
                            break;
                        }
                    }
                }
                if (!workspace)
                    continue;
                sexos_line(
                    \"[collar.workspace.allow] subject=%llu object=%llu grant=%llu published=1 kernel_caps_minted=0\",
                    (unsigned long long)caller, (unsigned long long)object_id,
                    (unsigned long long)grant->grant_id);
            }
            if ((grant->operation_mask & (UINT64_C(1) << operation)) == 0)
                continue;
            sexos_line(\"[collar.grant.match] grant_id=%llu subject=%llu object=%llu op=%u\",
                       (unsigned long long)grant->grant_id, (unsigned long long)grant->subject_id,
                       (unsigned long long)grant->object_id, (unsigned)operation);
            sexos_line(\"[collar.policy.allow] op=%u object=%llu caller=%llu grant=%llu\",
                       (unsigned)operation, (unsigned long long)object_id,
                       (unsigned long long)caller, (unsigned long long)grant->grant_id);
            record_collar_audit(operation, object_id, caller, COLLAR_DECISION_ALLOW,
                                grant->grant_id, 0);
            if (system_capability && COLLAR_ENFORCE_PROOF_ENABLED)
                sexos_line(\"[collar.enforce.allow] op=%u caller=%llu target=%llu grant=%llu\",
                           (unsigned)operation, (unsigned long long)caller,
                           (unsigned long long)object_id, (unsigned long long)grant->grant_id);
            return COLLAR_DECISION_ALLOW;
        }
        sexos_line(\"[collar.grant.reject] reason=no_grant op=%u object=%llu caller=%llu\",
                   (unsigned)operation, (unsigned long long)object_id, (unsigned long long)caller);
        sexos_line(\"[collar.policy.deny] op=%u object=%llu caller=%llu reason=no_grant\",
                   (unsigned)operation, (unsigned long long)object_id, (unsigned long long)caller);
        record_collar_audit(operation, object_id, caller, COLLAR_DECISION_DENY, 0, 3);
        if (system_capability && COLLAR_ENFORCE_PROOF_ENABLED)
            sexos_line(\"[collar.enforce.deny] op=%u caller=%llu target=%llu reason=missing_cap\",
                       (unsigned)operation, (unsigned long long)caller,
                       (unsigned long long)object_id);
        return COLLAR_DECISION_DENY;
    }
    if (operation == COLLAR_OP_SAVE_BUFFER || operation == COLLAR_OP_BUILD_TARGET ||
        operation == COLLAR_OP_RUN_TARGET) {
        sexos_line(\"[collar.gate.reject] reason=stop_first op=%u\", (unsigned)operation);
        record_collar_audit(operation, object_id, caller, COLLAR_DECISION_BLOCKED_STOP_FIRST, 0, 4);
        return COLLAR_DECISION_BLOCKED_STOP_FIRST;
    }
    if (operation == COLLAR_OP_RENAME_OBJECT || operation == COLLAR_OP_ARCHIVE_OBJECT) {
        sexos_line(\"[collar.gate.needs_grant] op=%u\", (unsigned)operation);
        record_collar_audit(operation, object_id, caller, COLLAR_DECISION_NEEDS_GRANT_LATER, 0, 5);
        return COLLAR_DECISION_NEEDS_GRANT_LATER;
    }
    sexos_line(\"[collar.gate.reject] reason=always_deny op=%u\", (unsigned)operation);
    record_collar_audit(operation, object_id, caller, COLLAR_DECISION_DENY, 0, 6);
    if (COLLAR_ENFORCE_PROOF_ENABLED)
        sexos_line(\"[collar.enforce.deny] op=%u caller=%llu target=%llu reason=dangerous_cap\",
                   (unsigned)operation, (unsigned long long)caller, (unsigned long long)object_id);
    return COLLAR_DECISION_DENY;
}

void collar_init_grants(void) {
    SilkShellModelsState *state = &SILK_SHELL_STATE.models;
    uint64_t count = 0;
    for (size_t i = 0; i < LINEN_MAX_OBJECTS; ++i) {
        const LinenObject *object = &state->LINEN_OBJECTS[i];
        if (!object->present)
            continue;
        uint64_t subjects[2] = {SURFACE_ID_LINEN, SURFACE_ID_MESH};
        for (size_t j = 0; j < 2; ++j) {
            uint64_t generation = state->COLLAR_GRANT_GENERATION++;
            size_t index = ((size_t)generation - 1) % COLLAR_GRANT_CAP;
            state->COLLAR_GRANTS[index] = (CollarGrant){
                .present = true,
                .grant_id = generation,
                .subject_id = subjects[j],
                .object_id = object->object_id,
                .operation_mask = UINT64_C(1) << COLLAR_OP_LINK_OBJECT_TO_BUFFER,
                .generation = generation,
                .state = COLLAR_GRANT_ACTIVE,
            };
            sexos_line(
                \"[collar.grant.auto] grant_id=%llu subject=%llu object=%llu op=LinkObjectToBuffer\",
                (unsigned long long)generation, (unsigned long long)subjects[j],
                (unsigned long long)object->object_id);
            ++count;
        }
    }
    if (state->COLLAR_GRANT_GENERATION != UINT64_MAX) {
        uint64_t generation = state->COLLAR_GRANT_GENERATION;
        size_t index = ((size_t)generation - 1) % COLLAR_GRANT_CAP;
        if (state->COLLAR_GRANTS[index].present) {
            sexos_fail();
            for (;;) {
            }
        }
        state->COLLAR_GRANT_GENERATION = generation + 1;
        state->COLLAR_GRANTS[index] =
            (CollarGrant){.present = true,
                          .grant_id = generation,
                          .subject_id = SURFACE_ID_LINEN,
                          .object_id = UINT64_MAX,
                          .operation_mask = (UINT64_C(1) << COLLAR_OP_OPEN_OBJECT) |
                                            (UINT64_C(1) << COLLAR_OP_LINK_OBJECT_TO_BUFFER),
                          .generation = generation,
                          .state = COLLAR_GRANT_ACTIVE};
        ++count;
        sexos_line(
            \"[collar.workspace.seed] subject=200 grant=%llu storage_boot_edge=1 kernel_caps_minted=0 revocable=1\",
            (unsigned long long)generation);
    }
    sexos_line(\"[collar.grant.init] count=%llu generation=%llu\", (unsigned long long)count,
               (unsigned long long)state->COLLAR_GRANT_GENERATION);
}

void collar_render_grants_text(void) {
    uint8_t buffer[120];
    memset(buffer, ' ', sizeof buffer);
    uint8_t total = collar_grant_count();
    memcpy(buffer, \"COLLAR GRANTS\", 13);
    buffer[14] = (uint8_t)('0' + total / 10 % 10);
    buffer[15] = (uint8_t)('0' + total % 10);
    size_t row = 0;
    uint8_t visible = 0;
    for (size_t i = 0; i < COLLAR_GRANT_CAP && row < 5; ++i) {
        const CollarGrant *grant = &SILK_SHELL_STATE.models.COLLAR_GRANTS[i];
        if (!grant->present || grant->state != COLLAR_GRANT_ACTIVE)
            continue;
        size_t base = (row + 1) * 20;
        buffer[base] = visible == SILK_SHELL_STATE.models.COLLAR_SELECTED_GRANT_IDX ? '>' : ' ';
        buffer[base + 1] = 'G';
        buffer[base + 2] = (uint8_t)('0' + grant->grant_id / 10 % 10);
        buffer[base + 3] = (uint8_t)('0' + grant->grant_id % 10);
        buffer[base + 5] = 'S';
        buffer[base + 6] = (uint8_t)('0' + grant->subject_id / 100 % 10);
        buffer[base + 7] = (uint8_t)('0' + grant->subject_id / 10 % 10);
        buffer[base + 8] = (uint8_t)('0' + grant->subject_id % 10);
        buffer[base + 10] = 'O';
        buffer[base + 11] = (uint8_t)('0' + grant->object_id / 10 % 10);
        buffer[base + 12] = (uint8_t)('0' + grant->object_id % 10);
        if (grant->object_id == UINT64_MAX) {
            buffer[base + 10] = 'W';
            buffer[base + 11] = 'S';
            buffer[base + 12] = ' ';
        }
        buffer[base + 14] = 'A';
        ++row;
        ++visible;
    }
    (void)sexos_pdx_call(SLOT_DISPLAY, OP_TEXT_CLEAR, SURFACE_ID_COLLAR, 0, 0);
    bool accepted =
        shell_draw_text(SURFACE_ID_COLLAR, buffer, sizeof buffer, UINT64_C(0x00E8FFFF), NULL);
    uint32_t *budget =
        &SILK_SHELL_STATE.models.collar_render_grants_text__COLLAR_GRANTS_TEXT_BUDGET;
    if (*budget != 0) {
        --*budget;
        sexos_line(\"[collar.grants.render.ok] grants=%u ok=%u\", (unsigned)total,
                   (unsigned)accepted);
    }
}

bool open_linen_object_in_quil(uint64_t object_id) {
    sexos_line(\"[linen.quil.open.request] id=%llu\", (unsigned long long)object_id);
    LinenObject object;
    if (!linen_object_by_id(object_id, &object)) {
        sexos_line(\"[linen.quil.open.reject.missing] id=%llu\", (unsigned long long)object_id);
        return false;
    }
    if (object.disk_path != 0 && object.disk_path < 3) {
        sexos_line(\"[linen.quil.open.reject.workspace] object=%llu disk_path=%u protected=1\",
                   (unsigned long long)object_id, (unsigned)object.disk_path);
        return false;
    }
    if (object.grant_ref == 0)
        sexos_line(\"[linen.quil.open.no_grant] id=%llu kind=%u\", (unsigned long long)object_id,
                   (unsigned)object.kind);
    uint8_t capability = collar_check_operation(COLLAR_OP_ACCESS_SEXFILES,
                                                SILK_SHELL_STATE.chrome.FOCUSED_SURFACE_ID, 0);
    if (capability != COLLAR_DECISION_ALLOW) {
        sexos_line(\"[linen.quil.open.reject.cap] op=AccessSexFiles decision=%u\",
                   (unsigned)capability);
        return false;
    }
    uint8_t decision = collar_check_operation(COLLAR_OP_LINK_OBJECT_TO_BUFFER, object_id, 0);
    if (decision != COLLAR_DECISION_ALLOW) {
        sexos_line(\"[linen.quil.open.reject.collar] decision=%u\", (unsigned)decision);
        return false;
    }
    uint8_t kind = QUIL_BUF_KIND_TEXT;
    if (object.kind == LINEN_OBJ_KIND_CODE_FILE)
        kind = QUIL_BUF_KIND_CODE;
    else if (object.kind == LINEN_OBJ_KIND_MEDIA_ASSET)
        kind = QUIL_BUF_KIND_LINEN_OBJECT_VIEW;
    else if (object.kind == LINEN_OBJ_KIND_BUILD_ARTIFACT)
        kind = QUIL_BUF_KIND_BUILD_OUTPUT;
    uint64_t dynamic_id = QUIL_DYNAMIC_BUFFER_ID_BASE + object_id;
    uint64_t linked_id = dynamic_id;
    bool created = false;
    bool found = false;
    for (size_t i = 0; i < QUIL_MAX_BUFFERS; ++i) {
        QuilBuffer *buffer = &SILK_SHELL_STATE.models.QUIL_BUFFERS[i];
        if (buffer->present && buffer->linen_object_ref == object_id) {
            buffer->state = QUIL_BUF_STATE_OPEN;
            buffer->linked_surface_id = SURFACE_ID_QUIL;
            found = true;
            linked_id = buffer->buffer_id;
            sexos_line(\"[linen.quil.open.reuse_existing] object_id=%llu buffer_id=%llu\",
                       (unsigned long long)object_id, (unsigned long long)buffer->buffer_id);
            break;
        }
    }
    if (!found) {
        for (size_t i = 0; i < QUIL_MAX_BUFFERS; ++i) {
            const QuilBuffer *buffer = &SILK_SHELL_STATE.models.QUIL_BUFFERS[i];
            if (buffer->present && buffer->buffer_id == dynamic_id &&
                buffer->linen_object_ref != object_id) {
                sexos_line(
                    \"[linen.quil.open.reject.buffer_id_collision] dynamic_id=%llu existing_ref=%llu\",
                    (unsigned long long)dynamic_id, (unsigned long long)buffer->linen_object_ref);
                return false;
            }
        }
        for (size_t i = 0; i < QUIL_MAX_BUFFERS; ++i) {
            QuilBuffer *buffer = &SILK_SHELL_STATE.models.QUIL_BUFFERS[i];
            if (!buffer->present) {
                sexos_line(\"[linen.quil.open.dynamic_id] object_id=%llu dynamic_buffer_id=%llu\",
                           (unsigned long long)object_id, (unsigned long long)dynamic_id);
                *buffer = (QuilBuffer){
                    .present = true,
                    .buffer_id = dynamic_id,
                    .kind = kind,
                    .state = QUIL_BUF_STATE_OPEN,
                    .linen_object_ref = object_id,
                    .project_id = object.project_id,
                    .grant_ref = object.grant_ref,
                    .linked_surface_id = SURFACE_ID_QUIL,
                    .display_name = object.display_name,
                };
                created = true;
                found = true;
                break;
            }
        }
    }
    if (!found) {
        sexos_line(\"[linen.quil.open.reject.full] object_id=%llu\", (unsigned long long)object_id);
        return false;
    }
    for (size_t i = 0; i < LINEN_MAX_OBJECTS; ++i) {
        LinenObject *entry = &SILK_SHELL_STATE.models.LINEN_OBJECTS[i];
        if (entry->present && entry->object_id == object_id) {
            entry->linked_surface_id = SURFACE_ID_QUIL;
            break;
        }
    }
    sexos_line(\"[linen.quil.buffer.linked] object_id=%llu buffer_id=%llu kind=%u\",
               (unsigned long long)object_id, (unsigned long long)linked_id, (unsigned)kind);
    if (object.disk_path > 0) {
        uint64_t path = (uint64_t)object.disk_path - 1;
        (void)sexos_pdx_call(SLOT_QUIL, OP_QUIL_OPEN_DISK_DOC, object_id, path == 2 ? 0 : path, 0);
        sexos_line(\"[linen.quil.disk_doc.intent] object_id=%llu path_id=%llu ok=1\",
                   (unsigned long long)object_id, (unsigned long long)path);
    }
    if (open_quil_in_active_scene())
        sexos_line(\"[linen.quil.quil_opened] object_id=%llu\", (unsigned long long)object_id);
    sexos_line(\"[linen.quil.done] object_id=%llu buffer_created=%s\", (unsigned long long)object_id,
               created ? \"true\" : \"false\");
    mesh_emit_linen_quil_links();
    bell_emit_object_link_event(object_id, linked_id);
    quil_render_buffer_list();
    return true;
}
")
    (fn void quil_render_buffer_list
      (void)
      (var uint32_t width (. (. SILK_SHELL_STATE input) SURFACE_201_W))
      (var uint32_t height (. (. SILK_SHELL_STATE input) SURFACE_201_H))
      (if (|| (== width 0) (== height 0))
        (return))
      (call sexos_line "[quil.buffer_list.render] w=%u h=%u" (cast unsigned width) (cast unsigned height))
      (cast
        void
        (call
          sexos_pdx_call
          SLOT_DISPLAY
          0xEF
          SURFACE_ID_QUIL
          0
          (|
            (| (<< (cast uint64_t QUIL_LIST_HEADER_COLOR) 32) (<< (cast uint64_t QUIL_LIST_HEADER_H) 16))
            width)))
      (var size_t count (call quil_buffer_count))
      (var uint32_t background_height
        (-
          (* (cast uint32_t QUIL_LIST_ACCENT_BARS) (+ QUIL_LIST_ROW_H QUIL_LIST_ROW_GAP))
          QUIL_LIST_ROW_GAP))
      (cast
        void
        (call
          sexos_pdx_call
          SLOT_DISPLAY
          0xEF
          SURFACE_ID_QUIL
          (<< (cast uint64_t QUIL_LIST_HEADER_H) 32)
          (|
            (|
              (| (<< (call UINT64_C 1) 56) (<< (cast uint64_t QUIL_LIST_BG_COLOR) 32))
              (<< (cast uint64_t background_height) 16))
            width)))
      (call
        sexos_line
        "[quil.bg_rect] y=%u h=%u"
        (cast unsigned QUIL_LIST_HEADER_H)
        (cast unsigned background_height))
      (call sexos_line "[quil.row.reject] reason=no_selection_model")
      (var uint8_t rows 0)
      (for (var size_t i 0)
        (< i QUIL_MAX_BUFFERS)
        (++ i)
        (block
          (var (const QuilBuffer) (* buffer) (& ([] (. (. SILK_SHELL_STATE models) QUIL_BUFFERS) i)))
          (if (! (-> buffer present))
            continue)
          (if (>= rows QUIL_LIST_MAX_ROWS)
            (block
              (call
                sexos_line
                "[quil.buffer_list.skip] id=%llu reason=max_rows"
                (cast (unsigned long long) (-> buffer buffer_id)))
              continue))
          (call
            sexos_line
            "[quil.buffer_list.row] buffer_id=%llu kind=%s state=%s linen_ref=%llu surface_id=%llu name=%s"
            (cast (unsigned long long) (-> buffer buffer_id))
            (call quil_buffer_kind_name (-> buffer kind))
            (call quil_buffer_state_name (-> buffer state))
            (cast (unsigned long long) (-> buffer linen_object_ref))
            (cast (unsigned long long) (-> buffer linked_surface_id))
            (-> buffer display_name))
          (if (< rows QUIL_LIST_ACCENT_BARS)
            (block
              (var uint64_t rectangle (& (+ (cast uint64_t rows) 3) 7))
              (var uint32_t y
                (+ QUIL_LIST_HEADER_H (* (cast uint32_t rows) (+ QUIL_LIST_ROW_H QUIL_LIST_ROW_GAP))))
              (var uint32_t color (call quil_buffer_kind_color (-> buffer kind)))
              (cast
                void
                (call
                  sexos_pdx_call
                  SLOT_DISPLAY
                  0xEF
                  SURFACE_ID_QUIL
                  (<< (cast uint64_t y) 32)
                  (|
                    (| (| (<< rectangle 56) (<< (cast uint64_t color) 32)) (<< (cast uint64_t QUIL_LIST_ROW_H) 16))
                    QUIL_ACCENT_BAR_W)))
              (call
                sexos_line
                "[quil.row_visual.accent] index=%llu id=%llu kind=%s color=0x%08x"
                (cast (unsigned long long) rectangle)
                (cast (unsigned long long) (-> buffer buffer_id))
                (call quil_buffer_kind_name (-> buffer kind))
                (cast unsigned color)))
            (block
              (call
                sexos_line
                "[quil.row_visual.skip] id=%llu reason=accent_budget"
                (cast (unsigned long long) (-> buffer buffer_id)))))
          (++ rows)))
      (call sexos_line "[quil.buffer_list.done] count=%zu rows=%u" count (cast unsigned rows)))


  )
)
