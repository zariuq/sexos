    (fn void run_sexfiles_reboot_proofs (void)
      (call sexos_line "[sexfiles.reboot.proof.start]")
      (var RebootOutcome outcome)
      (var int64_t err (call diskfs_proof_reboot_persistence_roundtrip (& outcome)))
      (if (== err 0)
        (block
          (call sexos_line "[sexfiles.reboot.proof.write_commit] ok=%u objects_created=%u journal_records=%zu"
            (?: (. outcome write_committed) 1u 0u) (. outcome objects_created) (. outcome journal_records))
          (call sexos_line "[sexfiles.reboot.proof.verify_mount] ok=%u fs_generation_advanced=%s replay_applied=%zu"
            (?: (. outcome fs_generation_advanced) 1u 0u)
            (?: (. outcome fs_generation_advanced) "true" "false")
            (. outcome replay_applied))
