(cesta native-c/1 compact-c/2
  (unit
    (include "sexfiles.h")

    (comment "RamFS, DiskFS, Linen, Checkpoint, Extent, Fault, AP2-AP6, and SexFS v0 proof harnesses (servers/sexfiles/src/proof.rs).")

    (define SELF_PD "((uint32_t)0)")
    (define DISKFS_MANIFEST_OBJECT_PATH_STR "\"/disk/sexfiles-proof-v1\"")
    (define DISKFS_MANIFEST_OBJECT_PATH_LEN "((size_t)23)")
    (define DISKFS_OBJECT_PATH_LINEN_STR "\"/disk/linen-object-v1\"")
    (define DISKFS_OBJECT_PATH_LINEN_LEN "((size_t)21)")
    (define DISKFS_OBJECT_PATH_QUIL_STR "\"/disk/quil-object-v1\"")
    (define DISKFS_OBJECT_PATH_QUIL_LEN "((size_t)20)")

    (fn (static inline uint64_t) read_le64 (((const uint8_t) (* p)))
      (var uint64_t v 0)
      (for (var size_t i 0) (< i 8) (++ i)
        (|= v (<< (cast uint64_t ([] p i)) (* i 8))))
      (return v))
    (fn (static inline void) write_le16 ((uint8_t (* p)) (uint16_t v))
      (= ([] p 0) (cast uint8_t (& v 0xFFu)))
      (= ([] p 1) (cast uint8_t (& (>> v 8) 0xFFu))))
    (fn (static inline void) write_le32 ((uint8_t (* p)) (uint32_t v))
      (for (var size_t i 0) (< i 4) (++ i)
        (= ([] p i) (cast uint8_t (& (>> v (* i 8)) 0xFFu)))))
    (fn (static inline void) write_le64 ((uint8_t (* p)) (uint64_t v))
      (for (var size_t i 0) (< i 8) (++ i)
        (= ([] p i) (cast uint8_t (& (>> v (* i 8)) 0xFFu)))))
    (fn (static inline void) proof_fail (((const char) (* msg)))
      (cast void msg)
      (call sexos_spin_forever))

    (fn (static void) proof_create_write_read (void)
      (var (const uint8_t) (* name) (cast ((const uint8_t) *) "proof_roundtrip"))
      (var uint64_t handle 0)
      (if (!= (call ramfs_open name 15 RAMFS_O_CREATE 0 SELF_PD (& handle)) 0)
        (call proof_fail "[proof.1] open failed"))
      (if (<= handle 0)
        (call proof_fail "[proof.1] handle > 0"))
      (var (const uint8_t) (* data) (cast ((const uint8_t) *) "RamFS Contract Lock V1"))
      (var uint64_t written 0)
      (if (!= (call ramfs_write handle 0 data 22 SELF_PD (& written)) 0)
        (call proof_fail "[proof.1] write failed"))
      (if (!= (cast size_t written) 22)
        (call proof_fail "[proof.1] write len"))
      (var uint8_t ([] buf 64))
      (call memset buf 0 64)
      (var uint64_t n 0)
      (if (!= (call ramfs_read handle 0 buf 64 SELF_PD (& n)) 0)
        (call proof_fail "[proof.1] read failed"))
      (if (|| (!= (cast size_t n) 22) (!= (call memcmp buf data 22) 0))
        (call proof_fail "[proof.1] data roundtrip"))
      (if (!= (call ramfs_close handle SELF_PD) 0)
        (call proof_fail "[proof.1] close failed"))
      (call sexos_line "[sexfiles.ramfs.proof.1] create/write/read roundtrip OK"))

    (fn (static void) proof_invalid_handle (void)
      (var uint8_t ([] buf 8))
      (var uint64_t n 0)
      (var int64_t err (call ramfs_read 0xBAD 0 buf 8 SELF_PD (& n)))
      (if (!= err ERR_INVALID_HANDLE)
        (call proof_fail "[proof.2] err code"))
      (= err (call ramfs_close 0xDEAD SELF_PD))
      (if (!= err ERR_INVALID_HANDLE)
        (call proof_fail "[proof.2] close err code"))
      (call sexos_line "[sexfiles.ramfs.proof.2] invalid handle rejected OK"))

    (fn (static void) proof_oversized_name (void)
      (var (const uint8_t) (* long_name) (cast ((const uint8_t) *) "this_name_exceeds_the_24_byte_maximum_for_ramfs"))
      (var uint64_t h 0)
      (var int64_t err (call ramfs_open long_name 47 RAMFS_O_CREATE 0 SELF_PD (& h)))
      (if (!= err ERR_NAME_TOO_LONG)
        (call proof_fail "[proof.3] err code"))
      (call sexos_line "[sexfiles.ramfs.proof.3] oversized name rejected OK"))

    (fn (static void) proof_oob_write (void)
      (var (const uint8_t) (* name) (cast ((const uint8_t) *) "proof_oob"))
      (var uint64_t handle 0)
      (if (!= (call ramfs_open name 9 RAMFS_O_CREATE 0 SELF_PD (& handle)) 0)
        (call proof_fail "[proof.4] open failed"))
      (var uint8_t ([] big (+ RAMFS_MAX_FILE_SIZE 1)))
      (call memset big 0xBB (sizeof big))
      (var uint64_t written 0)
      (var int64_t err (call ramfs_write handle 0 big (+ RAMFS_MAX_FILE_SIZE 1) SELF_PD (& written)))
      (if (!= err ERR_OVERFLOW)
        (call proof_fail "[proof.4] err code"))
      (var uint8_t ([] ok_data RAMFS_MAX_FILE_SIZE))
      (call memset ok_data 0xCC (sizeof ok_data))
      (if (!= (call ramfs_write handle 0 ok_data RAMFS_MAX_FILE_SIZE SELF_PD (& written)) 0)
        (call proof_fail "[proof.4] boundary write should succeed"))
      (if (!= (cast size_t written) RAMFS_MAX_FILE_SIZE)
        (call proof_fail "[proof.4] boundary write len"))
      (if (== (call ramfs_write handle 1 ok_data RAMFS_MAX_FILE_SIZE SELF_PD (& written)) 0)
        (call proof_fail "[proof.4] post-boundary write must err"))
      (if (!= (call ramfs_close handle SELF_PD) 0)
        (call proof_fail "[proof.4] close failed"))
      (call sexos_line "[sexfiles.ramfs.proof.4] OOB write rejected OK"))

    (fn (static void) proof_oob_read_clamped (void)
      (var (const uint8_t) (* name) (cast ((const uint8_t) *) "proof_oob_read"))
      (var uint64_t handle 0)
      (if (!= (call ramfs_open name 14 RAMFS_O_CREATE 0 SELF_PD (& handle)) 0)
        (call proof_fail "[proof.5] open failed"))
      (var (const uint8_t) (* data) (cast ((const uint8_t) *) "1234567890"))
      (var uint64_t written 0)
      (if (!= (call ramfs_write handle 0 data 10 SELF_PD (& written)) 0)
        (call proof_fail "[proof.5] write failed"))
      (var uint8_t ([] buf 8))
      (var uint64_t n 0)
      (if (!= (call ramfs_read handle 100 buf 8 SELF_PD (& n)) 0)
        (call proof_fail "[proof.5] OOB read should not err"))
      (if (!= n 0)
        (call proof_fail "[proof.5] OOB read returns 0"))
      (if (!= (call ramfs_read handle 5 buf 8 SELF_PD (& n)) 0)
        (call proof_fail "[proof.5] partial read"))
      (if (|| (!= n 5) (!= (call memcmp buf "67890" 5) 0))
        (call proof_fail "[proof.5] partial read data"))
      (if (!= (call ramfs_close handle SELF_PD) 0)
        (call proof_fail "[proof.5] close failed"))
      (call sexos_line "[sexfiles.ramfs.proof.5] OOB read clamped OK"))

    (fn (static void) proof_max_files (void)
      (var uint64_t ([] handles RAMFS_MAX_FILES))
      (for (var size_t i 0) (< i RAMFS_MAX_FILES) (++ i)
        (block
          (var uint8_t ([] name 16))
          (call memset name 0 16)
          (call memcpy name "file_" 5)
          (var cesta_write_bytes out
            (compound cesta_write_bytes
              (= (. data) (+ name 5))
              (= (. len) 11)))
          (var size_t dlen (call format_bytes_unsigned_decimal out (cast uint64_t i)))
          (var size_t nlen (+ 5 dlen))
          (if (!= (call ramfs_open name nlen RAMFS_O_CREATE 0 SELF_PD (& ([] handles i))) 0)
            (call proof_fail "[proof.6] max file create"))))
      (var uint64_t dummy 0)
      (var int64_t err (call ramfs_open (cast ((const uint8_t) *) "file_overflow") 13 RAMFS_O_CREATE 0 SELF_PD (& dummy)))
      (if (!= err ERR_FULL)
        (call proof_fail "[proof.6] err code"))
      (for (var size_t i 0) (< i RAMFS_MAX_FILES) (++ i)
        (if (!= (call ramfs_close ([] handles i) SELF_PD) 0)
          (call proof_fail "[proof.6] close failed")))
      (if (!= (call ramfs_len SELF_PD) 0)
        (call proof_fail "[proof.6] all closed"))
      (call sexos_line "[sexfiles.ramfs.proof.6] max files limit enforced OK"))

    (fn (static void) proof_close_reopen_persist (void)
      (var (const uint8_t) (* name) (cast ((const uint8_t) *) "proof_persist"))
      (var uint64_t handle 0)
      (if (!= (call ramfs_open name 13 RAMFS_O_CREATE 0 SELF_PD (& handle)) 0)
        (call proof_fail "[proof.7] open failed"))
      (var (const uint8_t) (* data) (cast ((const uint8_t) *) "Persist!"))
      (var uint64_t written 0)
      (if (!= (call ramfs_write handle 0 data 8 SELF_PD (& written)) 0)
        (call proof_fail "[proof.7] write failed"))
      (if (!= (call ramfs_close handle SELF_PD) 0)
        (call proof_fail "[proof.7] close failed"))
      (var uint64_t reopened 0)
      (if (!= (call ramfs_open name 13 0 0 SELF_PD (& reopened)) 0)
        (call proof_fail "[proof.7] reopen failed"))
      (var uint8_t ([] buf 64))
      (var uint64_t n 0)
      (if (!= (call ramfs_read reopened 0 buf 64 SELF_PD (& n)) 0)
        (call proof_fail "[proof.7] read failed"))
      (if (|| (!= n 8) (!= (call memcmp buf data 8) 0))
        (call proof_fail "[proof.7] reopen data intact"))
      (if (!= (call ramfs_close reopened SELF_PD) 0)
        (call proof_fail "[proof.7] close reopened failed"))
      (call sexos_line "[sexfiles.ramfs.proof.7] close+reopen data persistence OK"))

    (fn (static void) proof_non_owner_denied (void)
      (var (const uint8_t) (* name) (cast ((const uint8_t) *) "proof_owner"))
      (var uint64_t handle 0)
      (if (!= (call ramfs_open name 11 RAMFS_O_CREATE 0 1 (& handle)) 0)
        (call proof_fail "[proof.8] open failed"))
      (var uint8_t ([] buf 8))
      (var uint64_t n 0)
      (if (!= (call ramfs_read handle 0 buf 8 2 (& n)) ERR_PERM_DENIED)
        (call proof_fail "[proof.8] non-owner read must err"))
      (if (!= (call ramfs_write handle 0 (cast ((const uint8_t) *) "x") 1 2 (& n)) ERR_PERM_DENIED)
        (call proof_fail "[proof.8] non-owner write must err"))
      (if (!= (call ramfs_close handle 2) ERR_PERM_DENIED)
        (call proof_fail "[proof.8] non-owner close must err"))
      (var uint64_t sz 0)
      (var uint32_t nl 0)
      (if (!= (call ramfs_stat handle 2 (& sz) (& nl)) ERR_PERM_DENIED)
        (call proof_fail "[proof.8] non-owner stat must err"))
      (var uint64_t h2 0)
      (if (!= (call ramfs_open name 11 0 0 2 (& h2)) ERR_PERM_DENIED)
        (call proof_fail "[proof.8] non-owner open must err"))
      (if (|| (!= (call ramfs_read handle 0 buf 8 1 (& n)) 0) (!= n 0))
        (call proof_fail "[proof.8] owner read should succeed"))
      (if (!= (call ramfs_close handle 1) 0)
        (call proof_fail "[proof.8] owner close failed"))
      (call sexos_line "[sexfiles.ramfs.proof.8] non-owner access denied OK"))

    (fn void run_all_proofs (void)
      (call sexos_line "[sexfiles.ramfs.proof.start]")
      (call proof_create_write_read)
      (call proof_invalid_handle)
      (call proof_oversized_name)
      (call proof_oob_write)
      (call proof_oob_read_clamped)
      (call proof_max_files)
      (call proof_close_reopen_persist)
      (call proof_non_owner_denied)
      (call sexos_line "[sexfiles.ramfs.proof.done] ALL CHECKS PASSED"))

    (fn void run_diskfs_object_table_proofs (void)
      (if (!= (call diskfs_format_init_empty) 0)
        (call proof_fail "[diskfs.proof] format failed"))
      (call sexos_line "[diskfs.proof.format] ok=1")
      (var SexfilesSuperblock sb)
      (if (!= (call diskfs_mount (& sb)) 0)
        (call proof_fail "[diskfs.proof] mount failed"))
      (var bool ok_mount (&& (== (. sb version_major) 1) (&& (== (. sb block_size) 4096) (== (. sb object_table_entry_count) (cast uint32_t DISKFS_MAX_OBJECTS)))))
      (call sexos_line "[diskfs.proof.mount] ok=%u gen=%llu" (?: ok_mount 1u 0u) (cast (unsigned long long) (. sb fs_generation)))
      (var uint64_t oid 0)
      (if (!= (call diskfs_create_object_entry 1 9 (& oid)) 0)
        (call proof_fail "[diskfs.proof] create failed"))
      (call sexos_line "[diskfs.proof.create_object] id=%llu owner=9 kind=1" (cast (unsigned long long) oid))
      (var SexfilesObjectEntry st)
      (if (!= (call diskfs_stat_object_entry oid (& st)) 0)
        (call proof_fail "[diskfs.proof] stat failed"))
      (var bool ok_stat (&& (== (. st object_id) oid) (&& (== (. st owner_pd) 9) (== (. st kind) 1))))
      (call sexos_line "[diskfs.proof.stat_object] ok=%u id=%llu owner=%u" (?: ok_stat 1u 0u) (cast (unsigned long long) (. st object_id)) (. st owner_pd))
      (var int64_t invalid (call diskfs_stat_object_entry UINT64_MAX NULL))
      (var bool ok_invalid (== invalid ERR_INVALID_HANDLE))
      (call sexos_line "[diskfs.proof.invalid_object] ok=%u" (?: ok_invalid 1u 0u))
      (for (var size_t i 1) (< i DISKFS_MAX_OBJECTS) (++ i)
        (block
          (var uint64_t dummy 0)
          (if (!= (call diskfs_create_object_entry 2 9 (& dummy)) 0)
            (call proof_fail "[diskfs.proof] fill failed"))))
      (var uint64_t full_oid 0)
      (var int64_t full (call diskfs_create_object_entry 2 9 (& full_oid)))
      (var bool ok_full (== full ERR_FULL))
      (call sexos_line "[diskfs.proof.table_full] ok=%u slots=%zu" (?: ok_full 1u 0u) (cast size_t DISKFS_MAX_OBJECTS)))

    (fn void run_sexfiles_journal_proofs (void)
      (if (!= (call diskfs_format_init_empty) 0)
        (call proof_fail "[sexfiles.journal.proof] format failed"))
      (if (!= (call diskfs_mount NULL) 0)
        (call proof_fail "[sexfiles.journal.proof] mount failed"))
      (var size_t before (call diskfs_journal_len))
      (var uint64_t oid 0)
      (if (!= (call diskfs_create_object_entry 1 11 (& oid)) 0)
        (call proof_fail "[sexfiles.journal.proof] create failed"))
      (var size_t after (call diskfs_journal_len))
      (var bool ok_begin (>= after (+ before 3)))
      (var size_t delta (?: (>= after before) (- after before) 0))
      (call sexos_line "[sexfiles.journal.proof.begin] ok=%u oid=%llu" (?: ok_begin 1u 0u) (cast (unsigned long long) oid))
      (call sexos_line "[sexfiles.journal.proof.append] ok=%u delta=%zu" (?: ok_begin 1u 0u) delta)
      (call sexos_line "[sexfiles.journal.proof.commit] ok=%u journal_len=%zu" (?: ok_begin 1u 0u) after)
      (var bool full_hit false)
      (for (var size_t i 0) (< i (+ DISKFS_JOURNAL_CAPACITY 8)) (++ i)
        (block
          (var uint64_t dummy 0)
          (var int64_t err (call diskfs_create_object_entry 2 11 (& dummy)))
          (if (== err ERR_FULL)
            (block
              (= full_hit true)
              break))
          (if (!= err 0)
            break)))
      (call sexos_line "[sexfiles.journal.proof.full] ok=%u cap=%zu" (?: full_hit 1u 0u) (cast size_t DISKFS_JOURNAL_CAPACITY))
      (if (!= (call diskfs_format_init_empty) 0)
        (call proof_fail "[sexfiles.journal.proof] reformat failed"))
      (if (!= (call diskfs_mount NULL) 0)
        (call proof_fail "[sexfiles.journal.proof] remount failed"))
      (var int64_t bad (call diskfs_proof_inject_bad_record_for_checksum))
      (var bool ok_bad (== bad ERR_OVERFLOW))
      (call sexos_line "[sexfiles.journal.proof.checksum_reject] ok=%u" (?: ok_bad 1u 0u)))

    (fn void run_sexfiles_replay_proofs (void)
      (var ReplayOutcome out)
      (if (!= (call diskfs_proof_replay_recovery_scenario (& out)) 0)
        (call proof_fail "[sexfiles.replay.proof] scenario failed"))
      (call sexos_line "[sexfiles.replay.proof.committed_applied] ok=%u" (?: (. out committed_applied) 1u 0u))
      (call sexos_line "[sexfiles.replay.proof.uncommitted_ignored] ok=%u" (?: (. out uncommitted_ignored) 1u 0u))
      (call sexos_line "[sexfiles.replay.proof.corrupt_rejected] ok=%u" (?: (. out corrupt_rejected) 1u 0u))
      (call sexos_line "[sexfiles.replay.proof.generation_order] ok=%u" (?: (. out generation_order) 1u 0u))
      (call sexos_line "[sexfiles.replay.proof.object_restored] ok=%u" (?: (. out object_restored) 1u 0u)))

    (fn void run_sexfiles_cap_record_proofs (void)
      (var (const uint8_t) (* name) (cast ((const uint8_t) *) "caprec_file"))
      (var uint32_t owner_pd 41)
      (var uint32_t subject_pd 42)
      (var uint32_t other_pd 43)
      (var uint64_t h_owner 0)
      (if (!= (call ramfs_open name 11 RAMFS_O_CREATE 0 owner_pd (& h_owner)) 0)
        (block
          (call sexos_line "[sexfiles.caprec.proof.grant_allow] ok=0")
          (call sexos_line "[sexfiles.caprec.proof.read_allow] ok=0")
          (call sexos_line "[sexfiles.caprec.proof.write_allow] ok=0")
          (call sexos_line "[sexfiles.caprec.proof.missing_deny] ok=0")
          (call sexos_line "[sexfiles.caprec.proof.revoked_deny] ok=0")
          (call sexos_line "[sexfiles.caprec.proof.generation_deny] ok=0")
          (return)))
      (var uint64_t dummy_w 0)
      (cast void (call ramfs_write h_owner 0 (cast ((const uint8_t) *) "seed") 4 owner_pd (& dummy_w)))
      (var uint8_t grant_rights (cast uint8_t (| (| CAP_RIGHT_READ CAP_RIGHT_WRITE) (| CAP_RIGHT_APPEND (| CAP_RIGHT_LIST CAP_RIGHT_GRANT)))))
      (var bool grant_allow (== (call ramfs_proof_grant_caps_by_name owner_pd name 11 subject_pd grant_rights) 0))
      (call sexos_line "[sexfiles.caprec.proof.grant_allow] ok=%u" (?: grant_allow 1u 0u))
      (var uint64_t h_subject 0)
      (if (!= (call ramfs_open name 11 0 0 subject_pd (& h_subject)) 0)
        (block
          (call sexos_line "[sexfiles.caprec.proof.read_allow] ok=0")
          (call sexos_line "[sexfiles.caprec.proof.write_allow] ok=0")
          (call sexos_line "[sexfiles.caprec.proof.missing_deny] ok=0")
          (call sexos_line "[sexfiles.caprec.proof.revoked_deny] ok=0")
          (call sexos_line "[sexfiles.caprec.proof.generation_deny] ok=0")
          (cast void (call ramfs_close h_owner owner_pd))
          (return)))
      (var uint8_t ([] buf 8))
      (var uint64_t n 0)
      (var bool read_ok (== (call ramfs_read h_subject 0 buf 8 subject_pd (& n)) 0))
      (call sexos_line "[sexfiles.caprec.proof.read_allow] ok=%u" (?: read_ok 1u 0u))
      (var bool write_ok (== (call ramfs_write h_subject 1 (cast ((const uint8_t) *) "X") 1 subject_pd (& dummy_w)) 0))
      (call sexos_line "[sexfiles.caprec.proof.write_allow] ok=%u" (?: write_ok 1u 0u))
      (var bool missing_deny (== (call ramfs_read h_subject 0 buf 8 other_pd (& n)) ERR_PERM_DENIED))
      (call sexos_line "[sexfiles.caprec.proof.missing_deny] ok=%u" (?: missing_deny 1u 0u))
      (cast void (call ramfs_proof_revoke_caps_by_name owner_pd name 11))
      (var bool revoked_deny (== (call ramfs_read h_subject 0 buf 8 subject_pd (& n)) ERR_PERM_DENIED))
      (call sexos_line "[sexfiles.caprec.proof.revoked_deny] ok=%u" (?: revoked_deny 1u 0u))
      (cast void (call ramfs_proof_inject_stale_generation_cap name 11 subject_pd CAP_RIGHT_READ 1))
      (var bool generation_deny (== (call ramfs_read h_subject 0 buf 8 subject_pd (& n)) ERR_PERM_DENIED))
      (call sexos_line "[sexfiles.caprec.proof.generation_deny] ok=%u" (?: generation_deny 1u 0u))
      (cast void (call ramfs_close h_owner owner_pd)))

    (fn void run_linen_sexfiles_metadata_proofs (void)
      (call sexos_line "[sexfiles.linen.metadata.proof.start]")
      (var (const uint8_t) (* meta_name) (cast ((const uint8_t) *) "linen_meta_proof_01"))
      (var uint32_t owner_pd 42)
      (var uint32_t other_pd 99)
      (var uint64_t h 0)
      (var int64_t err (call ramfs_create_with_owner meta_name 19 owner_pd 0 (& h)))
      (if (!= err 0)
        (block
          (call sexos_line "[linen.sexfiles.proof.create_link] ok=0 err=%lld" (cast (long long) err))
          (call sexos_line "[sexfiles.linen.metadata.proof.done] FAILED")
          (return)))
      (call sexos_line "[linen.sexfiles.proof.create_link] ok=1 handle=%llu owner=%u" (cast (unsigned long long) h) owner_pd)
      (var uint8_t ([] data 8))
      (= ([] data 0) 0x01) (= ([] data 1) 0x00) (= ([] data 2) 0x2A) (= ([] data 3) 0x00)
      (= ([] data 4) 0x00) (= ([] data 5) 0x00) (= ([] data 6) 0x00) (= ([] data 7) 0x01)
      (var uint64_t n 0)
      (= err (call ramfs_write h 0 data 8 owner_pd (& n)))
      (if (== err 0)
        (call sexos_line "[linen.sexfiles.proof.generation] ok=1 n=%llu" (cast (unsigned long long) n))
        (call sexos_line "[linen.sexfiles.proof.generation] ok=0 err=%lld" (cast (long long) err)))
      (var uint64_t lh 0)
      (var uint32_t name_len 0)
      (if (call ramfs_list_at 0 owner_pd (& lh) (& name_len))
        (call sexos_line "[linen.sexfiles.proof.list_link] ok=1 handle=%llu name_len=%u" (cast (unsigned long long) lh) name_len)
        (call sexos_line "[linen.sexfiles.proof.list_link] ok=0 reason=not_found"))
      (var uint64_t sz 0)
      (= err (call ramfs_stat h owner_pd (& sz) (& name_len)))
      (if (== err 0)
        (call sexos_line "[linen.sexfiles.proof.get_link] ok=1 size=%llu name_len=%u" (cast (unsigned long long) sz) name_len)
        (call sexos_line "[linen.sexfiles.proof.get_link] ok=0 err=%lld" (cast (long long) err)))
      (var uint8_t ([] buf 8))
      (= err (call ramfs_read h 0 buf 8 other_pd (& n)))
      (var bool deny_ok (== err ERR_PERM_DENIED))
      (call sexos_line "[linen.sexfiles.proof.owner_deny] ok=%u" (?: deny_ok 1u 0u))
      (cast void (call ramfs_close h owner_pd))
      (call sexos_line "[sexfiles.linen.metadata.proof.done] ALL CHECKS PASSED"))

    (fn void run_linen_disk_object_proof (void)
      (call sexos_line "[linen.disk.object.proof.begin]")
      (var uint64_t buf_va (call diskfs_bridge_get_buf_va))
      (if (|| (== buf_va 0) (== buf_va UINT64_MAX))
        (block
          (call sexos_line "[linen.disk.object.proof] buf_grant_failed va=%#llx" (cast (unsigned long long) buf_va))
          (return)))
      (call sexos_line "[linen.disk.object.proof.buf_va] va=%#llx" (cast (unsigned long long) buf_va))
      (var (const uint8_t) (* path) (cast ((const uint8_t) *) DISKFS_MANIFEST_OBJECT_PATH_STR))
      (var size_t path_len DISKFS_MANIFEST_OBJECT_PATH_LEN)
      (var uint8_t ([] manifest_sector 512))
      (call diskfs_proof_manifest_build_single_entry_sector manifest_sector)
      (var (volatile uint8_t) (* p) (cast ((volatile uint8_t) *) (cast uintptr_t buf_va)))
      (for (var size_t i 0) (< i 512) (++ i)
