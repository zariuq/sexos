    (fn uint64_t va_alloc ((uint64_t size))
      (comment "A reservation names at least one page and never wraps; a misaligned cursor reserves nothing.")
      (if (|| (== size 0) (> size (- UINT64_MAX (- KERNEL_PAGE_SIZE 1)))) (return NO_ADDRESS))
      (if (|| (|| (< (. frames va_next) USER_VA_BASE) (>= (. frames va_next) USER_VA_END))
              (!= (% (. frames va_next) KERNEL_PAGE_SIZE) 0)) (return NO_ADDRESS))
      (var uint64_t rounded (call align_up size KERNEL_PAGE_SIZE))
