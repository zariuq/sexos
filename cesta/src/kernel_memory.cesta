      (if (== phys NO_ADDRESS) (return NULL))
      (= ([] table index) (| phys (| PTE_PRESENT (| PTE_WRITABLE (?: user PTE_USER 0)))))
      (return (call table_at phys)))

    (fn (static uint64_t) * root_table (void)
      (return (call table_at (call cpu_read_cr3))))

    (fn (static uint64_t) table_index ((uint64_t va) (unsigned level))
      (return (& (>> va (+ 12 (* 9 level))) 511)))

    (comment "Map one 4 KiB page with the given flags and protection key. A page that is already mapped is refused, as the reference's mapper refuses it. Program frames use their single-tracking wrapper.")
    (fn bool map_page ((uint64_t va) (uint64_t phys) (uint64_t flags) (uint8_t key))
      (if (&& (call program_frame_blocked phys) (! (. program_frames map_active))) (return false))
      (var bool user (!= (& flags PTE_USER) 0))
      (var uint64_t (* table) (call root_table))
      (for (var unsigned level 3) (> level 0) (-- level)
        (block
          (= table (call next_table table (call table_index va level) user true))
          (if (== table NULL) (return false))))
      (var uint64_t (* pte) (& ([] table (call table_index va 0))))
      (if (!= (& (* pte) PTE_PRESENT) 0) (return false))
