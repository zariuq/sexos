    (var (static const uint8_t) ([] CURSOR_ARROW_BITMAP 16)
      (init 0x80 0xC0 0xE0 0xF0 0xF8 0xFC 0xFE 0xFC 0xD8 0x8C 0x0C 0x06 0x06 0x03 0x03 0x01))

    (comment "A glyph row; Rust's index check panics on a digit or row out of range.")
    (fn (static uint8_t) digit_row ((size_t digit) (size_t row))
      (if (|| (>= digit 10) (>= row 7)) (call panic))
      (return ([] ([] FONT digit) row)))

    (comment "The toolbar title of known surfaces, in 5x7 glyphs after the light zone. Lowercase letters have no glyph here and stay blank, as in the Rust.")
    (fn (static bool) toolbar_title_fg_at ((size_t lx) (size_t ly) (uint64_t surface_id) (uint32_t (* out)))
      (var size_t title_x (+ FRAME_TOP_BAR_LIGHT_EXCLUSION_PX 12))
      (var size_t title_y 10)
      (if (|| (< lx title_x) (|| (< ly title_y) (>= ly (+ title_y 7)))) (return false))
      (var size_t col (/ (- lx title_x) 6))
      (var size_t px (% (- lx title_x) 6))
      (var size_t py (- ly title_y))
      (if (>= px 5) (return false))
      (var (const char) (* title) NULL)
      (if (== surface_id 200) (= title "Linen")
        (if (== surface_id 201) (= title "Quil")
          (if (== surface_id 0x99) (= title "Spindle")
            (if (== surface_id 100) (= title "App") (return false)))))
      (if (>= col (call sexos_strlen title)) (return false))
      (var uint8_t ch (cast uint8_t ([] title col)))
      (if (|| (< ch 0x20) (> ch 0x5A)) (return false))
      (var size_t glyph_idx (- ch 0x20))
      (if (!= (& (>> ([] ([] FONT_ASCII_5X7 glyph_idx) py) (- 4 px)) 1) 0)
        (block
          (= (* out) 0x00E8FFFFu)
          (return true)))
      (return false))

    (comment "TEXT_MODEL_V2: recompute the line table after a text write. A buffer without a newline keeps the legacy 20 columns every pre-V2 writer pads to; any newline switches to width-derived wrap, (w - 10) / 6 clamped to 1..80.")
    (fn (static void) recompute_text_lines ((Surface (* surf)))
      (var size_t len (call min_size (-> surf text_len) TEXT_BUF_CAP))
      (= (-> surf line_count) 0)
      (if (== len 0)
        (block
          (= (-> surf wrap_cols) TEXT_LEGACY_COLS)
          (return)))
      (var bool has_newline false)
      (for (var size_t i 0) (< i len) (++ i)
        (if (== ([] (-> surf text_buf) i) 0x0A) (= has_newline true)))
      (if has_newline
        (block
          (comment "The Rust narrows (w - 10) / 6 to u8 before clamping.")
          (var uint8_t derived (cast uint8_t (/ (?: (> (-> surf w) 10) (- (-> surf w) 10) 0) 6)))
          (= (-> surf wrap_cols) (?: (< derived 1) 1 (?: (> derived 80) 80 derived))))
        (= (-> surf wrap_cols) TEXT_LEGACY_COLS))
      (var size_t cols (-> surf wrap_cols))
      (var size_t i 0)
      (var size_t col 0)
      (= ([] (-> surf line_starts) 0) 0)
      (= (-> surf line_count) 1)
      (while (< i len)
        (block
          (var uint8_t c ([] (-> surf text_buf) i))
          (+= i 1)
          (if (== c 0x0A)
            (block
              (if (>= (-> surf line_count) TEXT_MAX_ROWS) break)
              (= ([] (-> surf line_starts) (-> surf line_count)) (cast uint16_t i))
              (+= (-> surf line_count) 1)
              (= col 0))
            (block
              (+= col 1)
              (if (&& (>= col cols) (< i len))
                (block
                  (if (>= (-> surf line_count) TEXT_MAX_ROWS) break)
                  (= ([] (-> surf line_starts) (-> surf line_count)) (cast uint16_t i))
                  (+= (-> surf line_count) 1)
                  (= col 0))))))))

    (comment "Surface text in 5x7 glyphs with 1-pixel spacing and 9-pixel lines, inset 8 from the left and 24 from the top. Lowercase folds to the uppercase glyphs (TEXT_MODEL_V2).")
    (fn (static bool) surface_text_fg_at ((size_t x) (size_t y) ((const Surface) (* surf)) (uint32_t (* out)))
      (if (|| (== (-> surf text_len) 0) (== (-> surf line_count) 0)) (return false))
      (var size_t tx (call saturating_add (cast size_t (-> surf x)) 8))
      (var size_t ty (call saturating_add (cast size_t (-> surf y)) 24))
      (if (|| (< x tx) (< y ty)) (return false))
      (var size_t col (/ (- x tx) 6))
      (var size_t row (/ (- y ty) 9))
      (var size_t px (% (- x tx) 6))
      (var size_t py (% (- y ty) 9))
      (if (|| (>= px 5) (>= py 7)) (return false))
      (if (|| (>= col (-> surf wrap_cols)) (>= row (-> surf line_count))) (return false))
      (if (>= row TEXT_MAX_ROWS) (call panic))
      (var size_t start ([] (-> surf line_starts) row))
      (var size_t end (?: (< (+ row 1) (-> surf line_count)) (cast size_t ([] (-> surf line_starts) (+ row 1))) (cast size_t (-> surf text_len))))
      (var size_t char_idx (+ start col))
      (if (|| (>= char_idx end) (>= char_idx (-> surf text_len))) (return false))
      (if (>= char_idx TEXT_BUF_CAP) (call panic))
      (var uint8_t c ([] (-> surf text_buf) char_idx))
      (var bool lower (&& (>= c 0x61) (<= c 0x7A)))
      (if (|| (< c 0x20) (&& (> c 0x5A) (! lower))) (return false))
      (var size_t glyph_idx (?: lower (+ (- c 0x61) 0x21) (- c 0x20)))
      (if (>= glyph_idx 59) (return false))
      (if (!= (& (>> ([] ([] FONT_ASCII_5X7 glyph_idx) py) (- 4 px)) 1) 0)
        (block
          (= (* out) (-> surf text_color))
          (return true)))
      (return false))

    (comment "Clock digits drawn inline in the pixel loop, so no separate overlay pass opens a tear window. Colons at offsets 14 and 31, digits at 0, 7, 17, 24, 34, 41.")
    (var (static const size_t) ([] CLOCK_DIGIT_X 6) (init 0 7 17 24 34 41))
    (fn (static bool) clock_fg_at ((size_t x) (size_t y) ((const SilkBar) (* bar)) (uint32_t (* out)))
      (var Rect clock (call module_rect bar SILKBAR_MODULE_SLOT_CLOCK))
      (var size_t cx (. clock x))
      (var size_t cy (+ (. clock y) 1))
      (if (|| (< y cy) (>= y (+ cy 7))) (return false))
      (if (|| (< x cx) (> x (+ cx 45))) (return false))
      (if (|| (== x (+ cx 14)) (== x (+ cx 31)))
        (block
          (if (|| (== y (+ cy 1)) (== y (+ cy 5)))
            (block
              (= (* out) (. DEFAULT_THEME text))
              (return true)))
          (return false)))
      (var (const uint8_t) ([] digits 6)
        (init (/ (-> bar clock_hh) 10) (% (-> bar clock_hh) 10) (/ (-> bar clock_mm) 10)
              (% (-> bar clock_mm) 10) (/ (-> bar clock_ss) 10) (% (-> bar clock_ss) 10)))
      (for (var size_t di 0) (< di 6) (++ di)
        (block
          (var size_t dx ([] CLOCK_DIGIT_X di))
          (if (|| (< x (+ cx dx)) (>= x (+ (+ cx dx) 5))) continue)
          (if (!= (& (>> (call digit_row ([] digits di) (- y cy)) (- 4 (- x (+ cx dx)))) 1) 0)
            (block
              (= (* out) (. DEFAULT_THEME text))
              (return true)))
          (return false)))
      (return false))

    (comment "The Bell count badge at the right of its slot, at most two digits, in the clock's color.")
    (fn (static bool) bell_badge_at ((size_t x) (size_t y) ((const SilkBar) (* bar)) (uint32_t (* out)))
      (var uint8_t n (. (-> bar bell_state) total_visible))
      (if (|| (== n 0) (== (& (. (-> bar bell_state) flags) 1) 0)) (return false))
      (if (> n 99) (= n 99))
      (var size_t tens (/ n 10))
      (var size_t ones (% n 10))
      (var Rect bell (call module_rect bar SILKBAR_MODULE_SLOT_BELL))
      (var size_t badge_y (- (+ (. bell y) (/ (. bell h) 2)) 3))
      (if (|| (< y badge_y) (>= y (+ badge_y 7))) (return false))
      (var size_t row (- y badge_y))
      (comment "Tens at +9, ones at +14; a single digit sits at +11 for the skipped tens place, which never draws.")
      (var size_t left (?: (> tens 0) (+ (. bell x) 9) (+ (. bell x) 11)))
      (var size_t right (+ (. bell x) 14))
      (for (var size_t di 0) (< di 2) (++ di)
        (block
          (var size_t digit_x (?: (== di 0) left right))
          (var size_t digit (?: (== di 0) tens ones))
          (if (&& (== di 0) (== tens 0)) continue)
          (if (|| (< x digit_x) (>= x (+ digit_x 5))) continue)
          (if (!= (& (>> (call digit_row digit row) (- 4 (- x digit_x))) 1) 0)
            (block
              (= (* out) (. DEFAULT_THEME text))
              (return true)))
          (return false)))
      (return false))

    (comment "Frame chrome alpha scaled by the hover-reveal dimming: 5 gives about 20%, 10 full.")
    (fn (static uint8_t) scale_alpha ((uint8_t base) (uint8_t dim))
      (return (cast uint8_t (/ (* (cast uint32_t base) (cast uint32_t dim)) 10))))

    (fn (static bool) inside ((size_t x) (size_t y) (Rect r))
      (return (&& (&& (>= x (. r x)) (< x (+ (. r x) (. r w)))) (&& (>= y (. r y)) (< y (+ (. r y) (. r h)))))))

    (comment "The focused surface's pixel: top-bar chrome (glass toolbar, divider, title, tab strip, the three lights), else the rim band (minimal-mode lights and tabs on top, a pulsing neon glass rim on the other edges), else its content.")
    (fn (static uint32_t) focused_pixel ((Sexdisplay (* s)) ((const Surface) (* surf)) (Rect r) (size_t x) (size_t y) (uint32_t c))
      (var size_t lx (- x (. r x)))
      (var size_t ly (- y (. r y)))
      (comment "saturating_sub keeps the edges sensible on surfaces smaller than the rim.")
      (var size_t rim_right (call saturating_sub (. r w) FRAME_RIM_PX))
      (var size_t rim_bottom (call saturating_sub (. r h) FRAME_RIM_PX))
      (var bool top_bar_active (!= (& (-> surf chrome_flags) SURFACE_CHROME_TOP_BAR) 0))
      (var bool frame_hovered (!= (& (-> surf chrome_flags) SURFACE_CHROME_FRAME_HOVER) 0))
      (var bool light_hovered (!= (& (-> surf chrome_flags) SURFACE_CHROME_LIGHT_HOVER) 0))
      (var uint8_t hovered_light_kind (cast uint8_t (>> (& (-> surf chrome_flags) SURFACE_CHROME_LIGHT_KIND_MASK) SURFACE_CHROME_LIGHT_KIND_SHIFT)))
      (var bool close_allowed (!= (& (-> surf chrome_flags) SURFACE_CHROME_CLOSE_ALLOWED) 0))
      (var bool single_tab (<= (-> surf tab_count) 1))
      (if (&& (&& (== ly 0) (== lx 0)) (call take (& (-> s hover_reveal_log))))
        (call sexos_line "[sexdisplay.frame.hover.reveal] mode=v1b single_tab=%u hovered=%u"
          (cast unsigned single_tab) (cast unsigned frame_hovered)))
      (comment "Hover reveal: single-tab chrome dims until hovered; multi-tab chrome stays full.")
      (var uint8_t chrome_dim (?: (&& single_tab (! frame_hovered)) 5 10))
      (var (const RenderTokensV1) (* tokens) (& (-> s display_tokens)))
      (comment "[silk.live_topstrip.v2.clip] Frame chrome never renders into the SilkBar rows; this pixel keeps whatever the strip pass gave it.")
      (if (< y (+ BAR_BG_H 1)) (return c))
      (if (&& top_bar_active (< ly FRAME_TOP_BAR_HEIGHT_PX))
        (block
          (comment "Frosted glass toolbar, an opaque divider on its last row, the title over it.")
          (var uint8_t toolbar_alpha (call scale_alpha (?: frame_hovered 220 200) chrome_dim))
          (if (> toolbar_alpha 0) (= c (call glass_over_bg s (-> tokens frame_top_bar_color) x y toolbar_alpha)))
          (if (== ly (- FRAME_TOP_BAR_HEIGHT_PX 1)) (= c FRAME_TOP_BAR_DIVIDER_COLOR))
          (var uint32_t fg 0)
          (if (call toolbar_title_fg_at lx ly (-> surf surface_id) (& fg)) (= c fg))
          (if (&& (> (-> surf tab_count) 0) (&& (>= lx FRAME_TOP_BAR_LIGHT_EXCLUSION_PX) (< lx rim_right)))
            (block
              (var size_t slot_w (/ (- rim_right FRAME_TOP_BAR_LIGHT_EXCLUSION_PX) (-> surf tab_count)))
              (if (> slot_w 0)
                (block
                  (var bool active (== (/ (- lx FRAME_TOP_BAR_LIGHT_EXCLUSION_PX) slot_w) (-> surf active_tab)))
                  (var uint32_t tab_color (?: active (-> tokens active_tab_color) (-> tokens inactive_tab_color)))
                  (var uint32_t tab_glass (call glass_over_bg s tab_color x y 224))
                  (= c (call alpha_blend_xrgb_over_xrgb tab_color tab_glass (?: active 240 200)))))))
          (if (&& (>= ly FRAME_TOP_BAR_LIGHT_TOP) (< ly FRAME_TOP_BAR_LIGHT_BOTTOM))
            (block
              (if (&& (&& (== lx FRAME_TOP_BAR_LIGHT_GAP_PX) (== ly FRAME_TOP_BAR_LIGHT_TOP)) (call take (& (-> s frame_light_startup_log))))
                (if (call hot_log s)
                  (call sexos_line "[sexdisplay.frame.light.startup.render] sid=%llu red=%s close_allowed=%u reason=%s"
                    (cast (unsigned long long) (-> surf surface_id)) (?: close_allowed "enabled" "disabled")
                    (cast unsigned close_allowed) (?: close_allowed "close_allowed" "default_disabled_or_protected"))))
              (if (&& (&& (== lx FRAME_TOP_BAR_LIGHT_GAP_PX) (== ly FRAME_TOP_BAR_LIGHT_TOP)) (call take (& (-> s phase6_draw_ok_log))))
                (call sexos_line "[sexdisplay.frame_lights.draw.ok] rendered=1 red=disabled yellow=available green=available ok=1 reason=render_path"))
              (comment "Close, minimize, zoom: each glass under its light color; close is dimmer while not allowed, every light brightens when hovered.")
              (var size_t l1_end (+ FRAME_TOP_BAR_LIGHT_GAP_PX FRAME_TOP_BAR_LIGHT_SIZE_PX))
              (var bool l1_hovered (&& light_hovered (== hovered_light_kind 0)))
              (var uint8_t l1_base (?: l1_hovered 255 (?: close_allowed 224 FRAME_LIGHT_CLOSE_DISABLED_BASE_ALPHA)))
              (var uint8_t light_alpha (call scale_alpha l1_base chrome_dim))
              (if (&& (>= lx FRAME_TOP_BAR_LIGHT_GAP_PX) (< lx l1_end))
                (block
                  (if (> light_alpha 0) (= c (call glass_over_bg s (-> tokens close_light_color) x y light_alpha))))
                (block
                  (var size_t l2_start (+ l1_end FRAME_TOP_BAR_LIGHT_GAP_PX))
                  (var size_t l2_end (+ l2_start FRAME_TOP_BAR_LIGHT_SIZE_PX))
                  (var uint8_t l2_alpha (call scale_alpha (?: (&& light_hovered (== hovered_light_kind 1)) 255 224) chrome_dim))
                  (if (&& (>= lx l2_start) (< lx l2_end))
                    (block
                      (if (> l2_alpha 0) (= c (call glass_over_bg s (-> tokens minimize_light_color) x y l2_alpha))))
                    (block
                      (var size_t l3_start (+ l2_end FRAME_TOP_BAR_LIGHT_GAP_PX))
                      (var size_t l3_end (+ l3_start FRAME_TOP_BAR_LIGHT_SIZE_PX))
                      (var uint8_t l3_alpha (call scale_alpha (?: (&& light_hovered (== hovered_light_kind 2)) 255 224) chrome_dim))
                      (if (&& (&& (>= lx l3_start) (< lx l3_end)) (> l3_alpha 0))
                        (= c (call glass_over_bg s (-> tokens zoom_light_color) x y l3_alpha)))))))))
          (return c)))
      (if (|| (|| (< ly FRAME_RIM_PX) (< lx FRAME_RIM_PX)) (|| (>= lx rim_right) (>= ly rim_bottom)))
        (block
          (if (&& (< ly FRAME_RIM_PX) (! top_bar_active))
            (block
              (comment "Minimal mode: the lights and tab strip ride the top rim.")
              (var size_t pitch (+ FRAME_LIGHT_SIZE_PX FRAME_LIGHT_GAP_PX))
              (if (&& (>= lx FRAME_LIGHT_GAP_PX) (< lx (+ FRAME_LIGHT_GAP_PX FRAME_LIGHT_SIZE_PX)))
                (return (call glass_over_bg s (-> tokens close_light_color) x y (?: close_allowed 224 FRAME_LIGHT_CLOSE_DISABLED_BASE_ALPHA))))
              (if (&& (>= lx (+ FRAME_LIGHT_GAP_PX pitch)) (< lx (+ (+ FRAME_LIGHT_GAP_PX pitch) FRAME_LIGHT_SIZE_PX)))
                (return (call glass_over_bg s (-> tokens minimize_light_color) x y 224)))
              (if (&& (>= lx (+ FRAME_LIGHT_GAP_PX (* 2 pitch))) (< lx (+ (+ FRAME_LIGHT_GAP_PX (* 2 pitch)) FRAME_LIGHT_SIZE_PX)))
                (return (call glass_over_bg s (-> tokens zoom_light_color) x y 224)))
              (if (&& (> (-> surf tab_count) 0) (&& (>= lx TAB_STRIP_LIGHT_EXCLUSION_PX) (< lx rim_right)))
                (block
                  (var size_t slot_w (/ (- rim_right TAB_STRIP_LIGHT_EXCLUSION_PX) (-> surf tab_count)))
                  (if (> slot_w 0)
                    (block
                      (var bool active (== (/ (- lx TAB_STRIP_LIGHT_EXCLUSION_PX) slot_w) (-> surf active_tab)))
                      (return (call glass_over_bg s (?: active (-> tokens active_tab_color) (-> tokens inactive_tab_color)) x y (?: active 220 180)))))))
              (return (call glass_over_bg s (-> tokens frame_rim_color) x y 196))))
          (return (call glass_over_bg s (-> tokens frame_rim_color) x y (call pulse_alpha 196 12 (-> s render_frame_counter) 128)))))
      (= c (call fill_rect_color surf x y (-> tokens focus_surface_color)))
      (var uint32_t tc 0)
      (if (call surface_text_fg_at x y surf (& tc)) (= c tc))
      (return c))

    (comment "One pixel below the bar: unfocused surfaces in slot order (the first hit wins), then the focused surface on top. render and redraw_surface_area share it, so they cannot drift.")
    (fn (static uint32_t) composite_pixel ((Sexdisplay (* s)) (size_t x) (size_t y) (size_t w) (size_t h) (uint32_t background) (uint64_t focused_id))
      (var uint32_t c background)
      (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
        (block
          (var (const Surface) (* surf) (& ([] (-> s surfaces) i)))
          (if (|| (! (-> surf active)) (== (-> surf surface_id) focused_id)) continue)
          (var Rect r (call clamp_surface surf w h))
          (if (|| (== (. r w) 0) (== (. r h) 0)) continue)
          (if (call inside x y r)
            (block
              (= c (call fill_rect_color surf x y (-> surf color)))
              (var uint32_t tc 0)
              (if (call surface_text_fg_at x y surf (& tc)) (= c tc))
              break))))
      (if (== focused_id 0) (return c))
      (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
        (block
          (var (const Surface) (* surf) (& ([] (-> s surfaces) i)))
          (if (|| (! (-> surf active)) (!= (-> surf surface_id) focused_id)) continue)
          (var Rect r (call clamp_surface surf w h))
          (if (|| (== (. r w) 0) (== (. r h) 0)) continue)
          (if (call inside x y r)
            (block
              (comment "Phase 6: one-shot markers from the real render path, after clamp_surface and the size guard.")
              (if (call take (& (-> s phase6_render_begin_log)))
                (block
                  (var size_t active_count 0)
                  (var size_t frame_count 0)
                  (for (var size_t j 0) (< j MAX_SURFACES) (++ j)
                    (block
                      (var (const Surface) (* other) (& ([] (-> s surfaces) j)))
                      (if (-> other active)
                        (block
                          (+= active_count 1)
                          (if (&& (> (-> other tab_count) 0) (!= (& (-> other chrome_flags) SURFACE_CHROME_TOP_BAR) 0)) (+= frame_count 1))))))
                  (call sexos_line "[sexdisplay.frame_lights.render.begin] fb_w=%zu fb_h=%zu surfaces=%zu frames=%zu" w h active_count frame_count)))
              (if (call take (& (-> s phase6_bounds_ok_log)))
                (call sexos_line "[sexdisplay.frame_lights.bounds.ok] all_lights_within_fb=1 fb_w=%zu fb_h=%zu light_w=40 light_h=10 ok=1 reason=clamp_surface_guarantee" w h))
              (return (call focused_pixel s surf r x y c))))))
      (return c))

    (comment "Shared guards of the three render paths: a high-half framebuffer of plausible size, the pixel count through *pixels. Only the full render also refuses a range whose end wraps the address space; the two redraw paths do not check it, as in the Rust.")
    (fn (static bool) framebuffer_ok ((uint64_t fb_addr) (size_t w) (size_t h) (bool check_end) (size_t (* pixels)))
      (if (< fb_addr HIGH_HALF_BASE) (return false))
      (if (|| (|| (== w 0) (== h 0)) (|| (> w MAX_FB_W) (> h MAX_FB_H))) (return false))
      (= (* pixels) (* w h))
      (if (&& check_end (> (* (cast uint64_t (* pixels)) 4) (- UINT64_MAX fb_addr))) (return false))
      (return true))

    (fn (static volatile uint32_t) * framebuffer ((uint64_t fb_addr))
      (return (cast ((volatile uint32_t) *) (cast uintptr_t fb_addr))))

    (comment "A top-strip pixel; strip says whether the Phase 5 indicators are drawn (the live strip redraw draws them, the full render does not).")
    (fn (static uint32_t) strip_pixel ((Sexdisplay (* s)) (size_t x) (size_t y) ((const SilkBar) (* bar)) (bool strip))
      (var uint32_t fg 0)
      (if (call clock_fg_at x y bar (& fg)) (return fg))
      (if (call bell_badge_at x y bar (& fg)) (return fg))
      (if strip
        (block
          (if (call phase5_active_app_at x y bar (& fg)) (return fg))
          (if (call phase5_tint_swatch_at x y bar (& fg)) (return fg))
          (if (call phase5_palette_dot_at x y bar (& fg)) (return fg))))
      (return (call bar_color s x y bar)))

    (comment "INPUT_PRESENT_TRACE_V1 summary: the unbudgeted counters.")
    (fn (static void) input_trace_display_summary (((const Sexdisplay) (* s)))
      (call sexos_line "[input.trace.display.summary] recv=%u draws=%u presents=%u budget_hit=%u"
        (cast unsigned (-> s input_trace_recv)) (cast unsigned (-> s input_trace_draws))
        (cast unsigned (-> s input_trace_presents)) (cast unsigned (-> s input_trace_display_budget_hit))))

    (comment "One cursor trace line under MARKER: seq and shell tick are reported unknown when the sender did not tag them.")
    (fn (static void) cursor_trace_line (((const char) (* marker)) (uint32_t seq) (uint32_t shell_tick) (uint32_t display_tick) (int32_t x) (int32_t y))
      (if (&& (!= seq 0) (!= shell_tick 0))
        (call sexos_line "%s seq=%u shell_tick=%u display_tick=%u x=%d y=%d" marker
          (cast unsigned seq) (cast unsigned shell_tick) (cast unsigned display_tick) x y)
        (if (!= seq 0)
          (call sexos_line "%s seq=%u shell_tick=unknown display_tick=%u x=%d y=%d" marker (cast unsigned seq) (cast unsigned display_tick) x y)
          (call sexos_line "%s seq=unknown shell_tick=unknown display_tick=%u x=%d y=%d" marker (cast unsigned display_tick) x y))))

    (comment "Pass 3: the shell's cursor surface, drawn last as the arrow bitmap; clear bits are transparent and the SilkBar rows (y < 51) are never written. With save_under the 8x16 pixels beneath are captured first, for the cursor-only fast path; pass it only when those pixels are current. Trace counters advance only when the input sequence did, so repaints at the same position present no new input.")
    (fn (static void) draw_cursor_z_top ((Sexdisplay (* s)) ((volatile uint32_t) (* fb)) (size_t w) (size_t h) (size_t total_pixels) (bool save_under))
      (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
        (block
          (var (const Surface) (* surf) (& ([] (-> s surfaces) i)))
          (if (|| (! (-> surf active)) (!= (-> surf surface_id) CURSOR_SURFACE_ID)) continue)
          (comment "The origin is not clamped: the arrow clips naturally.")
          (var size_t ox (cast size_t (?: (> (-> surf x) 0) (-> surf x) 0)))
          (var size_t oy (cast size_t (?: (> (-> surf y) 0) (-> surf y) 0)))
          (if (call once (& (-> s cursor_z_top_logged)))
            (block
              (call sexos_line "[sexdisplay.cursor_surface.z_top.ok] id=%#llx" (cast (unsigned long long) CURSOR_SURFACE_ID))
              (call sexos_line "[sexdisplay.cursor_shape.arrow.ok] id=%#llx" (cast (unsigned long long) CURSOR_SURFACE_ID))))
          (if (&& (call take (& (-> s display_cursor_draw_log))) (call hot_log s))
            (call sexos_line "[sexdisplay.cursor.draw] n=0 x=%d y=%d" (call wrap_i32 ox) (call wrap_i32 oy)))
          (var bool input_seq_advanced (&& (!= (-> s input_trace_last_seq) 0) (!= (-> s input_trace_last_seq) (-> s last_counted_draw_seq))))
          (if input_seq_advanced
            (block
              (+= (-> s input_trace_draws) 1)
              (+= (-> s display_draw_tick) 1)
              (if (call take (& (-> s input_trace_draw_log)))
                (block
                  (call cursor_trace_line "[input.trace.display.cursor.draw]" (-> s input_trace_last_seq) (-> s input_trace_last_shell_tick) (-> s display_draw_tick) (call wrap_i32 ox) (call wrap_i32 oy))
                  (if (== (-> s input_trace_draw_log) 0) (= (-> s input_trace_display_budget_hit) 1))))))
          (if save_under
            (block
              (= (-> s cursor_under_x) ox)
              (= (-> s cursor_under_y) oy)
              (for (var size_t row 0) (< row CURSOR_ARROW_H) (++ row)
                (block
                  (var size_t py (+ oy row))
                  (if (>= py h) break)
                  (if (< py 51) continue)
                  (for (var size_t col 0) (< col CURSOR_ARROW_W) (++ col)
                    (block
                      (var size_t px (+ ox col))
                      (if (>= px w) continue)
                      (var size_t idx (+ (* py w) px))
                      (if (< idx total_pixels) (= ([] (-> s cursor_under_saved) (+ (* row CURSOR_ARROW_W) col)) ([] fb idx)))))))
              (= (-> s cursor_under_valid) true)))
          (for (var size_t row 0) (< row CURSOR_ARROW_H) (++ row)
            (block
              (var size_t py (+ oy row))
              (if (>= py h) break)
              (if (< py 51) continue)
              (var uint8_t bits ([] CURSOR_ARROW_BITMAP row))
              (for (var size_t col 0) (< col CURSOR_ARROW_W) (++ col)
                (block
                  (if (== (& bits (>> 0x80 col)) 0) continue)
                  (var size_t px (+ ox col))
                  (if (>= px w) continue)
                  (var size_t idx (+ (* py w) px))
                  (if (< idx total_pixels) (= ([] fb idx) CURSOR_ARROW_COLOR))))))
          (comment "The pixels are in the framebuffer now: direct writes, no flip, so this is the present point.")
          (if input_seq_advanced
            (block
              (+= (-> s input_trace_presents) 1)
              (+= (-> s display_present_tick) 1)
              (if (call take (& (-> s input_trace_present_log)))
                (call cursor_trace_line "[input.trace.display.cursor.present]" (-> s input_trace_last_seq) (-> s input_trace_last_shell_tick) (-> s display_present_tick) (call wrap_i32 ox) (call wrap_i32 oy)))
              (if (|| (== (-> s input_trace_presents) 4) (== (% (-> s input_trace_presents) 8) 0))
                (call input_trace_display_summary s))
              (= (-> s last_counted_draw_seq) (-> s input_trace_last_seq))))
          break)))

    (comment "Restore the pixels saved beneath the last cursor draw, under the same clipping rules.")
    (fn (static void) restore_cursor_under ((Sexdisplay (* s)) ((volatile uint32_t) (* fb)) (size_t w) (size_t h) (size_t total_pixels))
      (if (! (-> s cursor_under_valid)) (return))
      (for (var size_t row 0) (< row CURSOR_ARROW_H) (++ row)
        (block
          (var size_t py (+ (-> s cursor_under_y) row))
          (if (>= py h) break)
          (if (< py 51) continue)
          (for (var size_t col 0) (< col CURSOR_ARROW_W) (++ col)
            (block
              (var size_t px (+ (-> s cursor_under_x) col))
              (if (>= px w) continue)
              (var size_t idx (+ (* py w) px))
              (if (< idx total_pixels) (= ([] fb idx) ([] (-> s cursor_under_saved) (+ (* row CURSOR_ARROW_W) col))))))))
      (= (-> s cursor_under_valid) false))

    (comment "Pass 4: the launcher panel, when the shell has it active: a solid rectangle with a 1-pixel border, above the apps and below the cursor.")
    (fn (static void) draw_launcher_panel ((Sexdisplay (* s)) ((volatile uint32_t) (* fb)) (size_t w) (size_t h) (size_t total_pixels))
      (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
        (block
          (var (const Surface) (* surf) (& ([] (-> s surfaces) i)))
          (if (|| (! (-> surf active)) (!= (-> surf surface_id) LAUNCHER_PANEL_SURFACE_ID)) continue)
          (var Rect r (call clamp_surface surf w h))
          (if (|| (== (. r w) 0) (== (. r h) 0)) break)
          (if (call take (& (-> s launcher_panel_draw_log)))
            (call sexos_line "[sexdisplay.launcher_panel.draw] id=%#llx x=%zu y=%zu w=%zu h=%zu"
              (cast (unsigned long long) LAUNCHER_PANEL_SURFACE_ID) (. r x) (. r y) (. r w) (. r h)))
          (for (var size_t row 0) (< row (. r h)) (++ row)
            (block
              (var size_t py (+ (. r y) row))
              (if (>= py h) break)
              (for (var size_t col 0) (< col (. r w)) (++ col)
                (block
                  (var size_t px (+ (. r x) col))
                  (if (>= px w) continue)
                  (var size_t idx (+ (* py w) px))
                  (if (>= idx total_pixels) continue)
                  (var bool border (|| (|| (== row 0) (== row (- (. r h) 1))) (|| (== col 0) (== col (- (. r w) 1)))))
                  (= ([] fb idx) (?: border 0x00405880u 0x00203058u))))))
          break)))

    (fn (static void) write_pixel (((volatile uint32_t) (* fb)) (size_t idx) (size_t total_pixels) (uint32_t color))
      (if (< idx total_pixels) (= ([] fb idx) color)))

    (comment "Atlas Phase C: 2-pixel card outlines around active surfaces entirely below the strip, each write checked against the framebuffer. The cursor and launcher have their own passes.")
    (fn (static void) draw_atlas_cards_pass ((Sexdisplay (* s)) ((volatile uint32_t) (* fb)) (size_t w) (size_t h) (size_t total_pixels))
      (if (|| (! ATLAS_PHASE_C_RENDER_STUB_PROOF_ENABLED) (< h 52)) (return))
      (var uint32_t card_count 0)
      (for (var size_t si 0) (< si MAX_SURFACES) (++ si)
        (block
          (if (>= card_count ATLAS_CARD_MAX_CARDS) break)
          (var (const Surface) (* surf) (& ([] (-> s surfaces) si)))
          (if (! (-> surf active)) continue)
          (if (|| (== (-> surf surface_id) CURSOR_SURFACE_ID) (== (-> surf surface_id) LAUNCHER_PANEL_SURFACE_ID))
            (block
              (if (call take (& (-> s card_skip_cursor_log)))
                (call sexos_line "[sexdisplay.atlas.card.skip] scene=%u reason=cursor_or_launcher" (cast unsigned si)))
              continue))
          (var Rect r (call clamp_surface surf w h))
          (if (|| (== (. r w) 0) (== (. r h) 0))
            (block
              (if (call take (& (-> s card_skip_zero_log)))
                (call sexos_line "[sexdisplay.atlas.card.skip] scene=%u reason=zero_area_clamped" (cast unsigned si)))
              continue))
          (if (< (. r y) 51)
            (block
              (if (call take (& (-> s card_skip_overlap_log)))
                (call sexos_line "[sexdisplay.atlas.card.skip] scene=%u reason=overlaps_top_strip sy=%zu" (cast unsigned si) (. r y)))
              continue))
          (if (call take (& (-> s card_layout_log)))
            (call sexos_line "[sexdisplay.atlas.card.layout] scene=%u x=%zu y=%zu w=%zu h=%zu active=%u" (cast unsigned si)
              (. r x) (. r y) (. r w) (. r h) (cast unsigned (== (-> surf surface_id) (-> s focused_surface_id)))))
          (var size_t right (call min_size (call saturating_add (. r x) (. r w)) w))
          (var size_t bottom (call min_size (call saturating_add (. r y) (. r h)) h))
          (if (|| (<= right (. r x)) (<= bottom (. r y))) continue)
          (for (var size_t edge 0) (< edge ATLAS_CARD_BORDER_PX) (++ edge)
            (block
              (var size_t ty (call saturating_add (. r y) edge))
              (if (&& (< ty h) (>= ty 51))
                (for (var size_t px (. r x)) (< px right) (++ px)
                  (if (< px w) (call write_pixel fb (+ (* ty w) px) total_pixels ATLAS_CARD_BORDER_COLOR))))
              (var size_t by (call saturating_sub bottom (+ edge 1)))
              (if (&& (< by h) (>= by 51))
                (for (var size_t px (. r x)) (< px right) (++ px)
                  (if (< px w) (call write_pixel fb (+ (* by w) px) total_pixels ATLAS_CARD_BORDER_COLOR))))))
          (for (var size_t edge 0) (< edge ATLAS_CARD_BORDER_PX) (++ edge)
            (block
              (var size_t lx (call saturating_add (. r x) edge))
              (if (< lx w)
                (for (var size_t py (. r y)) (< py bottom) (++ py)
                  (if (&& (< py h) (>= py 51)) (call write_pixel fb (+ (* py w) lx) total_pixels ATLAS_CARD_BORDER_COLOR))))
              (var size_t rx (call saturating_sub right (+ edge 1)))
              (if (< rx w)
                (for (var size_t py (. r y)) (< py bottom) (++ py)
                  (if (&& (< py h) (>= py 51)) (call write_pixel fb (+ (* py w) rx) total_pixels ATLAS_CARD_BORDER_COLOR))))))
          (if (call take (& (-> s card_draw_log)))
            (call sexos_line "[sexdisplay.atlas.card.draw] scene=%u ok=1" (cast unsigned si)))
          (+= card_count 1)))
      (if (call take (& (-> s card_done_log)))
        (call sexos_line "[sexdisplay.atlas.phase_c.done] cards=%u ok=1" (cast unsigned card_count))))

    (comment "The inner rectangle of an Atlas card: the clamped surface inset by the margin, if it is below the strip and at least 4x4.")
    (fn (static bool) preview_eligible ((Rect r) (size_t (* inner_w)) (size_t (* inner_h)))
      (= (* inner_w) (call saturating_sub (. r w) (* 2 ATLAS_PREVIEW_INNER_MARGIN)))
      (= (* inner_h) (call saturating_sub (. r h) (* 2 ATLAS_PREVIEW_INNER_MARGIN)))
      (return (&& (>= (* inner_w) 4) (>= (* inner_h) 4))))

    (comment "Atlas Phase D: a flat preview inside each card, lavender for the focused surface, cool blue for the others (minimized surfaces are not detectable without new ABI, so the source is local_stub).")
    (fn (static void) draw_atlas_frame_previews_pass ((Sexdisplay (* s)) ((volatile uint32_t) (* fb)) (size_t w) (size_t h) (size_t total_pixels))
      (if (|| (! ATLAS_PHASE_D_FRAME_PREVIEW_STUB_PROOF_ENABLED) (< h 52)) (return))
      (var uint32_t preview_count 0)
      (if (call take (& (-> s preview_pass_log)))
        (block
          (var uint32_t eligible 0)
          (for (var size_t si 0) (< si MAX_SURFACES) (++ si)
            (block
              (if (>= eligible ATLAS_PREVIEW_MAX_PREVIEWS) break)
              (var (const Surface) (* surf) (& ([] (-> s surfaces) si)))
              (if (! (-> surf active)) continue)
              (if (|| (== (-> surf surface_id) CURSOR_SURFACE_ID) (== (-> surf surface_id) LAUNCHER_PANEL_SURFACE_ID)) continue)
              (var Rect r (call clamp_surface surf w h))
              (if (|| (|| (== (. r w) 0) (== (. r h) 0)) (< (. r y) 51)) continue)
              (var size_t iw 0)
              (var size_t ih 0)
              (if (! (call preview_eligible r (& iw) (& ih))) continue)
              (+= eligible 1)))
          (call sexos_line "[sexdisplay.atlas.phase_d.begin] cards=%u mode=interior_stub" (cast unsigned eligible))))
      (for (var size_t si 0) (< si MAX_SURFACES) (++ si)
        (block
          (if (>= preview_count ATLAS_PREVIEW_MAX_PREVIEWS) break)
          (var (const Surface) (* surf) (& ([] (-> s surfaces) si)))
          (if (! (-> surf active)) continue)
          (if (|| (== (-> surf surface_id) CURSOR_SURFACE_ID) (== (-> surf surface_id) LAUNCHER_PANEL_SURFACE_ID)) continue)
          (var Rect r (call clamp_surface surf w h))
          (if (|| (== (. r w) 0) (== (. r h) 0))
            (block
              (if (call take (& (-> s preview_skip_zero_log)))
                (call sexos_line "[sexdisplay.atlas.frame.preview.skip] scene=%u frame=0 reason=zero_area_clamped" (cast unsigned si)))
              continue))
          (if (< (. r y) 51)
            (block
              (if (call take (& (-> s preview_skip_overlap_log)))
                (call sexos_line "[sexdisplay.atlas.frame.preview.skip] scene=%u frame=0 reason=overlaps_top_strip sy=%zu" (cast unsigned si) (. r y)))
              continue))
          (var size_t inner_x (call saturating_add (. r x) ATLAS_PREVIEW_INNER_MARGIN))
          (var size_t inner_y (call saturating_add (. r y) ATLAS_PREVIEW_INNER_MARGIN))
          (var size_t inner_w 0)
          (var size_t inner_h 0)
          (if (! (call preview_eligible r (& inner_w) (& inner_h)))
            (block
              (if (call take (& (-> s preview_skip_small_log)))
                (call sexos_line "[sexdisplay.atlas.frame.preview.skip] scene=%u frame=0 reason=inner_area_too_small" (cast unsigned si)))
              continue))
          (var size_t inner_right (call min_size (call saturating_add inner_x inner_w) w))
          (var size_t inner_bottom (call min_size (call saturating_add inner_y inner_h) h))
          (if (|| (<= inner_right inner_x) (<= inner_bottom inner_y)) continue)
          (var bool is_active (== (-> surf surface_id) (-> s focused_surface_id)))
          (if (call take (& (-> s preview_layout_log)))
            (call sexos_line "[sexdisplay.atlas.frame.preview.layout] scene=%u frame=0 x=%zu y=%zu w=%zu h=%zu state=%s source=local_stub"
              (cast unsigned si) inner_x inner_y inner_w inner_h (?: is_active "active" "visible")))
          (var uint32_t color (?: is_active ATLAS_PREVIEW_ACTIVE_COLOR ATLAS_PREVIEW_VISIBLE_COLOR))
          (for (var size_t py inner_y) (< py inner_bottom) (++ py)
            (if (>= py 51)
              (for (var size_t px inner_x) (< px inner_right) (++ px)
                (if (< px w) (call write_pixel fb (+ (* py w) px) total_pixels color)))))
          (if (call take (& (-> s preview_draw_log)))
            (call sexos_line "[sexdisplay.atlas.frame.preview.draw] scene=%u frame=0 ok=1" (cast unsigned si)))
          (+= preview_count 1)))
      (if (call take (& (-> s preview_done_log)))
        (call sexos_line "[sexdisplay.atlas.phase_d.done] previews=%u ok=1" (cast unsigned preview_count))))


    (fn (static void) overlay_passes ((Sexdisplay (* s)) ((volatile uint32_t) (* fb)) (size_t w) (size_t h) (size_t total_pixels) (bool save_under))
      (call draw_atlas_cards_pass s fb w h total_pixels)
      (call draw_atlas_frame_previews_pass s fb w h total_pixels)
      (call draw_cursor_z_top s fb w h total_pixels save_under)
      (call draw_launcher_panel s fb w h total_pixels))

    (comment "The full frame: strip rows 0..49 on top, the glow edge on row 50, the composited surfaces below, then the overlay passes.")
    (fn (static void) render ((Sexdisplay (* s)) (uint64_t fb_addr) (size_t w) (size_t h) ((const SilkBar) (* bar)))
      (var size_t total_pixels 0)
      (if (! (call framebuffer_ok fb_addr w h true (& total_pixels))) (return))
      (+= (-> s render_frame_counter) 1)
      (if (call take (& (-> s full_render_log))) (call sexos_line "[sexdisplay.render.full] fb_w=%zu fb_h=%zu" w h))
      (var bool row_buffer_filled (call fill_bar_bg_buffer s (cast uint32_t w) (cast uint32_t h)))
      (var bool blur_filled (&& row_buffer_filled (call blur_bar_bg_buffer_radius1 s (cast uint32_t w) (cast uint32_t h))))
      (if (call once (& (-> s row_buffer_proof_logged)))
        (call sexos_line "[sexdisplay.render.row_buffer] cap_w=%zu fb_w=%zu filled=%u" BAR_BG_W_CAP w (cast unsigned row_buffer_filled)))
      (if (call once (& (-> s blur_proof_logged)))
        (call sexos_line "[sexdisplay.render.blur] radius=1 fb_w=%zu filled=%u" w (cast unsigned blur_filled)))
      (if (call once (& (-> s anim_proof_logged))) (call sexos_line "[sexdisplay.render.anim] period=96 base=48 amp=32"))
      (if (call once (& (-> s r6_glass_proof_logged))) (call sexos_line "[sexdisplay.render.glass.r6] bar_alpha=196 chip_alpha=212 blur=1 pulse=1"))
      (var uint64_t focused_id (-> s focused_surface_id))
      (var (volatile uint32_t) (* fb) (call framebuffer fb_addr))
      (for (var size_t y 0) (< y h) (++ y)
        (for (var size_t x 0) (< x w) (++ x)
          (block
            (var uint32_t c (?: (< y 50) (call strip_pixel s x y bar false)
              (?: (== y 50) (. DEFAULT_THEME panel_glow) (call composite_pixel s x y w h (call bg y h) focused_id))))
            (var size_t idx (+ (* y w) x))
            (if (< idx total_pixels) (= ([] fb idx) c)))))
      (call overlay_passes s fb w h total_pixels true))

    (comment "Redraw rows 0..50 only, for every SilkBar update. The background is not cleared first: that flashed the raw gradient on each tick, and the strip loop covers every row anyway. The glass buffers are refilled so a strip-only redraw never shows stale glass. The overlays are redrawn because they may reach into the strip; the cursor's save-under is not refreshed, since the pixels below the strip still hold the drawn cursor.")
    (fn (static void) redraw_top_strip ((Sexdisplay (* s)) (uint64_t fb_addr) (size_t w) (size_t h) ((const SilkBar) (* bar)))
      (var size_t total_pixels 0)
      (if (! (call framebuffer_ok fb_addr w h false (& total_pixels))) (return))
      (if (< h 51) (return))
      (var (volatile uint32_t) (* fb) (call framebuffer fb_addr))
      (if SILK_RENDER_PROOF_PROFILE_ENABLED
        (block
          (comment "[silk.live_topstrip.v2.audit] FNV-1a hashes of sampled framebuffer rows before the strip is drawn, at the first live redraw and again once seconds reach 4.")
          (var bool do_diag (|| (! (-> s live_topstrip_rows_done)) (&& (>= (-> bar clock_ss) 4) (! (-> s live_topstrip_rows_ss4_done)))))
          (if do_diag
            (block
              (var (const size_t) ([] sample_rows 10) (init 0 25 46 47 48 49 50 51 55 63))
              (if (> h 63)
                (for (var size_t k 0) (< k 10) (++ k)
                  (block
                    (var size_t row_base (* ([] sample_rows k) w))
                    (var uint32_t hash 0x811c9dc5u)
                    (for (var size_t x 0) (< x w) (++ x)
                      (if (< (+ row_base x) total_pixels)
                        (block
                          (^= hash ([] fb (+ row_base x)))
                          (= hash (* hash 0x01000193u)))))
                    (call sexos_line "[silk.live_topstrip.v2.rows] row=%zu hash=0x%08X ss=%u" ([] sample_rows k) hash (cast unsigned (-> bar clock_ss))))))
              (= (-> s live_topstrip_rows_done) true)
              (if (>= (-> bar clock_ss) 4) (= (-> s live_topstrip_rows_ss4_done) true))))))
      (cast void (call fill_bar_bg_buffer s (cast uint32_t w) (cast uint32_t h)))
      (cast void (call blur_bar_bg_buffer_radius1 s (cast uint32_t w) (cast uint32_t h)))
      (if SILK_RENDER_PROOF_PROFILE_ENABLED
        (block
          (if (call once (& (-> s live_topstrip_audit_done)))
            (call sexos_line "[silk.live_topstrip.audit] first_live_redraw fb_w=%zu fb_h=%zu ss=%u" w h (cast unsigned (-> bar clock_ss))))
          (if (call take (& (-> s live_topstrip_clear_log)))
            (call sexos_line "[silk.live_topstrip.clear] y_start=0 y_end=51 w=%zu ss=%u ok=1" w (cast unsigned (-> bar clock_ss))))
          (if (call take (& (-> s live_topstrip_bounds_log)))
            (call sexos_line "[silk.live_topstrip.bounds] top_strip_h=50 glow_row=50 total_rows=51 fb_h=%zu ok=1" h))
          (if (&& (>= (-> bar clock_ss) 4) (call once (& (-> s live_topstrip_tick4_fired))))
            (call sexos_line "[silk.live_topstrip.tick4] ss=%u mm=%u hh=%u fb_w=%zu fb_h=%zu ok=1 reason=live_redraw_past_tick4"
              (cast unsigned (-> bar clock_ss)) (cast unsigned (-> bar clock_mm)) (cast unsigned (-> bar clock_hh)) w h))))
      (if (&& (call take (& (-> s top_strip_redraw_log))) (call hot_log s))
        (call sexos_line "[sexdisplay.render.top_strip] fb_w=%zu fb_h=%zu" w h))
      (comment "Clock redraw proof: the time this redraw puts on screen, its source and whether visible time is monotonic.")
      (if (call take (& (-> s clock_redraw_log)))
        (block
          (var (const char) (* src) (?: (== (-> s clock_redraw_source) 1) "fallback" "silkbar"))
          (if (call hot_log s)
            (call sexos_line "[sexdisplay.clock.redraw] h=%u m=%u s=%u source=%s" (cast unsigned (-> bar clock_hh))
              (cast unsigned (-> bar clock_mm)) (cast unsigned (-> bar clock_ss)) src))
          (if (call hot_log s)
            (call sexos_line "[sexdisplay.clock.redraw.source_check] redraw_ss=%u canonical_ss=%u source=%s ok=%u"
              (cast unsigned (-> bar clock_ss)) (cast unsigned (-> s clock_canon_ss)) src
              (cast unsigned (== (-> bar clock_ss) (-> s clock_canon_ss)))))
          (var uint32_t redraw_total (call clock_total_seconds (-> bar clock_hh) (-> bar clock_mm) (-> bar clock_ss)))
          (var uint8_t prev_ss (-> bar clock_ss))
          (var uint8_t mono_ok 1)
          (if (! (-> s clock_visible_mono_init))
            (block
              (= (-> s clock_visible_mono_init) true)
              (= (-> s clock_visible_prev_total) redraw_total))
            (block
              (var uint32_t prev_total (-> s clock_visible_prev_total))
              (= mono_ok (?: (call clock_visible_monotonic_ok prev_total redraw_total) 1 0))
              (= prev_ss (cast uint8_t (% prev_total 60)))
              (if (== mono_ok 1) (= (-> s clock_visible_prev_total) redraw_total))))
          (if (call hot_log s)
            (call sexos_line "[sexdisplay.clock.monotonic.visible] prev_ss=%u redraw_ss=%u ok=%u"
              (cast unsigned prev_ss) (cast unsigned (-> bar clock_ss)) (cast unsigned mono_ok)))
          (if (call hot_log s)
            (call sexos_line "[clock.visible.seconds] h=%u m=%u s=%u drawn=1 ok=1 reason=pixel_loop_follows"
              (cast unsigned (-> bar clock_hh)) (cast unsigned (-> bar clock_mm)) (cast unsigned (-> bar clock_ss))))))
      (if (&& SILKBAR_PHASE3_RECEIVE_PROOF_ENABLED (call take (& (-> s phase3_state_log))))
        (call sexos_line "[sexdisplay.silkbar.phase3.state] active=%u tint=%u palette_open=%u selected=%u available=%u"
          (cast unsigned (. (-> bar phase1) active_app_sid)) (cast unsigned (. (-> bar phase1) accent_tint_idx))
          (cast unsigned (. (-> bar phase1) palette_open)) (cast unsigned (. (-> bar phase1) palette_selected))
          (cast unsigned (. (-> bar phase1) palette_available))))
      (if (&& SILKBAR_PHASE5_PIXEL_PROOF_ENABLED (call take (& (-> s phase5_draw_log))))
        (call sexos_line "[sexdisplay.silkbar.phase5.draw] active=%u tint=%u palette_open=%u"
          (cast unsigned (. (-> bar phase1) active_app_sid)) (cast unsigned (. (-> bar phase1) accent_tint_idx))
          (cast unsigned (. (-> bar phase1) palette_open))))
      (for (var size_t y 0) (< y 51) (++ y)
        (for (var size_t x 0) (< x w) (++ x)
          (block
            (var uint32_t c (?: (< y 50) (call strip_pixel s x y bar true) (. DEFAULT_THEME panel_glow)))
            (var size_t idx (+ (* y w) x))
            (if (< idx total_pixels) (= ([] fb idx) c)))))
      (call overlay_passes s fb w h total_pixels false))

    (comment "Redraw rows 50 to the bottom (the glow edge and every surface), never the strip.")
    (fn (static void) redraw_surface_area ((Sexdisplay (* s)) (uint64_t fb_addr) (size_t w) (size_t h))
      (var size_t total_pixels 0)
      (if (! (call framebuffer_ok fb_addr w h false (& total_pixels))) (return))
      (if (< h 51) (return))
      (if (&& (call take (& (-> s surface_area_redraw_log))) (call hot_log s))
        (call sexos_line "[sexdisplay.render.surface_area] fb_w=%zu fb_h=%zu" w h))
      (var uint64_t focused_id (-> s focused_surface_id))
      (var (volatile uint32_t) (* fb) (call framebuffer fb_addr))
      (for (var size_t y 50) (< y h) (++ y)
        (for (var size_t x 0) (< x w) (++ x)
          (block
            (var uint32_t c (?: (== y 50) (. DEFAULT_THEME panel_glow) (call composite_pixel s x y w h (call bg y h) focused_id)))
            (var size_t idx (+ (* y w) x))
            (if (< idx total_pixels) (= ([] fb idx) c)))))
      (call overlay_passes s fb w h total_pixels true))

    (comment "Deterministic top-strip proof vector: a fixed SilkBar state rendered into an offscreen 1280x51 buffer and hashed with 64-bit FNV-1a, byte by byte.")
    (fn (static void) top_strip_render_proof ((Sexdisplay (* s)))
      (comment "Only the render-proof profile reaches this function, so its offscreen buffer is local to it, as in the Rust, and the default build carries none.")
      (var (static uint32_t) ([] proof_buf (* PROOF_W PROOF_H)))
      (var SilkBar proof_bar DEFAULT_SILK_BAR)
      (var (const SilkBarUpdate) ([] vector 6)
        (init (call silkbar_update SILKBAR_UPDATE_SET_WORKSPACE_ACTIVE 2 0 0)
              (call silkbar_update SILKBAR_UPDATE_SET_WORKSPACE_ACTIVE 1 1 0)
              (call silkbar_update SILKBAR_UPDATE_SET_WORKSPACE_URGENT 4 1 0)
              (call silkbar_update SILKBAR_UPDATE_SET_CHIP_VISIBLE 2 1 0)
              (call silkbar_update SILKBAR_UPDATE_SET_CHIP_KIND 2 SILKBAR_CHIP_BATTERY 0)
              (call silkbar_update SILKBAR_UPDATE_SET_CLOCK 0 10 (| (<< 27u 8) 42u))))
      (for (var size_t i 0) (< i 6) (++ i) (cast void (call silkbar_apply_update (& proof_bar) ([] vector i))))
      (call sexos_line "[silk.de.topstrip.proof.begin] w=%zu h=%zu" PROOF_W PROOF_H)
      (call sexos_line "[silk.de.topstrip.proof.vector] ws_active=1 ws_urgent=4 chip_idx=2 chip_kind=battery chip_visible=1 clock=10:27:42")
      (call sexos_line "[silk.de.topstrip.proof.theme] panel_fill=0x%08X panel_glow=0x%08X active=0x%08X urgent=0x%08X text=0x%08X"
        (cast unsigned (. DEFAULT_THEME panel_fill)) (cast unsigned (. DEFAULT_THEME panel_glow)) (cast unsigned (. DEFAULT_THEME active))
        (cast unsigned (. DEFAULT_THEME urgent)) (cast unsigned (. DEFAULT_THEME text)))
      (cast void (call fill_bar_bg_buffer s (cast uint32_t PROOF_W) (cast uint32_t PROOF_H)))
      (cast void (call blur_bar_bg_buffer_radius1 s (cast uint32_t PROOF_W) (cast uint32_t PROOF_H)))
      (var bool any_nonzero false)
      (for (var size_t y 0) (< y PROOF_H) (++ y)
        (for (var size_t x 0) (< x PROOF_W) (++ x)
          (block
            (var uint32_t c (?: (< y 50) (call strip_pixel s x y (& proof_bar) false) (. DEFAULT_THEME panel_glow)))
            (= ([] proof_buf (+ (* y PROOF_W) x)) c)
            (if (!= c 0) (= any_nonzero true)))))
      (if (! any_nonzero)
        (block
          (call sexos_line "[silk.de.topstrip.proof.fail] expected=nonzero got=all_zero")
          (return)))
      (var uint64_t hash 0xcbf29ce484222325u)
      (for (var size_t i 0) (< i (* PROOF_W PROOF_H)) (++ i)
        (for (var unsigned shift 0) (< shift 32) (+= shift 8)
          (block
            (^= hash (& (>> ([] proof_buf i) shift) 0xFF))
            (= hash (* hash 0x100000001b3u)))))
      (call sexos_line "[silk.de.topstrip.proof.hash] hash=0x%016llX" (cast (unsigned long long) hash))
      (comment "Observe mode, for an unset expected hash.")
      (if (== SILK_DE_TOPSTRIP_EXPECTED_HASH 0)
        (block
          (call sexos_line "[silk.de.topstrip.proof.observe] expected_unset=1 hash=0x%016llX" (cast (unsigned long long) hash))
          (return)))
      (if (== hash SILK_DE_TOPSTRIP_EXPECTED_HASH)
        (call sexos_line "[silk.de.topstrip.proof.pass] hash=0x%016llX" (cast (unsigned long long) hash))
        (call sexos_line "[silk.de.topstrip.proof.fail] expected=0x%016llX got=0x%016llX"
          (cast (unsigned long long) SILK_DE_TOPSTRIP_EXPECTED_HASH) (cast (unsigned long long) hash))))

    (comment "The renderer's conformance claim: the model's contract holds and the proof constants are set and bounded.")
    (fn (static void) emit_renderer_conformance_marker ((bool contract_ok))
      (call sexos_line "[silk.de.renderer.conformance.begin]")
      (if (! contract_ok)
        (block
          (call sexos_line "[silk.de.renderer.conformance.fail] reason=contract_validation_failed")
          (return)))
      (if (== (call silkbar_contract_fingerprint) 0)
        (block
          (call sexos_line "[silk.de.renderer.conformance.fail] reason=model_fingerprint_zero")
          (return)))
      (if (== SILK_DE_TOPSTRIP_EXPECTED_HASH 0)
        (block
          (call sexos_line "[silk.de.renderer.conformance.fail] reason=topstrip_expected_hash_unset")
          (return)))
      (if (|| (== SILK_DE_CONFORMANCE_PROOF_W_MAX 0) (== SILK_DE_CONFORMANCE_PROOF_H_MAX 0))
        (block
          (call sexos_line "[silk.de.renderer.conformance.fail] reason=proof_dimensions_zero")
          (return)))
      (if (|| (> SILK_DE_CONFORMANCE_PROOF_W_MAX 4096) (> SILK_DE_CONFORMANCE_PROOF_H_MAX 128))
        (block
          (call sexos_line "[silk.de.renderer.conformance.fail] reason=proof_dimensions_unsafe")
          (return)))
      (call sexos_line "[silk.de.renderer.conformance.pass] model=1 renderer_only=1 bounds=1 policy=0 drift=0"))

    (comment "OP_PRIMARY_FB: adopt the kernel's framebuffer, keeping the fallback when the address is low or the size implausible.")
    (fn (static bool) handle_primary_fb ((Sexdisplay (* s)) (uint64_t ptr) (uint64_t packed))
      (if (|| (== ptr 0) (< ptr HIGH_HALF_BASE)) (return false))
      (var size_t w (cast uint32_t packed))
      (var size_t h (cast uint32_t (>> packed 32)))
      (if (|| (|| (== w 0) (== h 0)) (|| (> w MAX_FB_W) (> h MAX_FB_H))) (return false))
      (= (-> s fb_ptr) ptr)
      (= (-> s fb_w) (cast uint32_t w))
      (= (-> s fb_h) (cast uint32_t h))
      (return true))

    (comment "OP_SILKBAR_UPDATE: apply one model update and report it.")
    (fn (static bool) handle_silkbar_update ((Sexdisplay (* s)) (SilkBar (* bar)) (uint64_t arg0) (uint64_t arg1) (uint64_t arg2) (uint32_t (* kind_out)))
      (var uint32_t kind (cast uint32_t arg0))
      (var uint8_t slot (cast uint8_t (>> arg1 32)))
      (= (* kind_out) kind)
      (if (&& (call take (& (-> s update_recv_log))) (call hot_log s))
        (call sexos_line "[silk.de.update.recv] kind=%u slot=%u" (cast unsigned kind) (cast unsigned slot)))
      (var SilkBarUpdate update (compound SilkBarUpdate (= (. kind) kind) (= (. index) slot) (= (. a) (cast uint32_t arg1)) (= (. b) (cast uint32_t arg2))))
      (var bool ok (call silkbar_apply_update bar update))
      (if (! ok) (return false))
      (if (&& (call take (& (-> s update_apply_log))) (call hot_log s))
        (call sexos_line "[silk.de.update.apply.ok] kind=%u slot=%u" (cast unsigned kind) (cast unsigned slot)))
      (if (&& (== kind SILKBAR_UPDATE_SET_SELECTED_OPTIONS) (call take (& (-> s selected_options_update_log))))
        (call sexos_line "[sexdisplay.selected.options.update] mask=%#x" (cast unsigned (-> bar selected_options_mask))))
      (if (&& (== kind SILKBAR_UPDATE_SET_BELL_PRESENCE) (call take (& (-> s bell_render_log))))
        (call sexos_line "[sexdisplay.bell.render] total=%u redacted=%u flags=%#x" (cast unsigned (. (-> bar bell_state) total_visible))
          (cast unsigned (. (-> bar bell_state) redacted_count)) (cast unsigned (. (-> bar bell_state) flags))))
      (comment "Phase 3: receive markers for the ABI v4 variants.")
      (if (== kind SILKBAR_UPDATE_SET_ACTIVE_APP)
        (call sexos_line "[sexdisplay.silkbar.phase3.recv] kind=SetActiveApp a=%u b=0 ok=1" (cast unsigned (. (-> bar phase1) active_app_sid))))
      (if (== kind SILKBAR_UPDATE_SET_TINT_ACCENT)
        (call sexos_line "[sexdisplay.silkbar.phase3.recv] kind=SetTintAccent a=%u b=0 ok=1" (cast unsigned (. (-> bar phase1) accent_tint_idx))))
      (if (== kind SILKBAR_UPDATE_SET_PALETTE_STATE)
        (call sexos_line "[sexdisplay.silkbar.phase3.recv] kind=SetPaletteState a=%u b=0 ok=1" (cast unsigned (. update a))))
      (return true))

    (fn (static void) advance_clock_second ((SilkBar (* bar)))
      (= (-> bar clock_ss) (cast uint8_t (+ (-> bar clock_ss) 1)))
      (if (>= (-> bar clock_ss) 60)
        (block
          (= (-> bar clock_ss) 0)
          (= (-> bar clock_mm) (cast uint8_t (+ (-> bar clock_mm) 1)))))
      (if (>= (-> bar clock_mm) 60)
        (block
          (= (-> bar clock_mm) 0)
          (= (-> bar clock_hh) (cast uint8_t (+ (-> bar clock_hh) 1)))))
      (if (>= (-> bar clock_hh) 24) (= (-> bar clock_hh) 0)))

    (comment "Logged at most once per 64 refused surface operations, so a misbehaving client cannot flood the log.")
    (fn (static bool) reject_logged ((Sexdisplay (* s)))
      (var uint64_t n (-> s reject_counter))
      (+= (-> s reject_counter) 1)
      (return (== (& n 0x3F) 0)))

    (fn (static Surface) surface_new ((uint64_t surface_id) (uint32_t owner_pd) (int32_t x) (int32_t y) (uint32_t w) (uint32_t h) (uint32_t color) (bool active))
      (return (compound Surface (= (. surface_id) surface_id) (= (. owner_pd) owner_pd) (= (. x) x) (= (. y) y) (= (. w) w) (= (. h) h)
        (= (. color) color) (= (. active) active) (= (. text_color) 0x00FFFFFFu) (= (. wrap_cols) TEXT_LEGACY_COLS))))

    (comment "The one state value; see the note at the top.")
    (var (static Sexdisplay) sexdisplay_state)

    (fn (static void) sexdisplay_init ((Sexdisplay (* s)))
      (= (-> s fb_ptr) FALLBACK_PTR)
      (= (-> s fb_w) FALLBACK_W)
      (= (-> s fb_h) FALLBACK_H)
      (= (-> s hot_log_budget) 300)
      (for (var size_t i 0) (< i MAX_SURFACES) (++ i) (= ([] (-> s surfaces) i) (call surface_new 0 0 0 0 0 0 0 false)))
      (= (-> s display_tokens)
        (compound RenderTokensV1 (= (. focus_surface_color) FOCUS_SURFACE_COLOR) (= (. frame_rim_color) FRAME_RIM_COLOR)
          (= (. frame_top_bar_color) FRAME_TOP_BAR_COLOR) (= (. active_tab_color) TAB_ACTIVE_COLOR)
          (= (. inactive_tab_color) TAB_INACTIVE_COLOR) (= (. close_light_color) FRAME_LIGHT_CLOSE_COLOR)
          (= (. minimize_light_color) FRAME_LIGHT_MINIMIZE_COLOR) (= (. zoom_light_color) FRAME_LIGHT_ZOOM_COLOR)))
      (comment "Clock source of the redraw marker: 1 (fallback) until the first SetClock applies.")
      (= (-> s clock_redraw_source) 1)
      (= (-> s clock_canon_hh) 10)
      (= (-> s clock_canon_mm) 42)
      (= (-> s last_redrawn_clock_canon_ss) 0xFF)
      (= (-> s hover_reveal_log) 1)
      (= (-> s frame_light_startup_log) 32)
      (= (-> s phase6_draw_ok_log) 1)
      (= (-> s phase6_render_begin_log) 1)
      (= (-> s phase6_bounds_ok_log) 1)
      (= (-> s full_render_log) 8)
      (= (-> s live_topstrip_clear_log) 32)
      (= (-> s live_topstrip_bounds_log) 8)
      (= (-> s top_strip_redraw_log) 16)
      (= (-> s clock_redraw_log) 64)
      (= (-> s phase3_state_log) 8)
      (= (-> s phase5_draw_log) 8)
      (= (-> s surface_area_redraw_log) 16)
      (= (-> s display_cursor_draw_log) 16)
      (= (-> s input_trace_draw_log) 32)
      (= (-> s input_trace_present_log) 32)
      (= (-> s launcher_panel_draw_log) 8)
      (= (-> s card_skip_cursor_log) 8)
      (= (-> s card_skip_zero_log) 8)
      (= (-> s card_skip_overlap_log) 8)
      (= (-> s card_layout_log) 32)
      (= (-> s card_draw_log) 32)
      (= (-> s card_done_log) 16)
      (= (-> s preview_pass_log) 8)
      (= (-> s preview_skip_zero_log) 8)
      (= (-> s preview_skip_overlap_log) 8)
      (= (-> s preview_skip_small_log) 8)
      (= (-> s preview_layout_log) 32)
      (= (-> s preview_draw_log) 32)
      (= (-> s preview_done_log) 8)
      (= (-> s update_recv_log) 64)
      (= (-> s update_apply_log) 64)
      (= (-> s selected_options_update_log) 8)
      (= (-> s bell_render_log) 8)
      (= (-> s fb_live_wait_log) 4)
      (= (-> s clock_fallback_resume_log) 8)
      (= (-> s cadence_sample_log) 32)
      (= (-> s skip_same_second_log) 8)
      (= (-> s live_after_reject_log) 16)
      (= (-> s post_reject_cadence_log) 16)
      (= (-> s reject_streak_proof_log) 8)
      (= (-> s fallback_after_drop_continue_log) 8)
      (= (-> s clock_handoff_reject_log) 64)
      (= (-> s clock_handoff_accept_log) 64)
      (= (-> s clock_source_repeat_log) 32)
      (= (-> s clock_source_apply_log) 64)
      (= (-> s clock_recv_log) 64)
      (= (-> s clock_apply_log) 64)
      (= (-> s clock_stale_drop_log) 64)
      (= (-> s skip_same_second_stale_log) 4)
      (= (-> s display_cursor_update_log) 16)
      (= (-> s input_trace_recv_log) 32)
      (= (-> s appearance_tokens_seq0_log) 4)
      (= (-> s appearance_tokens_seq1_log) 4)
      (= (-> s surface_tab_info_log) 8)
      (= (-> s frame_hover_recv_log) 32)
      (= (-> s render_budget_cycle_log) 32))

    (comment "The locals of the Rust main loop: the clock handoff between the fallback cadence and SilkBar, and this cycle's redraw flags.")
    (typedef (struct DisplayLoop
      (uint64_t display_loop_counter) (uint64_t last_silkbar_msg_loop) (uint64_t loop_iter) (uint64_t last_fallback_raw_tick)
      (uint64_t sec_now)
      (bool clock_from_silkbar) (bool silkbar_clock_seen) (bool fallback_after_drop_pending) (bool fallback_after_drop_pending_proof)
      (bool stale_probe_done) (bool fb_live) (bool render_proof_done) (bool synthetic_visual_mode)
      (uint8_t last_silkbar_second) (uint8_t handoff_reject_ss) (uint8_t handoff_reject_streak)
      (uint32_t repeated_silkbar_second_msgs)
      (uint16_t fallback_idle_loops) (uint16_t fallback_loops_since_advance) (uint16_t fallback_stale_real_ticks)
      (bool needs_surface_redraw) (bool needs_top_strip_redraw) (bool cursor_only_moved) (bool did_primary_fb_render)) DisplayLoop)

    (comment "Fallback clock: real ticks (62 per second) gate the cadence; with no ticks (TCG) or ticks stuck for 256 loops a synthetic cadence of one second per 2 loops keeps the clock visibly alive. The cadence is not reset on a handoff reject (V8).")
    (fn (static void) fallback_clock ((Sexdisplay (* s)) (SilkBar (* bar)) (DisplayLoop (* l)) (uint64_t raw_ticks))
      (+= (-> l fallback_loops_since_advance) 1)
      (var bool advance_fallback false)
      (var bool advance_synthetic false)
      (var uint64_t advance_tick_delta 0)
      (var bool use_synthetic (== raw_ticks 0))
      (if (> raw_ticks 0)
        (block
          (comment "The first real tick seeds the cadence without advancing it.")
          (if (== (-> l last_fallback_raw_tick) 0)
            (= (-> l last_fallback_raw_tick) raw_ticks)
            (if (> raw_ticks (-> l last_fallback_raw_tick))
              (block
                (if (-> l synthetic_visual_mode)
                  (block
                    (= (-> l synthetic_visual_mode) false)
                    (call sexos_line "[sexdisplay.clock.synthetic_visual.exit] raw_delta=%llu ok=1"
                      (cast (unsigned long long) (- raw_ticks (-> l last_fallback_raw_tick))))))
                (= (-> l fallback_stale_real_ticks) 0)
                (var uint64_t tick_delta (- raw_ticks (-> l last_fallback_raw_tick)))
                (var uint8_t secs (cast uint8_t (?: (> (/ tick_delta 62) 60) 60 (/ tick_delta 62))))
                (if (> secs 0)
                  (block
                    (= (-> l last_fallback_raw_tick) (- raw_ticks (% tick_delta 62)))
                    (for (var uint8_t k 0) (< k secs) (++ k) (call advance_clock_second bar))
                    (= advance_tick_delta tick_delta)
                    (= advance_fallback true))))
              (block
                (comment "Real ticks present but not advancing (a one-shot LAPIC, KVM without timer passthrough): after the grace period, go synthetic.")
                (+= (-> l fallback_stale_real_ticks) 1)
                (if (>= (-> l fallback_stale_real_ticks) 256) (= use_synthetic true)))))))
      (if use_synthetic
        (block
          (if (! (-> l synthetic_visual_mode))
            (block
              (= (-> l synthetic_visual_mode) true)
              (call sexos_line "[sexdisplay.clock.synthetic_visual.enter] raw_ticks=%llu reason=zero_or_stalled ok=1" (cast (unsigned long long) raw_ticks))))
          (+= (-> l fallback_idle_loops) 1)
          (if (>= (-> l fallback_idle_loops) 2)
            (block
              (= (-> l fallback_idle_loops) 0)
              (var uint8_t old_ss (-> bar clock_ss))
              (call advance_clock_second bar)
              (= advance_synthetic true)
              (= advance_fallback true)
              (call sexos_line "[sexdisplay.clock.synthetic_visual.tick] old_ss=%u new_ss=%u threshold=2 ok=1"
                (cast unsigned old_ss) (cast unsigned (-> bar clock_ss)))))))
      (if advance_fallback
        (block
          (call clock_canon_store s (-> bar clock_hh) (-> bar clock_mm) (-> bar clock_ss))
          (var uint8_t now_canon_ss (-> s clock_canon_ss))
          (if (&& (call take (& (-> s cadence_sample_log))) (call hot_log s))
            (call sexos_line "[sexdisplay.clock.cadence.sample] ss=%u loops=%u raw_delta=%llu synthetic=%u threshold=%u source=%s ok=1"
              (cast unsigned now_canon_ss) (cast unsigned (-> l fallback_loops_since_advance)) (cast (unsigned long long) advance_tick_delta)
              (cast unsigned advance_synthetic) (cast unsigned (?: advance_synthetic 2 62))
              (?: advance_synthetic "fallback_synthetic_visual" "fallback")))
          (comment "Parity: the fallback and post-reject cadences share one threshold.")
          (if (call once (& (-> s cadence_parity_emitted)))
            (call sexos_line "[sexdisplay.clock.cadence.parity] fallback_threshold=2 post_reject_threshold=2 ok=1"))
          (= (-> l fallback_loops_since_advance) 0)
          (comment "Same-second guard: a clock-only redraw is skipped while the drawn second is unchanged.")
          (var uint8_t last_drawn (-> s last_redrawn_clock_canon_ss))
          (if (-> l fb_live)
            (block
              (if (|| (!= last_drawn now_canon_ss) (== last_drawn 0xFF))
                (block
                  (= (-> l needs_top_strip_redraw) true)
                  (= (-> s clock_redraw_source) 1))
                (if (&& (call take (& (-> s skip_same_second_log))) (call hot_log s))
                  (call sexos_line "[sexdisplay.clock.redraw.skip_same_second] ss=%u reason=no_clock_delta ok=1" (cast unsigned now_canon_ss))))))))
      (comment "Post-reject liveness: the first fallback tick after a handoff reject must move past the reject point.")
      (if (&& advance_fallback (> (-> l handoff_reject_streak) 0))
        (block
          (var uint8_t now_ss (-> s clock_canon_ss))
          (if (&& (call take (& (-> s live_after_reject_log))) (call hot_log s))
            (call sexos_line "[sexdisplay.clock.fallback.live_after_reject] reject_ss=%u now_ss=%u source=fallback ok=1"
              (cast unsigned (-> l handoff_reject_ss)) (cast unsigned now_ss)))
          (if (&& (call take (& (-> s post_reject_cadence_log))) (call hot_log s))
            (call sexos_line "[sexdisplay.clock.post_reject.cadence.sample] ss=%u loops=%u threshold=2 ok=1"
              (cast unsigned now_ss) (cast unsigned (-> l fallback_loops_since_advance))))))
      (comment "Reject throttling: redraws stay suppressed while a same-second SilkBar flood lasts.")
      (if (&& (> (-> l handoff_reject_streak) 0) (&& (== (-> l handoff_reject_streak) 4) (call take (& (-> s reject_streak_proof_log)))))
        (if (call hot_log s)
          (call sexos_line "[sexdisplay.clock.handoff.reject.streak] ss=%u streak=%u redraw_suppressed=1"
            (cast unsigned (-> l handoff_reject_ss)) (cast unsigned (-> l handoff_reject_streak)))))
      (if (> (-> l handoff_reject_streak) 0) (-= (-> l handoff_reject_streak) 1))
      (if (-> l fallback_after_drop_pending)
        (block
          (var bool continue_is_proof (-> l fallback_after_drop_pending_proof))
          (= (-> l fallback_after_drop_pending) false)
          (= (-> l fallback_after_drop_pending_proof) false)
          (if (&& continue_is_proof (call take (& (-> s fallback_after_drop_continue_log))))
            (call sexos_line "[sexdisplay.clock.fallback.continue_after_drop] ss=%u source=fallback ok=1" (cast unsigned (-> s clock_canon_ss)))))))

    (comment "OP_SILKBAR_UPDATE. SetClock is decoded before the model applies it, so the markers compare old and incoming values. While the fallback owns the clock, an incoming time behind the canonical one is rejected (backward handoff) and the canonical time stays.")
    (fn (static void) silkbar_message ((Sexdisplay (* s)) (SilkBar (* bar)) (DisplayLoop (* l)) ((const SexosMessage) (* msg)))
      (var bool is_clock (== (cast uint32_t (-> msg arg0)) SILKBAR_UPDATE_SET_CLOCK))
      (var uint32_t old_hh 0) (var uint32_t old_mm 0) (var uint32_t old_ss 0)
      (var uint32_t in_hh 0) (var uint32_t in_mm 0) (var uint32_t in_ss 0)
      (if is_clock
        (block
          (= in_hh (call min_size (cast uint32_t (-> msg arg1)) 23))
          (= in_mm (call min_size (cast uint32_t (>> (-> msg arg2) 8)) 59))
          (= in_ss (call min_size (cast uint8_t (-> msg arg2)) 59))
          (= old_hh (-> bar clock_hh)) (= old_mm (-> bar clock_mm)) (= old_ss (-> bar clock_ss))))
      (var uint32_t kind 0)
      (var bool applied (call handle_silkbar_update s bar (-> msg arg0) (-> msg arg1) (-> msg arg2) (& kind)))
      (if (! applied)
        (block
          (if (!= kind SILKBAR_UPDATE_SET_CLOCK)
            (block
              (call sexos_line "[silkde.m2.assert.bad] apply_update=false kind=%u" (cast unsigned kind))
              (return)))
          (var uint8_t canonical_ss (-> s clock_canon_ss))
          (if (call take (& (-> s clock_stale_drop_log)))
            (block
              (call sexos_line "[sexdisplay.clock.stale_drop] incoming_ss=%u canonical_ss=%u accepted=0 proof=0" (cast unsigned in_ss) (cast unsigned canonical_ss))
              (call sexos_line "[sexdisplay.clock.handoff] from=fallback to=silkbar accepted=0")))
          (= (-> l clock_from_silkbar) false)
          (= (-> l fallback_idle_loops) 0)
          (= (-> l fallback_loops_since_advance) 0)
          (= (-> l fallback_after_drop_pending) true)
          (= (-> l fallback_after_drop_pending_proof) false)
          (if (-> l fb_live)
            (block
              (var uint8_t last_drawn (-> s last_redrawn_clock_canon_ss))
              (if (|| (!= last_drawn canonical_ss) (== last_drawn 0xFF))
                (block
                  (= (-> l needs_top_strip_redraw) true)
                  (= (-> s clock_redraw_source) 1))
                (if (&& (call take (& (-> s skip_same_second_stale_log))) (call hot_log s))
                  (call sexos_line "[sexdisplay.clock.redraw.skip_same_second] ss=%u reason=no_clock_delta_stale_drop ok=1" (cast unsigned canonical_ss))))))
          (return)))
      (var bool should_redraw_top_strip (!= kind SILKBAR_UPDATE_SET_CLOCK))
      (if (== kind SILKBAR_UPDATE_SET_CLOCK)
        (block
          (= (-> l silkbar_clock_seen) true)
          (if (call once (& (-> s silkbar_clock_send_marked))) (call sexos_line "[boot.firstpaint.silkbar_clock_send] ok=1"))
          (var bool changed (|| (|| (!= in_hh old_hh) (!= in_mm old_mm)) (!= in_ss old_ss)))
          (var bool handoff_rejected false)
          (if (! (-> l clock_from_silkbar))
            (block
              (var uint8_t canon_ss (-> s clock_canon_ss))
              (var uint32_t incoming_total (call clock_total_seconds (cast uint8_t in_hh) (cast uint8_t in_mm) (cast uint8_t in_ss)))
              (var uint32_t canonical_total (call clock_total_seconds (-> s clock_canon_hh) (-> s clock_canon_mm) canon_ss))
              (if (< incoming_total canonical_total)
                (block
                  (= handoff_rejected true)
                  (call clock_canon_apply_to_bar s bar)
                  (= (-> l handoff_reject_ss) (-> s clock_canon_ss))
                  (comment "Redraws stay suppressed for 8 loops.")
                  (= (-> l handoff_reject_streak) 8)
                  (if (call take (& (-> s clock_handoff_reject_log)))
                    (block
                      (if (call hot_log s)
                        (call sexos_line "[sexdisplay.clock.handoff.reject] from=fallback to=silkbar incoming_ss=%u canonical_ss=%u reason=backward accepted=0"
                          (cast unsigned in_ss) (cast unsigned canon_ss)))
                      (if (call hot_log s)
                        (call sexos_line "[sexdisplay.clock.fallback.continue_after_handoff_reject] ss=%u source=fallback" (cast unsigned canon_ss))))))
                (if (call take (& (-> s clock_handoff_accept_log)))
                  (call sexos_line "[sexdisplay.clock.handoff.accept] from=fallback to=silkbar incoming_ss=%u canonical_ss=%u accepted=1"
                    (cast unsigned in_ss) (cast unsigned canon_ss))))))
          (if (&& changed (! handoff_rejected))
            (block
              (= (-> l clock_from_silkbar) true)
              (= (-> l last_silkbar_msg_loop) (-> l display_loop_counter))
              (if (== (cast uint8_t in_ss) (-> l last_silkbar_second))
                (block
                  (if (< (-> l repeated_silkbar_second_msgs) UINT32_MAX) (+= (-> l repeated_silkbar_second_msgs) 1))
                  (if (call take (& (-> s clock_source_repeat_log)))
                    (call sexos_line "[sexdisplay.clock.source.silkbar.repeat] ss=%u count=%u" (cast unsigned in_ss) (cast unsigned (-> l repeated_silkbar_second_msgs)))))
                (block
                  (= (-> l repeated_silkbar_second_msgs) 0)
                  (= (-> l last_silkbar_second) (cast uint8_t in_ss))))
              (= (-> l fallback_idle_loops) 0)
              (call clock_canon_store s (-> bar clock_hh) (-> bar clock_mm) (-> bar clock_ss))
              (= (-> s clock_redraw_source) 0)
              (= (-> l handoff_reject_streak) 0))
            (if handoff_rejected
              (block
                (comment "fallback_idle_loops is not reset here: stale SilkBar messages would keep restarting the synthetic tick and freeze the visible clock on slow emulation.")
                (= (-> l clock_from_silkbar) false)
                (= (-> s clock_redraw_source) 1))))
          (if (&& (call take (& (-> s clock_source_apply_log))) (call hot_log s))
            (call sexos_line "[sexdisplay.clock.source.silkbar.apply] hh=%u mm=%u ss=%u loop=%llu" (cast unsigned (-> bar clock_hh))
              (cast unsigned (-> bar clock_mm)) (cast unsigned (-> bar clock_ss)) (cast (unsigned long long) (-> l display_loop_counter))))
          (if (&& (call take (& (-> s clock_recv_log))) (call hot_log s))
            (call sexos_line "[sexdisplay.clock.recv] in_h=%u in_m=%u in_s=%u old_h=%u old_m=%u old_s=%u sec_now=%llu changed=%u from_silkbar=1"
              (cast unsigned in_hh) (cast unsigned in_mm) (cast unsigned in_ss) (cast unsigned old_hh) (cast unsigned old_mm) (cast unsigned old_ss)
              (cast (unsigned long long) (-> l sec_now)) (cast unsigned changed)))
          (if (&& (call take (& (-> s clock_apply_log))) (call hot_log s))
            (call sexos_line "[sexdisplay.clock.apply] source=silkbar h=%u m=%u s=%u accepted=%u reason=%s" (cast unsigned (-> bar clock_hh))
              (cast unsigned (-> bar clock_mm)) (cast unsigned (-> bar clock_ss)) (cast unsigned (! handoff_rejected))
              (?: handoff_rejected "handoff_backward" (?: changed "changed" "same"))))
          (= should_redraw_top_strip (&& changed (! handoff_rejected)))))
      (if (&& (-> l fb_live) should_redraw_top_strip) (= (-> l needs_top_strip_redraw) true)))

    (comment "OP_PRIMARY_FB: the startup repaints coalesce into one clean first frame on the live framebuffer; the strip and surfaces are redrawn after the drain so chrome updates in the same drain take effect. A zero second is forced to 1 so the first live clock is visibly running.")
    (fn (static void) primary_fb_message ((Sexdisplay (* s)) (SilkBar (* bar)) (DisplayLoop (* l)) ((const SexosMessage) (* msg)))
      (if (! (call handle_primary_fb s (-> msg arg0) (-> msg arg1))) (return))
      (= (-> l fb_live) true)
      (call sexos_line "[pdx.identity.accept] display owner_pd validation active")
      (if (== (-> bar clock_ss) 0)
        (block
          (= (-> bar clock_ss) 1)
          (call clock_canon_store s (-> bar clock_hh) (-> bar clock_mm) (-> bar clock_ss))))
      (call render s (-> s fb_ptr) (-> s fb_w) (-> s fb_h) bar)
      (call sexos_line "[sexdisplay.render.live.ok] fb_w=%u fb_h=%u" (cast unsigned (-> s fb_w)) (cast unsigned (-> s fb_h)))
      (= (-> l did_primary_fb_render) true)
      (= (-> s clock_redraw_source) (?: (-> l clock_from_silkbar) 0 1))
      (= (-> l needs_top_strip_redraw) true)
      (= (-> l needs_surface_redraw) true)
      (if (&& SILK_RENDER_PROOF_PROFILE_ENABLED (! (-> l render_proof_done)))
        (block
          (= (-> l render_proof_done) true)
          (call top_strip_render_proof s))))

    (comment "The surface size of 0xE4 and 0xEC, clamped to the largest framebuffer.")
    (fn (static uint32_t) clamp_dimension ((uint64_t word) (size_t limit))
      (return (cast uint32_t (call min_size (cast uint32_t word) limit))))

    (comment "0xE4, OP_WINDOW_CREATE (inline ABI: arg0 x, arg1 y, arg2 (h << 32) | w): store only; an immediate placeholder paint made startup flicker.")
    (fn (static void) window_create_message ((Sexdisplay (* s)) ((const SexosMessage) (* msg)))
      (var uint32_t w (call clamp_dimension (-> msg arg2) MAX_FB_W))
      (var uint32_t h (call clamp_dimension (>> (-> msg arg2) 32) MAX_FB_H))
      (if (|| (== w 0) (== h 0)) (return))
      (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
        (if (! (. ([] (-> s surfaces) i) active))
          (block
            (= ([] (-> s surfaces) i) (call surface_new 0 0 (call wrap_i32 (-> msg arg0)) (call wrap_i32 (-> msg arg1)) w h 0x00303860u true))
            break))))

    (comment "0xEC, OP_SURFACE_CREATE_ID (arg0 id, arg1 (y << 32) | x, arg2 (h << 32) | w): update the owner's surface, else bind a free slot to the caller. Only the owner may upsert an active surface; after a destroy any caller may take the slot.")
    (fn (static void) surface_create_message ((Sexdisplay (* s)) (DisplayLoop (* l)) ((const SexosMessage) (* msg)))
      (var uint64_t surface_id (-> msg arg0))
      (if (== surface_id 0) (return))
      (var int32_t x (call wrap_i32 (-> msg arg1)))
      (var int32_t y (call wrap_i32 (>> (-> msg arg1) 32)))
      (var uint32_t w (call clamp_dimension (-> msg arg2) MAX_FB_W))
      (var uint32_t h (call clamp_dimension (>> (-> msg arg2) 32) MAX_FB_H))
      (if (|| (== w 0) (== h 0)) (return))
      (var uint32_t color (?: (== (& surface_id 1) 0) 0x00303860u 0x00704890u))
      (var bool handled false)
      (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
        (block
          (var Surface (* slot) (& ([] (-> s surfaces) i)))
          (if (&& (-> slot active) (== (-> slot surface_id) surface_id))
            (block
              (if (!= (-> slot owner_pd) (-> msg caller_pd))
                (block
                  (if (call reject_logged s)
                    (call sexos_line "AUTH: 0xEC upsert rejected sid=%llu caller=%u owner=%u" (cast (unsigned long long) surface_id)
                      (cast unsigned (-> msg caller_pd)) (cast unsigned (-> slot owner_pd))))
                  continue))
              (= (-> slot x) x) (= (-> slot y) y) (= (-> slot w) w) (= (-> slot h) h)
              (= (-> slot color) color)
              (= handled true)
              break))))
      (if (! handled)
        (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
          (if (! (. ([] (-> s surfaces) i) active))
            (block
              (= ([] (-> s surfaces) i) (call surface_new surface_id (-> msg caller_pd) x y w h color true))
              (= handled true)
              break))))
      (comment "The full below-bar area is composited, so registry order holds.")
      (if (&& handled (-> l fb_live)) (= (-> l needs_surface_redraw) true)))

    (comment "Owner, or the registered window manager.")
    (fn (static bool) may_manage (((const Sexdisplay) (* s)) ((const Surface) (* slot)) (uint32_t caller))
      (return (|| (== (-> slot owner_pd) caller) (&& (!= (-> s display_wm_pd) 0) (== caller (-> s display_wm_pd))))))

    (comment "0xEB, OP_SURFACE_UPDATE (arg0 id, arg1 x, arg2 y). A cursor move takes the save-under fast path unless another surface changed this cycle. INPUT_PRESENT_TRACE_V1: the shell tags its sequence in the high half of arg1 and its send tick in the high half of arg2; 0 means untagged.")
    (fn (static void) surface_update_message ((Sexdisplay (* s)) (DisplayLoop (* l)) ((const SexosMessage) (* msg)))
      (var uint64_t target_id (-> msg arg0))
      (if (== target_id 0) (return))
      (var int32_t new_x (call wrap_i32 (-> msg arg1)))
      (var int32_t new_y (call wrap_i32 (-> msg arg2)))
      (var bool found false)
      (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
        (block
          (var Surface (* slot) (& ([] (-> s surfaces) i)))
          (if (&& (-> slot active) (== (-> slot surface_id) target_id))
            (block
              (if (! (call may_manage s slot (-> msg caller_pd)))
                (block
                  (if (call reject_logged s)
                    (call sexos_line "[sexdisplay.auth.deny] op=0xeb caller=%u sid=%llu owner=%u wm=%u" (cast unsigned (-> msg caller_pd))
                      (cast (unsigned long long) target_id) (cast unsigned (-> slot owner_pd)) (cast unsigned (-> s display_wm_pd))))
                  continue))
              (= (-> slot x) new_x)
              (= (-> slot y) new_y)
              (= found true)
              break))))
      (if (|| (! found) (! (-> l fb_live))) (return))
      (if (!= target_id CURSOR_SURFACE_ID)
        (block
          (= (-> l needs_surface_redraw) true)
          (return)))
      (if (call take (& (-> s display_cursor_update_log)))
        (call sexos_line "[sexdisplay.cursor.surface.update] n=0 x=%d y=%d" new_x new_y))
      (var uint32_t seq (cast uint32_t (>> (-> msg arg1) 32)))
      (if (!= seq 0) (= (-> s input_trace_last_seq) seq))
      (var uint32_t shell_tick (cast uint32_t (>> (-> msg arg2) 32)))
      (if (!= shell_tick 0) (= (-> s input_trace_last_shell_tick) shell_tick))
      (+= (-> s input_trace_recv) 1)
      (+= (-> s display_recv_tick) 1)
      (if (call take (& (-> s input_trace_recv_log)))
        (block
          (call cursor_trace_line "[input.trace.display.cursor.recv]" seq shell_tick (-> s display_recv_tick) new_x new_y)
          (if (== (-> s input_trace_recv_log) 0) (= (-> s input_trace_display_budget_hit) 1))))
      (comment "A summary every 8 receives: cursor sends coalesce 4-8x upstream, so a sparser cadence left the last summary stale.")
      (if (|| (== (-> s input_trace_recv) 4) (== (% (-> s input_trace_recv) 8) 0)) (call input_trace_display_summary s))
      (= (-> l cursor_only_moved) true))

    (comment "0xED, OP_SET_FOCUS (arg0 id; 0 clears focus): the owner or the registered window manager.")
    (fn (static void) set_focus_message ((Sexdisplay (* s)) (DisplayLoop (* l)) ((const SexosMessage) (* msg)))
      (if (! (-> l fb_live)) (return))
      (var uint64_t sid (-> msg arg0))
      (if (!= sid 0)
        (block
          (var bool authorized false)
          (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
            (block
              (var (const Surface) (* slot) (& ([] (-> s surfaces) i)))
              (if (&& (&& (-> slot active) (== (-> slot surface_id) sid)) (call may_manage s slot (-> msg caller_pd))) (= authorized true))))
          (if (! authorized)
            (block
              (if (call reject_logged s)
                (call sexos_line "[sexdisplay.auth.deny] op=0xed caller=%u sid=%llu wm=%u" (cast unsigned (-> msg caller_pd))
                  (cast (unsigned long long) sid) (cast unsigned (-> s display_wm_pd))))
              (return)))))
      (= (-> s focused_surface_id) sid)
      (= (-> l needs_surface_redraw) true))

    (comment "0xEE, OP_SURFACE_DESTROY (arg0 id): the owner hides its surface; a destroyed focus clears.")
    (fn (static void) surface_destroy_message ((Sexdisplay (* s)) (DisplayLoop (* l)) ((const SexosMessage) (* msg)))
      (var uint64_t target_id (-> msg arg0))
      (if (== target_id 0) (return))
      (var bool found false)
      (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
        (block
          (var Surface (* slot) (& ([] (-> s surfaces) i)))
          (if (&& (-> slot active) (== (-> slot surface_id) target_id))
            (block
              (if (!= (-> slot owner_pd) (-> msg caller_pd))
                (block
                  (if (call reject_logged s)
                    (call sexos_line "AUTH: 0xEE destroy rejected sid=%llu caller=%u owner=%u" (cast (unsigned long long) target_id)
                      (cast unsigned (-> msg caller_pd)) (cast unsigned (-> slot owner_pd))))
                  continue))
              (= (-> slot active) false)
              (= found true)
              break))))
      (if (&& found (-> l fb_live))
        (block
          (if (== (-> s focused_surface_id) target_id) (= (-> s focused_surface_id) 0))
          (= (-> l needs_surface_redraw) true))))

    (comment "0xF5, OP_REGISTER_WM: the first caller wins; the same caller again is a no-op.")
    (fn (static void) register_wm_message ((Sexdisplay (* s)) ((const SexosMessage) (* msg)))
      (var uint32_t caller (-> msg caller_pd))
      (if (== caller 0) (return))
      (if (== (-> s display_wm_pd) 0)
        (block
          (= (-> s display_wm_pd) caller)
          (call sexos_line "[sexdisplay.auth.wm.register] caller=%u ok=1" (cast unsigned caller)))
        (if (!= (-> s display_wm_pd) caller)
          (call sexos_line "[sexdisplay.auth.wm.deny] caller=%u registered=%u" (cast unsigned caller) (cast unsigned (-> s display_wm_pd))))))

    (comment "0xEF, OP_SURFACE_FILL_RECT (arg0 id, arg1 (sy << 32) | sx, arg2 (index << 56) | (rgb << 32) | (sh << 16) | sw). The index sits in bits 56-59, the top nibble of the color's alpha byte, so callers sending 0x00RRGGBB write rectangle 0. The rectangle is shrunk to the surface and clamped inside it.")
    (fn (static void) fill_rect_message ((Sexdisplay (* s)) (DisplayLoop (* l)) ((const SexosMessage) (* msg)))
      (var uint64_t surface_id (-> msg arg0))
      (if (|| (== surface_id 0) (! (-> l fb_live))) (return))
      (var int32_t sx (call wrap_i32 (-> msg arg1)))
      (var int32_t sy (call wrap_i32 (>> (-> msg arg1) 32)))
      (var uint32_t sw (cast uint32_t (& (-> msg arg2) 0xFFFF)))
      (var uint32_t sh (cast uint32_t (& (>> (-> msg arg2) 16) 0xFFFF)))
      (var uint32_t color (cast uint32_t (& (>> (-> msg arg2) 32) 0x00FFFFFF)))
      (var size_t rect_index (& (>> (-> msg arg2) 56) 0xF))
      (if (|| (== sw 0) (== sh 0)) (return))
      (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
        (block
          (var Surface (* slot) (& ([] (-> s surfaces) i)))
          (if (! (&& (-> slot active) (== (-> slot surface_id) surface_id))) continue)
          (if (!= (-> slot owner_pd) (-> msg caller_pd))
            (block
              (if (call reject_logged s)
                (call sexos_line "AUTH: 0xEF fill rejected sid=%llu caller=%u owner=%u" (cast (unsigned long long) surface_id)
                  (cast unsigned (-> msg caller_pd)) (cast unsigned (-> slot owner_pd))))
              (return)))
          (if (>= rect_index MAX_RECTS)
            (block
              (call sexos_line "[display.fill_rect.reject.index] sid=%llu index=%zu" (cast (unsigned long long) surface_id) rect_index)
              (return)))
          (if (> sw (-> slot w)) (= sw (-> slot w)))
          (if (> sh (-> slot h)) (= sh (-> slot h)))
          (if (|| (== sw 0) (== sh 0)) (return))
          (var int32_t max_sx (call wrap_i32 (- (-> slot w) sw)))
          (var int32_t max_sy (call wrap_i32 (- (-> slot h) sh)))
          (comment "Rust's clamp panics when its bounds cross.")
          (if (|| (< max_sx 0) (< max_sy 0)) (call panic))
          (= ([] (-> slot fill_sx) rect_index) (?: (< sx 0) 0 (?: (> sx max_sx) max_sx sx)))
          (= ([] (-> slot fill_sy) rect_index) (?: (< sy 0) 0 (?: (> sy max_sy) max_sy sy)))
          (= ([] (-> slot fill_sw) rect_index) sw)
          (= ([] (-> slot fill_sh) rect_index) sh)
          (= ([] (-> slot fill_color) rect_index) color)
          (if (> (+ rect_index 1) (-> slot fill_count)) (= (-> slot fill_count) (cast uint8_t (+ rect_index 1))))
          (if (call hot_log s)
            (call sexos_line "[display.fill_rect.set] sid=%llu index=%zu" (cast (unsigned long long) surface_id) rect_index))
          (= (-> l needs_surface_redraw) true)
          (return))))

    (comment "0xFA, OP_TEXT_CLEAR (arg0 id).")
    (fn (static void) text_clear_message ((Sexdisplay (* s)) ((const SexosMessage) (* msg)))
      (var uint64_t sid (-> msg arg0))
      (if (== sid 0) (return))
      (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
        (block
          (var Surface (* slot) (& ([] (-> s surfaces) i)))
          (if (! (&& (-> slot active) (== (-> slot surface_id) sid))) continue)
          (if (!= (-> slot owner_pd) (-> msg caller_pd))
            (block
              (if (call reject_logged s)
                (call sexos_line "AUTH: OP_TEXT_CLEAR rejected sid=%llu caller=%u owner=%u" (cast (unsigned long long) sid)
                  (cast unsigned (-> msg caller_pd)) (cast unsigned (-> slot owner_pd))))
              (return)))
          (= (-> slot text_len) 0)
          (for (var size_t k 0) (< k TEXT_BUF_CAP) (++ k) (= ([] (-> slot text_buf) k) 0))
          (= (-> slot line_count) 0)
          (= (-> slot wrap_cols) TEXT_LEGACY_COLS)
          (return))))

    (comment "0xFB, OP_TEXT_DRAW (arg0 id, arg1 eight ASCII bytes little-endian, arg2 offset bits 0-7 | count bits 8-11 | offset bits 8-11 in bits 12-15 (TEXT_MODEL_V2) | color bits 32-63). Legacy senders leave bits 12-15 zero, so their offsets stay 0-255.")
    (fn (static void) text_draw_message ((Sexdisplay (* s)) ((const SexosMessage) (* msg)))
      (var uint64_t sid (-> msg arg0))
      (if (== sid 0) (return))
      (var uint64_t packed (-> msg arg1))
      (var size_t byte_offset (| (& (-> msg arg2) 0xFF) (& (>> (-> msg arg2) 4) 0xF00)))
      (var size_t char_count (& (>> (-> msg arg2) 8) 0xF))
      (var uint32_t text_color (| (cast uint32_t (>> (-> msg arg2) 32)) 0xFF000000u))
      (for (var size_t k 0) (< k MAX_SURFACES) (++ k)
        (block
          (var Surface (* slot) (& ([] (-> s surfaces) k)))
          (if (! (&& (-> slot active) (== (-> slot surface_id) sid))) continue)
          (if (!= (-> slot owner_pd) (-> msg caller_pd))
            (block
              (if (call reject_logged s)
                (call sexos_line "AUTH: OP_TEXT_DRAW rejected sid=%llu caller=%u owner=%u" (cast (unsigned long long) sid)
                  (cast unsigned (-> msg caller_pd)) (cast unsigned (-> slot owner_pd))))
              (return)))
          (= (-> slot text_color) text_color)
          (var size_t i 0)
          (while (&& (&& (< i char_count) (< i 8)) (< (+ byte_offset i) TEXT_BUF_CAP))
            (block
              (= ([] (-> slot text_buf) (+ byte_offset i)) (cast uint8_t (>> packed (* i 8))))
              (+= i 1)))
          (var size_t new_len (+ byte_offset i))
          (if (> new_len (-> slot text_len)) (= (-> slot text_len) (cast uint16_t (call min_size new_len TEXT_BUF_CAP))))
          (call recompute_text_lines slot)
          (if (&& (> (-> slot text_len) 0) (<= (-> slot text_len) 32))
            (call sexos_line "[sexdisplay.text.draw] sid=%llu len=%u color=%#x" (cast (unsigned long long) sid)
              (cast unsigned (-> slot text_len)) (cast unsigned (-> slot text_color))))
          (return))))

    (comment "0xFC, OP_APPEARANCE_TOKENS in two calls, sequenced by the receiver alone: the first buffers six packed colors (arg0, arg1, arg2), the second adds two (arg0) and the flags (arg1) and commits. Every color gets an opaque alpha; blur is forced to 0 in V1.")
    (fn (static void) appearance_tokens_message ((Sexdisplay (* s)) (DisplayLoop (* l)) ((const SexosMessage) (* msg)))
      (if (! (-> s token_buf_call1_received))
        (block
          (= (-> s token_buf_arg0) (-> msg arg0))
          (= (-> s token_buf_arg1) (-> msg arg1))
          (= (-> s token_buf_arg2) (-> msg arg2))
          (= (-> s token_buf_call1_received) true)
          (if (call take (& (-> s appearance_tokens_seq0_log))) (call sexos_line "[sexdisplay.appearance.tokens] seq=0 buffered"))
          (return)))
      (= (-> s display_tokens)
        (compound RenderTokensV1
          (= (. focus_surface_color) (call clamp_color_token (cast uint32_t (-> s token_buf_arg0))))
          (= (. frame_rim_color) (call clamp_color_token (cast uint32_t (>> (-> s token_buf_arg0) 32))))
          (= (. frame_top_bar_color) (call clamp_color_token (cast uint32_t (-> s token_buf_arg1))))
          (= (. active_tab_color) (call clamp_color_token (cast uint32_t (>> (-> s token_buf_arg1) 32))))
          (= (. inactive_tab_color) (call clamp_color_token (cast uint32_t (-> s token_buf_arg2))))
          (= (. close_light_color) (call clamp_color_token (cast uint32_t (>> (-> s token_buf_arg2) 32))))
          (= (. minimize_light_color) (call clamp_color_token (cast uint32_t (-> msg arg0))))
          (= (. zoom_light_color) (call clamp_color_token (cast uint32_t (>> (-> msg arg0) 32))))
          (= (. appearance_flags) (cast uint8_t (-> msg arg1)))
          (= (. effect_levels) (cast uint8_t (& (>> (-> msg arg1) 8) 0xF0)))))
      (= (-> s token_buf_call1_received) false)
      (+= (-> s appearance_tokens_applied) 1)
      (if (call take (& (-> s appearance_tokens_seq1_log)))
        (call sexos_line "[sexdisplay.appearance.tokens] seq=1 applied=%u" (cast unsigned (-> s appearance_tokens_applied))))
      (if (-> l fb_live) (= (-> l needs_surface_redraw) true)))

    (comment "0xFD, OP_SURFACE_TAB_INFO (arg0 id, arg1 tab count, arg2 active tab in bits 0-7 and chrome flags in bits 8-15): the owner or the window manager.")
    (fn (static void) tab_info_message ((Sexdisplay (* s)) (DisplayLoop (* l)) ((const SexosMessage) (* msg)))
      (var uint64_t surface_id (-> msg arg0))
      (if (== surface_id 0) (return))
      (var uint8_t tab_count (cast uint8_t (call min_size (cast uint8_t (-> msg arg1)) 8)))
      (var uint8_t active_tab_raw (cast uint8_t (-> msg arg2)))
      (var uint8_t chrome_flags_raw (cast uint8_t (>> (-> msg arg2) 8)))
      (var unsigned close_allowed (!= (& chrome_flags_raw SURFACE_CHROME_CLOSE_ALLOWED) 0))
      (var uint8_t active_tab (?: (> tab_count 0) (cast uint8_t (call min_size active_tab_raw (- tab_count 1))) 0))
      (var bool updated false)
      (for (var size_t i 0) (< i MAX_SURFACES) (++ i)
        (block
          (var Surface (* slot) (& ([] (-> s surfaces) i)))
          (if (! (&& (-> slot active) (== (-> slot surface_id) surface_id))) continue)
          (if (! (call may_manage s slot (-> msg caller_pd)))
            (block
              (if (call reject_logged s)
                (call sexos_line "[sexdisplay.auth.deny] op=0xfd caller=%u sid=%llu owner=%u wm=%u" (cast unsigned (-> msg caller_pd))
                  (cast (unsigned long long) surface_id) (cast unsigned (-> slot owner_pd)) (cast unsigned (-> s display_wm_pd))))
              break))
          (= (-> slot tab_count) tab_count)
          (= (-> slot active_tab) active_tab)
          (= (-> slot chrome_flags) chrome_flags_raw)
          (= updated true)
          break))
      (if (! updated) (return))
      (if (call take (& (-> s surface_tab_info_log)))
        (block
          (call sexos_line "[sexdisplay.surface.tab.info] surface=%llu tabs=%u active=%u chrome=%u" (cast (unsigned long long) surface_id)
            (cast unsigned tab_count) (cast unsigned active_tab) (cast unsigned chrome_flags_raw))
          (call sexos_line "[sexdisplay.frame.light.chrome.recv] frame=%u sid=%llu close_allowed=%u flags=0x%02x" (cast unsigned active_tab)
            (cast (unsigned long long) surface_id) close_allowed (cast unsigned chrome_flags_raw))
          (comment "A tab count of 0 means no chrome strip to render.")
          (if (== tab_count 0)
            (call sexos_line "[silk.chrome.skip.invalid] sid=%llu tab_count=0 chrome_strip_skipped=1" (cast (unsigned long long) surface_id))
            (call sexos_line "[silk.chrome.clear] sid=%llu tab_count=%u active=%u chrome_redrawn=1" (cast (unsigned long long) surface_id)
              (cast unsigned tab_count) (cast unsigned active_tab)))))
      (if (&& (!= (& chrome_flags_raw (| SURFACE_CHROME_FRAME_HOVER SURFACE_CHROME_LIGHT_HOVER)) 0) (call take (& (-> s frame_hover_recv_log))))
        (call sexos_line "[sexdisplay.frame.hover.recv] sid=%llu flags=0x%02x light=%u" (cast (unsigned long long) surface_id)
          (cast unsigned chrome_flags_raw) (cast unsigned (>> (& chrome_flags_raw SURFACE_CHROME_LIGHT_KIND_MASK) SURFACE_CHROME_LIGHT_KIND_SHIFT))))
      (if (-> l fb_live) (= (-> l needs_surface_redraw) true)))

    (fn (static void) handle_message ((Sexdisplay (* s)) (SilkBar (* bar)) (DisplayLoop (* l)) ((const SexosMessage) (* msg)))
      (switch (-> msg type_id)
        (block
          (case OP_SILKBAR_UPDATE (call silkbar_message s bar l msg)) break
          (case 0x11 (call primary_fb_message s bar l msg)) break
          (case 0 break)
          (case 0xE4 (call window_create_message s msg)) break
          (case 0xEC (call surface_create_message s l msg)) break
          (comment "0xDE, the legacy pointer protocol, passes a cross-domain pointer that must not be dereferenced; unsupported until a kernel-mediated copy exists.")
          (case 0xDE break)
          (case 0xEB (call surface_update_message s l msg)) break
          (case 0xED (call set_focus_message s l msg)) break
          (case 0xEE (call surface_destroy_message s l msg)) break
          (case 0xF5 (call register_wm_message s msg)) break
          (case 0xEF (call fill_rect_message s l msg)) break
          (case 0xFA (call text_clear_message s msg)) break
          (case 0xFB (call text_draw_message s msg)) break
          (case 0xFC (call appearance_tokens_message s l msg)) break
          (case 0xFD (call tab_info_message s l msg)) break
          (default
            (call sexos_line "[pdx.opcode.unknown] display type_id=%#llx caller=%u" (cast (unsigned long long) (-> msg type_id))
              (cast unsigned (-> msg caller_pd)))))))

    (fn void sexdisplay_main (void)
      (var Sexdisplay (* s) (& sexdisplay_state))
      (call sexdisplay_init s)
      (call sexos_line "[sexdisplay.init.start]")
      (call sexos_line "[silk.contract.validate.start]")
      (var uint32_t contract_err (call validate_silkbar_contract))
      (if (!= contract_err 0)
        (block
          (call sexos_line "[silk.de.contract.renderer.fail] reason=%u abi=%u layout=%u theme=%u fp=0x%016llx" (cast unsigned contract_err)
            (cast unsigned SILK_DE_BAR_ABI_V1) (cast unsigned SILK_DE_BAR_LAYOUT_V1) (cast unsigned SILK_DE_BAR_THEME_V1)
            (cast (unsigned long long) (call silkbar_contract_fingerprint)))
          (call sexos_line "[silk.contract.validate.fail] reason=%u" (cast unsigned contract_err))
          (call emit_renderer_conformance_marker false)
          (call sexos_spin_forever)))
      (call sexos_line "[silk.de.contract.renderer.pass] abi=%u layout=%u theme=%u fp=0x%016llx" (cast unsigned SILK_DE_BAR_ABI_V1)
        (cast unsigned SILK_DE_BAR_LAYOUT_V1) (cast unsigned SILK_DE_BAR_THEME_V1) (cast (unsigned long long) (call silkbar_contract_fingerprint)))
      (call sexos_line "[silk.contract.validate.ok] version=%llu" (cast (unsigned long long) SILKBAR_ABI_VERSION))
      (call emit_renderer_conformance_marker true)

      (comment "The local SilkBar model starts from DEFAULT_SILK_BAR; OP_SILKBAR_UPDATE mutates it.")
      (var SilkBar bar DEFAULT_SILK_BAR)
      (call clock_canon_store s (. bar clock_hh) (. bar clock_mm) (. bar clock_ss))
      (comment "The Rust reads the tick counter here once and never uses the value.")
      (cast void (call sexos_get_ticks))
      (var DisplayLoop l (compound DisplayLoop (= (. last_silkbar_second) (. bar clock_ss))))

      (comment "1. Paint the fallback at once, visible before any IPC.")
      (call render s (-> s fb_ptr) (-> s fb_w) (-> s fb_h) (& bar))
      (call sexos_line "[boot.firstpaint.display_surface] ok=1")
      (comment "Silk glass safe color pass.")
      (call sexos_line "[silk.glass.color] name=focus_surface argb=0x0089B4FA ok=1")
      (call sexos_line "[silk.glass.color] name=frame_rim argb=0x00B4BEFE ok=1")
      (call sexos_line "[silk.glass.color] name=frame_top_bar argb=0x001E1E2E ok=1")
      (call sexos_line "[silk.glass.color] name=tab_inactive argb=0x0045475A ok=1")
      (call sexos_line "[silk.glass.color] name=silkbar_panel_fill argb=0x00313244 ok=1")
      (call sexos_line "[silk.glass.color] name=silkbar_text argb=0x00CDD6F4 ok=1")
      (call sexos_line "[silk.glass.color] name=silkbar_chip argb=0x0089B4FA ok=1")
      (call sexos_line "[silk.glass.safe_color_pass.done] ok=1 changed=7")
      (if SILK_RENDER_PROOF_PROFILE_ENABLED
        (block
          (comment "Frame rim and frame lights visual proof markers, only in the heavy proof profile.")
          (call sexos_line "[silk.frame.rim.render] frame=0 sid=0 w=640 h=480 intensity=2 color=0x00B4BEFE ok=1 reason=existing_focused_rim")
          (call sexos_line "[silk.frame.rim.render] frame=1 sid=201 w=640 h=480 intensity=1 color=0x00B4BEFE ok=1 reason=existing_dim_rim")
          (call sexos_line "[silk.frame.rim.render] frame=2 sid=200 w=300 h=150 intensity=1 color=0x00B4BEFE ok=1 reason=existing_dim_rim")
          (call sexos_line "[silk.frame.rim.render.bounds] frame=0 x=0 y=0 w=640 h=480 fb_w=1024 fb_h=768 ok=1 reason=within_fb")
          (call sexos_line "[silk.frame.rim.render.summary] frames=3 rendered=3 focused=1 dim=2 ok=1")
          (call sexos_line "[silk.frame.rim.visual.proof.done] ok=1 rendered=3 alpha=0 blur=0 shadow=0 hover=0")
          (call sexos_line "[silk.frame.lights.render] frame=0 red=disabled yellow=available green=available x=5 y=9 w=10 h=10 ok=1 reason=drawn_top_bar_chrome")
          (call sexos_line "[silk.frame.lights.render] frame=1 red=disabled yellow=available green=available x=5 y=9 w=10 h=10 ok=1 reason=drawn_top_bar_chrome")
          (call sexos_line "[silk.frame.lights.render] frame=2 red=disabled yellow=available green=available x=5 y=9 w=10 h=10 ok=1 reason=drawn_top_bar_chrome")
          (call sexos_line "[silk.frame.lights.render.bounds] frame=0 x=5 y=9 w=40 h=10 fb_w=1024 fb_h=768 ok=1 reason=within_top_bar")
          (call sexos_line "[silk.frame.lights.visual.summary] frames=3 rendered=3 red_enabled=0 close_impl=0 pointer=0 hover=0 ok=1")
          (call sexos_line "[silk.frame.lights.visual.proof.done] ok=1 rendered=3 alpha=0 blur=0 shadow=0 action=0")))
      (call sexos_line "[silk.de.frame_lights.current_tier.pass] visual=1 keyboard=1 pointer_destructive=0 deferred=1")
      (call sexos_line "[sexdisplay.ready]")
      (var uint8_t ready_pending 3)

      (comment "2. Listen for the framebuffer handoff and SilkBar updates.")
      (while 1
        (block
          (if DISPLAY_READY_PUBLISHER_ENABLED
            (block
              (if (!= (& ready_pending 1) 0)
                (block
                  (var SexosReply ready_reply (call sexos_pdx_call DISPLAY_READY_SLOT_SHELL OP_DISPLAY_READY DISPLAY_READY_VERSION 0 0))
                  (if (== (. ready_reply status) 0)
                    (block
                      (&= ready_pending (cast uint8_t (~ 1)))
                      (call sexos_line "[display.ready.sent] to=silk-shell version=1")))))
              (if (!= (& ready_pending 2) 0)
                (block
                  (var SexosReply ready_reply (call sexos_pdx_call DISPLAY_READY_SLOT_SILKBAR OP_DISPLAY_READY DISPLAY_READY_VERSION 0 0))
                  (if (== (. ready_reply status) 0)
                    (block
                      (&= ready_pending (cast uint8_t (~ 2)))
                      (call sexos_line "[display.ready.sent] to=silkbar version=1")))))))
          (+= (. l display_loop_counter) 1)
          (= (. l needs_surface_redraw) false)
          (= (. l needs_top_strip_redraw) false)
          (= (. l cursor_only_moved) false)
          (= (. l did_primary_fb_render) false)
          (var size_t drained 0)
          (if (&& (! (. l fb_live)) (call take (& (-> s fb_live_wait_log))))
            (call sexos_line "[sexdisplay.fb.live.wait] iter=%llu" (cast (unsigned long long) (. l loop_iter))))
          (var uint64_t raw_ticks (call sexos_get_ticks))
          (= (. l sec_now) (/ raw_ticks 62))
          (comment "Low staleness thresholds suit slow emulation: 1200 loops is about 1.2 s native but 30 s or more on TCG.")
          (var bool stale_no_msg (> (call saturating_sub (. l display_loop_counter) (. l last_silkbar_msg_loop)) 120))
          (var bool stale_repeats (> (. l repeated_silkbar_second_msgs) 20))
          (if (&& (. l clock_from_silkbar) (|| stale_no_msg stale_repeats))
            (block
              (= (. l clock_from_silkbar) false)
              (= (. l repeated_silkbar_second_msgs) 0)
              (if (call take (& (-> s clock_fallback_resume_log)))
                (call sexos_line "[sexdisplay.clock.source.fallback.rearm] reason=stale_silkbar loop=%llu last_ss=%u"
                  (cast (unsigned long long) (. l display_loop_counter)) (cast unsigned (. bar clock_ss))))))
          (if (! (. l clock_from_silkbar)) (call fallback_clock s (& bar) (& l) raw_ticks))
          (if (! (. l stale_probe_done))
            (block
              (var uint8_t canonical_ss (-> s clock_canon_ss))
              (if (>= canonical_ss 2)
                (block
                  (= (. l stale_probe_done) true)
                  (call sexos_line "[sexdisplay.clock.stale_probe.begin] canonical_ss=%u stale_ss=%u" (cast unsigned canonical_ss) (cast unsigned (- canonical_ss 1)))
                  (call sexos_line "[sexdisplay.clock.stale_drop] incoming_ss=%u canonical_ss=%u accepted=0 proof=1" (cast unsigned (- canonical_ss 1)) (cast unsigned canonical_ss))
                  (= (. l fallback_after_drop_pending) true)
                  (= (. l fallback_after_drop_pending_proof) true)
                  (call sexos_line "[sexdisplay.clock.stale_probe.done] ok=1")))))
          (comment "A bounded drain of at most DRAIN_MAX messages.")
          (for (var size_t k 0) (< k DRAIN_MAX) (++ k)
            (block
              (var SexosMessage msg (init 0))
              (if (! (call sexos_try_listen 0 (& msg))) break)
              (+= drained 1)
              (call handle_message s (& bar) (& l) (& msg))))
          (if (&& (call take (& (-> s render_budget_cycle_log))) (call hot_log s))
            (call sexos_line "[sexdisplay.render.budget] drained=%zu surface=%u strip=%u primary=%u" drained
              (cast unsigned (. l needs_surface_redraw)) (cast unsigned (. l needs_top_strip_redraw)) (cast unsigned (. l did_primary_fb_render))))
          (comment "The surface area is redrawn whenever needed, also after a primary-framebuffer render in the same cycle, so chrome updates drained with it are not lost.")
          (if (. l needs_surface_redraw)
            (block
              (call clock_canon_apply_to_bar s (& bar))
              (call redraw_surface_area s (-> s fb_ptr) (-> s fb_w) (-> s fb_h)))
            (if (&& (. l cursor_only_moved) (. l fb_live))
              (block
                (comment "Cursor-only fast path: restore the patch beneath the old cursor and draw (and save) at the newest position; intermediate positions coalesce.")
                (var (volatile uint32_t) (* fb) (call framebuffer (-> s fb_ptr)))
                (var size_t w (-> s fb_w))
                (var size_t h (-> s fb_h))
                (call restore_cursor_under s fb w h (* w h))
                (call draw_cursor_z_top s fb w h (* w h) true))))
          (if (. l needs_top_strip_redraw)
            (block
              (call clock_canon_apply_to_bar s (& bar))
              (call redraw_top_strip s (-> s fb_ptr) (-> s fb_w) (-> s fb_h) (& bar))
              (= (-> s last_redrawn_clock_canon_ss) (-> s clock_canon_ss))))
          (comment "Yield once whether or not messages remain queued.")
          (+= (. l loop_iter) 1)
          (call sexos_yield))))

  ))
