            (init 0x1E 0x11 0x11 0x1E 0x10 0x10 0x10) (init 0x0E 0x11 0x11 0x11 0x15 0x12 0x0D)
            (init 0x1E 0x11 0x11 0x1E 0x14 0x12 0x11) (init 0x0E 0x11 0x10 0x0E 0x01 0x11 0x0E)
