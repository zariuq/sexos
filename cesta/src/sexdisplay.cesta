            (init 0x00 0x04 0x15 0x0E 0x15 0x04 0x00) (init 0x00 0x04 0x04 0x1F 0x04 0x04 0x00)
            (init 0x00 0x00 0x00 0x00 0x0C 0x04 0x08) (init 0x00 0x00 0x00 0x1F 0x00 0x00 0x00)
            (init 0x00 0x00 0x00 0x00 0x00 0x0C 0x0C) (init 0x01 0x02 0x02 0x04 0x08 0x08 0x10)
            (init 0x0E 0x11 0x13 0x15 0x19 0x11 0x0E) (init 0x04 0x0C 0x04 0x04 0x04 0x04 0x0E)
            (init 0x0E 0x11 0x01 0x02 0x04 0x08 0x1F) (init 0x0E 0x11 0x01 0x06 0x01 0x11 0x0E)
            (init 0x02 0x06 0x0A 0x12 0x1F 0x02 0x02) (init 0x1F 0x10 0x1E 0x01 0x01 0x11 0x0E)
            (init 0x06 0x08 0x10 0x1E 0x11 0x11 0x0E) (init 0x1F 0x01 0x02 0x04 0x08 0x08 0x08)
