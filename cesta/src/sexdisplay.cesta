(cesta native-c/1 compact-c/2
  (unit
    (include "sexos_server.h")
    (include "silkbar_model.h")
    (comment "SexDisplay compositor, translated from servers/sexdisplay/src/main.rs. The Rust statics, global and function-local, are fields of one owned Sexdisplay state; its two 500 KiB glass buffers exceed the 64 KiB stack, so that one value lives in static storage and only sexdisplay_main takes its address. Every index the Rust bounds-checks is checked here too, and a failed check stops the server as Rust's panic handler does.")
    (define OP_DISPLAY_READY "UINT64_C(0x101)")
    (define DISPLAY_READY_VERSION "UINT64_C(1)")
    (define DISPLAY_READY_SLOT_SHELL "UINT64_C(6)")
    (define DISPLAY_READY_SLOT_SILKBAR "UINT64_C(7)")
    (cpp-if "!defined(SEXOS_DISPLAY_READY_PUBLISHER)" (then (define SEXOS_DISPLAY_READY_PUBLISHER "1")))
    (define DISPLAY_READY_PUBLISHER_ENABLED "(((SEXOS_DISPLAY_READY_PUBLISHER) != 0))")

    (comment "Build-time proof profiles (option_env! in the Rust source).")
    (cpp-if "defined(SEXOS_SILKBAR_PHASE3_RECEIVE_PROOF)"
      (then (define SILKBAR_PHASE3_RECEIVE_PROOF_ENABLED "1"))
      (else (define SILKBAR_PHASE3_RECEIVE_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SILKBAR_PHASE5_PIXEL_PROOF)"
      (then (define SILKBAR_PHASE5_PIXEL_PROOF_ENABLED "1"))
      (else (define SILKBAR_PHASE5_PIXEL_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_SILK_RENDER_PROOF_PROFILE)"
      (then (define SILK_RENDER_PROOF_PROFILE_ENABLED "1"))
      (else (define SILK_RENDER_PROOF_PROFILE_ENABLED "0")))
    (cpp-if "defined(SEXOS_ATLAS_PHASE_C_RENDER_STUB_PROOF)"
      (then (define ATLAS_PHASE_C_RENDER_STUB_PROOF_ENABLED "1"))
      (else (define ATLAS_PHASE_C_RENDER_STUB_PROOF_ENABLED "0")))
    (cpp-if "defined(SEXOS_ATLAS_PHASE_D_FRAME_PREVIEW_STUB_PROOF)"
      (then (define ATLAS_PHASE_D_FRAME_PREVIEW_STUB_PROOF_ENABLED "1"))
      (else (define ATLAS_PHASE_D_FRAME_PREVIEW_STUB_PROOF_ENABLED "0")))

    (comment "The framebuffer lies in the kernel's high half: the fallback until OP_PRIMARY_FB names the live one, and any address below HIGH_HALF_BASE is refused. A hosted build may place both elsewhere.")
    (cpp-if "!defined(FALLBACK_PTR)" (then (define FALLBACK_PTR "UINT64_C(0xffff8000fd000000)")))
    (cpp-if "!defined(HIGH_HALF_BASE)" (then (define HIGH_HALF_BASE "UINT64_C(0xffff800000000000)")))
    (define FALLBACK_W "UINT32_C(1280)")
    (define FALLBACK_H "UINT32_C(800)")
    (define MAX_FB_W "((size_t)8192)")
    (define MAX_FB_H "((size_t)4320)")
    (comment "Text arrives eight bytes per message. Applying up to 256 messages per frame prevents the current upstream display inbox from falling seconds behind without making the drain unbounded. Frozen-reference qualification selects its historical value explicitly.")
    (cpp-if "!defined(SEXOS_DISPLAY_DRAIN_MAX)" (then (define SEXOS_DISPLAY_DRAIN_MAX "256u")))
    (define DRAIN_MAX "((size_t)SEXOS_DISPLAY_DRAIN_MAX)")

    (comment "Atlas Phase C cards: flat 2-pixel teal-cyan outlines around active surfaces below the bar.")
    (define ATLAS_CARD_BORDER_COLOR "UINT32_C(0x0089DCE6)")
    (define ATLAS_CARD_BORDER_PX "((size_t)2)")
    (define ATLAS_CARD_MAX_CARDS "((size_t)16)")
    (comment "Atlas Phase D previews: flat interiors inset from the card edges.")
    (define ATLAS_PREVIEW_INNER_MARGIN "((size_t)4)")
    (define ATLAS_PREVIEW_MAX_PREVIEWS "((size_t)16)")
    (define ATLAS_PREVIEW_ACTIVE_COLOR "UINT32_C(0x00B880FF)")
    (define ATLAS_PREVIEW_VISIBLE_COLOR "UINT32_C(0x003070A0)")
    (define ATLAS_PREVIEW_MINIMIZED_COLOR "UINT32_C(0x00505058)")

    (comment "The glass buffers cover the bar rows of framebuffers up to 2560 pixels wide.")
    (define BAR_BG_W_CAP "((size_t)2560)")
    (define BAR_BG_H "((size_t)50)")

    (comment "Surface registry (V1: inline ABI, no backing buffers). A surface is a solid rectangle below the bar with up to MAX_RECTS fill rectangles and a text buffer. owner_pd is bound on first create and never changes while active; only the owner may mutate or destroy it, while focus is compositor state open to all callers.")
    (define MAX_RECTS "((size_t)8)")
    (define MAX_SURFACES "((size_t)16)")
    (define TEXT_BUF_CAP "((size_t)512)")
    (define TEXT_MAX_ROWS "((size_t)24)")
    (define TEXT_LEGACY_COLS "((uint8_t)20)")
    (typedef (struct Surface
      (uint64_t surface_id)
      (uint32_t owner_pd)
      (int32_t x) (int32_t y) (uint32_t w) (uint32_t h)
      (uint32_t color)
      (bool active)
      (comment "Tab info (0xFD from the shell) and chrome flags (bit 0: top bar).")
      (uint8_t tab_count) (uint8_t active_tab) (uint8_t chrome_flags)
      (comment "fill_count is the highest set rectangle index plus one.")
      (uint8_t fill_count)
      (int32_t ([] fill_sx MAX_RECTS)) (int32_t ([] fill_sy MAX_RECTS))
      (uint32_t ([] fill_sw MAX_RECTS)) (uint32_t ([] fill_sh MAX_RECTS)) (uint32_t ([] fill_color MAX_RECTS))
      (uint16_t text_len)
      (uint32_t text_color)
      (comment "TEXT_MODEL_V2: line starts are recomputed on every write; lines split on newline and wrap at wrap_cols, which stays at the legacy 20 until a newline appears.")
      (uint8_t ([] text_buf TEXT_BUF_CAP))
      (uint16_t ([] line_starts TEXT_MAX_ROWS))
      (uint8_t line_count)
      (uint8_t wrap_cols)) Surface)

    (define FOCUS_SURFACE_COLOR "UINT32_C(0x0089B4FA)")
    (comment "Frame rim of the focused surface (minimal mode until OP_SURFACE_TAB_INFO sets the top bar), sized so the first render already shows clickable lights.")
    (define FRAME_RIM_PX "((size_t)8)")
    (define FRAME_RIM_COLOR "UINT32_C(0x00B4BEFE)")
    (define FRAME_LIGHT_SIZE_PX "((size_t)8)")
    (define FRAME_LIGHT_GAP_PX "((size_t)3)")
    (define FRAME_LIGHT_CLOSE_COLOR "UINT32_C(0x00FF4444)")
    (define FRAME_LIGHT_MINIMIZE_COLOR "UINT32_C(0x00FFCC44)")
    (define FRAME_LIGHT_ZOOM_COLOR "UINT32_C(0x0044FF44)")
    (comment "V1 disables close everywhere: red renders at reduced alpha.")
    (define FRAME_LIGHT_CLOSE_DISABLED_BASE_ALPHA "((uint8_t)160)")
    (define TAB_STRIP_LIGHT_EXCLUSION_PX "((size_t)20)")
    (define TAB_ACTIVE_COLOR "FOCUS_SURFACE_COLOR")
    (define TAB_INACTIVE_COLOR "UINT32_C(0x0045475A)")
    (comment "chrome_flags: bit 0 top bar, bit 1 frame hovered, bit 2 light hovered, bits 3-4 the hovered light (close, minimize, zoom), bit 5 close allowed.")
    (define SURFACE_CHROME_TOP_BAR "((uint8_t)0x01)")
    (define SURFACE_CHROME_FRAME_HOVER "((uint8_t)0x02)")
    (define SURFACE_CHROME_LIGHT_HOVER "((uint8_t)0x04)")
    (define SURFACE_CHROME_LIGHT_KIND_MASK "((uint8_t)0x18)")
    (define SURFACE_CHROME_LIGHT_KIND_SHIFT "3")
    (define SURFACE_CHROME_CLOSE_ALLOWED "((uint8_t)0x20)")
    (comment "Default chrome: a 28-pixel top bar with three 10-pixel lights.")
    (define FRAME_TOP_BAR_HEIGHT_PX "((size_t)28)")
    (define FRAME_TOP_BAR_LIGHT_SIZE_PX "((size_t)10)")
    (define FRAME_TOP_BAR_LIGHT_GAP_PX "((size_t)5)")
    (define FRAME_TOP_BAR_LIGHT_EXCLUSION_PX "((size_t)50)")
    (define FRAME_TOP_BAR_COLOR "UINT32_C(0x001E1E2E)")
    (define FRAME_TOP_BAR_DIVIDER_COLOR "UINT32_C(0x00B4BEFE)")
    (define FRAME_TOP_BAR_LIGHT_TOP "((size_t)9)")
    (define FRAME_TOP_BAR_LIGHT_BOTTOM "((size_t)19)")

    (comment "Appearance tokens (V1: flat colors, blur forced to zero).")
    (typedef (struct RenderTokensV1
      (uint32_t focus_surface_color) (uint32_t frame_rim_color) (uint32_t frame_top_bar_color)
      (uint32_t active_tab_color) (uint32_t inactive_tab_color) (uint32_t close_light_color)
      (uint32_t minimize_light_color) (uint32_t zoom_light_color)
      (uint8_t appearance_flags) (uint8_t effect_levels)) RenderTokensV1)

    (comment "The shell's cursor surface, always drawn last, and its launcher panel.")
    (define CURSOR_SURFACE_ID "UINT64_C(0x90)")
    (define LAUNCHER_PANEL_SURFACE_ID "UINT64_C(0x92)")

    (comment "Classic NW arrow, 8 by 16; bit 7 of a row is its leftmost pixel.")
    (define CURSOR_ARROW_W "((size_t)8)")
    (define CURSOR_ARROW_H "((size_t)16)")
    (define CURSOR_ARROW_COLOR "UINT32_C(0x00FFFFFF)")

    (comment "The deterministic top-strip proof renders 1280 by 51 pixels and expects this FNV-1a hash.")
    (define PROOF_W "((size_t)1280)")
    (define PROOF_H "((size_t)51)")
    (define SILK_DE_TOPSTRIP_EXPECTED_HASH "UINT64_C(0x9b5d54e17bdfa6f1)")
    (define SILK_DE_CONFORMANCE_PROOF_W_MAX "((size_t)1280)")
    (define SILK_DE_CONFORMANCE_PROOF_H_MAX "((size_t)51)")
    (typedef (struct Sexdisplay
      (uint64_t fb_ptr)
      (uint32_t fb_w)
      (uint32_t fb_h)
      (uint32_t hot_log_budget)
      (uint32_t ([] bar_bg_buf (* BAR_BG_H BAR_BG_W_CAP)))
      (uint32_t ([] bar_blur_buf (* BAR_BG_H BAR_BG_W_CAP)))
      (Surface ([] surfaces MAX_SURFACES))
      (uint64_t focused_surface_id)
      (RenderTokensV1 display_tokens)
      (uint64_t token_buf_arg0)
      (uint64_t token_buf_arg1)
      (uint64_t token_buf_arg2)
      (uint64_t reject_counter)
      (uint32_t display_wm_pd)
      (uint64_t render_frame_counter)
      (uint8_t clock_redraw_source)
      (uint8_t clock_canon_hh)
      (uint8_t clock_canon_mm)
      (uint8_t clock_canon_ss)
      (uint8_t last_redrawn_clock_canon_ss)
      (uint32_t clock_visible_prev_total)
      (uint32_t ([] cursor_under_saved (* CURSOR_ARROW_W CURSOR_ARROW_H)))
      (size_t cursor_under_x)
      (size_t cursor_under_y)
      (uint32_t input_trace_last_seq)
      (uint32_t input_trace_recv)
      (uint32_t input_trace_draws)
      (uint32_t input_trace_presents)
      (uint32_t input_trace_display_budget_hit)
      (uint32_t input_trace_last_shell_tick)
      (uint32_t display_recv_tick)
      (uint32_t display_draw_tick)
      (uint32_t display_present_tick)
      (uint32_t last_counted_draw_seq)
      (uint32_t appearance_tokens_applied)
      (comment "One-shot markers.")
      (bool anim_proof_logged) (bool blur_proof_logged) (bool cadence_parity_emitted) (bool clock_visible_mono_init) (bool cursor_under_valid) (bool cursor_z_top_logged) (bool live_topstrip_audit_done) (bool live_topstrip_rows_done) (bool live_topstrip_rows_ss4_done) (bool live_topstrip_tick4_fired) (bool r6_glass_proof_logged) (bool row_buffer_proof_logged) (bool silkbar_clock_send_marked) (bool token_buf_call1_received)
      (comment "Log budgets, in the order the Rust declares them.")
      (uint32_t hover_reveal_log) (uint32_t frame_light_startup_log) (uint32_t phase6_draw_ok_log) (uint32_t phase6_render_begin_log)
      (uint32_t phase6_bounds_ok_log) (uint32_t full_render_log) (uint32_t live_topstrip_clear_log) (uint32_t live_topstrip_bounds_log)
      (uint32_t top_strip_redraw_log) (uint32_t clock_redraw_log) (uint32_t phase3_state_log) (uint32_t phase5_draw_log)
      (uint32_t surface_area_redraw_log) (uint32_t display_cursor_draw_log) (uint32_t input_trace_draw_log) (uint32_t input_trace_present_log)
      (uint32_t launcher_panel_draw_log) (uint32_t card_skip_cursor_log) (uint32_t card_skip_zero_log) (uint32_t card_skip_overlap_log)
      (uint32_t card_layout_log) (uint32_t card_draw_log) (uint32_t card_done_log) (uint32_t preview_pass_log)
      (uint32_t preview_skip_zero_log) (uint32_t preview_skip_overlap_log) (uint32_t preview_skip_small_log) (uint32_t preview_layout_log)
      (uint32_t preview_draw_log) (uint32_t preview_done_log) (uint32_t update_recv_log) (uint32_t update_apply_log)
      (uint32_t selected_options_update_log) (uint32_t bell_render_log) (uint32_t fb_live_wait_log) (uint32_t clock_fallback_resume_log)
      (uint32_t cadence_sample_log) (uint32_t skip_same_second_log) (uint32_t live_after_reject_log) (uint32_t post_reject_cadence_log)
      (uint32_t reject_streak_proof_log) (uint32_t fallback_after_drop_continue_log) (uint32_t clock_handoff_reject_log) (uint32_t clock_handoff_accept_log)
      (uint32_t clock_source_repeat_log) (uint32_t clock_source_apply_log) (uint32_t clock_recv_log) (uint32_t clock_apply_log)
      (uint32_t clock_stale_drop_log) (uint32_t skip_same_second_stale_log) (uint32_t display_cursor_update_log) (uint32_t input_trace_recv_log)
      (uint32_t appearance_tokens_seq0_log) (uint32_t appearance_tokens_seq1_log) (uint32_t surface_tab_info_log) (uint32_t frame_hover_recv_log)
      (uint32_t render_budget_cycle_log)) Sexdisplay)

    (comment "Rust's bounds checks panic, and its panic handler spins forever.")
    (fn (static void) panic (void)
      (call sexos_spin_forever))

    (comment "A budget allows its line while it lasts.")
    (fn (static bool) take ((uint32_t (* budget)))
      (if (== (* budget) 0) (return false))
      (-= (* budget) 1)
      (return true))

    (comment "A one-shot marker fires the first time only (an AtomicBool swap in the Rust).")
    (fn (static bool) once ((bool (* fired)))
      (if (* fired) (return false))
      (= (* fired) true)
      (return true))

    (comment "SERIAL_DIET_V1: one shared budget for hot-loop diagnostics. The first 300 lines keep the full early trace; error and gate markers do not use it.")
    (fn (static bool) hot_log ((Sexdisplay (* s)))
      (return (call take (& (-> s hot_log_budget)))))

    (comment "Rust's `as i32` and its release-mode i32 arithmetic wrap; C's would not, so they go through defined unsigned arithmetic.")
    (fn (static int32_t) wrap_i32 ((uint64_t word))
      (var uint32_t low (cast uint32_t word))
      (return (?: (< low 0x80000000u) (cast int32_t low) (+ (cast int32_t (- low 0x80000000u)) INT32_MIN))))
    (fn (static int32_t) add_i32 ((int32_t a) (int32_t b))
      (return (call wrap_i32 (+ (cast uint32_t a) (cast uint32_t b)))))
    (fn (static int32_t) sub_i32 ((int32_t a) (int32_t b))
      (return (call wrap_i32 (- (cast uint32_t a) (cast uint32_t b)))))

    (fn (static size_t) min_size ((size_t a) (size_t b)) (return (?: (< a b) a b)))
    (fn (static size_t) saturating_sub ((size_t a) (size_t b)) (return (?: (> a b) (- a b) 0)))
    (fn (static size_t) saturating_add ((size_t a) (size_t b)) (return (?: (> a (- SIZE_MAX b)) SIZE_MAX (+ a b))))

    (comment "The renderer ignores alpha, but every token gets an opaque alpha byte.")
    (fn (static uint32_t) clamp_color_token ((uint32_t c))
      (return (| c 0xFF000000u)))

    (fn (static void) clock_canon_store ((Sexdisplay (* s)) (uint8_t hh) (uint8_t mm) (uint8_t ss))
      (= (-> s clock_canon_hh) hh)
      (= (-> s clock_canon_mm) mm)
      (= (-> s clock_canon_ss) ss))

    (fn (static uint32_t) clock_total_seconds ((uint8_t hh) (uint8_t mm) (uint8_t ss))
      (return (+ (+ (* (cast uint32_t hh) 3600) (* (cast uint32_t mm) 60)) (cast uint32_t ss))))

    (comment "Same or later, or one rollover at midnight.")
    (fn (static bool) clock_visible_monotonic_ok ((uint32_t prev) (uint32_t curr))
      (return (|| (>= curr prev) (&& (>= prev 86300) (<= curr 60)))))

    (fn (static void) clock_canon_apply_to_bar (((const Sexdisplay) (* s)) (SilkBar (* bar)))
      (= (-> bar clock_hh) (-> s clock_canon_hh))
      (= (-> bar clock_mm) (-> s clock_canon_mm))
      (= (-> bar clock_ss) (-> s clock_canon_ss)))

    (typedef (struct Rect (size_t x) (size_t y) (size_t w) (size_t h)) Rect)

    (comment "A surface clamped to the framebuffer and below the bar. BAR_H is the model's PANEL_Y + PANEL_H (48) plus a 2-pixel margin.")
    (fn (static Rect) clamp_surface (((const Surface) (* surf)) (size_t fb_w) (size_t fb_h))
      (var size_t x (call min_size (cast size_t (?: (> (-> surf x) 0) (-> surf x) 0)) (call saturating_sub fb_w 1)))
      (var size_t y (call min_size (cast size_t (?: (> (-> surf y) 50) (-> surf y) 50)) (call saturating_sub fb_h 1)))
      (var size_t w (call min_size (-> surf w) (call saturating_sub fb_w x)))
      (var size_t h (call min_size (-> surf h) (call saturating_sub fb_h y)))
      (return (compound Rect (= (. x) x) (= (. y) y) (= (. w) w) (= (. h) h))))

    (fn (static bool) in_rect ((size_t x) (size_t y) (size_t rx) (size_t ry) (size_t rw) (size_t rh))
      (return (&& (&& (>= x rx) (< x (+ rx rw))) (&& (>= y ry) (< y (+ ry rh))))))

    (comment "Fill rectangles in painter's order: the last one containing the pixel wins.")
    (fn (static uint32_t) fill_rect_color (((const Surface) (* surf)) (size_t x) (size_t y) (uint32_t base_color))
      (if (== (-> surf fill_count) 0) (return base_color))
      (var int32_t lx (call sub_i32 (call wrap_i32 x) (-> surf x)))
      (var int32_t ly (call sub_i32 (call wrap_i32 y) (-> surf y)))
      (var uint32_t c base_color)
      (var size_t count (-> surf fill_count))
      (if (> count MAX_RECTS) (call panic))
      (for (var size_t i 0) (< i count) (++ i)
        (block
          (if (|| (== ([] (-> surf fill_sw) i) 0) (== ([] (-> surf fill_sh) i) 0)) continue)
          (if (&& (&& (>= lx ([] (-> surf fill_sx) i))
                      (< lx (call add_i32 ([] (-> surf fill_sx) i) (call wrap_i32 ([] (-> surf fill_sw) i)))))
                  (&& (>= ly ([] (-> surf fill_sy) i))
                      (< ly (call add_i32 ([] (-> surf fill_sy) i) (call wrap_i32 ([] (-> surf fill_sh) i))))))
            (= c ([] (-> surf fill_color) i)))))
      (return c))

    (comment "Fixed-point interpolation between two XRGB colors: t=0 gives a, t=255 gives b, alpha forced opaque. The channel arithmetic wraps as the Rust's does.")
    (fn (static uint32_t) lerp_color_xrgb ((uint32_t a) (uint32_t b) (uint8_t t))
      (if (== t 0) (return (| a 0xFF000000u)))
      (if (== t 255) (return (| b 0xFF000000u)))
      (var uint32_t ar (& a 0xFF)) (var uint32_t ag (& (>> a 8) 0xFF)) (var uint32_t ab (& (>> a 16) 0xFF))
      (var uint32_t br (& b 0xFF)) (var uint32_t bg_ (& (>> b 8) 0xFF)) (var uint32_t bb (& (>> b 16) 0xFF))
      (var uint32_t ti t)
      (var uint32_t r (+ ar (/ (* (- br ar) ti) 255u)))
      (var uint32_t g (+ ag (/ (* (- bg_ ag) ti) 255u)))
      (var uint32_t b2 (+ ab (/ (* (- bb ab) ti) 255u)))
      (return (| (| (| 0xFF000000u (<< b2 16)) (<< g 8)) r)))

    (fn (static uint32_t) vertical_gradient_xrgb ((size_t y) (size_t h) (uint32_t top) (uint32_t bottom))
      (if (<= h 1) (return top))
      (var uint32_t t (/ (* (cast uint32_t (call min_size y (- h 1))) 255u) (cast uint32_t (- h 1))))
      (return (call lerp_color_xrgb top bottom (cast uint8_t t))))

    (comment "Desktop background: a smooth gradient between the theme's endpoint colors.")
    (fn (static uint32_t) bg ((size_t y) (size_t h))
      (return (call vertical_gradient_xrgb y h (. DEFAULT_THEME bg_top) (. DEFAULT_THEME bg_bottom))))

    (fn (static bool) fill_bar_bg_buffer ((Sexdisplay (* s)) (uint32_t fb_w) (uint32_t fb_h))
      (var size_t fill_w fb_w)
      (if (> fill_w BAR_BG_W_CAP) (return false))
      (var size_t fill_h (call min_size BAR_BG_H fb_h))
      (for (var size_t y 0) (< y fill_h) (++ y)
        (block
          (var uint32_t c (call bg y fb_h))
          (for (var size_t x 0) (< x fill_w) (++ x)
            (= ([] (-> s bar_bg_buf) (+ (* y BAR_BG_W_CAP) x)) c))))
      (return true))

    (comment "A box blur of radius 1 over the bar rows, the window clipped at the edges.")
    (fn (static bool) blur_bar_bg_buffer_radius1 ((Sexdisplay (* s)) (uint32_t fb_w) (uint32_t fb_h))
      (var size_t width fb_w)
      (if (> width BAR_BG_W_CAP) (return false))
      (var size_t height (call min_size BAR_BG_H fb_h))
      (for (var size_t y 0) (< y height) (++ y)
        (for (var size_t x 0) (< x width) (++ x)
          (block
            (var uint32_t acc_r 0) (var uint32_t acc_g 0) (var uint32_t acc_b 0)
            (var size_t y0 (call saturating_sub y 1))
            (var size_t y1 (call min_size (+ y 1) (call saturating_sub height 1)))
            (var size_t x0 (call saturating_sub x 1))
            (var size_t x1 (call min_size (+ x 1) (call saturating_sub width 1)))
            (for (var size_t sy y0) (<= sy y1) (++ sy)
              (for (var size_t sx x0) (<= sx x1) (++ sx)
                (block
                  (var uint32_t c ([] (-> s bar_bg_buf) (+ (* sy BAR_BG_W_CAP) sx)))
                  (+= acc_r (& c 0xFF))
                  (+= acc_g (& (>> c 8) 0xFF))
                  (+= acc_b (& (>> c 16) 0xFF)))))
            (var uint32_t count (cast uint32_t (* (+ (- y1 y0) 1) (+ (- x1 x0) 1))))
            (var uint32_t r (& (/ acc_r count) 0xFF))
            (var uint32_t g (& (/ acc_g count) 0xFF))
            (var uint32_t b (& (/ acc_b count) 0xFF))
            (= ([] (-> s bar_blur_buf) (+ (* y BAR_BG_W_CAP) x)) (| (| (| 0xFF000000u (<< b 16)) (<< g 8)) r)))))
      (return true))

    (fn (static uint32_t) sample_bar_blur_bg_xrgb (((const Sexdisplay) (* s)) (uint32_t x) (uint32_t y) (uint32_t fb_w) (uint32_t fb_h))
      (if (|| (> (cast size_t fb_w) BAR_BG_W_CAP) (|| (>= (cast size_t y) BAR_BG_H) (>= x fb_w)))
        (return (call bg y fb_h)))
      (return ([] (-> s bar_blur_buf) (+ (* (cast size_t y) BAR_BG_W_CAP) x))))

    (fn (static uint8_t) triangle_wave_u8 ((uint64_t frame) (uint64_t period))
      (if (== period 0) (return 0))
      (var uint64_t pos (% frame period))
      (var uint64_t half (/ period 2))
      (if (== half 0) (return 0))
      (if (< pos half) (return (cast uint8_t (/ (* pos 255) half))))
      (var uint64_t denom (- period half))
      (if (== denom 0) (return 0))
      (return (cast uint8_t (/ (* (- period pos) 255) denom))))

    (fn (static uint8_t) pulse_alpha ((uint8_t base) (uint8_t amp) (uint64_t frame) (uint64_t period))
      (if (== period 0) (return base))
      (var int32_t centered (- (cast int32_t (call triangle_wave_u8 frame period)) 127))
      (var int32_t out (+ (cast int32_t base) (/ (* centered (cast int32_t amp)) 127)))
      (return (cast uint8_t (?: (< out 0) 0 (?: (> out 255) 255 out)))))

    (comment "XRGB over XRGB: alpha 0 gives the background, 255 the foreground; opaque result, integers only.")
    (fn (static uint32_t) alpha_blend_xrgb_over_xrgb ((uint32_t fg) (uint32_t bg_color) (uint8_t alpha))
      (if (== alpha 0) (return bg_color))
      (if (== alpha 255) (return fg))
      (var uint32_t a alpha)
      (var uint32_t inv (- 255u a))
      (var uint32_t r (/ (+ (* (& fg 0xFF) a) (* (& bg_color 0xFF) inv)) 255u))
      (var uint32_t g (/ (+ (* (& (>> fg 8) 0xFF) a) (* (& (>> bg_color 8) 0xFF) inv)) 255u))
      (var uint32_t b (/ (+ (* (& (>> fg 16) 0xFF) a) (* (& (>> bg_color 16) 0xFF) inv)) 255u))
      (return (| (| (| 0xFF000000u (<< b 16)) (<< g 8)) r)))

    (comment "Glass: a foreground blended over the blurred desktop gradient.")
    (fn (static uint32_t) glass_over_bg (((const Sexdisplay) (* s)) (uint32_t fg) (size_t x) (size_t y) (uint8_t alpha))
      (if (== (-> s fb_h) 0) (return fg))
      (var uint32_t under (call sample_bar_blur_bg_xrgb s (cast uint32_t x) (cast uint32_t y) (-> s fb_w) (-> s fb_h)))
      (return (call alpha_blend_xrgb_over_xrgb fg under alpha)))

    (comment "Linear edge glow: distance 0 gives max_alpha, the spread or more gives 0.")
    (fn (static uint8_t) glow_edge_alpha ((uint32_t dist) (uint32_t spread) (uint8_t max_alpha))
      (if (|| (== spread 0) (>= dist spread)) (return 0))
      (return (cast uint8_t (/ (* (cast uint32_t max_alpha) (- spread dist)) spread))))

    (fn (static Rect) module_rect (((const SilkBar) (* bar)) (SilkBarModuleSlot slot))
      (var (const SilkBarLayoutBox) (* lb) (& ([] (-> bar layout) slot)))
      (return (compound Rect (= (. x) (-> lb x)) (= (. y) (-> lb y)) (= (. w) (-> lb w)) (= (. h) (-> lb h)))))

    (comment "Workspace indicators: the active one glows over glass with a slow pulse.")
    (var (static const SilkBarModuleSlot) ([] WS_SLOTS 5)
      (init SILKBAR_MODULE_SLOT_WORKSPACE0 SILKBAR_MODULE_SLOT_WORKSPACE1 SILKBAR_MODULE_SLOT_WORKSPACE2
            SILKBAR_MODULE_SLOT_WORKSPACE3 SILKBAR_MODULE_SLOT_WORKSPACE4))
    (fn (static bool) workspace_color (((const Sexdisplay) (* s)) (size_t x) (size_t y) ((const SilkBar) (* bar)) (uint32_t (* out)))
      (for (var size_t idx 0) (< idx 5) (++ idx)
        (block
          (var Rect r (call module_rect bar ([] WS_SLOTS idx)))
          (if (call in_rect x y (. r x) (. r y) (. r w) (. r h))
            (block
              (var (const SilkBarWorkspaceState) (* ws) (& ([] (-> bar workspaces) idx)))
              (if (-> ws active)
                (block
                  (var uint8_t glow_alpha (call pulse_alpha 48 32 (-> s render_frame_counter) 96))
                  (var uint32_t active_glow (call alpha_blend_xrgb_over_xrgb 0x00FFFFFFu (. DEFAULT_THEME active) glow_alpha))
                  (= (* out) (call glass_over_bg s active_glow x y 224))
                  (return true)))
              (= (* out) (?: (-> ws urgent) (. DEFAULT_THEME urgent) (. DEFAULT_THEME muted)))
              (return true)))))
      (return false))

    (comment "Status chip backgrounds, R6 glass for the network chip.")
    (var (static const SilkBarModuleSlot) ([] CHIP_SLOTS 4)
      (init SILKBAR_MODULE_SLOT_CHIP0 SILKBAR_MODULE_SLOT_CHIP1 SILKBAR_MODULE_SLOT_CHIP2 SILKBAR_MODULE_SLOT_CLOCK))
    (fn (static bool) chip_color (((const Sexdisplay) (* s)) (size_t x) (size_t y) ((const SilkBar) (* bar)) (uint32_t (* out)))
      (for (var size_t idx 0) (< idx 4) (++ idx)
        (block
          (var Rect r (call module_rect bar ([] CHIP_SLOTS idx)))
          (if (call in_rect x y (. r x) (. r y) (. r w) (. r h))
            (block
              (var (const SilkBarChipState) (* chip) (& ([] (-> bar chips) idx)))
              (if (! (-> chip visible))
                (= (* out) 0x00102038u)
                (switch (-> chip kind)
                  (block
                    (case SILKBAR_CHIP_NET (= (* out) (call glass_over_bg s (. DEFAULT_THEME chip_fill) x y 212))) break
                    (case SILKBAR_CHIP_WIFI (= (* out) 0x0038D6C8u)) break
                    (case SILKBAR_CHIP_BATTERY (= (* out) 0x00FFB84Du)) break
                    (case SILKBAR_CHIP_CLOCK (= (* out) (. DEFAULT_THEME chip_border))) break)))
              (return true)))))
      (return false))

    (comment "Phase 5 pixel indicators: tiny dots and swatches inside the strip.")
    (fn (static bool) app_indicator_color ((uint32_t sid) (uint32_t (* out)))
      (comment "Linen green, Quil mauve, Mesh teal, Collar peach, Bell red, Spindle blue; no app none; any other dim gray.")
      (switch sid
        (block
          (case 200 (= (* out) 0x00A6E3A1u)) break
          (case 201 (= (* out) 0x00CBA6F7u)) break
          (case 202 (= (* out) 0x0094E2D5u)) break
          (case 203 (= (* out) 0x00FAB387u)) break
          (case 204 (= (* out) 0x00F38BA8u)) break
          (case 153 (= (* out) 0x0089B4FAu)) break
          (case 0 (return false))
          (default (= (* out) 0x00444444u))))
      (return true))

    (comment "The Atlas 8-accent palette: blue, green, yellow, peach, red, mauve, pink, teal.")
    (var (static const uint32_t) ([] ACCENT 8)
      (init 0x0089B4FAu 0x00A6E3A1u 0x00F9E2AFu 0x00FAB387u 0x00F38BA8u 0x00CBA6F7u 0x00F5C2E7u 0x0094E2D5u))
    (fn (static uint32_t) accent_swatch_color ((uint8_t idx))
      (return (?: (< idx 8) ([] ACCENT idx) 0x00444444u)))

    (comment "Active app: a 4x4 dot at (155, 22), right of the option dots.")
    (fn (static bool) phase5_active_app_at ((size_t x) (size_t y) ((const SilkBar) (* bar)) (uint32_t (* out)))
      (if (|| (! SILKBAR_PHASE5_PIXEL_PROOF_ENABLED) (== (. (-> bar phase1) active_app_sid) 0)) (return false))
      (if (! (call in_rect x y 155 22 4 4)) (return false))
      (return (call app_indicator_color (. (-> bar phase1) active_app_sid) out)))

    (comment "Tint swatch: 4x4 at (1045, 22), between Bell and Clock.")
    (fn (static bool) phase5_tint_swatch_at ((size_t x) (size_t y) ((const SilkBar) (* bar)) (uint32_t (* out)))
      (if (|| (! SILKBAR_PHASE5_PIXEL_PROOF_ENABLED) (! (call in_rect x y 1045 22 4 4))) (return false))
      (= (* out) (call accent_swatch_color (. (-> bar phase1) accent_tint_idx)))
      (return true))

    (comment "Palette dot: 3x3 at (1060, 23), bright green when open.")
    (fn (static bool) phase5_palette_dot_at ((size_t x) (size_t y) ((const SilkBar) (* bar)) (uint32_t (* out)))
      (if (|| (! SILKBAR_PHASE5_PIXEL_PROOF_ENABLED) (! (call in_rect x y 1060 23 3 3))) (return false))
      (= (* out) (?: (. (-> bar phase1) palette_open) 0x0044FF44u 0x00224422u))
      (return true))

    (comment "Selected-window option dots: red, green, yellow, cyan, 3x3 each, 5 apart from x=135 on rows 19..21.")
    (var (static const uint32_t) ([] OPTION_DOT_COLORS 4) (init 0x00FF4444u 0x0044FF44u 0x00FFCC44u 0x0044CCFFu))

    (fn (static uint32_t) bar_color (((const Sexdisplay) (* s)) (size_t x) (size_t y) ((const SilkBar) (* bar)))
      (comment "Only a dot's own pixels are intercepted; everything else falls through, so the modules on the same rows still render.")
      (if (&& (!= (-> bar selected_options_mask) 0) (&& (>= y 19) (< y 22)))
        (for (var size_t bit 0) (< bit 4) (++ bit)
          (block
            (var size_t dot_x (+ 135 (* bit 5)))
            (if (&& (&& (>= x dot_x) (< x (+ dot_x 3))) (!= (& (>> (-> bar selected_options_mask) bit) 1) 0))
              (return ([] OPTION_DOT_COLORS bit))))))
      (var uint32_t c 0)
      (if (call workspace_color s x y bar (& c)) (return c))
      (if (call chip_color s x y bar (& c)) (return c))
      (comment "Bell: a privacy-safe presence dot. Dim when Bell is unavailable or empty, amber with redacted events, gold otherwise.")
      (var Rect bell (call module_rect bar SILKBAR_MODULE_SLOT_BELL))
      (if (call in_rect x y (. bell x) (. bell y) (. bell w) (. bell h))
        (block
          (var (const SilkBarBellState) (* b) (& (-> bar bell_state)))
          (if (|| (== (& (-> b flags) 1) 0) (== (-> b total_visible) 0)) (return (. DEFAULT_THEME muted)))
          (return (?: (> (-> b redacted_count) 0) 0x00FFAA44u 0x00FFD700u))))
      (comment "Launcher: a rounded-illusion border around a glass body.")
      (var Rect l (call module_rect bar SILKBAR_MODULE_SLOT_LAUNCHER))
      (if (call in_rect x y (. l x) (. l y) (. l w) (. l h))
        (block
          (if (|| (|| (< x (+ (. l x) 2)) (>= x (- (+ (. l x) (. l w)) 2)))
                  (|| (< y (+ (. l y) 2)) (>= y (- (+ (. l y) (. l h)) 2))))
            (return (call glass_over_bg s (. DEFAULT_THEME panel_glow) x y 72)))
          (return (call alpha_blend_xrgb_over_xrgb 0x0082D6FFu (call glass_over_bg s 0x005CAEE8u x y 200) 64))))
      (comment "Bar body: glass over the desktop, a highlight on row 0, a dark edge on row 49 and a glow falling off over the last four rows.")
      (var uint32_t base (call glass_over_bg s (. DEFAULT_THEME panel_fill) x y 196))
      (if (== y 0) (return (call alpha_blend_xrgb_over_xrgb 0x00A8D8FFu base 64)))
      (if (== y 49)
        (return (call alpha_blend_xrgb_over_xrgb (. DEFAULT_THEME panel_glow)
          (call alpha_blend_xrgb_over_xrgb 0x000B1220u base 88) 48)))
      (if (&& (>= (+ y 4) 50) (< y 50))
        (block
          (var uint8_t glow_a (call glow_edge_alpha (cast uint32_t (- 49 y)) 4 72))
          (if (> glow_a 0)
            (return (call alpha_blend_xrgb_over_xrgb (. DEFAULT_THEME panel_glow)
              (call alpha_blend_xrgb_over_xrgb 0x001C2A54u base 36) glow_a)))))
      (return (call alpha_blend_xrgb_over_xrgb 0x001C2A54u base 32)))

    (comment "5x7 digit glyphs; bit 4 of a row is its leftmost pixel.")
    (var (static const uint8_t) ([] ([] FONT 10) 7)
