(cesta-tables/1
  (Table Domains
    (Columns (Column id Nat) (Column name Identifier) (Column module Text) (Column log_name Text))
    (Key name) (Unique id)
    (Rows (Row 1 sexdisplay "sexdisplay" "sexdisplay") (Row 2 sexdrive "sexdrive" "sexdrive")
          (Row 3 silk_shell "silk-shell" "silk-shell") (Row 4 sexinput "sexinput" "sexinput")
          (Row 5 sexusb "sexusb" "sexusb") (Row 6 silkbar "silkbar" "silkbar") (Row 7 linen "linen" "linen")
          (Row 8 sexstore "sexstore" "sexstore") (Row 9 quil "quil" "quil") (Row 10 sexbell "sexbell" "sexbell")
          (Row 11 sexfiles "sexfiles" "sexfiles") (Row 12 spindle "spindle" "spindle")
          (Row 13 sexnet "sexnet" "sexnet") (Row 15 kaleidoscope "kaleidoscope" "kaleidoscope")))
  (Table RingGrants
    (Columns (Column order Nat) (Column holder (Ref Domains name)) (Column slot Nat) (Column slot_label Text)
             (Column target (Ref Domains name)) (Column optional Bool))
    (Key order) (Unique holder slot)
    (Rows (Row 0 silk_shell 5 "SLOT_DISPLAY" sexdisplay false)
          (Row 1 silk_shell 6 "SLOT_SHELL" silk_shell false)
          (Row 2 silk_shell 7 "SLOT_SILKBAR" silkbar true)
          (Row 3 silk_shell 10 "SLOT_SEXSTORE" sexstore true)
          (Row 4 silk_shell 12 "SLOT_BELL" sexbell true)
          (Row 5 sexinput 6 "SLOT_SHELL" silk_shell false)
          (Row 6 sexusb 9 "9" sexinput true)
          (Row 7 silkbar 5 "SLOT_DISPLAY" sexdisplay false)
          (Row 8 silkbar 12 "SLOT_BELL" sexbell true)
          (Row 9 linen 5 "SLOT_DISPLAY" sexdisplay false)
          (Row 10 linen 1 "SLOT_STORAGE" sexfiles true)
          (Row 11 silk_shell 13 "SLOT_LINEN" linen true)
          (Row 12 silk_shell 11 "SLOT_QUIL" quil true)
          (Row 13 quil 5 "SLOT_DISPLAY" sexdisplay false)
          (Row 14 quil 1 "SLOT_STORAGE" sexfiles true)
          (Row 15 silk_shell 14 "SLOT_SPINDLE" spindle true)
          (Row 16 sexbell 12 "SLOT_BELL" sexbell true)
          (Row 17 spindle 5 "SLOT_DISPLAY" sexdisplay false)
          (Row 18 spindle 1 "SLOT_STORAGE" sexfiles true)
          (Row 19 spindle 12 "SLOT_BELL" sexbell true)
          (Row 20 spindle 13 "SLOT_LINEN" linen true)
          (Row 21 spindle 6 "SLOT_SHELL" silk_shell true)
          (Row 22 sexfiles 15 "SLOT_BLOCK" sexdrive true)
          (Row 23 kaleidoscope 18 "SLOT_NET" sexnet true)))
  (Table NetworkGrants
    (Columns (Column holder (Ref Domains name)) (Column slot Nat) (Column slot_label Text)
             (Column target (Ref Domains name)) (Column optional Bool))
    (Key holder slot)
    (Rows (Row kaleidoscope 5 "SLOT_DISPLAY" sexdisplay true)))
  (Table InputGrants
    (Columns (Column holder (Ref Domains name)) (Column slot Nat) (Column slot_label Text))
    (Key holder slot)
    (Rows (Row sexinput 3 "SLOT_INPUT"))))
