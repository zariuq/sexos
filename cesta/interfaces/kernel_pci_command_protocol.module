Module KernelPciCommand {
  Theory Protocols() {
    Empty Equations {
      (kernel_pci_command_run) == (Protocol "cesta-protocol/1"
        (Context KernelPciCommandContext)
        (Hooks
          (Hook snapshot kernel_pci_command_snapshot prepare
            (Requires) (Uses) (Proves snapshotted))
          (Hook transform kernel_pci_command_transform effect
            (Requires snapshotted) (Uses) (Proves transformed))
          (Hook swap kernel_pci_command_swap prepare
            (Requires snapshotted transformed) (Uses) (Proves swapped))
          (Hook commit kernel_pci_command_commit effect
            (Requires snapshotted transformed swapped) (Uses) (Proves)
            (Invalidates snapshotted transformed swapped)))
        (Resources)
        (Entry (Facts) (Owns))
        (Body
          (Call snapshot
            (Call transform
              (Call swap
                (Call commit (Return done) (Return engine_failure))
                (Return engine_failure))
              (Return engine_failure))
            (Return declined)))
        (Checks
          (Fact snapshotted kernel_pci_command_is_snapshotted)
          (Fact transformed kernel_pci_command_is_transformed)
          (Fact swapped kernel_pci_command_is_swapped)));
    }
  }
}
