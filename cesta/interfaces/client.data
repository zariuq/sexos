(cesta-tables/1
  (Table Syscalls
    (Columns (Column id Nat) (Column name Identifier))
    (Key id) (Unique name)
    (Rows (Row 0 call) (Row 28 listen) (Row 29 reply) (Row 30 map_memory) (Row 31 allocate_memory) (Row 32 yield)
          (Row 34 ticks) (Row 40 alloc_shared_buffer) (Row 42 set_state) (Row 43 map_pci_bar)
          (Row 50 grant_mem_lend) (Row 51 map_mem_lend) (Row 52 net_diag)))
  (Table Slots
    (Columns (Column id Nat) (Column name Identifier))
    (Key id) (Unique name)
    (Rows (Row 0 kernel) (Row 1 storage) (Row 3 input) (Row 5 display) (Row 6 shell) (Row 12 bell) (Row 13 linen)
          (Row 14 spindle) (Row 15 block) (Row 17 buf_lend) (Row 18 net)))
  (Table RpcSyscalls
    (Columns (Column id Nat) (Column name Identifier))
    (Key id) (Unique name)
    (Rows (Row 128 register) (Row 129 call) (Row 130 poll)
          (Row 131 listen) (Row 132 reply) (Row 133 cancel)))
  (Table KernelOperations
    (Columns (Column id Nat) (Column name Identifier))
    (Key id) (Unique name)
    (Rows (Row 69 raw_print) (Row 255 exit)))
  (Table DisplayOperations
    (Columns (Column id Nat) (Column name Identifier))
    (Key id) (Unique name)
    (Rows (Row 235 commit) (Row 236 create_surface) (Row 251 text_chunk)))
  (Table BellOperations
    (Columns (Column id Nat) (Column name Identifier))
    (Key id) (Unique name)
    (Rows (Row 192 notify) (Row 193 close) (Row 194 action) (Row 195 list) (Row 196 clear) (Row 197 subscribe)
          (Row 198 set_policy) (Row 199 mute_sender)))
  (Table SilkbarOperations
    (Columns (Column id Nat) (Column name Identifier))
    (Key id) (Unique name)
    (Rows (Row 240 ping) (Row 241 get_abi) (Row 242 update) (Row 243 workspace_active) (Row 244 focus_state)))
  (Table InputOperations
    (Columns (Column id Nat) (Column name Identifier))
    (Key id) (Unique name)
    (Rows (Row 513 raw_input) (Row 514 hid_event) (Row 608 usb_mouse_report) (Row 609 usb_keyboard_report)
          (Row 672 autodemo_tick)))
  (Table HidEventClasses
    (Columns (Column id Nat) (Column name Identifier))
    (Key id) (Unique name)
    (Rows (Row 1 key) (Row 2 rel) (Row 3 abs) (Row 4 btn)))
  (Table ServiceStates
    (Columns (Column id Nat) (Column name Identifier))
    (Key id) (Unique name)
    (Rows (Row 1 listening)))
  (Table NetworkOperations
    (Columns (Column id Nat) (Column name Identifier))
    (Key id) (Unique name)
    (Rows (Row 512 request) (Row 519 text_length) (Row 520 text_chunk)
          (Row 521 body_length) (Row 522 body_chunk) (Row 523 dns_resolve) (Row 524 http_result)))
)
