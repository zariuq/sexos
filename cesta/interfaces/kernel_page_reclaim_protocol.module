Module KernelPageReclaim {
  Theory Protocols() {
    Empty Equations {
      (kernel_page_reclaim_run) == (Protocol "cesta-protocol/1"
        (Context KernelPageReclaimContext)
        (Hooks
          (Hook snapshot kernel_page_reclaim_snapshot prepare
            (Requires) (Uses) (Proves snapshotted))
          (Hook transform kernel_page_reclaim_transform prepare
            (Requires snapshotted) (Uses) (Proves transformed))
          (Hook swap kernel_page_reclaim_swap prepare
            (Requires snapshotted transformed) (Uses) (Proves swapped))
          (Hook commit kernel_page_reclaim_commit effect
            (Requires snapshotted transformed swapped) (Uses) (Proves)
            (Invalidates snapshotted transformed swapped)))
        (Resources)
        (Entry (Facts) (Owns))
        (Body
          (Call snapshot
            (Call transform
              (Call swap
                (Call commit (Return done) (Return engine_failure))
                (Return engine_failure))
              (Return engine_failure))
            (Return declined)))
        (Checks
          (Fact snapshotted kernel_page_reclaim_is_snapshotted)
          (Fact transformed kernel_page_reclaim_is_transformed)
          (Fact swapped kernel_page_reclaim_is_swapped)));
    }
  }
}
