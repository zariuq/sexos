Module KernelInput {
  Theory Protocols() {
    Empty Equations {
      (kernel_input_push_run) == (Protocol "cesta-protocol/1"
        (Context KernelInputPushContext)
        (Hooks
          (Hook snapshot kernel_input_push_snapshot prepare
            (Requires) (Uses) (Proves snapshotted))
          (Hook transform kernel_input_push_transform prepare
            (Requires snapshotted) (Uses) (Proves transformed))
          (Hook swap kernel_input_push_swap effect
            (Requires snapshotted transformed) (Uses) (Proves swapped))
          (Hook commit kernel_input_push_commit effect
            (Requires snapshotted transformed swapped) (Uses) (Proves)
            (Invalidates snapshotted transformed swapped)))
        (Resources)
        (Entry (Facts) (Owns))
        (Body
          (Call snapshot
            (Call transform
              (Call swap
                (Call commit (Return done) (Return engine_failure))
                (Return engine_failure))
              (Return engine_failure))
            (Return declined)))
        (Checks
          (Fact snapshotted kernel_input_push_is_snapshotted)
          (Fact transformed kernel_input_push_is_transformed)
          (Fact swapped kernel_input_push_is_swapped)));

      (kernel_input_pop_run) == (Protocol "cesta-protocol/1"
        (Context KernelInputPopContext)
        (Hooks
          (Hook snapshot kernel_input_pop_snapshot prepare
            (Requires) (Uses) (Proves snapshotted))
          (Hook transform kernel_input_pop_transform prepare
            (Requires snapshotted) (Uses) (Proves transformed))
          (Hook swap kernel_input_pop_swap prepare
            (Requires snapshotted transformed) (Uses) (Proves swapped))
          (Hook commit kernel_input_pop_commit effect
            (Requires snapshotted transformed swapped) (Uses) (Proves)
            (Invalidates snapshotted transformed swapped)))
        (Resources)
        (Entry (Facts) (Owns))
        (Body
          (Call snapshot
            (Call transform
              (Call swap
                (Call commit (Return done) (Return engine_failure))
                (Return engine_failure))
              (Return engine_failure))
            (Return declined)))
        (Checks
          (Fact snapshotted kernel_input_pop_is_snapshotted)
          (Fact transformed kernel_input_pop_is_transformed)
          (Fact swapped kernel_input_pop_is_swapped)));
    }
  }
}
